@using Microsoft.Extensions.Localization
@model (int Round, StatisticsDetailsModel Details)
@inject ICurrentUser CurrentUser

@{
    var details = Model.Details;
    var round = Model.Round;
    var halves = details.Statistic?.Statistic?.Halves ?? [];
    var allPlayers = details.Statistic?.Statistic?.PlayerNames ?? [];
}

@{
    LocalizedString? PlayerStatsHelp(PlayerStats playerStats)
    {
        return playerStats switch
        {
            PlayerStats.DmgTaken => L["Damage from player infected and commons attributed to a Boomer; regular common damage is excluded."],
            _ => null
        };
    }

    LocalizedString? InfectedStatsHelp(InfectedStats infectedStats)
    {
        return infectedStats switch
        {
            InfectedStats.DmgTotal => L["SI damage, including incapacitated and post-boom damage; Tank damage is excluded."],
            InfectedStats.DmgBoom => L["Common damage to upright survivors after a Boomer bile."],
            InfectedStats.HunterDpDmg => L["Sum of damage from all recorded high pounces."],
            _ => null
        };
    }

    bool HasPlayerStats(List<Player> players, PlayerStats playerStats)
    {
        return players.Any(player => player[playerStats] != 0);
    }

    bool HasInfectedStats(List<InfectedPlayer> infectedPlayers, InfectedStats infectedStats)
    {
        return infectedPlayers.Any(player => player[infectedStats] != 0);
    }

    void RenderPlayerStats(List<Player> players, PlayerStats playerStats)
    {
        if (!HasPlayerStats(players, playerStats))
            return;

        var help = PlayerStatsHelp(playerStats);

        <tr>
            <th>
                @PlayerStatsText(playerStats):
                @if (help != null)
                {
                    <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@help" aria-label="@L["More information"]"></span>
                }
            </th>
            @foreach (var player in players)
            {
                <td class="slim text-center">
                    @if (playerStats == PlayerStats.AvgClearTime)
                    {
                        @((player[playerStats] / AppConsts.AvgClearTimeDivisor).ToString("N2"))
                    }
                    else
                    {
                        @player[playerStats].ToString("N0")
                    }
                </td>
            }
        </tr>
    }

    void RenderPlayerStatsCollection(List<Player> players, IEnumerable<PlayerStats> playerStats, bool lineBreak = true)
    {
        var any = false;

        @foreach (var ps in playerStats.Where(ps => HasPlayerStats(players, ps)))
        {
            RenderPlayerStats(players, ps);
            any = true;
        }

        @if (lineBreak && any)
        {
            <tr>
                <td colspan="@(players.Count + 1)"></td>
            </tr>
        }
    }

    void RenderPlayerStatsBetween(List<Player> players, PlayerStats start, PlayerStats end, bool lineBreak = true)
    {
        var startValue = (int)start;
        var endValue = (int)end;
        var count = Math.Max(endValue - startValue + 1, 1);
        var playerStats = Enumerable.Range(startValue, count).Select(v => (PlayerStats)v);

        RenderPlayerStatsCollection(players, playerStats, lineBreak);
    }

    void RenderInfectedStats(List<InfectedPlayer> infectedPlayers, InfectedStats infectedStats)
    {
        if (!HasInfectedStats(infectedPlayers, infectedStats))
            return;

        var help = InfectedStatsHelp(infectedStats);

        <tr>
            <th>
                @InfectedStatsText(infectedStats):
                @if (help != null)
                {
                    <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@help" aria-label="@L["More information"]"></span>
                }
            </th>
            @foreach (var infectedPlayer in infectedPlayers)
            {
                <td class="slim text-center">
                    @infectedPlayer[infectedStats].ToString("N0")
                </td>
            }
        </tr>
    }

    void RenderInfectedStatsCollection(List<InfectedPlayer> infectedPlayers, IEnumerable<InfectedStats> infectedStats, bool lineBreak = true)
    {
        var any = false;

        @foreach (var ps in infectedStats.Where(ps => HasInfectedStats(infectedPlayers, ps)))
        {
            RenderInfectedStats(infectedPlayers, ps);
            any = true;
        }

        @if (lineBreak && any)
        {
            <tr>
                <td colspan="@(infectedPlayers.Count + 1)"></td>
            </tr>
        }
    }

    void RenderInfectedStatsBetween(List<InfectedPlayer> infectedPlayers, InfectedStats start, InfectedStats end, bool lineBreak = true)
    {
        var startValue = (int)start;
        var endValue = (int)end;
        var count = Math.Max(endValue - startValue + 1, 1);
        var infectedStats = Enumerable.Range(startValue, count).Select(v => (InfectedStats)v);

        RenderInfectedStatsCollection(infectedPlayers, infectedStats, lineBreak);
    }
}

@{
    var half = halves[round - 1];
    var roundHalf = half.RoundHalf!;
    var scoring = details.Statistic?.Statistic?.Scoring;
    var survivorWinning = round == 1 ? scoring?.TeamAWon : scoring?.TeamBWon;
    var infectedWinning = round == 1 ? scoring?.TeamBWon : scoring?.TeamAWon;

    var mvpSiDamage = half.Players.Where(p => p.SiDamage > 0).OrderByDescending(p => p.SiDamage).FirstOrDefault();
    var mvpCommon = half.Players.Where(p => p.Common > 0).OrderByDescending(p => p.Common).FirstOrDefault();
    var lvpFfGiven = half.Players.Where(p => p.FfGiven > 0).OrderByDescending(p => p.FfGiven).FirstOrDefault();
    var tankWipe = TankWipes.Player(half);

    var players = half.Players
        .OrderByDescending(p => p == mvpSiDamage)
        .ThenByDescending(p => p == mvpCommon)
        .ThenBy(p => p == lvpFfGiven)
        .ToList();

    var infectedPlayers = half.InfectedPlayers
        .OrderByDescending(p => p.DmgTotal)
        .ToList();
}

<div id="tab-round-half-@round" class="tab-pane fade @(round == 1 ? "in active" : string.Empty) match">
<div class="row">
    <div class="col-md-5">
        <div class="row">
            <div class="col-xs-6" style="padding-right: 3px">
                <div class="panel panel-@(survivorWinning == true ? "success" : "danger")" style="margin-bottom: 0;">
                    <div class="panel-heading bold" style="padding: 3px 15px">
                        @L["Survivors"]
                    </div>
                    <div class="panel-body" style="padding: 0">
                        <table class="table table-striped table-hover table-bordered table-condensed">
                            <tbody>
                            @foreach (var player in players)
                            {
                                <tr class="@(CurrentUser.ItIsMe(player.CommunityId) ? "it-is-me" : string.Empty)">
                                    <td style="padding: 2px" class="slim">
                                        <a href="/player/@player.CommunityId" title="@(DisplayNames.Apply(player.CommunityId, player.PlayerName))">
                                            <img src="/avatar/@player.CommunityId" alt="@(DisplayNames.Apply(player.CommunityId, player.PlayerName))" title="@(DisplayNames.Apply(player.CommunityId, player.PlayerName))" style="width: 32px; border-radius: 5px" onerror="imgOnError(this)"/>
                                        </a>
                                    </td>
                                    <td class="vertical-align-middle">
                                        <a href="/player/@player.CommunityId">@((DisplayNames.Apply(player.CommunityId, player.PlayerName))?.TruncatePlayerName() ?? "-")</a>

                                        @if (player == mvpSiDamage)
                                        {
                                            <img src="~/imgs/icons/star.png" alt="@L["MVP (SI)"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["MVP (SI)"]"/>
                                        }

                                        @if (player == mvpCommon)
                                        {
                                            <img src="~/imgs/icons/star-blue.png" alt="@L["MVP (CI)"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["MVP (CI)"]"/>
                                        }

                                        @if (player == lvpFfGiven)
                                        {
                                            <img src="~/imgs/icons/lvp.png" alt="@L["LVP"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["LVP"]"/>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-xs-6" style="padding-left: 3px">
                <div class="panel panel-@(infectedWinning == true ? "success" : "danger")" style="margin-bottom: 0;">
                    <div class="panel-heading bold" style="padding: 3px 15px">
                        @L["Infecteds"]
                    </div>
                    <div class="panel-body" style="padding: 0">
                        <table class="table table-striped table-hover table-bordered table-condensed">
                            <tbody>
                            @foreach (var infectedPlayer in infectedPlayers)
                            {
                                <tr class="@(CurrentUser.ItIsMe(infectedPlayer.CommunityId) ? "it-is-me" : string.Empty)">
                                    <td style="padding: 2px" class="slim">
                                        <a href="/player/@infectedPlayer.CommunityId" title="@(DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))">
                                            <img src="/avatar/@infectedPlayer.CommunityId" alt="@(DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))" title="@(DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))" style="width: 32px; border-radius: 5px" onerror="imgOnError(this)"/>
                                        </a>
                                    </td>
                                    <td class="vertical-align-middle">
                                        <a href="/player/@infectedPlayer.CommunityId">@((DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))?.TruncatePlayerName() ?? "-")</a>

                                        @if (tankWipe != null && infectedPlayer.CommunityId == tankWipe)
                                        {
                                            <img src="~/imgs/infected-type/tank.jpg" alt="@L["Tank wipe"]" class="icon tank-wipe" data-toggle="tooltip" data-placement="top" title="@L["Tank wipe"]"/>
                                        }
                                    </td>
                                    <td class="slim text-center">
                                        <span data-toggle="tooltip" data-placement="top" title="@L["SI damage (excl. Tank)"]">
                                            @infectedPlayer.DmgTotal.ToString("N0")
                                        </span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="panel panel-default" style="margin-bottom: 0;">
            <div class="panel-heading bold" style="padding: 3px 15px">
                @L["Details"]
            </div>
            <div class="panel-body" style="padding: 0">
                <div class="row round-details">
                    <div class="col-md-6 left-side">
                        <table class="table table-striped table-hover table-bordered table-condensed">
                            <tbody>
                            @foreach (var roundStats in Enum
                                          .GetValues<RoundStats>()
                                          .Where(rs => rs.DataType() == DataType.Number && roundHalf[rs] != 0))
                            {
                                <tr>
                                    <th>@RoundStatsText(roundStats):</th>
                                    <td class="slim text-center">@roundHalf[roundStats].ToString("N0")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6 right-side">
                        <table class="table table-striped table-hover table-bordered table-condensed">
                            <tbody>
                            @if (roundHalf.StartTime != null)
                            {
                                <tr>
                                    <th>@L["Round start"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.StartTime, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.EndTime != null)
                            {
                                <tr>
                                    <th>@L["Round end"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.EndTime, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.RoundElapsed != null)
                            {
                                <tr>
                                    <th>@L["Round duration"]:</th>
                                    <td class="slim text-center">@MatchDisplay.Elapsed(roundHalf.RoundElapsed)</td>
                                </tr>
                            }
                            @if (roundHalf.StartTimePause != null)
                            {
                                <tr>
                                    <th>@L["Pause start"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.StartTimePause, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.StopTimePause != null)
                            {
                                <tr>
                                    <th>@L["Pause end"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.StopTimePause, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.PauseElapsed != null)
                            {
                                <tr>
                                    <th>@L["Pause duration"]:</th>
                                    <td class="slim text-center">@MatchDisplay.Elapsed(roundHalf.PauseElapsed)</td>
                                </tr>
                            }
                            @if (roundHalf.StartTimeTank != null)
                            {
                                <tr>
                                    <th>@L["Tank start"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.StartTimeTank, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.StopTimeTank != null)
                            {
                                <tr>
                                    <th>@L["Tank end"]:</th>
                                    <td class="slim text-center">@MatchDisplay.DateAndTime(roundHalf.StopTimeTank, details.TimeZone)</td>
                                </tr>
                            }
                            @if (roundHalf.TankElapsed != null)
                            {
                                <tr>
                                    <th>@L["Tank duration"]:</th>
                                    <td class="slim text-center">@MatchDisplay.Elapsed(roundHalf.TankElapsed)</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<br/>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default" style="margin-bottom: 0;">
            <div class="panel-heading bold" style="padding: 3px 15px">
                @L["Survivors"]
            </div>
            <div class="panel-body" style="padding: 0">
                <table class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                    <tr>
                        <th></th>
                        @foreach (var player in players)
                        {
                            <th class="text-center player-name">
                                <a href="/player/@player.CommunityId" title="@(DisplayNames.Apply(player.CommunityId, player.PlayerName))">
                                    @((DisplayNames.Apply(player.CommunityId, player.PlayerName))?.TruncatePlayerName())
                                </a>
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>

                    @{
                        RenderPlayerStatsCollection(players, [
                            PlayerStats.Died,
                            PlayerStats.Incaps,
                            PlayerStats.DmgTaken,
                            PlayerStats.FallDamage
                        ]);
                    }

                    @{
                        var weapons = Enum
                            .GetValues<PlayerStats>()
                            .Where(ps => ps.ToString().StartsWith(AppConsts.WeaponShotsPrefix))
                            .Select(ps => ps.ToString()[AppConsts.WeaponShotsPrefix.Length..]);
                    }

                    @foreach (var weapon in weapons)
                    {
                        if (!Enum.TryParse($"Shots{weapon}", out PlayerStats shots)
                            || !Enum.TryParse($"Hits{weapon}", out PlayerStats hits)
                            || !Enum.TryParse($"HitsSi{weapon}", out PlayerStats hitsSi)
                            || !Enum.TryParse($"HitsTank{weapon}", out PlayerStats hitsTank))
                            continue;

                        var supportsHeadshots = Enum.TryParse($"Headshots{weapon}", out PlayerStats headshots)
                                                & Enum.TryParse($"HeadshotsSi{weapon}", out PlayerStats headshotsSi);
                        var hasShots = HasPlayerStats(players, shots);
                        var hasHits = HasPlayerStats(players, hits);
                        var hasHitsSi = HasPlayerStats(players, hitsSi);
                        var hasHitsTank = HasPlayerStats(players, hitsTank);
                        var hasHeadshots = supportsHeadshots && HasPlayerStats(players, headshots);
                        var hasHeadshotsSi = supportsHeadshots && HasPlayerStats(players, headshotsSi);

                        if (!hasShots && !hasHits && !hasHitsSi && !hasHitsTank && !hasHeadshots && !hasHeadshotsSi)
                            continue;

                        RenderPlayerStats(players, shots);
                        RenderPlayerStats(players, hits);

                        @if (hasHits)
                        {
                            <tr>
                                <th>@TextHitsPercent(weapon):</th>
                                @foreach (var player in players)
                                {
                                    var percent = player[shots] != 0 ? player[hits] / (decimal)player[shots] : 0;
                                    <td class="slim text-center">
                                        @percent.ToString("P0")
                                    </td>
                                }
                            </tr>
                        }

                        RenderPlayerStats(players, hitsSi);

                        @if (hasHitsSi)
                        {
                            <tr>
                                <th>@TextHitsSiPercent(weapon):</th>
                                @foreach (var player in players)
                                {
                                    var percent = player[hits] != 0 ? player[hitsSi] / (decimal)player[hits] : 0;
                                    <td class="slim text-center">
                                        @percent.ToString("P0")
                                    </td>
                                }
                            </tr>
                        }

                        RenderPlayerStats(players, hitsTank);

                        @if (hasHitsTank)
                        {
                            <tr>
                                <th>@TextHitsTankPercent(weapon):</th>
                                @foreach (var player in players)
                                {
                                    var percent = player[hits] != 0 ? player[hitsTank] / (decimal)player[hits] : 0;
                                    <td class="slim text-center">
                                        @percent.ToString("P0")
                                    </td>
                                }
                            </tr>
                        }

                        @if (supportsHeadshots)
                        {
                            RenderPlayerStats(players, headshots);

                            @if (hasHeadshots)
                            {
                                <tr>
                                    <th>@TextHeadshotsPercent(weapon):</th>
                                    @foreach (var player in players)
                                    {
                                        var eligibleHits = player[hits] - player[hitsTank];
                                        var percent = eligibleHits > 0 ? player[headshots] / (decimal)eligibleHits : 0;
                                        <td class="slim text-center">
                                            @percent.ToString("P0")
                                        </td>
                                    }
                                </tr>
                            }

                            RenderPlayerStats(players, headshotsSi);

                            @if (hasHeadshotsSi)
                            {
                                <tr>
                                    <th>@TextHeadshotsSiPercent(weapon):</th>
                                    @foreach (var player in players)
                                    {
                                        var percent = player[hitsSi] > 0 ? player[headshotsSi] / (decimal)player[hitsSi] : 0;
                                        <td class="slim text-center">
                                            @percent.ToString("P0")
                                        </td>
                                    }
                                </tr>
                            }
                        }

                        <tr>
                            <td colspan="@(players.Count + 1)"></td>
                        </tr>
                    }

                    @{
                        RenderPlayerStatsBetween(players, PlayerStats.Common, PlayerStats.SiDamageTankUp);
                        RenderPlayerStatsBetween(players, PlayerStats.TankDamage, PlayerStats.RockEats);
                        RenderPlayerStatsBetween(players, PlayerStats.Skeets, PlayerStats.SelfClears, false);
                        RenderPlayerStatsBetween(players, PlayerStats.Clears, PlayerStats.AvgClearTime);
                    }

                    @{
                        var ffGivenStats = new[]
                        {
                            PlayerStats.FfGiven,
                            PlayerStats.FfGivenPellet,
                            PlayerStats.FfGivenBullet,
                            PlayerStats.FfGivenMelee,
                            PlayerStats.FfGivenFire,
                            PlayerStats.FfGivenIncap,
                            PlayerStats.FfGivenOther,
                            PlayerStats.FfGivenSelf,
                            PlayerStats.FfGivenTotal
                        };
                        var ffTakenStats = new[]
                        {
                            PlayerStats.FfTaken,
                            PlayerStats.FfTakenPellet,
                            PlayerStats.FfTakenBullet,
                            PlayerStats.FfTakenMelee,
                            PlayerStats.FfTakenFire,
                            PlayerStats.FfTakenIncap,
                            PlayerStats.FfTakenOther,
                            PlayerStats.FfTakenTotal
                        };
                        var hasFfTaken = ffTakenStats.Any(ps => HasPlayerStats(players, ps));

                        RenderPlayerStatsCollection(players, ffGivenStats, hasFfTaken);
                        RenderPlayerStatsCollection(players, ffTakenStats, false);
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default" style="margin-bottom: 0;">
            <div class="panel-heading bold" style="padding: 3px 15px">
                @L["Infecteds"]
            </div>
            <div class="panel-body" style="padding: 0">
                <table class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                    <tr>
                        <th></th>
                        @foreach (var infectedPlayer in infectedPlayers)
                        {
                            <th class="text-center player-name">
                                <a href="/player/@infectedPlayer.CommunityId" title="@(DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))">
                                    @((DisplayNames.Apply(infectedPlayer.CommunityId, infectedPlayer.PlayerName))?.TruncatePlayerName())
                                </a>
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        RenderInfectedStatsBetween(infectedPlayers, InfectedStats.DmgTotal, InfectedStats.DmgUpright);

                        RenderInfectedStatsCollection(infectedPlayers, [
                            InfectedStats.DmgTank,
                            InfectedStats.DmgTankIncap,
                            InfectedStats.TankPasses
                        ]);

                        RenderInfectedStatsCollection(infectedPlayers, [
                            InfectedStats.DmgScratch,
                            InfectedStats.DmgTankUp,
                            InfectedStats.DmgSpit,
                            InfectedStats.DmgBoom
                        ]);

                        RenderInfectedStatsBetween(infectedPlayers, InfectedStats.HunterDPs, InfectedStats.Ledged, false);

                        RenderInfectedStats(infectedPlayers, InfectedStats.Common);
                    }

                    <tr>
                        <td colspan="@(infectedPlayers.Count + 1)"></td>
                    </tr>

                    @{
                        RenderInfectedStatsBetween(infectedPlayers, InfectedStats.Spawns, InfectedStats.SpawnJockey, false);
                    }
                    </tbody>
                </table>

            </div>
        </div>

        <br/>

        <div class="panel panel-default" style="margin-bottom: 0;">
            <div class="panel-heading bold" style="padding: 3px 15px">
                @L["Connected Players"]
            </div>
            <div class="panel-body" style="padding: 0">
                <table class="table table-striped table-hover table-bordered table-condensed">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Steam ID</th>
                        <th>Community ID</th>
                        <th>@L["Name"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < allPlayers.Count; i++)
                    {
                        var playerName = allPlayers[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="line-break-anywhere">
                                @playerName.SteamId
                                @if (!string.IsNullOrWhiteSpace(playerName.SteamId))
                                {
                                    @await Html.PartialAsync("_CopyButton", playerName.SteamId)
                                }
                            </td>
                            <td class="line-break-anywhere">
                                @playerName.CommunityId
                                @if (!string.IsNullOrWhiteSpace(playerName.CommunityId))
                                {
                                    @await Html.PartialAsync("_CopyButton", playerName.CommunityId)
                                }
                            </td>
                            <td>
                                <a href="/player/@playerName.CommunityId" title="@(DisplayNames.Apply(playerName.CommunityId, playerName.Name))">
                                    @((DisplayNames.Apply(playerName.CommunityId, playerName.Name))?.TruncatePlayerName())
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>
</div>

@functions {

    private LocalizedString PlayerStatsText(PlayerStats key)
    {
        return key switch
        {
            PlayerStats.ShotsShotgun => L["Shotgun - Shots (Pellets)"],
            PlayerStats.ShotsSmg => L["SMG / Rifle - Shots"],
            PlayerStats.ShotsSniper => L["Sniper - Shots"],
            PlayerStats.ShotsPistol => L["Pistol - Shots"],
            PlayerStats.HitsShotgun => L["Shotgun - Hits"],
            PlayerStats.HitsSmg => L["SMG / Rifle - Hits"],
            PlayerStats.HitsSniper => L["Sniper - Hits"],
            PlayerStats.HitsPistol => L["Pistol - Hits"],
            PlayerStats.HeadshotsSmg => L["SMG / Rifle - Headshots"],
            PlayerStats.HeadshotsSniper => L["Sniper - Headshots"],
            PlayerStats.HeadshotsPistol => L["Pistol - Headshots"],
            PlayerStats.HeadshotsSiSmg => L["SMG / Rifle - Headshots on SI"],
            PlayerStats.HeadshotsSiSniper => L["Sniper - SI headshots"],
            PlayerStats.HeadshotsSiPistol => L["Pistol - SI headshots"],
            PlayerStats.HitsSiShotgun => L["Shotgun - SI hits"],
            PlayerStats.HitsSiSmg => L["SMG / Rifle - Hits on SI"],
            PlayerStats.HitsSiSniper => L["Sniper - SI hits"],
            PlayerStats.HitsSiPistol => L["Pistol - SI hits"],
            PlayerStats.HitsTankShotgun => L["Shotgun - Hits on Tank"],
