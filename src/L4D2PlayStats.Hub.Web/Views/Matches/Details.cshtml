@model MatchDetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    var match = Model.Match;
    var campaign = match.Campaign ?? L["Campaign"].Value;
    var campaignName = match.Campaign ?? L["Custom campaign"].Value;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = $"{L["Match details"].Value} - {campaign}",
        Description = L["See details of the match on {0}, played on {1}, with a {2}–{3} score.", campaign, Model.Card.MatchStart.ToString("d"), match.ScoreA, match.ScoreB],
        Image = Model.Card.CampaignImage,
        ImageAlt = campaign
    };
}

@section Styles {
    <style>
        .maps .label {
            margin: 0 3px;
        }
    </style>
}

@section Scripts {
    @if (Model.Administrator)
    {
        <script>
            function showMatch(result) {
                if (result && result.matchId)
                    location.href = "@AppConsts.MatchesUrl/" + result.matchId;
                else
                    location.href = "@AppConsts.MatchesUrl";
            }

            function editScore(statisticId, team, score, message) {
                var output = prompt(message, score);

                if (!output)
                    return;

                var score = +output;

                if (isNaN(score))
                    return;

                if (score < 0 || score > 10000) {
                    alert("@L["Invalid score range"]");
                    return;
                }

                var command = {
                    team: team,
                    score: score
                };

                $.ajax({
                    url: "/api/statistics/" + statisticId + "/update-score",
                    type: "PUT",
                    contentType: "application/json",
                    headers: { "@AppConsts.AntiforgeryHeader": "@Antiforgery.GetAndStoreTokens(Context).RequestToken" },
                    data: JSON.stringify(command)
                }).done(showMatch);
            }
        </script>
    }
}

@if (Model.Statistics.Count == 0)
{
    <div class="row">
        <div class="col-xs-12">
            <h4 class="text-center">
                @L["No match found"]
            </h4>
        </div>
    </div>
    return;
}

<h4 class="text-center">@L["Match details"]</h4>

<ol class="breadcrumb">
    <li>
        <a href="@AppConsts.MatchesUrl">@L["Last matches"]</a>
    </li>
    <li class="active">
        @campaignName
    </li>
</ol>

<div class="match">
    @await Html.PartialAsync("_Match", Model.Card)
</div>

<div class="maps">
    <div class="panel panel-default">
        <div class="panel-heading">
            @L["Maps"]
        </div>
        <div class="panel-body">
            @L["Map results"]
        </div>
        <table class="table table-striped table-hover table-condensed table-responsive">
            <thead>
            <th class="text-center">#</th>
            <th class="text-center">@L["Map"]</th>
            <th class="text-center">@L["Start"]</th>
            <th class="text-center">@L["End"]</th>
            <th class="text-center">@L["Elapsed"]</th>
            <th class="text-center slim" colspan="3">@L["Scoreboard"]</th>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Statistics.Count; i++)
            {
                var result = Model.Statistics[i];
                var statistic = result.Statistic;
                var gameRound = statistic?.GameRound;
                var scoring = statistic?.Scoring;
                var labelTeamA = scoring?.Draw == true ? "default" : scoring?.TeamAWon == true ? "success" : "danger";
                var labelTeamB = scoring?.Draw == true ? "default" : scoring?.TeamBWon == true ? "success" : "danger";

                <tr>
                    <td class="text-center" data-label="#">
                        <a href="@Model.StatisticsUrl(result)">
                            #@(i + 1)
                        </a>
                    </td>
                    <td class="text-center" data-label="@L["Map"]">
                        <a href="@Model.StatisticsUrl(result)">
                            @gameRound?.MapName
                        </a>
                    </td>
                    <td class="text-center" data-label="@L["Start"]">@MatchDisplay.DateAndTime(statistic?.MapStart, Model.TimeZone)</td>
                    <td class="text-center" data-label="@L["End"]">@MatchDisplay.DateAndTime(statistic?.MapEnd, Model.TimeZone)</td>
                    <td class="text-center" data-label="@L["Elapsed"]">@MatchDisplay.Elapsed(statistic?.MapElapsed)</td>
                    <td class="text-center slim" data-label="@L["Team A score"]">
                        <span class="label label-@labelTeamA" data-toggle="tooltip" data-placement="top" title="@L["Team A score"]">
                            @scoring?.TeamA?.Score.ToString("N0")
                        </span>
                        @if (Model.Administrator)
                        {
                            var team = scoring?.TeamA;

                            <button type="button" class="btn btn-link btn-xs" onclick="editScore('@result.FileId', '@team?.Letter', @team?.Score, '@string.Format(L["Team {0} score"].Value, team?.Letter)')" title="@L["Edit"]" data-toggle="tooltip" data-placement="bottom">
                                @L["Edit"]
                            </button>
                        }
                    </td>
                    <td class="text-center slim" data-label="@L["Score difference"]">
                        <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Score difference"]">
                            @scoring?.ScoreDiff?.ToString("N0")
                        </span>
                    </td>
                    <td class="text-center slim" data-label="@L["Team B score"]">
                        <span class="label label-@labelTeamB" data-toggle="tooltip" data-placement="top" title="@L["Team B score"]">
                            @scoring?.TeamB?.Score.ToString("N0")
                        </span>
                        @if (Model.Administrator)
                        {
                            var team = scoring?.TeamB;

                            <button type="button" class="btn btn-link btn-xs" onclick="editScore('@result.FileId', '@team?.Letter', @team?.Score, '@string.Format(L["Team {0} score"].Value, team?.Letter)')" title="@L["Edit"]" data-toggle="tooltip" data-placement="bottom">
                                @L["Edit"]
                            </button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

