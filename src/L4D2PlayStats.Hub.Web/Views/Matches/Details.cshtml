@foreach (var team in match.Teams)
{
    <div class="panel panel-default">
        <div class="panel-heading">@L["Team"] @team.Code - @L["Infected"]</div>
        <div class="panel-body">
            @string.Format(L["Statistics of team {0} playing as infected"].Value, team.Code)
        </div>
        <table class="table table-striped table-hover table-condensed table-responsive">
            <thead>
            <tr>
                <th class="text-center"></th>
                @foreach (var player in team.Players)
                {
                    <th class="text-center" colspan="2">
                        <a href="/player/@player.CommunityId" title="@player.Name?.TruncatePlayerName()">
                            @player.Name?.TruncatePlayerName()
                        </a>
                    </th>
                }
                <th class="text-center">@L["Total"]</th>
            </tr>
            <tr>
                <th></th>
                @for (var i = 0; i < team.Players.Count; i++)
                {
                    <th class="text-right">
                        <small>@L["Value"]</small>
                    </th>
                    <th class="text-left">
                        <small>@L["Team %"]</small>
                    </th>
                }
                <th></th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>
                    @L["Tank wipes"]
                    <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@L["Round halves in which the player, as Tank, wiped the survivors and was still alive when the round ended."]" aria-label="@L["More information"]"></span>
                </td>
                @foreach (var player in team.Players)
                {
                    <td class="text-right" data-label="@player.Name?.TruncatePlayerName()">
                        @player.TankWipes.ToString("N0")
                    </td>
                    <td class="text-left hide-mobile">
                        @player.TankWipesPercentage.ToString("P0")
                    </td>
                }
                <td class="text-center" data-label="@L["Total"]">@team.TankWipes.ToString("N0")</td>
            </tr>

            <tr>
                <td>
                    @L["SI damage (excl. Tank)"]
                    <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@L["SI damage, including incapacitated and post-boom damage; Tank damage is excluded."]" aria-label="@L["More information"]"></span>
                </td>
                @foreach (var player in team.Players)
                {
                    <td class="text-right" data-label="@player.Name?.TruncatePlayerName()">
                        @player.DmgTotal.ToString("N0")
                    </td>
                    <td class="text-left hide-mobile">
                        @player.DmgTotalPercentage.ToString("P0")
                    </td>
                }
                <td class="text-center" data-label="@L["Total"]">@team.DmgTotal.ToString("N0")</td>
            </tr>

            <tr>
                <td>@L["Damage as Tank (upright)"]</td>
                @foreach (var player in team.Players)
                {
                    <td class="text-right" data-label="@player.Name?.TruncatePlayerName()">
                        @player.DmgTank.ToString("N0")
                    </td>
                    <td class="text-left hide-mobile">
                        @player.DmgTankPercentage.ToString("P0")
                    </td>
                }
                <td class="text-center" data-label="@L["Total"]">@team.DmgTank.ToString("N0")</td>
            </tr>

            <tr>
                <td>@L["Spit damage (upright)"]</td>
                @foreach (var player in team.Players)
                {
                    <td class="text-right" data-label="@player.Name?.TruncatePlayerName()">
                        @player.DmgSpit.ToString("N0")
                    </td>
                    <td class="text-left hide-mobile">
                        @player.DmgSpitPercentage.ToString("P0")
                    </td>
                }
                <td class="text-center" data-label="@L["Total"]">@team.DmgSpit.ToString("N0")</td>
            </tr>

            <tr>
                <td>
                    @L["Total pounce damage"]
                    <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@L["Sum of damage from all recorded high pounces."]" aria-label="@L["More information"]"></span>
                </td>
                @foreach (var player in team.Players)
                {
                    <td class="text-right" data-label="@player.Name?.TruncatePlayerName()">
                        @player.HunterDpDmg.ToString("N0")
                    </td>
                    <td class="text-left hide-mobile">
                        @player.HunterDpDmgPercentage.ToString("P0")
                    </td>
                }
                <td class="text-center" data-label="@L["Total"]">@team.HunterDpDmg.ToString("N0")</td>
            </tr>
            </tbody>
        </table>
    </div>
