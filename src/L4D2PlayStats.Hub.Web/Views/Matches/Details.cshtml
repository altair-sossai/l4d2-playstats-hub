@if (Model.Administrator)
{
    <div id="mrp-modal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">@L["Replace a player"]</h4>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@L["For a substitute who came in for a player. In the checked maps, the player who came in takes the place and the numbers of the player who left, and the match and the ranking are recalculated. The statistics files of those maps are changed; to undo it, replace the players back."]</p>
                    <div class="form-group">
                        <label for="mrp-replaced">@L["Player who left"] @FieldHelp.Tip(L["Everyone who played at least one map of this match, as survivor or infected, including who left before the last map."])</label>
                        <select id="mrp-replaced" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label for="mrp-replacement">@L["Player who came in"] @FieldHelp.Tip(L["A SteamID64, a Steam ID such as STEAM_1:0:123 or [U:1:123], or a profile link such as https://steamcommunity.com/profiles/76561198000000000."])</label>
                        <input type="hidden" id="mrp-replacement-name"/>
                        <div class="input-group">
                            <input type="text" id="mrp-replacement" class="form-control" placeholder="76561198000000000"/>
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default mrp-pick-player">
                                    <span class="glyphicon glyphicon-user"></span> @L["Choose from the list"]
                                </button>
                            </span>
                        </div>
                        <div class="mrp-picked text-muted" style="margin-top: 6px"></div>
                    </div>
                    <div class="form-group">
                        <label>@L["Maps"] @FieldHelp.Tip(L["Only the maps the player who left played can be checked. A map the player who came in already played cannot be changed, since both would be in it."])</label>
                        <div class="mrp-maps"></div>
                    </div>
                    <div class="mrp-message"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="btn btn-primary mrp-save">
                        <span class="glyphicon glyphicon-transfer"></span> @L["Replace"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_PlayerPickerModal")
}
