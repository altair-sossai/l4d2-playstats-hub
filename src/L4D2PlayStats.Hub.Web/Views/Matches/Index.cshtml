@model LastMatchesModel
@inject ISettingsService Settings

@{
    var site = await Settings.GetAsync<SiteSettings>();
    var latestMatch = Model.Matches.FirstOrDefault();

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Last matches"],
        Description = L["See the latest {0} matches, including scores, campaigns, and players.", site.Name],
        Image = latestMatch?.CampaignImage,
        ImageAlt = latestMatch?.Match.Campaign
    };
}

@section Styles {
    <style>
        .match-filter {
            margin-bottom: 10px;
        }

        .match-filter .form-control {
            display: inline-block;
            width: auto;
        }

        .admin-pagination {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            margin: 12px 0;
        }

        .admin-pagination .pagination {
            margin: 0;
        }
    </style>
}

<h4 class="text-center">@L["Last matches"]</h4>

@if (Model.Seasons.Count > 1 || Model.Servers.Count > 1)
{
<form class="match-filter text-right" method="get" action="@AppConsts.MatchesUrl">
    <select class="form-control input-sm" name="season" aria-label="@L["Season"]" title="@L["Season"]" onchange="this.form.submit()">
        <option value="">@L["All seasons"]</option>
        @foreach (var season in Model.Seasons)
        {
            <option value="@season.Id" selected="@(season.Id == Model.SeasonId)">@Display.SeasonName(season)</option>
        }
    </select>
    @if (Model.Servers.Count > 1)
    {
        <select class="form-control input-sm" name="server" aria-label="@L["Server"]" title="@L["Server"]" onchange="this.form.submit()">
            <option value="">@L["All servers"]</option>
            @foreach (var server in Model.Servers)
            {
                <option value="@server.Id" selected="@(server.Id == Model.ServerId)">@server.Name</option>
            }
        </select>
    }
</form>
}

@if (Model.Matches.Count == 0)
{
    <div class="row">
        <div class="col-xs-12">
            <h4 class="text-center">
                @L["No match found"]
            </h4>
        </div>
    </div>
}

<div class="match">
    @foreach (var match in Model.Matches)
    {
        @await Html.PartialAsync("_Match", match)
    }
</div>

@if (Model.Pagination.TotalPages > 1)
{
    @await Html.PartialAsync("_Pagination", Model.Pagination)
}
