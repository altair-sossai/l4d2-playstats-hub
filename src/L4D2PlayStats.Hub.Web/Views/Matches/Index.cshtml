@model LastMatchesModel
@inject ISettingsService Settings

@{
    var site = await Settings.GetAsync<SiteSettings>();
    var latestMatch = Model.Matches.FirstOrDefault();

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Last matches"],
        Description = L["See the latest {0} matches, including scores, campaigns, and players.", site.Name],
        Image = latestMatch?.CampaignImage,
        ImageAlt = latestMatch?.Match.Campaign
    };
}

@section Styles {
    <style>
        .match-filter {
            margin-bottom: 10px;
        }

        .match-filter .form-control {
            display: inline-block;
            width: auto;
        }
    </style>
    @await Html.PartialAsync("_PaginationStyles")
}

<h4 class="text-center">@L["Last matches"]</h4>

@if (Model.HasPeriodChoices || Model.Servers.Count > 1)
{
    <div class="match-filter text-right">
        @if (Model.HasPeriodChoices)
        {
            <select class="form-control input-sm" aria-label="@L["Season"]" title="@L["Season"]" onchange="location.href = this.value">
                <option value="@Model.Url(null, null, Model.ServerId)">@L["All seasons"]</option>
                @foreach (var season in Model.Seasons)
                {
                    <option value="@Model.Url(season.Id, null, Model.ServerId)" selected="@(season.Id == Model.SeasonId)">@RankingPeriod.ForSeason(season).Label(L)</option>
                }
                @foreach (var year in Model.Years)
                {
                    <option value="@Model.Url(null, year, Model.ServerId)" selected="@(year == Model.Year)">@L["Year of {0}", year]</option>
                }
            </select>
        }
        @if (Model.Servers.Count > 1)
        {
            <select class="form-control input-sm" aria-label="@L["Server"]" title="@L["Server"]" onchange="location.href = this.value">
                <option value="@Model.Url(Model.SeasonId, Model.Year, null)">@L["All servers"]</option>
                @foreach (var server in Model.Servers)
                {
                    <option value="@Model.Url(Model.SeasonId, Model.Year, server.Id)" selected="@(server.Id == Model.ServerId)">@server.Name</option>
                }
            </select>
        }
    </div>
}

@if (Model.Matches.Count == 0)
{
    <div class="row">
        <div class="col-xs-12">
            <h4 class="text-center">
                @L["No match found"]
            </h4>
        </div>
    </div>
}

<div class="match">
    @foreach (var match in Model.Matches)
    {
        @await Html.PartialAsync("_Match", match)
    }
</div>

@await Html.PartialAsync("_Pagination", Model.Pagination)
