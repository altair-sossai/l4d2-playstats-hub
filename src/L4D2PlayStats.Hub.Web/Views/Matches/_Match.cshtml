@model MatchCardModel
@inject ICurrentUser CurrentUser

@{
    var match = Model.Match;
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var campaign = match.Campaign ?? L["Custom campaign"].Value;

    var fontColor = light ? AppConsts.MatchChartLightFontColor : AppConsts.MatchChartDarkFontColor;

    var scoreboardChart = new
    {
        type = "line",
        data = new
        {
            labels = match.Maps.Select(m => m.MapName.Truncate(AppConsts.MatchChartMapNameLength)),
            datasets = match.Teams.Select(team => new
            {
                label = $"{L["Team"].Value} {team.Code}",
                data = match.Maps.Select(m => team.Code == 'A' ? m.TeamAScore : m.TeamBScore),
                borderColor = team.Code == match.Winner?.Code ? AppConsts.MatchChartSuccessColor : AppConsts.MatchChartDangerColor,
                backgroundColor = AppConsts.MatchChartTransparentColor,
                lineTension = 0
            })
        },
        options = new
        {
            title = new
            {
                display = true,
                text = L["Scoreboard"].Value,
                fontColor
            },
            legend = new
            {
                display = true,
                position = "bottom",
                labels = new { fontColor }
            },
            responsive = true,
            maintainAspectRatio = false,
            scales = new
            {
                xAxes = new object[]
                {
                    new
                    {
                        ticks = new { fontColor }
                    }
                },
                yAxes = new object[]
                {
                    new
                    {
                        ticks = new
                        {
                            fontColor,
                            beginAtZero = true
                        }
                    }
                }
            }
        }
    };

    var pointsEarnedOnMapChart = new
    {
        type = "bar",
        data = new
        {
            labels = match.Maps.Select(m => m.MapName.Truncate(AppConsts.MatchChartMapNameLength)),
            datasets = new List<object>()
        },
        options = new
        {
            title = new
            {
                display = true,
                text = L["Points earned per map"].Value,
                fontColor
            },
            tankWipe = new
            {
                image = Url.Content("~/imgs/infected-type/tank.jpg"),
                label = L["Tank wipe"].Value
            },
            legend = new
            {
                display = true,
                position = "bottom",
                labels = new { fontColor }
            },
            responsive = true,
            maintainAspectRatio = false,
            scales = new
            {
                xAxes = new object[]
                {
                    new
                    {
                        ticks = new { fontColor }
                    }
                },
                yAxes = new object[]
                {
                    new
                    {
                        ticks = new
                        {
                            fontColor,
                            beginAtZero = true
                        }
                    }
                }
            }
        }
    };

    var teamA = match.Maps
        .Select(m => m.TeamAScore)
        .ToArray();

    var teamB = match.Maps
        .Select(m => m.TeamBScore)
        .ToArray();

    for (var i = teamA.Length - 1; i > 0; i--)
        teamA[i] -= teamA[i - 1];

    for (var i = teamB.Length - 1; i > 0; i--)
        teamB[i] -= teamB[i - 1];

    foreach (var team in match.Teams)
    {
        var color = team.Code == match.Winner?.Code ? AppConsts.MatchChartSuccessColor : AppConsts.MatchChartDangerColor;

        pointsEarnedOnMapChart.data.datasets.Add(new
        {
            label = $"{L["Team"].Value} {team.Code}",
            data = team.Code == 'A' ? teamA : teamB,
            borderColor = color,
            backgroundColor = color,
            tankWipes = match.Maps.Select(map => map.TankWipeBy(team.Code) is { } wiper ? match.PlayerNames.GetValueOrDefault(wiper) ?? L["Unknown player"].Value : null)
        });
    }
}

<div class="panel panel-primary">
    <div class="panel-heading" style="padding: 6px 10px;">
        <div class="row">
            <div class="col-xs-8">
                <h4 style="display: inline; font-weight: bold">
                    @campaign
                </h4>
                <small style="font-style: italic"> - @match.ConfigurationName</small>
                @if (Model.ShowServer && !string.IsNullOrEmpty(match.GameServerName))
                {
                    <small style="font-style: italic"> - @match.GameServerName</small>
                }
                @if (match.Competitive)
                {
                    <span class="label label-success" style="margin-left: 5px;">@L["Competitive"]</span>
                }
                else
                {
                    <span class="label label-default" style="margin-left: 5px;">@L["Casual"]</span>
                }
                <p>
                    @string.Format(L["Team {0} won by {1:N0} points"].Value, match.Winner?.Code, match.Diff)
                </p>
            </div>
            <div class="col-xs-4 text-right">
                <p data-toggle="tooltip" data-placement="top" title="@L["Date and time when the game occurred"]">
                    <img src="~/imgs/icons/calendar.png" alt="@L["Calendar"]" class="icon"/>
                    @{
                        if (Model.MatchStart.Date == Model.Today)
                        {
                            @string.Format(L["Today at {0:t}"].Value, Model.MatchStart)
                        }
                        else if (Model.MatchStart.Date == Model.Today.AddDays(-1))
                        {
                            @string.Format(L["Yesterday at {0:t}"].Value, Model.MatchStart)
                        }
                        else
                        {
                            @string.Format(L["{0:d} at {0:t}"].Value, Model.MatchStart)
                        }
                    }
                </p>

                @if (match.MatchElapsed.HasValue)
                {
                    <p data-toggle="tooltip" data-placement="top" title="@L["Duration of the game in hours"]">
                        <img src="~/imgs/icons/clock.png" alt="@L["Clock"]" class="icon"/>
                        @MatchDisplay.Elapsed(match.MatchElapsed)
                    </p>
                }
            </div>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-xs-2 left-side text-center">
                <img src="@Model.CampaignImage" alt="@campaign" title="@campaign" class="img-responsive img-thumbnail img-campaign" data-lity/>
                @if (Model.ShowDetailsButton)
                {
                    <a href="@Model.DetailsUrl" class="btn btn-danger btn-xs btn-block" style="margin-top: 10px;">
                        @L["Details"]
                    </a>
                }
            </div>
            <div class="col-xs-10 right-side">
                <div class="row teams">
                    @foreach (var team in match.Teams)
                    {
                        <div class="col-xs-6">
                            <div class="panel panel-@(team.Code == match.Winner?.Code ? "success" : "danger")" style="margin-bottom: 0;">
                                <div class="panel-heading bold" style="padding: 3px 15px">
                                    <div class="row">
                                        <div class="col-xs-6">
                                            @L["Team"] @team.Code
                                        </div>
                                        <div class="col-xs-6 text-right">
                                            @team.Score.ToString("N0")
                                        </div>
                                    </div>
                                </div>
                                <div class="panel-body" style="padding: 0">
                                    <table class="table table-striped table-hover table-bordered table-condensed">
                                        <tbody>
                                        @foreach (var player in team.Players
                                                      .OrderByDescending(p => p.TotalMvp)
                                                      .ThenByDescending(p => p.MvpSiDamage)
                                                      .ThenByDescending(p => p.MvpCommon)
                                                      .ThenBy(p => p.LvpFfGiven)
                                                      .ToList())
                                        {
                                            <tr class="@(CurrentUser.ItIsMe(player.CommunityId) ? "it-is-me" : string.Empty)">
                                                <td style="padding: 2px" class="slim">
                                                    <a href="@Model.PlayerUrl(player.CommunityId)" title="@player.Name">
                                                        <img src="/avatar/@player.CommunityId" alt="@player.Name" title="@player.Name" style="width: 32px; border-radius: 5px" onerror="imgOnError(this)"/>
                                                    </a>
                                                </td>
                                                <td class="vertical-align-middle">
                                                    <a href="@Model.PlayerUrl(player.CommunityId)">@(player.Name?.TruncatePlayerName() ?? "-")</a>
                                                    @if (player.MvpSiDamage > 0 || player.MvpCommon > 0 || player.TankWipes > 0)
                                                    {
                                                        <small> | </small>
                                                    }

                                                    @for (var i = 0; i < player.MvpSiDamage; i++)
                                                    {
                                                        <img src="~/imgs/icons/star.png" alt="@L["MVP (SI)"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["MVP (SI)"]"/>
                                                    }

                                                    @for (var i = 0; i < player.MvpCommon; i++)
                                                    {
                                                        <img src="~/imgs/icons/star-blue.png" alt="@L["MVP (CI)"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["MVP (CI)"]"/>
                                                    }

                                                    @for (var i = 0; i < player.TankWipes; i++)
                                                    {
                                                        <img src="~/imgs/infected-type/tank.jpg" alt="@L["Tank wipe"]" class="icon tank-wipe" data-toggle="tooltip" data-placement="top" title="@L["Tank wipe"]"/>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <hr/>

        <div class="row">
            <div class="col-sm-6 col-xs-12" style="padding-right: 0">
                <div style="height: 200px;">
                    @{
                        var canvas = new TagBuilder("canvas");
                        canvas.AddCssClass("app-chart");
                        canvas.Attributes.Add("style", "max-height: 100%;");
                        canvas.Attributes.Add("data-chart", JsonSerializer.Serialize(scoreboardChart));
                    }
                    @canvas
                </div>
            </div>

            <div class="col-sm-6 col-xs-12" style="padding-left: 0">
                <div style="height: 200px;">
                    @{
                        canvas = new TagBuilder("canvas");
                        canvas.AddCssClass("app-chart");
                        canvas.Attributes.Add("style", "max-height: 100%;");
                        canvas.Attributes.Add("data-chart", JsonSerializer.Serialize(pointsEarnedOnMapChart));
                    }
                    @canvas
                </div>
            </div>
        </div>
    </div>
</div>
