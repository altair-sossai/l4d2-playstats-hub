@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts
@model SkinsModel
@inject ICurrentUser CurrentUser
@inject ISettingsService SiteSettingsService
@inject SkinThumbnailStore SkinThumbnails

@{
    var culture = CultureInfo.CurrentUICulture;
    var site = await SiteSettingsService.GetAsync<SiteSettings>();
    var administrator = await CurrentUser.IsAdministratorAsync();
    var highlight = Model.Skins.MaxBy(skin => skin.Price);

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Skins"],
        Description = L["Weapon skins unlocked by patent level on the {0} server, with credits to the Steam Workshop creators.", site.Name],
        Image = highlight == null ? null : SkinThumbnails.Url(Model.Settings.AssetsUrl, highlight.Id),
        ImageAlt = highlight?.Title(culture)
    };

    var wallet = Model.Wallet;
    var season = Model.Season;
    var authors = Model.Authors(culture);
    var loginUrl = $"/login?returnUrl={Uri.EscapeDataString(AppConsts.SkinShopUrl)}";
    var authorContactUrl = L4D2PlayStats.Hub.Core.Infrastructure.Helpers.SafeUrl.IsHttp(Model.Settings.AuthorContactUrl) ? Model.Settings.AuthorContactUrl : null;
    var authorRequestUrl = L4D2PlayStats.Hub.Core.Infrastructure.Helpers.SafeUrl.IsHttp(Model.Settings.AuthorRequestUrl) ? Model.Settings.AuthorRequestUrl : null;
    var authorNotice = authorContactUrl != null || authorRequestUrl != null;

    string WeaponName(string weapon)
    {
        return L[SkinWeapons.Name(weapon)].Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/skins.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="sk-hero">
    <div class="sk-hero-main">
        <span class="sk-kicker">@L["Skin shop"]</span>
        <h1>@L["Skins"]</h1>
        <p class="lead">@L["Trade the stars you earned as MVP for skins for your weapons."]</p>

        @if (season.Refunds)
        {
            <div class="sk-season">
                <span class="glyphicon glyphicon-calendar"></span>
                <span>@Html.Raw(string.Format(L["Season ends on <b>{0}</b> · {1} days left"].Value, season.LastDay.ToString("d", culture), season.DaysLeft.ToString("N0", culture)))</span>
            </div>
        }

        <div class="sk-hero-actions">
            <button type="button" class="btn btn-default btn-sm sk-howto-toggle collapsed" data-toggle="collapse" data-target="#sk-howto" aria-expanded="false" aria-controls="sk-howto">
                <span class="glyphicon glyphicon-info-sign"></span> @L["How it works"] <span class="caret"></span>
            </button>
            <button type="button" class="btn btn-info btn-sm sk-use-open">
                <span class="glyphicon glyphicon-question-sign"></span> @L["How do I use my skins in game?"]
            </button>
        </div>
    </div>

    <div class="sk-hero-side">
        @if (!Model.LoggedIn)
        {
            <div class="sk-wallet">
                <div class="sk-wallet-top">
                    <span class="sk-wallet-star">★</span>
                    <div class="sk-wallet-text">@L["Sign in with Steam to see how many stars you have and buy skins."]</div>
                </div>
                <a class="btn btn-warning btn-block" href="@loginUrl">@L["Sign in with Steam"]</a>
            </div>
        }
        else if (wallet == null)
        {
            <div class="sk-wallet sk-wallet-warning">
                <div class="sk-wallet-top">
                    <span class="sk-wallet-star">★</span>
                    <div class="sk-wallet-text">@L["We could not load your stars right now. Reload the page in a moment."]</div>
                </div>
            </div>
        }
        else
        {
            <div class="sk-wallet">
                <div class="sk-wallet-top">
                    <span class="sk-wallet-star">★</span>
                    <div>
                        <div class="sk-wallet-balance">@wallet.Balance.ToString("N0", culture)</div>
                        <div class="sk-wallet-label">@(wallet.Balance == 1 ? L["star available"] : L["stars available"])</div>
                    </div>
                </div>
                <p class="sk-wallet-summary">@Html.Raw(string.Format(L["You earned <b>{0} ⭐</b> as MVP and have spent <b>{1} ⭐</b> on skins."].Value, wallet.Stars.ToString("N0", culture), wallet.Spent.ToString("N0", culture)))</p>
                <p class="sk-wallet-mvps">@string.Format(L["{0} SI damage MVPs + {1} common MVPs"].Value, wallet.MvpSiDamage.ToString("N0", culture), wallet.MvpCommon.ToString("N0", culture))</p>
            </div>
        }
    </div>

    <div id="sk-howto" class="collapse sk-howto-panel">
        <div class="sk-howto">
            <div>
                <strong>@L["1. Earn stars"]</strong>
                @Html.Raw(L["Every SI damage MVP and every common infected MVP in competitive matches is worth <b>1 ⭐</b>. Your whole history counts, since the ranking began, and stars never expire."].Value)
            </div>
            <div>
                <strong>@L["2. Buy and equip"]</strong>
                @if (season.Refunds)
                {
                    @Html.Raw(L["Buy a skin with your stars. It is <b>equipped</b> right away and shows up on the server <b>from the next map change</b>. Each skin is bought only once and is yours until the end of the ranking season."].Value)
                }
                else
                {
                    @Html.Raw(L["Buy a skin with your stars. It is <b>equipped</b> right away and shows up on the server <b>from the next map change</b>. Each skin is bought only once and is yours forever."].Value)
                }
            </div>
            <div>
                <strong>@L["3. Switch in game"]</strong>
                @Html.Raw(L["During ready-up, use <code>!skin next</code> and <code>!skin prev</code> to switch between your skins, or <code>!skin default</code> to go back to the default one. You can also equip them here."].Value)
            </div>
        </div>

        @if (season.Refunds)
        {
            var lastDay = season.LastDay.ToString("d", culture);
            var daysLeft = season.DaysLeft.ToString("N0", culture);

            <div class="sk-banner sk-banner-info">
                <span class="glyphicon glyphicon-calendar"></span>
                <div>
                    <strong>@L["Skins per season"]</strong>
                    @if (season.LengthInMonths == 1)
                    {
                        <p>@L["Bought skins last until the ranking reset, which happens every month. The current season ends on {0} ({1} days left): at that moment every purchase is refunded automatically and the stars come back so you can buy again. Skins received as gifts are yours forever.", lastDay, daysLeft]</p>
                    }
                    else
                    {
                        <p>@L["Bought skins last until the ranking reset, which happens every {2} months. The current season ends on {0} ({1} days left): at that moment every purchase is refunded automatically and the stars come back so you can buy again. Skins received as gifts are yours forever.", lastDay, daysLeft, season.LengthInMonths]</p>
                    }
                </div>
            </div>
        }

        <p class="sk-credits">@L["All skins were made by the community on the Steam Workshop. Each skin shows its author with a link to their Steam profile, and the Authors tab credits all of them."]</p>
    </div>
</div>

@{
    async Task RenderActions(Skin skin, bool block)
    {
        var title = skin.Title(culture);
        var blockClass = block ? "btn-block" : string.Empty;

        if (!Model.LoggedIn)
        {
            <a class="btn btn-default btn-sm @blockClass sk-action" href="@loginUrl">@L["Sign in with Steam"]</a>
            return;
        }

        if (Model.IsEquipped(skin))
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action sk-unequip" data-weapon="@skin.Weapon" data-weapon-name="@WeaponName(skin.Weapon)">
                <span class="glyphicon glyphicon-repeat"></span> @L["Back to default"]
            </button>
            return;
        }

        if (Model.Owns(skin))
        {
            <button type="button" class="btn btn-success btn-sm @blockClass sk-action sk-equip" data-skin="@skin.Id" data-title="@title" data-weapon-name="@WeaponName(skin.Weapon)">
                <span class="glyphicon glyphicon-ok"></span> @L["Equip"]
            </button>
            return;
        }

        if (Model.Wallet == null)
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action" disabled>@string.Format(L["Buy for {0} ⭐"].Value, skin.Price.ToString("N0", culture))</button>
            return;
        }

        if (!Model.CanAfford(skin))
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action" disabled>@string.Format(L["Buy for {0} ⭐"].Value, skin.Price.ToString("N0", culture))</button>
            <small class="sk-missing">@string.Format(L["{0} ⭐ to go"].Value, Model.Missing(skin).ToString("N0", culture))</small>
            return;
        }

        <button type="button" class="btn btn-warning btn-sm @blockClass sk-action sk-buy" data-skin="@skin.Id" data-title="@title" data-price="@skin.Price" data-weapon-name="@WeaponName(skin.Weapon)">
            <span class="glyphicon glyphicon-shopping-cart"></span> @string.Format(L["Buy for {0} ⭐"].Value, skin.Price.ToString("N0", culture))
        </button>
    }

    const int shotCount = CoreConsts.SkinShotCount;

    async Task RenderDetails(Skin skin)
    {
        var title = skin.Title(culture);
        var description = skin.Description(culture);
        var original = string.Join(" — ", new[] { skin.OriginalTitle, skin.OriginalDescription }.Where(text => !string.IsNullOrWhiteSpace(text)));
        var image = Model.Image(skin);
        var shots = Model.Shots(skin);
        var authorUrl = SkinDisplay.AuthorUrl(skin);
        var workshop = SkinDisplay.WorkshopUrl(skin);

        <div class="sk-details hidden">
            <div class="row @SkinDisplay.RarityCss(skin.Rarity)">
                @if (shots != null)
                {
                    <div class="col-xs-12">
                        <div class="sk-gallery" data-shots="@shots" data-version="@skin.Shots">
                            <a class="sk-modal-image sk-gallery-main" href="@($"{shots}1{CoreConsts.SkinShotExtension}?v={skin.Shots}")" data-lity>
                                <img data-shot="1" data-size="" alt="@title"/>
                            </a>
                            <div class="sk-gallery-thumbs">
                                @for (var shot = 1; shot <= shotCount; shot++)
                                {
                                    <button type="button" class="sk-gallery-thumb @(shot == 1 ? "active" : "")" data-shot="@shot" title="@title (@shot/@shotCount)">
                                        <img data-shot="@shot" data-size="-thumb" alt="@title (@shot/@shotCount)"/>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-xs-12 col-sm-5">
                        <a class="sk-modal-image" href="@image" data-lity>
                            <img src="@image" alt="@title" loading="lazy"/>
                        </a>
                    </div>
                }
                <div class="col-xs-12 @(shots != null ? "" : "col-sm-7")">
                    <div class="sk-modal-tags">
                        <span class="label sk-modal-rarity">@L[SkinDisplay.RarityKey(skin.Rarity)]</span>
                        <span class="label label-default">@WeaponName(skin.Weapon)</span>
                        @if (Model.IsEquipped(skin))
                        {
                            <span class="label label-success">
                                <span class="glyphicon glyphicon-ok"></span> @L["Equipped"]
                            </span>
                        }
                        else if (Model.Owns(skin))
                        {
                            <span class="label label-info">@L["Owned"]</span>
                        }
                        @if (!skin.Available)
                        {
                            <span class="label label-warning">@L["No longer for sale"]</span>
                        }
                    </div>
                    <div class="sk-modal-price">@skin.Price.ToString("N0", culture) ⭐</div>
                    @if (!string.IsNullOrEmpty(skin.AuthorName))
                    {
                        <p class="sk-modal-author">
                            <b>@L["Author"]:</b>
                            @if (authorUrl != null)
                            {
                                <a href="@authorUrl" target="_blank" rel="noopener">
                                    <span class="glyphicon glyphicon-user"></span> @skin.AuthorName
                                </a>
                            }
                            else
                            {
                                <span>
                                    <span class="glyphicon glyphicon-user"></span> @skin.AuthorName
                                </span>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="sk-modal-desc">@description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(original))
                    {
                        <p class="sk-modal-original">
                            <b>@L["Original"]:</b> @original
                        </p>
                    }
                    <div class="sk-modal-actions">
                        @{ await RenderActions(skin, true); }
                    </div>
                    @if (Model.Owns(skin))
                    {
                        <div class="sk-command-label">@L["Chat command"]</div>
                        <div class="sk-command">
                            <code>@skin.Command</code>
                            @await Html.PartialAsync("_CopyButton", skin.Command)
                        </div>
                    }
                    @if (workshop != null)
                    {
                        <a class="btn btn-default btn-sm btn-block sk-workshop" href="@workshop" target="_blank" rel="noopener">
                            <span class="glyphicon glyphicon-new-window"></span> @L["View on Workshop"]
                        </a>
                    }
                    @if (administrator && skin.Available)
                    {
                        <button type="button" class="btn btn-success btn-sm btn-block sk-admin-gift" data-skin="@skin.Id">
                            <span class="glyphicon glyphicon-gift"></span> @L["Give as a gift (admin)"]
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    async Task RenderCard(Skin skin, bool anchor)
    {
        var title = skin.Title(culture);
        var owned = Model.Owns(skin);
        var equipped = Model.IsEquipped(skin);
        var shots = Model.Shots(skin);
        var authorUrl = SkinDisplay.AuthorUrl(skin);

        <div class="col-xs-6 col-sm-4 col-md-3 sk-col sk-item @SkinDisplay.RarityCss(skin.Rarity)"
             data-weapon="@skin.Weapon" data-rarity="@skin.Rarity" data-affordable="@(owned || Model.CanAfford(skin) ? 1 : 0)">
            <div class="sk-card sk-open @(owned ? "sk-owned" : "") @(skin.Rarity == SkinRarity.Legendary ? "sk-legendary-card" : "")" id="@(anchor ? SkinDisplay.Anchor(skin) : null)" data-title="@title" data-skin="@skin.Id" data-workshop="@SkinDisplay.WorkshopUrl(skin)">
                @{ await RenderDetails(skin); }
                <a class="sk-thumb" href="#@SkinDisplay.Anchor(skin)" data-shots="@shots" data-version="@(shots != null ? skin.Shots : null)">
                    <img src="@Model.Image(skin)" alt="@title" loading="lazy"/>
                    <span class="label sk-weapon">@WeaponName(skin.Weapon)</span>
                    @if (equipped)
                    {
                        <span class="label label-success sk-status">
                            <span class="glyphicon glyphicon-ok"></span> @L["Equipped"]
                        </span>
                    }
                    else if (owned)
                    {
                        <span class="label label-info sk-status">@L["Owned"]</span>
                    }
                    <span class="sk-price-tag">@skin.Price.ToString("N0", culture) ⭐</span>
                </a>
                <div class="sk-body">
                    <h4 class="sk-title" title="@title">@title</h4>
                    @if (!string.IsNullOrEmpty(skin.AuthorName))
                    {
                        <div class="sk-author" title="@skin.AuthorName">
                            @if (authorUrl != null)
                            {
                                @L["by"]
                                <a href="@authorUrl" target="_blank" rel="noopener">@skin.AuthorName</a>
                            }
                            else
                            {
                                @L["by"]
                                @skin.AuthorName
                            }
                        </div>
                    }
                    <div class="sk-rarity-name">@L[SkinDisplay.RarityKey(skin.Rarity)]</div>
                    <div class="sk-actions">
                        @{ await RenderActions(skin, true); }
                    </div>
                </div>
            </div>
        </div>
    }
}

<ul class="nav nav-tabs sk-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#shop" data-target="#sk-shop" role="tab" data-toggle="tab">
            @L["Shop"] <span class="badge">@Model.Skins.Count</span>
        </a>
    </li>
    @if (Model.LoggedIn)
    {
        <li role="presentation">
            <a href="#mine" data-target="#sk-mine" role="tab" data-toggle="tab">
                @L["My skins"] <span class="badge">@Model.OwnedSkins.Count</span>
            </a>
        </li>
    }
    <li role="presentation">
        <a href="#authors" data-target="#sk-authors" role="tab" data-toggle="tab">
            @L["Authors"] <span class="badge">@authors.Count</span>
        </a>
    </li>
</ul>

<div class="sk-toolbar">
    <label for="sk-weapon-filter">@L["Weapon"]</label>
    <select id="sk-weapon-filter" class="form-control input-sm">
        <option value="all">@L["All weapons"]</option>
        <optgroup label="@L["Firearms"]">
            @foreach (var weapon in Model.Weapons.Where(weapon => !SkinWeapons.IsMelee(weapon)))
            {
                <option value="@weapon">@WeaponName(weapon)</option>
            }
        </optgroup>
        <optgroup label="@L["Melee weapons"]">
            @foreach (var weapon in Model.Weapons.Where(SkinWeapons.IsMelee))
            {
                <option value="@weapon">@WeaponName(weapon)</option>
            }
        </optgroup>
    </select>
    <label for="sk-rarity-filter">@L["Rarity"]</label>
    <select id="sk-rarity-filter" class="form-control input-sm">
        <option value="all">@L["All rarities"]</option>
        @foreach (var rarity in SkinDisplay.Rarities)
        {
            <option value="@rarity">@L[SkinDisplay.RarityKey(rarity)]</option>
        }
    </select>
    @if (Model.Wallet != null)
    {
        <label>
            <input type="checkbox" id="sk-only-affordable"/> @L["Only the ones I can buy"]
        </label>
    }
</div>

<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="sk-shop">
        @foreach (var rarity in SkinDisplay.Rarities)
        {
            var skins = Model.SkinsOf(rarity);

            if (skins.Count == 0)
                continue;

            <section class="sk-rarity sk-section @SkinDisplay.RarityCss(rarity)">
                <div class="sk-rarity-header">
                    <h3>@L[SkinDisplay.RarityKey(rarity)]</h3>
                    <span class="sk-count">@string.Format(L["{0} skins"].Value, skins.Count) · @string.Format(L["{0} to {1} ⭐"].Value, skins.Min(skin => skin.Price).ToString("N0", culture), skins.Max(skin => skin.Price).ToString("N0", culture))</span>
                </div>
                <div class="row sk-grid">
                    @foreach (var skin in skins)
                    {
                        await RenderCard(skin, true);
                    }
                </div>
            </section>
        }
        @if (Model.Skins.Count == 0)
        {
            <p class="sk-empty">@L["There are no skins yet. An administrator has to import the catalog first."]</p>
        }
        <p class="sk-empty hidden">@L["No skins match these filters."]</p>
    </div>

    @if (Model.LoggedIn)
    {
        <div role="tabpanel" class="tab-pane" id="sk-mine">
            <p>
                <button type="button" class="btn btn-info btn-sm sk-use-open">
                    <span class="glyphicon glyphicon-question-sign"></span> @L["How do I use my skins in game?"]
                </button>
            </p>
            @if (Model.OwnedSkins.Count == 0)
            {
                <p class="sk-empty">@L["You do not own any skins yet. Pick one in the Shop tab!"]</p>
            }
            else
            {
                <section class="sk-section">
                    <div class="row sk-grid">
                        @foreach (var skin in Model.OwnedSkins)
                        {
                            await RenderCard(skin, false);
                        }
                    </div>
                </section>
                <p class="sk-empty hidden">@L["No skins match these filters."]</p>
            }
        </div>
    }
    <div role="tabpanel" class="tab-pane" id="sk-authors">
        <p>@L["Every skin in this shop was made by these Steam Workshop authors. Thank you! Click a name to open their Steam profile and see more of their work."]</p>
        <div class="sk-authors">
            @foreach (var author in authors)
            {
                <div>
                    <strong>
                        @if (author.ProfileUrl != null)
                        {
                            <a href="@author.ProfileUrl" target="_blank" rel="noopener" title="@author.Name">
                                <span class="glyphicon glyphicon-user"></span> @author.Name
                            </a>
                        }
                        else
                        {
                            <span title="@author.Name">
                                <span class="glyphicon glyphicon-user"></span> @author.Name
                            </span>
                        }
                    </strong>
                    <small>
                        @(author.Skins.Count == 1 ? L["{0} skin", author.Skins.Count.ToString("N0", culture)] : L["{0} skins", author.Skins.Count.ToString("N0", culture)]):
                        @string.Join(", ", author.Skins.Select(skin => skin.Title(culture)))
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<div id="sk-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                @if (authorNotice)
                {
                    <button type="button" class="btn btn-link btn-sm pull-left sk-author-notice-open" title="@L["Are you the author of this skin?"]">
                        <span class="glyphicon glyphicon-copyright-mark"></span> @L["Are you the author?"]
                    </button>
                }
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>

<div id="sk-author-notice" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">
                    <span class="glyphicon glyphicon-copyright-mark"></span> @L["Are you the author of this skin?"]
                </h4>
            </div>
            <div class="modal-body sk-author-notice">
                <p class="lead">@L["If you made this skin and do not want it on this site, just let me know. I will gladly remove it as soon as possible, no questions asked."]</p>
                <p>@L["I deeply respect the work of every author. Every skin shows who made it, with a link to the author's Steam profile and to the original Workshop page."]</p>
                <p>@L["This is a non-profit project. The server gives me no financial return, the skins are not sold and there is no money involved and no transaction of any kind. The shop stars are earned by playing and cannot be bought with money: the skins are only a cosmetic item for the players."]</p>
                <p>
                    <b>@L["If you are the author and do not want your skin here, you have every right. Contact me through one of the channels below and I will remove it as soon as possible."]</b>
                </p>
                <div class="sk-author-notice-actions">
                    @if (authorContactUrl != null)
                    {
                        <a class="btn btn-primary" href="@authorContactUrl" target="_blank" rel="noopener">
                            <span class="glyphicon glyphicon-user"></span> @L["Message me on Steam"]
                        </a>
                    }
                    @if (authorRequestUrl != null)
                    {
                        <a class="btn btn-default sk-author-notice-github" href="@authorRequestUrl" target="_blank" rel="noopener">
                            <span class="glyphicon glyphicon-envelope"></span> @L["Open a request on GitHub"]
                        </a>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>

<div id="sk-confirm" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@L["Confirm purchase"]</h4>
            </div>
            <div class="modal-body sk-message"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-warning sk-confirm-buy">
                    <span class="glyphicon glyphicon-shopping-cart"></span> @L["Confirm purchase"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="sk-result" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body sk-message"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">@L["Got it"]</button>
            </div>
        </div>
    </div>
</div>

<div id="sk-use-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["How to use your skins in game"]</h4>
            </div>
            <div class="modal-body sk-message">
                <p>@Html.Raw(L["Type the commands in the <b>game chat</b>. If you use <code>/</code> instead of <code>!</code> (e.g. <code>/skin next</code>), only you see the message."].Value)</p>
                <table class="table table-condensed table-striped sk-use-table">
                    <thead>
                    <tr>
                        <th>@L["Command"]</th>
                        <th>@L["What it does"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>
                            <code>!skin next</code><br/><code>!skin prev</code>
                        </td>
                        <td>@L["Switches between the skins you bought for the weapon in your hand. After the last one, it goes back to the default skin."]</td>
                    </tr>
                    <tr>
                        <td>
                            <code>!skin surtr</code>
                        </td>
                        <td>@L["Uses one of your skins by its id. The id is shown in the details of each skin (e.g. surtr)."]</td>
                    </tr>
                    <tr>
                        <td>
                            <code>!skin default</code>
                        </td>
                        <td>@L["Puts the weapon in your hand back on the default skin."]</td>
                    </tr>
                    <tr>
                        <td>
                            <code>!skin next pump</code>
                        </td>
                        <td>@L["Picks the weapon by name, without holding it."]</td>
                    </tr>
                    <tr>
                        <td>
                            <code>!skin status</code>
                        </td>
                        <td>@L["Shows how many stars and skins you have."]</td>
                    </tr>
                    <tr>
                        <td>
                            <code>!skin</code>
                        </td>
                        <td>@L["Shows the skins help in the chat."]</td>
                    </tr>
                    </tbody>
                </table>
                <p>
                    <small>@Html.Raw(L["Weapon names: <code>smg</code>, <code>mac</code>, <code>mp5</code>, <code>pump</code>, <code>chrome</code>, <code>magnum</code>, <code>axe</code>, <code>katana</code>, <code>machete</code>, <code>bat</code>, <code>cricket</code>, <code>guitar</code>, <code>crowbar</code>, <code>golf</code>, <code>pan</code>."].Value)</small>
                </p>
                <p>
                    <strong>@L["Good to know"]</strong>
                </p>
                <ul>
                    <li>@Html.Raw(L["In game, skins can only be changed as a <b>survivor</b> and during the <b>ready-up</b>."].Value)</li>
                    <li>@Html.Raw(L["A skin bought or equipped on the site shows up from the <b>next map change</b>."].Value)</li>
                    <li>@L["Your choice is saved: what you equip in game shows up on the site, and the other way around."]</li>
                    <li>@L["The skin stays with the weapon: if you drop it, whoever picks it up uses it with your skin."]</li>
                    <li>@Html.Raw(L["Downloads must be on: <b>Options > Multiplayer > Custom Server Content > Allow All</b>."].Value)</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">@L["Got it"]</button>
            </div>
        </div>
    </div>
</div>

@if (administrator)
{
    @await Html.PartialAsync("_GiftModal", Model.Skins)
}

@section Scripts {
    <script src="~/js/panzoom.min.js"></script>
    <script>
        var HubPage = {
            texts: {
                balance: @Json.Serialize(wallet?.Balance ?? 0),
                confirmUnequip: @Json.Serialize(L["Take off the skin of this weapon? It goes back to the default look, and you can equip the skin again later."].Value),
                confirmBuy: @Json.Serialize(L["Buy <b>{0}</b> for <b>{1} ⭐</b>?"].Value),
                confirmBalance: @Json.Serialize(L["Your balance goes from {0} ⭐ to {1} ⭐."].Value),
                confirmEquip: @Json.Serialize(L["Once done, it is equipped on your weapon ({0}) right away and shows up on the server from the next map change."].Value),
                confirmSeason: @Json.Serialize(season.Refunds ? string.Format(L["It lasts until the end of the ranking season, on {0}; then it is refunded automatically and the stars come back to you."].Value, season.LastDay.ToString("d", culture)) : null),
                confirmFinal: @Json.Serialize(season.Refunds ? L["Purchases cannot be undone before the ranking reset."].Value : L["Purchases cannot be undone."].Value),
                authorRequestUrl: @Json.Serialize(authorRequestUrl),
                buySuccessTitle: @Json.Serialize(L["Purchase complete!"].Value),
                buySuccess: @Json.Serialize(L["<b>{0}</b> is now equipped on your weapon ({1})."].Value),
                equipSuccessTitle: @Json.Serialize(L["Skin equipped!"].Value),
                equipSuccess: @Json.Serialize(L["Skins.Index.EquipSuccessText"].Value),
                unequipSuccessTitle: @Json.Serialize(L["Default skin is back"].Value),
                unequipSuccess: @Json.Serialize(L["Your weapon ({0}) is back to the default skin."].Value),
                nextMap: @Json.Serialize(L["The change shows up on the server <b>from the next map change</b>. If you are playing right now, it kicks in when the map changes."].Value),
                switchHint: @Json.Serialize(L["In game, during ready-up, use <code>!skin next</code> and <code>!skin prev</code> to switch between your skins, or <code>!skin default</code> to go back to the default one."].Value),
                errorTitle: @Json.Serialize(L["It did not work"].Value),
                previousPhoto: @Json.Serialize(L["Previous photo"].Value),
                nextPhoto: @Json.Serialize(L["Next photo"].Value),
                errors: {
                    InsufficientStars: @Json.Serialize(L["You do not have enough stars for this skin. No stars were spent."].Value),
                    AlreadyOwned: @Json.Serialize(L["You already own this skin. No stars were spent."].Value),
                    StarsUnavailable: @Json.Serialize(L["We could not check your stars right now. Try again in a moment. No stars were spent."].Value),
                    Busy: @Json.Serialize(L["Too many operations at the same time. Try again. No stars were spent."].Value),
                    NotOwned: @Json.Serialize(L["You do not own this skin yet."].Value),
                    SkinNotFound: @Json.Serialize(L["This skin is no longer available."].Value),
                    Generic: @Json.Serialize(L["Something went wrong. Reload the page to check whether the operation went through before trying again."].Value)
                }
            }
        };
    </script>
    <script src="~/js/pages/skins.js" asp-append-version="true"></script>
}
