@using L4D2PlayStats.Hub.Core.Modules.Skins.Helpers
@using L4D2PlayStats.Hub.Web.Helpers
@using L4D2PlayStats.Hub.Web.Models.Skins
@model SkinShopViewModel
@{
    var culture = CultureInfo.CurrentUICulture;
}
@if (Model.Skins.Count == 0)
{
    <div class="alert alert-secondary">@L["No skins match these filters."]</div>
}
else
{
    <div class="small text-body-secondary mb-2">@L["{0} skins", Model.Skins.Count]</div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var skin in Model.Skins)
        {
            var title = skin.Title(culture);
            var description = skin.Description(culture);
            var thumbnail = SkinAssets.Thumbnail(Model.Settings.AssetsUrl, skin.Id);
            var shots = skin.HasShots ? SkinAssets.ShotsFolder(Model.Settings.AssetsUrl, skin.Id) : null;
            var workshop = SkinDisplay.WorkshopUrl(skin);
            var owned = Model.Owns(skin);
            var equipped = Model.IsEquipped(skin);

            <div class="col">
                <div class="card h-100 skin-card @SkinDisplay.RarityCss(skin.Rarity)" id="skin-@skin.Id">
                    @if (thumbnail != null)
                    {
                        <img class="card-img-top skin-thumb" src="@thumbnail" alt="@title" loading="lazy">
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h2 class="h6 mb-1">@title</h2>
                            <span class="badge skin-rarity-badge">@L[$"Rarity.{skin.Rarity}"]</span>
                        </div>
                        <div class="small text-body-secondary mb-2">
                            @L[SkinWeapons.Name(skin.Weapon)]
                            @if (!string.IsNullOrEmpty(skin.AuthorName))
                            {
                                <span>
                                    · @L["by"]
                                    @if (skin.AuthorCommunityId != null)
                                    {
                                        <a class="link-secondary" href="@SteamIds.ProfileUrl(skin.AuthorCommunityId.Value)" rel="noopener" target="_blank">@skin.AuthorName</a>
                                    }
                                    else
                                    {
                                        @skin.AuthorName
                                    }
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(description))
                        {
                            <p class="small skin-description">@description</p>
                        }
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="skin-stars fw-bold">★ @skin.Price</span>
                                <code class="small" title="@L["Type this in the game chat to equip the skin"]">@skin.Command</code>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (owned && equipped)
                                {
                                    <span class="badge text-bg-success">@L["Equipped"]</span>
                                    <form method="post" asp-antiforgery="true" action="@AppConsts.SkinShopUrl/unequip">
                                        <input type="hidden" name="weapon" value="@skin.Weapon">
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Unequip"]</button>
                                    </form>
                                }
                                else if (owned)
                                {
                                    <span class="badge text-bg-secondary">@L["Yours"]</span>
                                    <form method="post" asp-antiforgery="true" action="@AppConsts.SkinShopUrl/@skin.Id/equip">
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                        <button class="btn btn-sm btn-primary" type="submit">@L["Equip"]</button>
                                    </form>
                                }
                                else if (Model.SignedIn && Model.CanAfford(skin))
                                {
                                    <form method="post" asp-antiforgery="true" action="@AppConsts.SkinShopUrl/@skin.Id/buy" onsubmit="return confirm('@L["Buy this skin?"]')">
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                        <button class="btn btn-sm btn-success" type="submit">@L["Buy"]</button>
                                    </form>
                                }
                                else if (Model.SignedIn)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" disabled>@L["{0} stars missing", Model.Missing(skin)]</button>
                                }
                                @if (!skin.Available)
                                {
                                    <span class="badge text-bg-warning">@L["No longer for sale"]</span>
                                }
                                @if (shots != null)
                                {
                                    <button class="btn btn-sm btn-outline-light" type="button" data-skin-shots="@shots" data-skin-version="@skin.Shots" data-skin-title="@title">@L["Photos"]</button>
                                }
                                @if (workshop != null)
                                {
                                    <a class="btn btn-sm btn-link px-0" href="@workshop" rel="noopener" target="_blank">@L["Workshop"]</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
