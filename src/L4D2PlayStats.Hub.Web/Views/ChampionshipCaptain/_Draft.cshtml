@model ChampionshipCaptainModel
@using L4D2PlayStats.Hub.Core.Modules.Championships.Services
@{
    var championship = Model.Championship;
    var team = Model.Team;
    var view = Model.Page;
    var onTheClock = ChampionshipDraftService.OnTheClock(championship);
    var mine = onTheClock?.Id == team.Id;
    var free = ChampionshipDraftService.Free(championship).OrderByDescending(id => view.Hours(id) ?? -1).ToList();
    var order = championship.Teams.Where(item => item.DraftPosition != null).OrderBy(item => item.DraftPosition).ToList();
    var picks = championship.DraftPicks.OrderByDescending(pick => pick.Number).ToList();
}

<p class="admin-lead">@L["The captains choose one player at a time, in the order of the draft ({0}). There is no time limit: when it is the turn of your team, choose here whenever you can; the next team chooses after you.", ChampionshipTexts.DraftMethod(L, championship.DraftMethod)]</p>

@if (mine)
{
    <div class="alert alert-success"><span class="glyphicon glyphicon-hand-right"></span> <strong>@L["It is the turn of your team."]</strong> @L["Choose a player below."]</div>
}
else if (onTheClock != null)
{
    <div class="alert alert-info"><span class="glyphicon glyphicon-hourglass"></span> @L["Now it is the turn of {0}. Your team chooses when its turn comes.", onTheClock.Name]</div>
}
else if (order.Count < championship.Teams.Count)
{
    <div class="alert alert-info"><span class="glyphicon glyphicon-hourglass"></span> @L["The administration has not drawn the order of the draft yet."]</div>
}
else
{
    <div class="alert alert-success"><span class="glyphicon glyphicon-ok"></span> @L["The draft is complete."]</div>
}

<div class="row">
    <div class="col-md-7">
        <h4 class="championship-section-title">@L["Players without a team"]</h4>
        @if (free.Count == 0)
        {
            <div class="admin-list">
                <div class="admin-empty">@L["Every player is in a team."]</div>
            </div>
        }
        else
        {
            <table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table">
                <thead>
                <tr>
                    <th>@L["Player"]</th>
                    <th class="text-center">@L["Hours"]</th>
                    @if (mine)
                    {
                        <th></th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var communityId in free)
                {
                    var hours = view.Hours(communityId);
                    var name = view.PlayerName(communityId);

                    <tr>
                        <td class="vertical-align-middle" data-label="@L["Player"]">
                            <img src="@AppConsts.AvatarUrl@communityId" alt="" class="championship-avatar" onerror="imgOnError(this)"/>
                            <a href="@PlayerUrls.Details(communityId)" target="_blank">@DisplayNames.Apply(communityId, name)</a>
                        </td>
                        <td class="text-center vertical-align-middle" data-label="@L["Hours"]">@(hours == null ? "—" : Display.Number(hours.Value))</td>
                        @if (mine)
                        {
                            <td class="text-center vertical-align-middle slim admin-actions admin-row-actions">
                                <form method="post" asp-antiforgery="true" action="@Model.Url/draft/pick" data-confirm="@L["Choose {0} for your team?", name]">
                                    <input type="hidden" name="communityId" value="@communityId"/>
                                    <button class="btn btn-xs btn-success" type="submit">
                                        <span class="glyphicon glyphicon-ok"></span> @L["Choose"]
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    <div class="col-md-5">
        <h4 class="championship-section-title">@L["Order of the captains"]</h4>
        <table class="table table-striped table-bordered table-condensed admin-table">
            <tbody>
            @foreach (var item in order)
            {
                <tr class="@(item.Id == onTheClock?.Id ? "warning" : null)">
                    <td class="text-center slim">@item.DraftPosition</td>
                    <td>@item.Name @if (item.Id == team.Id)
                        {
                            <span class="label label-primary">@L["Your team"]</span>
                        }</td>
                    <td class="text-center slim">@item.Members.Count / @championship.RosterSize</td>
                </tr>
            }
            </tbody>
        </table>
        <h4 class="championship-section-title">@L["Picks"]</h4>
        @if (picks.Count == 0)
        {
            <p class="text-muted">@L["No pick yet."]</p>
        }
        else
        {
            <table class="table table-striped table-bordered table-condensed admin-table">
                <tbody>
                @foreach (var pick in picks)
                {
                    <tr class="@(pick.TeamId == team.Id ? "info" : null)">
                        <td class="text-center slim">@pick.Number</td>
                        <td>@view.TeamName(pick.TeamId)</td>
                        <td>@DisplayNames.Apply(pick.CommunityId, view.PlayerName(pick.CommunityId))</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
