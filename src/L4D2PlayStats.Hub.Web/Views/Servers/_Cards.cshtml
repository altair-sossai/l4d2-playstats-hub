@model ServerListViewModel

@if (Model.Servers.Count == 0)
{
    <div class="alert alert-info text-center">@L["No game server available yet."]</div>
}

<div class="row">
    @foreach (var card in Model.Servers)
    {
        var configuration = card.Snapshot.Configuration;
        var round = card.Snapshot.Round;
        var scoreboard = card.Snapshot.Scoreboard;
        var labelSurvivor = scoreboard?.IsDraw != false ? "default" : scoreboard.IsSurvivorsWinning ? "success" : "danger";
        var labelInfected = scoreboard?.IsDraw != false ? "default" : scoreboard.IsInfectedsWinning ? "success" : "danger";
        var map = new List<string>();
        var mode = new List<string>();

        if (!string.IsNullOrEmpty(card.Campaign))
        {
            map.Add(card.Campaign);
        }

        map.Add(string.IsNullOrEmpty(card.Map) ? L["Unknown map"].Value : card.Map);

        if (round != null)
        {
            map.Add((round.InSecondHalfOfRound ? L["2nd round"] : L["1st round"]).Value);
        }

        if (configuration != null && !string.IsNullOrEmpty(configuration.Name))
        {
            mode.Add(configuration.Name);
        }

        if (configuration is { TeamSize: > 0 })
        {
            mode.Add($"{configuration.TeamSize}v{configuration.TeamSize}");
        }

        <div class="col-xs-12 col-sm-6 col-md-4" id="server-card-@card.Server.PublicId">
            <div class="panel panel-default server-card">
                <div class="panel-heading text-center">
                    <a href="@AppConsts.ServersUrl/@card.Server.PublicId" class="bold">@card.Name</a>
                    <span class="label label-@(card.Online ? "success" : "default")" style="margin-left: 5px">
                        @(card.Online ? L["Online"] : L["Offline"])
                    </span>
                </div>
                <table class="table table-condensed">
                    <tbody>
                    <tr>
                        <th class="slim text-right">@L["Map"]:</th>
                        <td>@string.Join(" - ", map)</td>
                    </tr>
                    <tr>
                        <th class="slim text-right">@L["Configuration"]:</th>
                        <td>@(mode.Count == 0 ? "-" : string.Join(" - ", mode))</td>
                    </tr>
                    <tr>
                        <th class="slim text-right">@L["Scoreboard"]:</th>
                        <td class="text-nowrap">
                            <span class="label label-@labelSurvivor" data-toggle="tooltip" data-placement="top" title="@L["Survivors"]">
                                @((scoreboard?.SurvivorScore ?? 0).ToString("N0"))
                            </span>
                            <span class="label label-@labelInfected" data-toggle="tooltip" data-placement="top" title="@L["Infecteds"]" style="margin-left: 5px">
                                @((scoreboard?.InfectedScore ?? 0).ToString("N0"))
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th class="slim text-right">@L["Players"]:</th>
                        <td>@card.Players.ToString("N0") / @card.MaxPlayers.ToString("N0")</td>
                    </tr>
                    </tbody>
                </table>
                <div class="panel-footer text-center">
                    <a href="@AppConsts.ServersUrl/@card.Server.PublicId" class="btn btn-sm btn-default">
                        <span class="glyphicon glyphicon-eye-open"></span> @L["Watch"]
                    </a>
                    @if (card.ConnectUrl != null)
                    {
                        <a href="@card.ConnectUrl" class="btn btn-sm btn-primary" style="margin-left: 5px">
                            connect @card.ServerIp
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>