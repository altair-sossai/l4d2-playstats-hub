@model ChargerLevelHurtEvent

<span class="game-event-stars">@Model.StarsText()</span>
@(Html.EventPlayer(Model.Actor!))
<span class="game-event-action">@L["chip-leveled"]</span>
@(Html.EventPlayer(Model.Charger, L["a charger"]))
(<span class="game-event-danger">@L["{0} damage", Model.Damage]</span>).
