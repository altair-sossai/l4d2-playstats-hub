@model ServerCardViewModel
@{
    var theme = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme ? AppConsts.IconThemeLight : AppConsts.IconThemeDark;

    var gameInfo = Model.Snapshot;
    var scoreboard = gameInfo.Scoreboard;
    var survivors = gameInfo.Survivors;
    var infecteds = gameInfo.Infecteds;
    var spectators = gameInfo.Spectators;

    var survivorScore = scoreboard?.SurvivorScore ?? 0;
    var infectedScore = scoreboard?.InfectedScore ?? 0;
    var labelSurvivor = scoreboard?.IsDraw == true ? "default" : scoreboard?.IsSurvivorsWinning == true ? "success" : "danger";
    var labelInfected = scoreboard?.IsDraw == true ? "default" : scoreboard?.IsInfectedsWinning == true ? "success" : "danger";

    string HealthProgressBarClass(HealthColor? healthColor)
    {
        return healthColor switch
        {
            HealthColor.Green => "progress-bar-success",
            HealthColor.Orange => "progress-bar-warning",
            HealthColor.Red => "progress-bar-danger",
            _ => string.Empty
        };
    }

    string ProgressBarWidth(decimal percentage)
    {
        return $"{Math.Round(percentage * 100, 2).ToString(CultureInfo.InvariantCulture)}%";
    }
}

<div class="@(Model.AnyPlayerConnected ? string.Empty : "hidden")">

<script id="survivors" type="application/json">
        @Html.Raw(Json.Serialize(survivors))
    </script>

<script id="infecteds" type="application/json">
        @Html.Raw(Json.Serialize(infecteds))
    </script>

<script id="spectators" type="application/json">
        @Html.Raw(Json.Serialize(spectators))
    </script>

@if (scoreboard is { SurvivorScore: > 0, InfectedScore: > 0 })
{
    var survivorBar = scoreboard.IsDraw ? string.Empty : scoreboard.IsSurvivorsWinning ? "progress-bar-success" : "progress-bar-danger";
    var infectedBar = scoreboard.IsDraw ? string.Empty : scoreboard.IsInfectedsWinning ? "progress-bar-success" : "progress-bar-danger";

    <div class="progress" style="position: relative; border-radius: 0">
        <div class="progress-bar @survivorBar" style="width: @ProgressBarWidth(scoreboard.SurvivorPercentage)" data-toggle="tooltip" data-placement="top" title="@L["Survivors"]">
            @scoreboard.SurvivorScore.ToString("N0")
            @if (scoreboard.IsSurvivorsWinning)
            {
                <span class="label label-default">+@scoreboard.Comeback.ToString("N0")</span>
            }
        </div>
        <div class="progress-bar @infectedBar" style="width: @ProgressBarWidth(scoreboard.InfectedPercentage)" data-toggle="tooltip" data-placement="top" title="@L["Infecteds"]">
            @scoreboard.InfectedScore.ToString("N0")
            @if (scoreboard.IsInfectedsWinning)
            {
                <span class="label label-default">+@scoreboard.Comeback.ToString("N0")</span>
            }
        </div>
        <span style="position: absolute; top: 0; bottom: 0; left: 50%; border-left: 1px dashed rgba(255, 255, 255, .8)" data-toggle="tooltip" data-placement="top" title="@L["Difference"]"></span>
    </div>
}

<div class="row row-players">
    <div class="col-xs-12 col-sm-6">
        <div class="panel panel-default">

            @if (survivorScore == 0 || infectedScore == 0)
            {
                <div class="panel-heading text-center">
                    @L["Survivors"]
                    <span class="label label-@labelSurvivor" data-toggle="tooltip" data-placement="top" title="@L["Survivors"]">
                        @survivorScore.ToString("N0")
                    </span>
                </div>
            }
            <div class="panel-body">
                @if (survivors is { Count: > 0 })
                {
                    <table class="table-survivors">
                        <tbody>
                        @for (var i = 0; i < survivors.Count; i++)
                        {
                            var survivor = survivors[i];
                            <tr id="tr0-survivor-@i">
                                <td rowspan="3" style="width: 75px; padding-right: 4px;">
                                    <img src="/imgs/survivor-character/@(survivor.Character.ToString().ToLower()).png" alt="@survivor.Character"
                                         data-toggle="tooltip" data-placement="top" title="@survivor.Character"
                                         class="img-responsive img-character @(survivor.Dead ? "img-gray" : string.Empty)"/>
                                </td>
                                <td style="width: 40px" rowspan="2">
                                    <a href="@LiveDisplay.PlayerUrl(survivor, Model.RankingEnabled)" target="_blank">
                                        <img src="@LiveDisplay.Avatar(survivor)" alt="@survivor.Name" onerror="imgOnError(this)"
                                             data-toggle="tooltip" data-placement="top" title="@survivor.Name"
                                             class="img-responsive img-avatar @(survivor.Dead ? "img-gray" : string.Empty)"/>
                                    </a>
                                </td>
                                <td>
                                    <a href="@LiveDisplay.PlayerUrl(survivor, Model.RankingEnabled)" target="_blank">@survivor.Name</a>

                                    @if (survivor.IsAdmin)
                                    {
                                        <span class="label label-primary" data-toggle="tooltip" data-placement="top" title="Admin" style="margin-right: 3px">
                                            Admin
                                        </span>
                                    }

                                    @if (!survivor.IsPlayerAlive)
                                    {
                                        <span class="label label-danger" data-toggle="tooltip" data-placement="top" title="@L["Dead"]">
                                            @L["Dead"]
                                        </span>
                                    }
                                    else
                                    {
                                        if (survivor.Incapacitated == true)
                                        {
                                            <span class="label label-warning" data-toggle="tooltip" data-placement="top" title="@L["Incapacitated"]">
                                                @L["Incapacitated"]
                                            </span>
                                        }
                                        else if (survivor.BlackAndWhite == true)
                                        {
                                            <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Black and white"]">
                                                @L["Black and white"]
                                            </span>
                                        }
                                    }
                                </td>
                                <td rowspan="3" class="td-latency text-center">
                                    @if (survivor.LatencyType != null)
                                    {
                                        <img src="/imgs/latency/@(survivor.LatencyType.Value.ToString().ToLower()).png"
                                             alt="@TextLatency(survivor.LatencyType.Value)"
                                             data-toggle="tooltip" data-placement="top" title="@TextLatency(survivor.LatencyType.Value)"
                                             class="img-responsive img-latency"/>
                                    }
                                </td>
                            </tr>
                            <tr id="tr1-survivor-@i">
                                <td class="text-right">
                                    @if (survivor.IsPlayerAlive)
                                    {
                                        var weapons = new List<Weapon?>
                                        {
                                            survivor.PrimaryWeapon,
                                            survivor.SecondaryWeapon,
                                            survivor.SlotNumber3,
                                            survivor.SlotNumber4,
                                            survivor.SlotNumber5
                                        };

                                        foreach (var weapon in weapons.Where(w => w.HasIcon()).Cast<Weapon>())
                                        {
                                            if (weapon == Weapon.Melee && survivor.MeleeWeapon != null && survivor.MeleeWeapon.HasIcon())
                                            {
                                                var meleeWeapon = survivor.MeleeWeapon.Value;

                                                <img src="/imgs/melee-weapon/@meleeWeapon.WeaponName()-@(theme).png" alt="@meleeWeapon.Description()"
                                                     data-toggle="tooltip" data-placement="top" title="@meleeWeapon.Description()"
                                                     class="img-responsive img-weapon"/>
                                            }
                                            else
                                            {
                                                <img src="/imgs/weapon/@weapon.WeaponName()-@(theme).png" alt="@weapon.Description()"
                                                     data-toggle="tooltip" data-placement="top" title="@weapon.Description()"
                                                     class="img-responsive img-weapon"/>
                                            }
                                        }
                                    }
                                </td>
                            </tr>
                            <tr id="tr2-survivor-@i">
                                <td colspan="2">
                                    <table class="table-hp-progress">
                                        @if (survivor.IsPlayerAlive)
                                        {
                                            <tr>
                                                @{
                                                    var permanentHealth = survivor.PermanentHealth ?? 0;
                                                }

                                                @{
                                                    var permanentHealthPercentage = survivor.MaxHealth == 0 ? 0 : permanentHealth / (decimal)survivor.MaxHealth;
                                                }
                                                @{
                                                    var temporaryHealth = survivor.TemporaryHealth ?? 0;
                                                }

                                                @{
                                                    var temporaryHealthPercentage = survivor.MaxHealth == 0 ? 0 : temporaryHealth / (decimal)survivor.MaxHealth;
                                                }
                                                @{
                                                    var progressBarClass = HealthProgressBarClass(survivor.HealthColor);
                                                }
                                                <td style="width: 100%">
                                                    <div class="progress" data-toggle="tooltip" data-placement="top" title="@L["Health"]" style="height: 12px">
                                                        @if (permanentHealth > 0)
                                                        {
                                                            <div class="progress-bar @progressBarClass @(survivor.Incapacitated == true ? "temporary" : string.Empty)" style="width: @ProgressBarWidth(permanentHealthPercentage)">
                                                            </div>
                                                        }
                                                        @if (temporaryHealth > 0)
                                                        {
                                                            <div class="progress-bar @progressBarClass temporary" style="width: @ProgressBarWidth(temporaryHealthPercentage)">
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="slim hp-progress-number">
                                                    <span data-toggle="tooltip" data-placement="top" title="@L["Health"]">
                                                        @survivor.Health.ToString("N0")
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width: 100%">
                                                    <div class="progress" data-toggle="tooltip" data-placement="top" title="@L["Progress"]" style="height: 8px">
                                                        <div class="progress-bar" style="width: @ProgressBarWidth(survivor.Progress)">
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="slim hp-progress-number">
                                                    <span data-toggle="tooltip" data-placement="top" title="@L["Progress"]">
                                                        @survivor.Progress.ToString("P0")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                </td>
                            </tr>
                            if (survivor != survivors.Last())
                            {
                                <tr id="tr3-survivor-@i">
                                    <td colspan="4">
                                        <hr/>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6">
        <div class="panel panel-default">
            @if (survivorScore == 0 || infectedScore == 0)
            {
                <div class="panel-heading text-center">
                    @L["Infecteds"]
                    <span class="label label-@labelInfected" data-toggle="tooltip" data-placement="top" title="@L["Infecteds"]">
                        @infectedScore.ToString("N0")
                    </span>
                </div>
            }
            <div class="panel-body">
                @if (infecteds is { Count: > 0 })
                {
                    <table class="table-infecteds">
                        <tbody>
                        @for (var i = 0; i < infecteds.Count; i++)
                        {
                            var infected = infecteds[i];
                            var infectedIcon = infected.Type == null ? "none" : infected.Type.Value.ToString().ToLower();
                            var infectedTitle = infected.Type?.Description() ?? "None";
                            <tr id="tr0-infected-@i">
                                <td style="width: 80px; padding-right: 8px; padding-bottom: 5px;" rowspan="2">
                                    <img src="/imgs/infected-type/@(infectedIcon).jpg" alt="@infectedTitle"
                                         data-toggle="tooltip" data-placement="top" title="@infectedTitle"
                                         class="img-responsive img-infected"/>
                                </td>
                                <td style="width: 40px">
                                    <a href="@LiveDisplay.PlayerUrl(infected, Model.RankingEnabled)" target="_blank">
                                        <img src="@LiveDisplay.Avatar(infected)" alt="@infected.Name" onerror="imgOnError(this)"
                                             data-toggle="tooltip" data-placement="top" title="@infected.Name"
                                             class="img-responsive img-avatar"/>
                                    </a>
                                </td>
                                <td>
                                    <a href="@LiveDisplay.PlayerUrl(infected, Model.RankingEnabled)" target="_blank">
                                        @infected.Name
                                    </a>

                                    @if (infected.IsAdmin)
                                    {
                                        <span class="label label-primary" data-toggle="tooltip" data-placement="top" title="Admin" style="margin-right: 3px">
                                            Admin
                                        </span>
                                    }

                                    @if (infected.IsInfectedGhost)
                                    {
                                        <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Spawning"]">
                                            @L["Spawning"]
                                        </span>
                                    }
                                    else
                                    {
                                        if (!infected.IsPlayerAlive)
                                        {
                                            <span class="label label-danger" data-toggle="tooltip" data-placement="top" title="@L["Dead"]">
                                                @L["Dead"]
                                            </span>
                                        }
                                    }
                                </td>
                                <td rowspan="2" class="text-center text-nowrap">
                                    <h4 data-toggle="tooltip" data-placement="top" title="@L["Damage"]">
                                        @infected.Damage.ToString("N0")
                                    </h4>
                                </td>
                                <td class="td-latency text-center" rowspan="2">
                                    @if (infected.LatencyType != null)
                                    {
                                        <img src="/imgs/latency/@(infected.LatencyType.Value.ToString().ToLower()).png"
                                             alt="@TextLatency(infected.LatencyType.Value)"
                                             data-toggle="tooltip" data-placement="top" title="@TextLatency(infected.LatencyType.Value)"
                                             class="img-responsive img-latency"/>
                                    }
                                </td>
                            </tr>
                            <tr id="tr1-infected-@i">
                                <td colspan="2">
                                    @if (infected.IsPlayerAlive)
                                    {
                                        var health = infected.Health ?? 0;
                                        var maxHealth = infected.MaxHealth ?? 0;
                                        var healthPercentage = maxHealth == 0 ? 0 : health / (decimal)maxHealth;

                                        <table class="table-hp">
                                            <tr>
                                                <td style="width: 100%">
                                                    <div class="progress" data-toggle="tooltip" data-placement="top" title="@L["Health"]">
                                                        <div class="progress-bar progress-bar-success" style="width: @ProgressBarWidth(healthPercentage)">
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="slim hp-number">
                                                    <span data-toggle="tooltip" data-placement="top" title="@L["Health"]">
                                                        @health.ToString("N0") / @maxHealth.ToString("N0")
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    }
                                </td>
                            </tr>
                            if (infected != infecteds.Last())
                            {
                                <tr id="tr2-infected-@i">
                                    <td colspan="5">
                                        <hr/>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@if (spectators is { Count: > 0 })
{
    <div class="row">
        <div class="col-md-12 spectators">
            <span style="font-weight: bold">@L["Spectators"] (@spectators.Count): </span>
            @foreach (var spectator in spectators)
            {
                <a href="@LiveDisplay.PlayerUrl(spectator, Model.RankingEnabled)" target="_blank" class="label label-default" id="spectator-@spectator.CommunityId">
                    @spectator.Name
                </a>
            }
        </div>
    </div>
}

</div>

@functions {
    private Microsoft.Extensions.Localization.LocalizedString TextLatency(object key)
    {
        return key.ToString() switch
        {
            "High" => L["High"],
            "Low" => L["Low"],
            "Medium" => L["Medium"],
            _ => L[key.ToString()!]
        };
    }
}
