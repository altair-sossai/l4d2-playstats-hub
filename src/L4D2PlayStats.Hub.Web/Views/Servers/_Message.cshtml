@model LiveChatMessage

@{
    var cssClass = Model.Team switch
    {
        LiveTeam.Survivor => "text-info",
        LiveTeam.Infected => "text-danger",
        LiveTeam.External => "text-warning",
        _ => "text-muted"
    };

    var team = Model.Team switch
    {
        LiveTeam.Survivor => L["Survivor"],
        LiveTeam.Infected => L["Infected"],
        LiveTeam.External => L["External"],
        _ => L["Spectator"]
    };
}

@if (!Model.Public)
{
    <small>@($"({team.Value})")</small>
}
<span class="@cssClass" style="font-weight: bold">
    <a href="@LiveDisplay.PlayerUrl(Model.Player)" target="_blank">@Model.Player.Name</a>
</span>
@if (Model.IsAdmin)
{
    <span class="text-muted">(Admin)</span>
}
<span>:</span>
<span>@Model.Message</span>
