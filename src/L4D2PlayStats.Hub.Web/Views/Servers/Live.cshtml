@model LiveServerViewModel
@inject ICurrentUser CurrentUser
@inject ISettingsService ChatSettings

@{
    var card = Model.Card;
    var publicId = card.Server.PublicId;
    var mapDescription = card.Campaign ?? card.Map ?? L["Map"].Value;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Server"],
        Description = L["Follow the {0} server, map {1}, and its {2} connected players.", Model.SiteName, mapDescription, card.Players],
        Image = card.CampaignImage,
        ImageAlt = mapDescription
    };

    var chatBan = Model.ChatBan;
    var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/servers-live.css" asp-append-version="true"/>
}

@section Scripts {
    @await Html.PartialAsync("_CommandBuilder")

    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script>
        var serverUrl = '@AppConsts.ServersUrl/@publicId';
        var serverPublicId = @Json.Serialize(publicId);
        var refreshInterval = @((await ChatSettings.GetAsync<LiveServerSettings>()).RefreshInMilliseconds);
        var safetyRefreshInterval = @AppConsts.LivePageSafetyRefreshInMilliseconds;
        var liveHubUrl = '@AppConsts.LiveHubUrl';
        var liveHubRetry = @AppConsts.LiveHubRetryInMilliseconds;
        var requestTimeout = @AppConsts.LivePageRequestTimeoutInMilliseconds;
        var maxFeedItems = @AppConsts.LivePageMaxFeedItems;
        var feedAfter = 0;
        var pushConnected = false;
        var dd = new diffDOM.DiffDOM();

        function sync(current, html) {
            var source = document.createElement('div');
            source.id = current.id;
            source.innerHTML = html;

            var diffs = dd.diff(current, source);
            dd.apply(current, diffs);
        }

        function createRefresher(load, interval) {
            var refresher = { timer: null, busy: false, pending: false };

            refresher.run = function () {
                clearTimeout(refresher.timer);
                refresher.timer = null;

                if (refresher.busy) {
                    refresher.pending = true;
                    return;
                }

                refresher.busy = true;
                refresher.pending = false;

                load(function () {
                    refresher.busy = false;
                    refresher.timer = setTimeout(refresher.run, refresher.pending ? 0 : pushConnected ? safetyRefreshInterval : interval);
                });
            };

            return refresher;
        }

        function loadHeader(done) {
            $.ajax({
                url: serverUrl + '/header',
                type: 'GET',
                timeout: requestTimeout,
                success: function (html) {
                    var target = document.getElementById('game-info-header');
                    sync(target, html);

                },
                complete: done
            });
        }

        function loadPlayers(done) {
            $.ajax({
                url: serverUrl + '/players',
                type: 'GET',
                timeout: requestTimeout,
                success: function (html) {
                    var target = document.getElementById('game-info-players');
                    sync(target, html);

                    $('.game-info-chat-own').toggle(!$(target).children('div').first().hasClass('hidden'));
                },
                complete: done
            });
        }

        function applyFeedFilter() {
            var mode = 'all';

            try { 
                mode = localStorage.getItem('feedFilter') || 'all'; 
            } catch (err) {
                console.warn('Unable to access localStorage:', err);
            }

            $('#feed p[data-feed-kind]').each(function () {
                var kind = $(this).attr('data-feed-kind');
                var show = mode === 'all'
                    || (mode === 'events' && kind === 'event')
                    || (mode === 'messages' && kind === 'message');
                $(this).toggle(show);
            });
        }

        function lastFeedSequence(items) {
            var last = 0;

            items.each(function () {
                last = Math.max(last, Number($(this).attr('data-feed-sequence')) || 0);
            });

            return last;
        }

        function loadFeed(done) {
            var after = feedAfter;

            $.ajax({
                url: serverUrl + '/feed?after=' + after,
                type: 'GET',
                timeout: requestTimeout,
                success: function (html, status) {
                    if (!html || status == "nocontent")
                        return;

                    var feed = $('#feed');
                    var scrollDown = feed[0].scrollHeight - feed.scrollTop() === feed.outerHeight();

                    feedAfter = lastFeedSequence($('<div>').html(html).find('p[data-feed-sequence]')) || feedAfter;

                    feed.append(html);

                    $('#feed p[data-feed-when]').each(function () {
                        var feedWhen = $(this).data('feed-when');
                        if (feedWhen) {
                            var $duplicates = $('#feed p[data-feed-when="' + feedWhen + '"]').slice(1);
                            $duplicates.remove();
                        }
                    });

                    var $items = $('#feed p[data-feed-when]');
                    if ($items.length > maxFeedItems)
                        $items.slice(0, $items.length - maxFeedItems).remove();

                    applyFeedFilter();

                    if (scrollDown)
                        feed.scrollTop(feed[0].scrollHeight);
                },
                complete: done
            });
        }

        var refreshers = {
            '@AppConsts.LiveChangeHeader': createRefresher(loadHeader, refreshInterval),
            '@AppConsts.LiveChangePlayers': createRefresher(loadPlayers, refreshInterval),
            '@AppConsts.LiveChangeFeed': createRefresher(loadFeed, refreshInterval / 2)
        };

        function refreshAll() {
            $.each(refreshers, function (name, refresher) {
                refresher.run();
            });
        }

        function refreshFeed() {
            refreshers['@AppConsts.LiveChangeFeed'].run();
        }

        function setPushConnected(connected) {
            if (pushConnected === connected)
                return;

            pushConnected = connected;
            refreshAll();
        }

        function startPush() {
            if (typeof signalR === 'undefined' || !window.Promise)
                return;

            var connection;

            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl(liveHubUrl)
                    .withAutomaticReconnect()
                    .configureLogging(signalR.LogLevel.None)
                    .build();
            } catch (err) {
                return;
            }

            function watch() {
                return connection.invoke('@nameof(LiveHub.Watch)', serverPublicId)
                    .then(function (watching) {
                        setPushConnected(watching === true);
                    })
                    .catch(function () {
                        setPushConnected(false);
                    });
            }

            var retryTimer = null;

            function retry() {
                if (retryTimer)
                    return;

                retryTimer = setTimeout(function () {
                    retryTimer = null;
                    connect();
                }, liveHubRetry);
            }

            function connect() {
                if (connection.state !== signalR.HubConnectionState.Disconnected)
                    return;

                connection.start().then(watch, retry);
            }

            connection.on('@AppConsts.LiveHubChangedMethod', function (changes) {
                $.each(changes || [], function (index, change) {
                    var refresher = refreshers[change];

                    if (refresher)
                        refresher.run();
                });
            });

            connection.onreconnecting(function () {
                setPushConnected(false);
            });

            connection.onreconnected(watch);

            connection.onclose(function () {
                setPushConnected(false);
                retry();
            });

            connect();
        }

        function sendMessage() {
            var message = $('#message').val().trim();
            if (!message)
                return;

            $.ajax({
                url: serverUrl + '/chat',
                type: 'POST',
                data: { message: message, __RequestVerificationToken: $('#chatForm input[name="__RequestVerificationToken"]').val() },
                success: function (result, statusCode) {
                    if (result?.success || statusCode == 'nocontent') {
                        refreshFeed();
                        $('#message').val('');
                        $('button[type="submit"]').prop('disabled', true);
                    } else {
                        alert(result?.errorMessage ?? statusCode);
                    }
                },
                error: function (jqXHR) {
                    if (jqXHR.status === 403) {
                        alert(jqXHR.responseJSON?.errorMessage ?? @Json.Serialize(L["You have been banned from the chat."].Value));
                        location.reload();
                    } else {
                        alert(jqXHR.responseJSON?.errorMessage ?? jqXHR.statusText);
                    }
                }
            });
        }

        terminal.apply = function (command) {
            $('#message').val(command);
            $('button[type="submit"]').prop('disabled', false);

            if (!confirm(@Json.Serialize(L["Are you sure you want to execute the following command?"].Value) + '\n\n' + command))
                return false;

            $("#chatForm").submit();

            return true;
        };

        $(document).ready(function () {
            feedAfter = lastFeedSequence($('#feed p[data-feed-sequence]'));

            refreshAll();
            startPush();

            var savedFilter = 'all';

            try { 
                savedFilter = localStorage.getItem('feedFilter') || 'all'; 
            } 
            catch (err) {
                console.warn('Unable to access localStorage:', err);
            }

            $('#feed-filter-label').text($('#feed-filter-menu a[data-filter="' + savedFilter + '"]').text());

            applyFeedFilter();

            $('#feed').scrollTop($('#feed')[0].scrollHeight);

            $('#feed-filter-menu a').on('click', function (e) {
                e.preventDefault();

                var mode = $(this).data('filter');

                try {
                    localStorage.setItem('feedFilter', mode);
                } catch (err) {
                    console.warn('Unable to access localStorage:', err);
                }

                $('#feed-filter-label').text($(this).text());
                applyFeedFilter();
                $('#feed').scrollTop($('#feed')[0].scrollHeight);
            });

             $('#chatForm').on('submit', function () {
                sendMessage();
            });

             $('#message').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            $('#message').on('input', function() {
                var message = $('#message').val().trim();
                $('button[type="submit"]').prop('disabled', message.length === 0);
            });
        });
    </script>
}

<h4 class="text-center">@L["Server"]</h4>

@if (!Model.SingleServer)
{
    <div class="text-center">
        <ul id="server-picker" class="nav nav-pills server-switch">
            @foreach (var other in Model.Servers)
            {
                <li role="presentation" class="@(other.Id == card.Server.Id ? "active" : null)">
                    <a href="@AppConsts.ServersUrl/@other.PublicId">@other.Name</a>
                </li>
            }
        </ul>
    </div>
}

<div id="game-info-header">
    @await Html.PartialAsync("_Header", card)
</div>

<div id="game-info-players">
    @await Html.PartialAsync("_Players", card)
</div>

<div id="@(Model.SingleServer ? "game-info-chat" : null)" class="row @(Model.SingleServer ? null : "game-info-chat-own")" style="margin-top: 20px; @(card.AnyPlayerConnected ? string.Empty : "display: none")">
    <div class="col-md-6 col-sm-12">
        <div class="panel panel-default">
            <div class="panel-heading feed-heading">
                <span>@L["Chat messages"]</span>
                <div class="dropdown">
                    <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                        <span id="feed-filter-label">@L["All"]</span>
                        <span class="caret"></span>
                    </button>
                    <ul id="feed-filter-menu" class="dropdown-menu dropdown-menu-right">
                        <li>
                            <a href="#" data-filter="all">@L["All"]</a>
                        </li>
                        <li>
                            <a href="#" data-filter="events">@L["Events"]</a>
                        </li>
                        <li>
                            <a href="#" data-filter="messages">@L["Messages"]</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="panel-body">
                <div id="feed" style="margin-bottom: 20px">
                    @await Html.PartialAsync("_Feed", Model.Feed)
                </div>
                @if (!Model.ChatEnabled)
                {
                }
                else if (chatBan != null)
                {
                    <p class="text-danger" style="margin: 0">
                        <strong>@L["You have been banned from the chat."]</strong>
                        @if (!string.IsNullOrWhiteSpace(chatBan.Reason))
                        {
                            <text> @L["Reason"]: @chatBan.Reason</text>
                        }
                    </p>
                }
                else if (CurrentUser.IsAuthenticated)
                {
                    <form id="chatForm" class="form-inline" onsubmit="return false;">
                        @Html.AntiForgeryToken()
                        <div class="input-group" style="width: 100%">
                            <input type="text" id="message" name="message" class="form-control" maxlength="@((await ChatSettings.GetAsync<SiteChatSettings>()).MaxMessageLength)" placeholder="@L["Type your message"]"/>
                            @if (Model.Administrator && Model.RemoteCommandsEnabled)
                            {
                                <div class="input-group-btn">
                                    <button type="button" class="btn btn-info btn-block" onclick="terminal.show()">
                                        <img src="~/imgs/icons/terminal.png" alt="@L["Terminal"]" class="icon" data-toggle="tooltip" data-placement="top" title="@L["Terminal"]"/>
                                    </button>
                                </div>
                            }
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary btn-block" disabled>
                                    @L["Send"]
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <a href="/login?returnUrl=@returnUrl" class="btn btn-default btn-block">
                        <img src="~/imgs/steam.png" alt="@L["Login with Steam"]" title="@L["Login with Steam"]" class="img-responsive img-header-icon">
                        @L["Sign in with Steam to use the chat."]
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (card.ConnectUrl != null)
{
    <div class="row hide-mobile">
        <div class="col-md-12 text-center">
            <a href="@card.ConnectUrl" class="btn btn-sm btn-primary" style="margin: 10px">
                connect @card.ServerIp
            </a>
        </div>
    </div>
}

@{
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var copyIcon = light ? AppConsts.CopyIconLight : AppConsts.CopyIconDark;
}

<div id="server-info-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Server info"]</h4>
            </div>
            <div class="modal-body">
                <table class="table table-condensed">
                    <tbody>
                    @if (!string.IsNullOrEmpty(card.ServerIp))
                    {
                        <tr>
                            <th class="text-nowrap">
                                IP
                                <span class="label label-success" style="margin-left: 5px">@L["Recommended"]</span>
                            </th>
                            <td class="line-break-anywhere">
                                <code>connect @card.ServerIp</code>
                                <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                                     data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                                     onclick="copyTextToClipboard('connect @card.ServerIp', this)"/>
                            </td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(card.ServerDns))
                    {
                        <tr>
                            <th class="text-nowrap">
                                DNS
                                <span class="label label-default" style="margin-left: 5px">@L["Alternative"]</span>
                            </th>
                            <td class="line-break-anywhere">
                                <code>connect @card.ServerDns</code>
                                <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                                     data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                                     onclick="copyTextToClipboard('connect @card.ServerDns', this)"/>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                @if (!string.IsNullOrEmpty(card.ServerDns))
                {
                    <p class="text-muted" style="margin-bottom: 0">
                        <small>@L["Prefer the IP: some chats (like Steam's) may turn the DNS into a link and break the connect command. The DNS is an alternative — it stays the same even if the server's IP changes."]</small>
                    </p>
                }
            </div>
        </div>
    </div>
</div>
