@model LiveFeedViewModel

@foreach (var item in Model.Items)
{
    <p data-feed-when="@item.Ticks" data-feed-sequence="@item.Sequence" data-feed-kind="@(item is LiveChatMessage ? AppConsts.FeedKindMessage : AppConsts.FeedKindEvent)" title="@LiveDisplay.Time(item.When, Model.TimeZone)">
        @await Html.PartialAsync(item is LiveChatMessage ? AppConsts.FeedMessagePartial : string.Format(AppConsts.FeedEventPartialFormat, item.GetType().Name), item)
    </p>
}
