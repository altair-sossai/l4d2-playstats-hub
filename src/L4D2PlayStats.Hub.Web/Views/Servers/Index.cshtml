@model ServerListViewModel
@inject ISettingsService Settings

@{
    var site = await Settings.GetAsync<SiteSettings>();

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Servers"],
        Description = L["Follow the {0} servers: map, score, and connected players of each one.", site.Name]
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/servers-index.css" asp-append-version="true"/>
}

@section Scripts {
    <script type="application/json" id="servers-index-config">{ "values": { "serversUrl": @Json.Serialize(AppConsts.ServersUrl), "serverPickerRefreshInMilliseconds": @Json.Serialize(AppConsts.ServerPickerRefreshInMilliseconds), "livePageRequestTimeoutInMilliseconds": @Json.Serialize(AppConsts.LivePageRequestTimeoutInMilliseconds) } }</script>
    <script src="~/js/pages/servers-index.js" asp-append-version="true"></script>
}

<h4 class="text-center">@L["Servers"]</h4>

<div id="server-cards">
    @await Html.PartialAsync("_Cards", Model)
</div>
