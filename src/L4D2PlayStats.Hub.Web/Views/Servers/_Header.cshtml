@model ServerCardViewModel

@{
    var gameInfo = Model.Snapshot;
    var configuration = gameInfo.Configuration;
    var round = gameInfo.Round;
    var scoreboard = gameInfo.Scoreboard;

    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var copyIcon = light ? AppConsts.CopyIconLight : AppConsts.CopyIconDark;
}

<div class="panel panel-default">
    <div class="panel-heading text-center">
        @{
            var header = new List<string>();

            if (!string.IsNullOrEmpty(Model.Name))
                header.Add(Model.Name);

            if (configuration != null && !string.IsNullOrEmpty(configuration.Name))
                header.Add(configuration.Name);

            if (configuration is { TeamSize: > 0 })
                header.Add($"{configuration.TeamSize}v{configuration.TeamSize}");
        }

        @string.Join(" - ", header)

        @if (round?.AntiCheatStatus is { } antiCheatStatus)
        {
            var (antiCheatLabel, antiCheatText, antiCheatTooltip) = antiCheatStatus switch
            {
                AntiCheatStatus.Enabled => ("success", L["Anti-Cheat on"], L["Only players running a validated anti-cheat client can play"]),
                AntiCheatStatus.ApiUnavailable => ("warning", L["Anti-Cheat API down"], L["The server cannot reach the anti-cheat API, so nobody is being blocked right now"]),
                _ => ("default", L["Anti-Cheat off"], L["Anyone can play; the anti-cheat only records who is running it"])
            };

            <a href="@(Model.AntiCheatPage ? AppConsts.AntiCheatUrl : null)" style="margin-left: 5px; text-decoration: none">
                <span class="label label-@antiCheatLabel" data-toggle="tooltip" data-placement="bottom" title="@antiCheatTooltip">
                    <span class="glyphicon glyphicon-lock"></span>
                    @antiCheatText
                </span>
            </a>
        }
    </div>

    <table class="table table-condensed table-responsive">
        <tbody>
        <tr>
            <th class="slim text-right text-nowrap" style="padding-left: 8px">
                @L["Server IP"]
                <button type="button" class="btn btn-link btn-xs" style="padding: 0" data-toggle="tooltip" data-placement="top"
                        title="@L["Server info"]" onclick="$('#server-info-modal').modal('show')">
                    <span class="glyphicon glyphicon-question-sign"></span>
                </button>:
            </th>
            <td data-label="@L["Server IP"]:">
                @Model.ServerIp

                @if (!string.IsNullOrEmpty(Model.ServerIp))
                {
                    <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                         data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                         onclick="copyTextToClipboard('connect @Model.ServerIp', this)"/>
                }
            </td>

            <th class="slim text-right">@L["Players"]:</th>
            <td data-label="@L["Players"]:">
                @Model.Players.ToString("N0") / @Model.MaxPlayers.ToString("N0")
            </td>

            <th class="slim text-right">@L["Map"]:</th>
            <td data-label="@L["Map"]:">
                @{
                    var map = new List<string>();
                    var campaign = Model.Campaign;

                    if (!string.IsNullOrEmpty(campaign))
                        map.Add(campaign);

                    if (!string.IsNullOrEmpty(Model.Map))
                        map.Add(Model.Map);

                    if (round != null)
                        map.Add((round.InSecondHalfOfRound ? L["2nd round"] : L["1st round"]).Value);
                }

                @string.Join(" - ", map)

                @if (round?.IsInPause == true)
                {
                    <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Paused"]" style="margin-left: 5px">
                        @L["Paused"]
                    </span>
                }
                else if (round?.IsInReady == true)
                {
                    <span class="label label-info" data-toggle="tooltip" data-placement="top" title="@(L["Starting"])..." style="margin-left: 5px">
                        @(L["Starting"])...
                    </span>
                }
                else if (round?.IsInReady == false)
                {
                    <span class="label label-success" data-toggle="tooltip" data-placement="top" title="@L["Started"]" style="margin-left: 5px">
                        @L["Started"]
                    </span>
                }
            </td>
        </tr>
        <tr>
            @{
                var survivorScore = scoreboard?.SurvivorScore ?? 0;
                var infectedScore = scoreboard?.InfectedScore ?? 0;
                var labelSurvivor = scoreboard?.IsDraw == true ? "default" : scoreboard?.IsSurvivorsWinning == true ? "success" : "danger";
                var labelInfected = scoreboard?.IsDraw == true ? "default" : scoreboard?.IsInfectedsWinning == true ? "success" : "danger";
            }
            <th class="text-right">@L["Scoreboard"]:</th>
            <td data-label="@L["Scoreboard"]:" class="text-nowrap">
                <span class="label label-@labelSurvivor" data-toggle="tooltip" data-placement="top" title="@L["Survivors"]" style="margin-left: 5px">
                    @survivorScore.ToString("N0")
                </span>
                <span class="label label-@labelInfected" data-toggle="tooltip" data-placement="top" title="@L["Infecteds"]" style="margin-left: 5px">
                    @infectedScore.ToString("N0")
                </span>
                @if (scoreboard?.Comeback is > 0)
                {
                    <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Difference"]" style="margin-left: 5px">
                        @scoreboard.Comeback.ToString("N0")
                    </span>
                }
            </td>

            <th class="text-right text-nowrap">@L["Progress points"]:</th>
            <td data-label="@L["Progress points"]:" class="text-nowrap">
                @{
                    var currentProgressPoints = scoreboard?.CurrentProgressPoints ?? 0;
                    var maxChapterProgressPoints = round?.MaxChapterProgressPoints ?? 0;
                    var progressPercentage = maxChapterProgressPoints == 0 ? 0 : currentProgressPoints / (decimal)maxChapterProgressPoints;
                }
                @currentProgressPoints.ToString("N0")
                <span> / </span>
                @maxChapterProgressPoints.ToString("N0")
                <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Progress points"] %">
                    @progressPercentage.ToString("P0")
                </span>
            </td>

            <th class="text-right">@L["Bonus"]:</th>
            <td data-label="@L["Bonus"]:" class="text-nowrap">
                @((scoreboard?.Bonus ?? 0).ToString("N0"))
                <span> / </span>
                @((scoreboard?.MaxBonus ?? 0).ToString("N0"))
                <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@L["Bonus"] %">
                    @((scoreboard?.BonusPercentage ?? 0).ToString("P0"))
                </span>
            </td>
        </tr>
        <tr>
            <th class="text-right">@L["Progress"]:</th>
            <td data-label="@L["Progress"]:" class="text-nowrap">
                @((scoreboard?.CurrentProgress ?? 0).ToString("P0"))
            </td>

            <th class="text-right text-nowrap">@L["Tank"]:</th>
            <td data-label="@L["Tank"]:">
                @if (round?.TankDisabled == true)
                {
                    <span class="label label-default">
                        @L["Disabled"]
                    </span>
                }
                else
                {
                    @((round?.TankPercent ?? 0).ToString("P0"))
                    if (scoreboard?.IsTankInPlay == true)
                    {
                        <span class="label label-info" data-toggle="tooltip" data-placement="top" title="@L["Alive"]" style="margin-left: 5px">
                            @L["Alive"]
                        </span>
                    }
                    else if (scoreboard?.TankIsDead == true)
                    {
                        <span class="label label-danger" data-toggle="tooltip" data-placement="top" title="@L["Dead"]" style="margin-left: 5px">
                            @L["Dead"]
                        </span>
                    }
                }
            </td>

            <th class="text-right text-nowrap">@L["Witch"]:</th>
            <td data-label="@L["Witch"]:">
                @if (round?.WitchDisabled == true)
                {
                    <span class="label label-default">
                        @L["Disabled"]
                    </span>
                }
                else
                {
                    @((round?.WitchPercent ?? 0).ToString("P0"))
                }
            </td>
        </tr>
        </tbody>
    </table>
</div>
