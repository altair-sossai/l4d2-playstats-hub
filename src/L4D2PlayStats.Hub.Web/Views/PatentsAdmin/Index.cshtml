@model L4D2PlayStats.Hub.Web.Models.Ranking.PatentsAdminViewModel
@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts
@{
    ViewData["Title"] = L["Patents"].Value;
    var scale = Model.Scale;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .pa-table img {
            width: 32px;
            height: 32px;
        }

        .pa-table .pa-xp {
            font-variant-numeric: tabular-nums;
        }
    </style>
}

<div class="admin-header">
    <h3>@L["Patents"]</h3>
    <a class="btn btn-default" href="/patents">
        <span class="glyphicon glyphicon-list"></span> @L["Patents page"]
    </a>
</div>

<p class="text-muted">@L["The 15 levels and their names are fixed. Here you set the experience the highest level, Global, needs; the other levels follow the same curve, and every page of the site uses the new values right away."]</p>
<p class="text-muted">@L["The patent icons inside the game are turned on and off on the game server, with patent_icon_enabled in its configuration files."]</p>

<form method="post" asp-antiforgery="true" action="@AppConsts.AdminPatentsUrl">
    <div class="row">
        <div class="col-lg-8">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="form-group">
                        <label for="MaxExperience">@L["Experience of the highest level"] @FieldHelp.More(L["The experience a player needs to reach level 15, Global. The default is 2,500."], L["Experience of the highest level"], L["Each level needs the experience of the highest level times ((level - 1) / 14)², rounded down to a multiple of 10. Level 1 always starts at 0.\nRaising the value makes every level harder to reach; lowering it makes them easier. The patents of the players change at once on every page, also for the matches already played.\nThe preview below shows the experience of each level with the value you type."])</label>
                        <input class="form-control" id="MaxExperience" name="MaxExperience" type="number" required min="@CoreConsts.PatentMaxExperienceMinimum" max="@CoreConsts.PatentMaxExperienceMaximum" step="@CoreConsts.PatentExperienceRounding" value="@scale.MaxExperience">
                        <span class="help-block">@L["Default: {0}.", Display.Number(CoreConsts.PatentMaxExperience)]</span>
                    </div>

                    <table class="table table-striped table-condensed table-bordered admin-table pa-table" style="margin-bottom: 0">
                        <thead>
                        <tr>
                            <th class="text-center">@L["Level"]</th>
                            <th class="hide-mobile"></th>
                            <th>@L["Patent"]</th>
                            <th class="text-right">@L["Experience"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var patent in scale.All.OrderByDescending(patent => patent.Level))
                        {
                            <tr>
                                <td class="text-center vertical-align-middle slim" data-label="@L["Level"]">@patent.Level</td>
                                <td class="text-center vertical-align-middle slim hide-mobile"><img src="@patent.Image" alt="@patent.Name"></td>
                                <td class="vertical-align-middle" data-label="@L["Patent"]">@patent.Name</td>
                                <td class="text-right vertical-align-middle pa-xp" data-label="@L["Experience"]" data-pa-level="@patent.Level">@Display.Number(patent.Experience)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_FormSaveButton")
</form>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('MaxExperience');
            var levels = @scale.All.Count;
            var rounding = @CoreConsts.PatentExperienceRounding;
            var format = new Intl.NumberFormat(document.documentElement.lang || undefined);

            function refresh() {
                var max = parseInt(input.value, 10);

                if (isNaN(max) || max <= 0)
                    return;

                document.querySelectorAll('[data-pa-level]').forEach(function (cell) {
                    var level = parseInt(cell.getAttribute('data-pa-level'), 10);
                    var value = Math.floor(Math.pow((level - 1) / (levels - 1), 2) * max / rounding) * rounding;

                    cell.textContent = format.format(value);
                });
            }

            input.addEventListener('input', refresh);
        })();
    </script>
}
