@model ChatBansModel
@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts

@{
    ViewData["Title"] = L["Chat Bans"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Bans, number => QueryUrl.Build(AppConsts.ChatBansUrl, (AppConsts.SearchQuery, Model.Query), (AppConsts.AdminPageQuery, number)));
    var tabs = new AdminTabsModel(
    [
        new AdminTab(AppConsts.ChatBansListTab, L["Bans"].Value, "ban-circle"),
        new AdminTab(AppConsts.ChatBansLimitsTab, L["Limits"].Value, "dashboard")
    ], AdminTabs.Active(Context.Request.Query[AppConsts.AdminTabQuery], AppConsts.ChatBansListTab, AppConsts.ChatBansLimitsTab));
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <link rel="stylesheet" href="~/css/pages/chat-bans.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="admin-header">
    <h3>@L["Chat Bans"]</h3>
</div>

<p class="text-muted">@L["Players banned from the chat cannot send messages from the site to the game servers. Click a ban to see its details, edit the reason or remove it."]</p>

<div class="admin-stats">
    <div>
        <strong>@Model.TotalBans.ToString("N0", culture)</strong>
        <small>@L["players banned from the chat"]</small>
    </div>
</div>

@if (TempData[AppConsts.LimitsSavedTempData] != null)
{
    <div class="alert alert-success">@L["Saved."]</div>
}

@await Html.PartialAsync("_AdminTabs", tabs)

<div class="tab-content">
    <div role="tabpanel" class="@AdminTabs.Pane(tabs, AppConsts.ChatBansListTab)" id="@AdminTabs.PaneId(AppConsts.ChatBansListTab)">
        <div class="admin-toolbar">
            <form method="get" class="admin-filters">
                <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@L["Search by name, Steam ID or reason..."]"/>
                <button type="submit" class="btn btn-default">
                    <span class="glyphicon glyphicon-search"></span> @L["Search"]
                </button>
                @if (!string.IsNullOrEmpty(Model.Query))
                {
                    <a class="btn btn-link" href="@AppConsts.ChatBansUrl">@L["Clear filters"]</a>
                }
            </form>
            <div class="admin-toolbar-actions">
                <button type="button" class="btn btn-primary cb-add">
                    <span class="glyphicon glyphicon-plus"></span> @L["Add"]
                </button>
            </div>
        </div>

        <div class="admin-list">
            @if (Model.Bans.Items.Count == 0)
            {
                <div class="admin-empty">@L["No chat bans found."]</div>
            }
            @foreach (var ban in Model.Bans.Items)
            {
                var name = DisplayNames.Apply(ban.CommunityId, string.IsNullOrWhiteSpace(ban.Name) ? ban.CommunityId : ban.Name);
                var bannedAt = Display.DateTime(ban.CreatedAtUtc, Model.TimeZone);
                var updatedAt = ban.UpdatedAtUtc == null ? null : Display.DateTime(ban.UpdatedAtUtc.Value, Model.TimeZone);

                <div class="admin-item cb-ban"
                     data-community-id="@ban.CommunityId" data-name="@name" data-stored-name="@ban.Name" data-avatar="@ban.AvatarUrl" data-steam-id="@ban.SteamId"
                     data-profile-url="@ban.ProfileUrl" data-reason="@ban.Reason" data-banned-at="@bannedAt" data-updated-at="@updatedAt"
                     data-banned-by="@DisplayNames.Apply(ban.CreatedByCommunityId, ban.CreatedByName)">
                    <img class="admin-avatar" src="@ban.AvatarUrl" alt="@name" onerror="imgOnError(this)"/>
                    <div class="admin-main">
                        <div class="admin-title">@name</div>
                        <small title="SteamID64: @ban.CommunityId">@ban.SteamId</small>
                        <small class="cb-reason">@(string.IsNullOrWhiteSpace(ban.Reason) ? L["No reason given"].Value : ban.Reason)</small>
                    </div>
                    <div class="admin-side">
                        <strong>@bannedAt</strong>
                        @if (!string.IsNullOrWhiteSpace(ban.CreatedByName))
                        {
                            <small>@string.Format(L["by {0}"].Value, DisplayNames.Apply(ban.CreatedByCommunityId, ban.CreatedByName))</small>
                        }
                    </div>
                </div>
            }
        </div>

        @await Html.PartialAsync("_Pagination", pagination)
    </div>

    <div role="tabpanel" class="@AdminTabs.Pane(tabs, AppConsts.ChatBansLimitsTab)" id="@AdminTabs.PaneId(AppConsts.ChatBansLimitsTab)">
        <div class="row">
            <div class="col-lg-8">
                <form method="post" action="/admin/chat-bans/limits">
                    @Html.AntiForgeryToken()
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <h3 class="panel-title">
                                <span class="glyphicon glyphicon-time"></span> @L["Limits of the messages sent from the site"]
                            </h3>
                        </div>
                        <div class="panel-body">
                            <div class="row cb-limits">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="GlobalCooldownInSeconds">@L["Seconds between any two messages"] @FieldHelp.More(L["After any message from the site, nobody can send another one to the same game server for this many seconds."], L["Seconds between any two messages"], L["It is a pause shared by everyone on the same game server, so the game chat is not flooded when many people write at once. Each game server has its own pause.\nAdministrators are not held by it.\n0 turns it off."])</label>
                                        <input class="form-control" id="GlobalCooldownInSeconds" name="GlobalCooldownInSeconds" type="number" min="0" max="@CoreConsts.SiteChatMaxCooldownInSeconds" value="@Model.Limits.GlobalCooldownInSeconds">
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="UserCooldownInSeconds">@L["Seconds between two messages of the same player"] @FieldHelp.More(L["After sending a message, the same player waits this many seconds before sending another one to that game server."], L["Seconds between two messages of the same player"], L["It stops one player from sending a message after another. It works together with the pause between any two messages: a message goes out only when both pauses are over.\nAdministrators are not held by it.\n0 turns it off."])</label>
                                        <input class="form-control" id="UserCooldownInSeconds" name="UserCooldownInSeconds" type="number" min="0" max="@CoreConsts.SiteChatMaxCooldownInSeconds" value="@Model.Limits.UserCooldownInSeconds">
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label for="MaxMessageLength">@L["Maximum characters per message"] @FieldHelp.Tip(L["Longer messages are refused. The game chat does not take more than 200 characters."])</label>
                                        <input class="form-control" id="MaxMessageLength" name="MaxMessageLength" type="number" min="@CoreConsts.SiteChatMinMessageLength" max="@CoreConsts.SiteChatMaxMessageLength" value="@Model.Limits.MaxMessageLength">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @await Html.PartialAsync("_FormSaveButton")
                </form>
            </div>
        </div>
    </div>
</div>

<div id="cb-details-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Ban details"]</h4>
            </div>
            <div class="modal-body">
                <div class="admin-details">
                    <img class="cb-avatar cb-details-avatar" src="" alt="" onerror="imgOnError(this)"/>
                    <dl>
                        <dt>@L["Player"]</dt>
                        <dd>
                            <a class="cb-player-link" href="#"></a><br/>
                            <small class="cb-ids text-muted"></small><br/>
                            <a class="cb-steam-link" href="#" target="_blank" rel="noopener noreferrer">@L["Steam profile"]</a>
                        </dd>
                        <dt>@L["Ban date"]</dt>
                        <dd class="cb-banned-at"></dd>
                        <dt class="cb-updated-at-label">@L["Updated at"]</dt>
                        <dd class="cb-updated-at"></dd>
                        <dt class="cb-banned-by-label">@L["Banned by"]</dt>
                        <dd class="cb-banned-by"></dd>
                    </dl>
                </div>
                <div class="form-group">
                    <label for="cb-details-reason">@L["Reason"] @FieldHelp.Tip(L["Optional, up to 300 characters. The banned player sees it on the live page, in place of the chat box."])</label>
                    <textarea id="cb-details-reason" class="form-control" rows="3"></textarea>
                </div>
                <div class="alert alert-warning admin-confirm cb-remove-confirm">@L["Are you sure you want to remove this chat ban?"]</div>
                <div class="cb-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger pull-left cb-remove">
                    <span class="glyphicon glyphicon-trash"></span> @L["Remove ban"]
                </button>
                <button type="button" class="btn btn-danger pull-left cb-remove-yes" style="display: none">@L["Confirm removal"]</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-primary cb-save-reason">
                    <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="cb-add-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Add a chat ban"]</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cb-add-name"/>
                <div class="form-group">
                    <label for="cb-add-player">@L["Steam ID or profile URL"] @FieldHelp.Tip(L["A SteamID64, a Steam ID such as STEAM_1:0:123 or [U:1:123], or a profile link such as https://steamcommunity.com/profiles/76561198000000000."])</label>
                    <div class="input-group">
                        <input type="text" id="cb-add-player" class="form-control" placeholder="76561198000000000"/>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-default cb-pick-player">
                                <span class="glyphicon glyphicon-user"></span> @L["Choose from the list"]
                            </button>
                        </span>
                    </div>
                    <div class="cb-picked text-muted" style="margin-top: 6px"></div>
                </div>
                <div class="form-group">
                    <label for="cb-add-reason">@L["Reason"] @FieldHelp.Tip(L["Optional, up to 300 characters. The banned player sees it on the live page, in place of the chat box."])</label>
                    <textarea id="cb-add-reason" class="form-control" rows="2"></textarea>
                </div>
                <label>@L["Recent chat senders"] @FieldHelp.Tip(L["Who wrote in the site chat in the last hour, with their message. Click one to fill in the player; a player who is already banned cannot be chosen."])</label>
                <div class="list-group cb-recent" style="max-height: 240px; overflow-y: auto"></div>
                <div class="cb-add-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-primary cb-add-save">
                    <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                </button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PlayerPickerModal")

@section Scripts {
    <script>
        var HubPage = {
            texts: {
                required: @Json.Serialize(L["Steam ID or profile URL"].Value),
                saved: @Json.Serialize(L["Ban saved. Reloading..."].Value),
                removed: @Json.Serialize(L["Ban removed. Reloading..."].Value),
                noRecent: @Json.Serialize(L["Nobody sent a message recently."].Value),
                alreadyBanned: @Json.Serialize(L["Already banned"].Value),
                error: @Json.Serialize(L["Something went wrong. Reload the page and try again."].Value)
            },
            playerUrl: @Json.Serialize(AppConsts.PlayerUrlPrefix),
            lookupUrl: @Json.Serialize(AppConsts.PlayerLookupUrl)
        };
    </script>
    <script src="~/js/pages/chat-bans.js" asp-append-version="true"></script>
}
