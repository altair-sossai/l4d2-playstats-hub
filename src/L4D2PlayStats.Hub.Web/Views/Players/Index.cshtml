@model PlayersModel
@inject ICurrentUser CurrentUser
@inject ISettingsService Settings

@{
    var site = await Settings.GetAsync<SiteSettings>();
    var topPlayer = Model.Players.Items.FirstOrDefault();
    var seasonId = Model.Period.Query;
    var pagination = Model.Summary
        ? PaginationModel.Of(Model.Players, number => PlayerUrls.Summary(Model.Sort, Model.Asc, seasonId, number))
        : PaginationModel.Of(Model.Players, number => PlayerUrls.List(Model.OrderBy!.Value, Model.Asc, seasonId, number));

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Players"],
        Description = L["Browse statistics for {0} players from the {1} server.", Model.Players.TotalItems, site.Name],
        Image = topPlayer == null ? null : $"/avatar/{topPlayer.CommunityId}",
        ImageAlt = topPlayer?.Name
    };

    var statistic = Model.OrderBy ?? PlayerResultProperty.Experience;
    var showPerGame = !Model.Summary && PlayerProperties.HasPerGame(statistic);
    var position = Model.Asc ? Model.Players.TotalItems - Model.Players.FirstItem + 1 : Model.Players.FirstItem;

    string SortUrl(PlayerResultProperty? column)
    {
        return PlayerUrls.Summary(column, column == Model.Sort && !Model.Asc, seasonId);
    }

    string SortArrow(PlayerResultProperty? column)
    {
        return column == Model.Sort ? (Model.Asc ? " ↑" : " ↓") : string.Empty;
    }
}

@section Styles {
    <style>
        table {
            margin-bottom: 0 !important;
        }

        p {
            margin-bottom: 0 !important;
        }

        th {
            vertical-align: middle !important;
        }

        th a {
            white-space: nowrap;
        }

        .place {
            width: 30px;
        }
    </style>
    @await Html.PartialAsync("_PaginationStyles")
}

<h4 class="text-center">@L["Players"]</h4>

<div class="row" style="margin-bottom: 5px">
    <div class="col-md-12">
        <div class="dropdown" style="display: inline-block; vertical-align: top; margin-bottom: 5px">
            <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                @L["Statistic"]: <b>@(Model.Summary ? L["Overview"] : L[PlayerProperties.Title(statistic)])</b>
                <span class="caret"></span>
            </button>
            <ul class="dropdown-menu" style="max-height: 60vh; overflow-y: auto">
                <li class="@(Model.Summary ? "active" : null)">
                    <a href="@PlayerUrls.Summary(null, false, seasonId)">@L["Overview"]</a>
                </li>
                <li role="separator" class="divider"></li>
                @foreach (var property in Enum.GetValues<PlayerResultProperty>())
                {
                    <li class="@(Model.OrderBy == property ? "active" : null)">
                        <a href="@PlayerUrls.List(property, false, seasonId)">
                            @L[PlayerProperties.Title(property)]
                        </a>
                    </li>
                }
            </ul>
        </div>
        @await Html.PartialAsync("_PeriodSelector", new PlayerPeriodSelectorModel(Model.Period, period => Model.Summary ? PlayerUrls.Summary(Model.Sort, Model.Asc, period) : PlayerUrls.List(statistic, Model.Asc, period)))
    </div>
</div>

@if (Model.Summary)
{
    <table class="table table-striped table-hover table-bordered table-condensed" id="table-players-summary">
        <thead>
        <tr>
            <th class="text-center"><a href="@SortUrl(null)">#@SortArrow(null)</a></th>
            <th colspan="2">@L["Player"]</th>
            @foreach (var column in PlayerProperties.SummaryColumns)
            {
                <th class="text-center @(column == PlayerResultProperty.Wins ? null : "hide-mobile")">
                    <a href="@SortUrl(column)">@L[PlayerProperties.Title(column)]@SortArrow(column)</a>
                </th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Players.Items)
        {
            var player = row.Player;

            <tr class="hover @(CurrentUser.ItIsMe(player.CommunityId) ? "it-is-me" : string.Empty)">
                <td class="text-center vertical-align-middle">
                    @switch (player.Position)
                    {
                        case 1:
                            <img src="~/imgs/first-place.png" alt="@L["First place"]" title="@L["First place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        case 2:
                            <img src="~/imgs/second-place.png" alt="@L["Second place"]" title="@L["Second place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        case 3:
                            <img src="~/imgs/third-place.png" alt="@L["Third place"]" title="@L["Third place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        default:
                            @($"#{player.Position:N0}")
                            break;
                    }
                </td>
                <td class="text-center vertical-align-middle slim" style="margin: 0; padding: 0">
                    <a href="@PlayerUrls.Details(player.CommunityId, null, seasonId)" title="@row.Name">
                        <img src="/avatar/@player.CommunityId" alt="@row.Name" title="@row.Name" style="width: 40px; border-radius: 5px; margin: 2px" onerror="imgOnError(this)"/>
                    </a>
                </td>
                <td class="vertical-align-middle">
                    <a href="@PlayerUrls.Details(player.CommunityId, null, seasonId)" title="@row.Name">@row.Name.TruncatePlayerName()</a>
                </td>
                <td class="text-center vertical-align-middle">
                    <p data-toggle="tooltip" data-placement="top" title="@L["Wins"] - @player.WinRate.ToString("P0") @L["Win rate"]">
                        @player.Wins.ToString("N0")
                    </p>
                </td>
                @foreach (var column in PlayerProperties.SummaryColumns.Where(column => column != PlayerResultProperty.Wins))
                {
                    <td class="text-center vertical-align-middle hide-mobile">
                        <p data-toggle="tooltip" data-placement="top" title="@L[PlayerProperties.Title(column)]">
                            @PlayerProperties.Format(column, PlayerProperties.Value(player, column))
                        </p>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <table class="table table-striped table-hover table-bordered table-condensed">
        <thead>
        <tr>
            <th class="text-center slim">#</th>
            <th colspan="2">@L["Player"]</th>
            <th class="text-center">
                <a href="@PlayerUrls.List(statistic, !Model.Asc, seasonId)">
                    @L[PlayerProperties.Title(statistic)]
                    &nbsp;
                    @(Model.Asc ? "↑" : "↓")
                </a>
            </th>
            @if (showPerGame)
            {
                <th class="text-center">@L["Per game"]</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var player in Model.Players.Items)
        {
            var help = PlayerProperties.Help(statistic);

            <tr class="hover @(CurrentUser.ItIsMe(player.CommunityId) ? "it-is-me" : string.Empty)">
                <td class="text-center vertical-align-middle slim">#@position.ToString("N0")</td>
                <td class="text-center vertical-align-middle slim" style="margin: 0; padding: 0">
                    <a href="@PlayerUrls.Details(player.CommunityId, null, seasonId)" title="@player.Name">
                        <img src="/avatar/@player.CommunityId" alt="@player.Name" title="@player.Name" style="width: 40px; border-radius: 5px; margin: 2px" onerror="imgOnError(this)"/>
                    </a>
                </td>
                <td class="vertical-align-middle">
                    <a href="@PlayerUrls.Details(player.CommunityId, null, seasonId)">@player.Name.TruncatePlayerName()</a>
                </td>
                <td class="text-center vertical-align-middle">
                    <p>
                        @PlayerProperties.Format(statistic, player.Value)
                        @if (help != null)
                        {
                            <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@L[help]" aria-label="@L["More information"]"></span>
                        }
                    </p>
                </td>
                @if (showPerGame)
                {
                    <td class="text-center vertical-align-middle">
                        <p>
                            @(player.PerGame?.ToString("N2") ?? "-")
                            <span class="glyphicon glyphicon-info-sign text-muted" tabindex="0" role="button" data-toggle="tooltip" data-trigger="hover focus" data-placement="top" title="@L["Games"]: @player.Games.ToString("N0")" aria-label="@L["Games"]: @player.Games.ToString("N0")"></span>
                        </p>
                    </td>
                }
            </tr>

            position += Model.Asc ? -1 : 1;
        }
        </tbody>
    </table>
}

@await Html.PartialAsync("_Pagination", pagination)
