@if (Model.LastMatches.Any())
{
    <h4 class="text-center">@L["Last matches"]</h4>

    <div class="match">
        @foreach (var match in Model.LastMatches)
        {
            @await Html.PartialAsync("../Matches/_Match", match)
        }
    </div>
}

</div>
