@using System.Text.Encodings.Web
@model PlayerDetailsModel
@inject ISettingsService Settings
@inject ICampaignImageService CampaignImages

@{
    var firstPlayerRanking = Model.FirstPlayerRanking;
    var firstPlayer = firstPlayerRanking.Player;
    var firstPlayerPatentProgress = firstPlayerRanking.PatentProgress;
    var firstPlayerPatent = firstPlayerPatentProgress.Patent;

    var secondPlayerRanking = Model.SecondPlayerRanking;
    var secondPlayer = secondPlayerRanking?.Player;
    var secondPlayerPatentProgress = secondPlayerRanking?.PatentProgress;
    var secondPlayerPatent = secondPlayerPatentProgress?.Patent;

    var seasonId = Model.Period.Query;
    var defaultPunishment = (await Settings.GetAsync<RankingSettings>()).DefaultPunishment;
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var copyIcon = light ? "copy-light.png" : "copy-dark.png";

    string FormatPunishment(int punishment)
    {
        return punishment == 0 ? "0" : $"-{punishment:N0} XP";
    }

    void RenderStreak(RankingPlayer player, bool second, bool showName)
    {
        <div class="streak-row">
            @if (showName)
            {
                <div class="streak-name @(second ? "second" : "text-muted")">@player.MainName</div>
            }
            <div class="streak-tiles">
                @if (player.Results.Count == 0)
                {
                    <small class="text-muted">@Html.Raw("&mdash;")</small>
                }
                else
                {
                    foreach (var result in player.Results)
                    {
                        var cssClass = result switch
                        {
                            MatchOutcome.Win => "streak-win",
                            MatchOutcome.Draw => "streak-draw",
                            _ => "streak-loss"
                        };

                        var title = result switch
                        {
                            MatchOutcome.Win => L["Win"],
                            MatchOutcome.Draw => L["Draw"],
                            _ => L["Loss"]
                        };

                        <span class="streak-tile @cssClass" data-toggle="tooltip" data-placement="top" title="@title"></span>
                    }
                }
            </div>
        </div>
    }
}

<div role="tabpanel" class="tab-pane active" id="general">

<div class="panel panel-default">
    <div class="panel-heading">
        @L["General statistics"]
    </div>

    <table class="table table-hover table-condensed table-responsive">
        <tbody>
        <tr>
            <th>@L["Ranking"]:</th>
            <td data-label="@L["Ranking"]:">
                #@firstPlayer.Position.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">#@secondPlayer.Position.ToString("N0")</span>
                }
            </td>

            <th>@L["Steam ID"]:</th>
            <td data-label="@L["Steam ID"]:" colspan="3">
                @SteamIds.DisplaySteamId(firstPlayer.CommunityId)
                <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                     data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                     onclick="copyTextToClipboard('@SteamIds.DisplaySteamId(firstPlayer.CommunityId)', this)"/>
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">
                        @SteamIds.DisplaySteamId(secondPlayer.CommunityId)
                        <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                             data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                             onclick="copyTextToClipboard('@SteamIds.DisplaySteamId(secondPlayer.CommunityId)', this)"/>
                    </span>
                }
            </td>
        </tr>
        <tr>
            <th>@L["Name"]:</th>
            <td data-label="@L["Name"]:">
                @firstPlayer.MainName
                @if (secondPlayer != null)
                {
                    <br/>
                    <span class="second">@secondPlayer.MainName</span>
                }
            </td>

            <th>@L["Profile URL"]:</th>
            <td data-label="@L["Profile URL"]:" colspan="3">
                <a href="@firstPlayer.ProfileUrl" target="_blank">@firstPlayer.ProfileUrl</a>
                @if (!string.IsNullOrWhiteSpace(firstPlayer.ProfileUrl))
                {
                    @await Html.PartialAsync("_CopyButton", firstPlayer.ProfileUrl)
                }
                @if (secondPlayer != null)
                {
                    <br/>
                    <span class="second">
                        <a href="@secondPlayer.ProfileUrl" target="_blank">
                            @secondPlayer.ProfileUrl
                        </a>
                        @if (!string.IsNullOrWhiteSpace(secondPlayer.ProfileUrl))
                        {
                            @await Html.PartialAsync("_CopyButton", secondPlayer.ProfileUrl)
                        }
                    </span>
                }
            </td>
        </tr>
        @if (firstPlayer.PreviousNames.Any())
        {
            <tr class="previous-names">
                <th>@L["Previous names"]:</th>
                <td data-label="@L["Previous names"]:" colspan="5">
                    @foreach (var previousName in firstPlayer.PreviousNames.Take(AppConsts.PlayerPreviousNamesVisible))
                    {
                        <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@previousName.Name">@previousName.Name</span>
                    }
                    @if (secondPlayer is { PreviousNames: not null } && secondPlayer.PreviousNames.Any())
                    {
                        <span class="separator"> | </span>
                        @foreach (var previousName in secondPlayer.PreviousNames.Take(AppConsts.PlayerPreviousNamesVisible))
                        {
                            <span class="label label-warning" data-toggle="tooltip" data-placement="top" title="@previousName.Name">@previousName.Name</span>
                        }
                    }
                </td>
            </tr>
        }
        @await Html.PartialAsync("_SteamFacts", new PlayerSteamFactsModel(Model.FirstPlayerSteam, Model.SecondPlayerSteam, true))
        <tr class="hide-mobile">
            <th class="vertical-align-middle">@L["Patent"]:</th>
            <td class="vertical-align-middle" data-label="@L["Patent"]:">
                <img src="@firstPlayerPatent.Image" alt="@firstPlayerPatent.FullName" data-toggle="tooltip" data-placement="top" title="@firstPlayer.MainName - @firstPlayerPatent.FullName" style="width: 32px"/>
                @if (secondPlayer != null && secondPlayerPatent != null)
                {
                    <span class="separator"> | </span>
                    <img src="@secondPlayerPatent.Image" alt="@secondPlayerPatent.FullName" data-toggle="tooltip" data-placement="top" title="@secondPlayer.MainName - @secondPlayerPatent.FullName" style="width: 32px"/>
                }
            </td>

            <th class="vertical-align-middle">XP:</th>
            <td class="text-center vertical-align-middle" data-label="XP:" colspan="3">
                <div class="progress" data-toggle="tooltip" data-placement="top" data-html="true" title="@firstPlayer.MainName - @firstPlayerPatentProgress.Tooltip">
                    <div class="progress-bar progress-bar-@firstPlayerPatentProgress.ProgressBarType" role="progressbar" style="width: @firstPlayerPatentProgress.ProgressBarWidth;">
                    </div>
                    <div class="progress-bar progress-bar-@firstPlayerPatentProgress.PreviousExperienceProgressBarType" role="progressbar" style="width: @firstPlayerPatentProgress.PreviousExperienceProgressBarWidth;">
                    </div>
                </div>
                @if (secondPlayer != null && secondPlayerPatentProgress != null)
                {
                    <p></p>
                    <div class="progress" data-toggle="tooltip" data-placement="top" data-html="true" title="@secondPlayer.MainName - @secondPlayerPatentProgress.Tooltip">
                        <div class="progress-bar progress-bar-@secondPlayerPatentProgress.ProgressBarType" role="progressbar" style="width: @secondPlayerPatentProgress.ProgressBarWidth;">
                        </div>
                        <div class="progress-bar progress-bar-@secondPlayerPatentProgress.PreviousExperienceProgressBarType" role="progressbar" style="width: @secondPlayerPatentProgress.PreviousExperienceProgressBarWidth;">
                        </div>
                    </div>
                }
            </td>
        </tr>
        <tr>
            <th>@L["Games"]:</th>
            <td data-label="@L["Games"]:">
                @firstPlayer.Games.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.Games.ToString("N0")</span>
                }
            </td>
            <th>@L["Wins"]:</th>
            <td data-label="@L["Wins"]:">
                @firstPlayer.Wins.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.Wins.ToString("N0")</span>
                }
            </td>
            <th>@L["Rage quit"]:</th>
            <td data-label="@L["Rage quit"]:">
                @firstPlayer.RageQuit.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.RageQuit.ToString("N0")</span>
                }
            </td>
        </tr>
        <tr>
            <th>@L["Win rate"]:</th>
            <td data-label="@L["Win rate"]:">
                @firstPlayer.WinRate.ToString("P0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.WinRate.ToString("P0")</span>
                }
            </td>
            <th>@L["Loss"]:</th>
            <td data-label="@L["Loss"]:">
                @firstPlayer.Loss.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.Loss.ToString("N0")</span>
                }
            </td>
            <th>@L["Punishment"]:</th>
            <td data-label="@L["Punishment"]:">
                @FormatPunishment(firstPlayer.Punishment)

                @if (Model.Administrator)
                {
                    <button type="button" class="btn btn-link btn-xs" onclick="editPunishment('@(firstPlayer.CommunityId)', '@defaultPunishment')" title="@L["Edit"]" data-toggle="tooltip" data-placement="bottom">
                        @L["Edit"]
                    </button>
                }

                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@FormatPunishment(secondPlayer.Punishment)</span>

                    @if (Model.Administrator)
                    {
                        <button type="button" class="btn btn-link btn-xs" onclick="editPunishment('@(secondPlayer.CommunityId)', '@defaultPunishment')" title="@L["Edit"]" data-toggle="tooltip" data-placement="bottom">
                            @L["Edit"]
                        </button>
                    }
                }
            </td>
        </tr>
        <tr>
            <th>@L["Longest win streak"]:</th>
            <td data-label="@L["Longest win streak"]:">
                @firstPlayer.MaxWinStreak.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.MaxWinStreak.ToString("N0")</span>
                }
            </td>
            <th>@L["Longest loss streak"]:</th>
            <td data-label="@L["Longest loss streak"]:" colspan="3">
                @firstPlayer.MaxLossStreak.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">@secondPlayer.MaxLossStreak.ToString("N0")</span>
                }
            </td>
        </tr>
        <tr>
            <th class="vertical-align-middle">@L["Match history"]:</th>
            <td data-label="@L["Match history"]:" colspan="5">
                @{ RenderStreak(firstPlayer, false, secondPlayer != null); }
                @if (secondPlayer != null)
                {
                    RenderStreak(secondPlayer, true, true);
                }
            </td>
        </tr>
        @if (secondPlayer != null && Model.HeadToHead != null)
        {
            var headToHead = Model.HeadToHead;

            @if (headToHead.TogetherGames > 0)
            {
                <tr>
                    <th class="mobile-row-label">@L["Playing together"]:</th>
                    <td data-label="@L["Games"]:">@headToHead.TogetherGames.ToString("N0") @L["Games"]</td>
                    <th>@L["Wins"]:</th>
                    <td data-label="@L["Wins"]:">
                        @headToHead.TogetherWins.ToString("N0")
                        <small class="text-muted" data-toggle="tooltip" data-placement="top" title="@L["Win rate"]"> (@headToHead.TogetherWinRate.ToString("P0"))</small>
                    </td>
                    <th>@L["Loss"]:</th>
                    <td data-label="@L["Loss"]:">
                        @headToHead.TogetherLosses.ToString("N0")
                        <small class="text-muted" data-toggle="tooltip" data-placement="top" title="@L["Loss rate"]"> (@headToHead.TogetherLossRate.ToString("P0"))</small>
                    </td>
                </tr>
            }

            @if (headToHead.AgainstGames > 0)
            {
                <tr>
                    <th class="mobile-row-label">@L["Playing against"]:</th>
                    <td data-label="@L["Games"]:">@headToHead.AgainstGames.ToString("N0") @L["Games"]</td>
                    <th>@L["Wins"]:</th>
                    <td data-label="@L["Wins"]:">
                        @headToHead.AgainstWins.ToString("N0")
                        <small class="text-muted" data-toggle="tooltip" data-placement="top" title="@L["Win rate"]"> (@headToHead.AgainstWinRate.ToString("P0"))</small>
                        <span class="separator"> | </span>
                        <span class="second">
                            @headToHead.AgainstLosses.ToString("N0")
                            <small data-toggle="tooltip" data-placement="top" title="@L["Win rate"]"> (@headToHead.AgainstLossRate.ToString("P0"))</small>
                        </span>
                    </td>
                    <th>@L["Loss"]:</th>
                    <td data-label="@L["Loss"]:">
                        @headToHead.AgainstLosses.ToString("N0")
                        <small class="text-muted" data-toggle="tooltip" data-placement="top" title="@L["Loss rate"]"> (@headToHead.AgainstLossRate.ToString("P0"))</small>
                        <span class="separator"> | </span>
                        <span class="second">
                            @headToHead.AgainstWins.ToString("N0")
                            <small data-toggle="tooltip" data-placement="top" title="@L["Loss rate"]"> (@headToHead.AgainstWinRate.ToString("P0"))</small>
                        </span>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@if (Model.RelatedPlayers.Any())
{
    <div class="panel panel-warning">
        <div class="panel-heading">
            @L["Related accounts"]
        </div>

        <table class="table table-hover table-condensed table-responsive">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Steam ID"]</th>
                <th>@L["Last login"]</th>
                <th>@L["Connections"]</th>
                <th>@L["Profile URL"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var relatedPlayer in Model.RelatedPlayers)
            {
                <tr>
                    <td data-label="@L["Name"]:">
                        <img src="/avatar/@relatedPlayer.CommunityId" alt="@relatedPlayer.Name" title="@relatedPlayer.Name" class="img-thumbnail" style="width: 32px; margin-right: 5px" onerror="imgOnError(this)"/>
                        <a href="@PlayerUrls.Details(long.Parse(relatedPlayer.CommunityId), null, seasonId)">@relatedPlayer.Name</a>
                    </td>
                    <td data-label="@L["Steam ID"]:">
                        @SteamIds.DisplaySteamId(long.Parse(relatedPlayer.CommunityId))
                        @if (!string.IsNullOrWhiteSpace(relatedPlayer.SteamId))
                        {
                            @await Html.PartialAsync("_CopyButton", SteamIds.DisplaySteamId(long.Parse(relatedPlayer.CommunityId)))
                        }
                    </td>
                    <td data-label="@L["Last login"]:">@Model.LocalTime(relatedPlayer.LastConnectedAtUtc).ToString("g")</td>
                    <td data-label="@L["Connections"]:">@relatedPlayer.ConnectionCount.ToString("N0")</td>
                    <td data-label="@L["Profile URL"]:">
                        @if (!string.IsNullOrWhiteSpace(relatedPlayer.ProfileUrl))
                        {
                            <a href="@relatedPlayer.ProfileUrl" target="_blank" rel="noopener noreferrer">
                                @relatedPlayer.ProfileUrl
                            </a>
                            @await Html.PartialAsync("_CopyButton", relatedPlayer.ProfileUrl)
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

