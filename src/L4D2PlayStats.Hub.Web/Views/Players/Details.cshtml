        }

        .streak-name {
            font-weight: bold;
            margin-bottom: 3px;
        }

        .streak-tiles {
            line-height: 0;
            font-size: 0;
        }

        .streak-tile {
            display: inline-block;
            width: 12px;
            height: 12px;
            margin: 0 3px 3px 0;
