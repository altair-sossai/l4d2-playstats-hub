@using Microsoft.AspNetCore.Antiforgery
@model PlayerDetailsModel
@inject ISettingsService Settings
@inject IAntiforgery Antiforgery

@{
    var firstPlayerRanking = Model.FirstPlayerRanking;
    var firstPlayer = firstPlayerRanking.Player;

    var secondPlayerRanking = Model.SecondPlayerRanking;
    var secondPlayer = secondPlayerRanking?.Player;

    var site = await Settings.GetAsync<SiteSettings>();
    var seasonId = Model.Period.Query;
    var antiforgeryToken = Model.Administrator ? Antiforgery.GetAndStoreTokens(Context).RequestToken : null;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = secondPlayer == null
            ? $"{firstPlayer.MainName} - {L["Player details"].Value}"
            : $"{firstPlayer.MainName} vs {secondPlayer.MainName}",
        Description = secondPlayer == null
            ? L["See {0}'s statistics: rank #{1}, {2} matches, and {3} wins.", firstPlayer.MainName, firstPlayer.Position, firstPlayer.Games, firstPlayer.Wins]
            : L["Compare {0} and {1}'s performance and statistics on {2}.", firstPlayer.MainName, secondPlayer.MainName, site.Name],
        Image = $"/avatar/{firstPlayer.CommunityId}",
        ImageAlt = firstPlayer.MainName,
        NoIndex = secondPlayer != null,
        OpenGraphType = AppConsts.PlayerOpenGraphType
    };
}

@section Styles {
    @if (Model.Community != null)
    {
        @await Html.PartialAsync("_CommunityStyles", Model.Community)
    }
    <link rel="stylesheet" href="~/css/pages/players-details.css" asp-append-version="true"/>
}

@section Scripts {
    <script type="application/json" id="players-details-config">{ "texts": { "How many experience points should the user lose?": @Json.Serialize(L["How many experience points should the user lose?"].Value), "Remove the punishments of this player in this season?": @Json.Serialize(L["Remove the punishments of this player in this season?"].Value) }, "values": { "antiforgeryHeaders": @Json.Serialize(new Dictionary<string, string> { [AppConsts.AntiforgeryHeader] = antiforgeryToken ?? string.Empty }), "playerSeasonParameter": @Json.Serialize(AppConsts.PlayerSeasonParameter), "seasonId": @Json.Serialize(Model.Period.Season?.Id) } }</script>
    <script src="~/js/pages/players-details.js" asp-append-version="true"></script>
}

<h4 class="text-center">@L["Player details"]</h4>

@if (Model.Period.HasChoices)
{
    <div class="row" style="margin-bottom: 5px">
        <div class="col-md-12">
            @await Html.PartialAsync("_PeriodSelector", new PlayerPeriodSelectorModel(Model.Period, season => PlayerUrls.Details(firstPlayer.CommunityId, secondPlayer?.CommunityId, season)))
        </div>
    </div>
}

<div class="row">
<div class="col-xs-2 left-side text-center">
    <div class="dropdown">
        <button class="btn btn-default btn-sm btn-block dropdown-toggle" type="button" data-toggle="dropdown">
            @firstPlayer.MainName.Truncate(AppConsts.PlayerDropdownNameLength)
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu players-dropdown-menu">
            @foreach (var player in Model.Players.Where(player => player.CommunityId != firstPlayer.CommunityId && player.CommunityId != secondPlayer?.CommunityId))
            {
                <li>
                    <a href="@PlayerUrls.Details(player.CommunityId, secondPlayer?.CommunityId, seasonId)">#@player.Position - @player.MainName</a>
                </li>
            }
        </ul>
    </div>

    <img src="/avatar/@(firstPlayer.CommunityId).jpg" alt="@firstPlayer.MainName" title="@firstPlayer.MainName" class="img-responsive img-thumbnail" style="margin-top: 5px" onerror="imgOnError(this)" data-lity/>
    @if (Model.Community != null)
    {
        @await Html.PartialAsync("_CommunityStanding", Model.Community.First)
    }

    <hr/>

    <div class="dropdown">
        <button class="btn btn-default btn-sm btn-block dropdown-toggle second" type="button" data-toggle="dropdown">
            @(secondPlayer?.MainName.Truncate(AppConsts.PlayerDropdownNameLength) ?? L["Compare..."])
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu players-dropdown-menu">
            @if (secondPlayer != null)
            {
                <li>
                    <a href="@PlayerUrls.Details(firstPlayer.CommunityId, null, seasonId)">
                        <span class="glyphicon glyphicon-remove"></span> @L["Remove comparison"]
                    </a>
                </li>
                <li class="divider"></li>
            }
            @foreach (var player in Model.Players.Where(player => player.CommunityId != firstPlayer.CommunityId && player.CommunityId != secondPlayer?.CommunityId))
            {
                <li>
                    <a href="@PlayerUrls.Details(firstPlayer.CommunityId, player.CommunityId, seasonId)" class="second">
                        #@player.Position - @player.MainName
                    </a>
                </li>
            }
        </ul>
    </div>
    @if (secondPlayer != null)
    {
        <img src="/avatar/@(secondPlayer.CommunityId).jpg" alt="@secondPlayer.MainName" title="@secondPlayer.MainName" class="img-responsive img-thumbnail" style="background-color: #FFBC00; margin-top: 5px" onerror="imgOnError(this)" data-lity/>
        @if (Model.Community?.Second != null)
        {
            @await Html.PartialAsync("_CommunityStanding", Model.Community.Second)
        }
    }
</div>
<div class="col-xs-10 right-side">

<ul class="nav nav-tabs player-tabs" id="player-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#general" role="tab" data-toggle="tab">@L["General"]</a>
    </li>
    <li role="presentation">
        <a href="#campaigns" role="tab" data-toggle="tab">
            @L["Campaigns"] <span class="badge">@Model.Campaigns.Count.ToString("N0")</span>
        </a>
    </li>
    @if (Model.SkinShop)
    {
        <li role="presentation">
            <a href="#skins" role="tab" data-toggle="tab">
                @L["Skins"] <span class="badge">@(((Model.FirstPlayerSkins?.OwnedSkins.Count ?? 0) + (Model.SecondPlayerSkins?.OwnedSkins.Count ?? 0)).ToString("N0"))</span>
            </a>
        </li>
    }
    @if (Model.Relations.Any())
    {
        <li role="presentation">
            <a href="#relations" role="tab" data-toggle="tab">
                @L["Relations"] <span class="badge">@Model.Relations.Count.ToString("N0")</span>
            </a>
        </li>
    }
    @if (Model.Community?.ShowsVotes == true)
    {
        <li role="presentation">
            <a href="#votes-received" role="tab" data-toggle="tab">
                @L["Votes received"] <span class="badge">@Model.Community.ReceivedTotal.ToString("N0")</span>
            </a>
        </li>
        @if (Model.Community.ShowVoters)
        {
            <li role="presentation">
                <a href="#votes-cast" role="tab" data-toggle="tab">
                    @L["Votes cast"] <span class="badge">@Model.Community.CastTotal.ToString("N0")</span>
                </a>
            </li>
        }
    }
</ul>

<div class="tab-content player-tab-content">
@await Html.PartialAsync("_DetailsGeneral", Model)
@await Html.PartialAsync("_DetailsCampaigns", Model)
@await Html.PartialAsync("_DetailsSkins", Model)

@await Html.PartialAsync("_DetailsRelations", Model)

@if (Model.Community?.ShowsVotes == true)
{
    @await Html.PartialAsync("_CommunityVotes", Model.Community)
}

</div>
</div>
</div>
