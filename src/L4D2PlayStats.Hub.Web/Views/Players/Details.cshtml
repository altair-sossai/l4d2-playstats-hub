            }

            .campaign-numbers strong {
                display: block;
                font-size: 18px;
                line-height: 1.2;
            }

            .campaign-numbers small {
                display: block;
                overflow: hidden;
                font-size: 11px;
                white-space: nowrap;
                text-overflow: ellipsis;
                opacity: .7;
            }

        .campaign-win {
            color: #2ea44f;
        }

        .campaign-loss {
            color: #d73a49;
        }

        @@media screen and (max-width: 700px) {
            .player-tabs > li > a {
                padding: 6px 8px;
                font-size: 12px;
            }

            .left-side {
                width: 100% !important;
                margin-bottom: 10px;
            }

            .right-side {
                width: 100% !important;
            }

            .table-responsive th.mobile-row-label {
                display: block !important;
                width: auto;
                white-space: normal;
                text-align: left;
                padding: 5px !important;
                border-bottom: 1px solid #ddd;
            }
        }
    </style>
}

@section Scripts {
    <script>
        function reloadPage() {
            location.reload();
        }

        var punishmentSeasonId = @Json.Serialize(Model.Period.Season.Id);
        var punishmentHeaders = { "@AppConsts.PlayerAntiforgeryHeader": @Json.Serialize(antiforgeryToken ?? string.Empty) };

        function addPunishments(communityId, lostExperiencePoints) {
            var command = { 
                communityId: communityId, 
                lostExperiencePoints: lostExperiencePoints,
                seasonId: punishmentSeasonId
            };

            $.ajax({
                url: "/api/punishments",
                type: "POST",
                contentType: "application/json",
                headers: punishmentHeaders,
                data: JSON.stringify(command)
            }).done(reloadPage);
        }

        function deletePunishments(communityId) {
            $.ajax({
                url: "/api/punishments/" + communityId + "?@AppConsts.PlayerSeasonParameter=" + punishmentSeasonId,
                type: "DELETE",
                headers: punishmentHeaders
            }).done(reloadPage);
        }

        function editPunishment(communityId, punishment) {
            var output = prompt("@Html.Raw(L["How many experience points should the user lose?"])", punishment);

            if (!output)
                return;

            var lostExperiencePoints = +output;

            if (isNaN(lostExperiencePoints))
                return;

            else if (lostExperiencePoints > 0)
                addPunishments(communityId, lostExperiencePoints);

            else if (lostExperiencePoints === 0)
                deletePunishments(communityId);
        }

        $(function () {
            var $tabs = $('#player-tabs a[data-toggle="tab"]');

            $tabs.on('shown.bs.tab', function () {
                history.replaceState(null, '', $(this).attr('href'));
                $(window).trigger('resize');
            });

            if (location.hash)
                $tabs.filter('[href="' + location.hash + '"]').tab('show');

            $('.players-dropdown-menu a, .relation-card-item .panel-heading a, .period-selector .dropdown-menu a').on('click', function () {
                if (location.hash)
                    this.href = this.href.split('#')[0] + location.hash;
            });

            $('#btn-show-more-relations').click(function () {
                var $button = $(this);
                var $cards = $('.relation-card-item');

                if ($cards.hasClass('hidden')) {
                    $cards.removeClass('hidden');
                    $button.text($button.data('less'));
                } else {
                    $cards.each(function (index) {
                        if (index >= $button.data('visible')) {
                            $(this).addClass('hidden');
                        }
                    });
                    $button.text($button.data('more'));
                }
            });
        });
    </script>
}

<h4 class="text-center">@L["Player details"]</h4>

@if (Model.Period.HasChoices)
{
    <div class="row" style="margin-bottom: 5px">
        <div class="col-md-12">
            @await Html.PartialAsync("_PeriodSelector", new PlayerPeriodSelectorModel(Model.Period, season => PlayerUrls.Details(firstPlayer.CommunityId, secondPlayer?.CommunityId, season)))
        </div>
    </div>
}

<div class="row">
<div class="col-xs-2 left-side text-center">
    <div class="dropdown">
        <button class="btn btn-default btn-sm btn-block dropdown-toggle" type="button" data-toggle="dropdown">
            @firstPlayer.MainName.Truncate(AppConsts.PlayerDropdownNameLength)
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu players-dropdown-menu">
            @foreach (var player in Model.Players.Where(player => player.CommunityId != firstPlayer.CommunityId && player.CommunityId != secondPlayer?.CommunityId))
            {
                <li>
                    <a href="@PlayerUrls.Details(player.CommunityId, secondPlayer?.CommunityId, seasonId)">#@player.Position - @player.MainName</a>
                </li>
            }
        </ul>
    </div>

    <img src="/avatar/@firstPlayer.CommunityId" alt="@firstPlayer.MainName" title="@firstPlayer.MainName" class="img-responsive img-thumbnail" style="margin-top: 5px" onerror="imgOnError(this)" data-lity/>

    <hr/>

    <div class="dropdown">
        <button class="btn btn-default btn-sm btn-block dropdown-toggle second" type="button" data-toggle="dropdown">
            @(secondPlayer?.MainName.Truncate(AppConsts.PlayerDropdownNameLength) ?? L["Compare..."])
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu players-dropdown-menu">
            @if (secondPlayer != null)
            {
                <li>
                    <a href="@PlayerUrls.Details(firstPlayer.CommunityId, null, seasonId)">
                        <span class="glyphicon glyphicon-remove"></span> @L["Remove comparison"]
                    </a>
                </li>
                <li class="divider"></li>
            }
            @foreach (var player in Model.Players.Where(player => player.CommunityId != firstPlayer.CommunityId && player.CommunityId != secondPlayer?.CommunityId))
            {
                <li>
                    <a href="@PlayerUrls.Details(firstPlayer.CommunityId, player.CommunityId, seasonId)" class="second">
                        #@player.Position - @player.MainName
                    </a>
                </li>
            }
        </ul>
    </div>
    @if (secondPlayer != null)
    {
        <img src="/avatar/@secondPlayer.CommunityId" alt="@secondPlayer.MainName" title="@secondPlayer.MainName" class="img-responsive img-thumbnail" style="background-color: #FFBC00; margin-top: 5px" onerror="imgOnError(this)" data-lity/>
    }
</div>
<div class="col-xs-10 right-side">

<ul class="nav nav-tabs player-tabs" id="player-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#general" role="tab" data-toggle="tab">@L["General"]</a>
    </li>
    <li role="presentation">
        <a href="#campaigns" role="tab" data-toggle="tab">
            @L["Campaigns"] <span class="badge">@Model.Campaigns.Count.ToString("N0")</span>
        </a>
    </li>
    @if (Model.SkinShop)
    {
    <li role="presentation">
        <a href="#skins" role="tab" data-toggle="tab">
            @L["Skins"] <span class="badge">@(((Model.FirstPlayerSkins?.OwnedSkins.Count ?? 0) + (Model.SecondPlayerSkins?.OwnedSkins.Count ?? 0)).ToString("N0"))</span>
        </a>
    </li>
    }
    @if (Model.Relations.Any())
    {
        <li role="presentation">
            <a href="#relations" role="tab" data-toggle="tab">
                @L["Relations"] <span class="badge">@Model.Relations.Count.ToString("N0")</span>
            </a>
        </li>
    }
</ul>

<div class="tab-content player-tab-content">
<div role="tabpanel" class="tab-pane active" id="general">

<div class="panel panel-default">
    <div class="panel-heading">
        @L["General statistics"]
    </div>

    <table class="table table-hover table-condensed table-responsive">
        <tbody>
        <tr>
            <th>@L["Ranking"]:</th>
            <td data-label="@L["Ranking"]:">
                #@firstPlayer.Position.ToString("N0")
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">#@secondPlayer.Position.ToString("N0")</span>
                }
            </td>

            <th>@L["Steam ID"]:</th>
            <td data-label="@L["Steam ID"]:" colspan="3">
                @SteamIds.DisplaySteamId(firstPlayer.CommunityId)
                <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                     data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                     onclick="copyTextToClipboard('@SteamIds.DisplaySteamId(firstPlayer.CommunityId)', this)"/>
                @if (secondPlayer != null)
                {
                    <span class="separator"> | </span>
                    <span class="second">
                        @SteamIds.DisplaySteamId(secondPlayer.CommunityId)
                        <img src="~/imgs/icons/@copyIcon" alt="@L["Copy"]" class="icon-copy"
                             data-toggle="popover" data-placement="top" data-content="@L["Text copied!"]"
                             onclick="copyTextToClipboard('@SteamIds.DisplaySteamId(secondPlayer.CommunityId)', this)"/>
                    </span>
                }
            </td>
        </tr>
        <tr>
            <th>@L["Name"]:</th>
            <td data-label="@L["Name"]:">
                @firstPlayer.MainName
                @if (secondPlayer != null)
                {
                    <br/>
                    <span class="second">@secondPlayer.MainName</span>
                }
            </td>

            <th>@L["Profile URL"]:</th>
            <td data-label="@L["Profile URL"]:" colspan="3">
                <a href="@firstPlayer.ProfileUrl" target="_blank">@firstPlayer.ProfileUrl</a>
                @if (!string.IsNullOrWhiteSpace(firstPlayer.ProfileUrl))
                {
                    @await Html.PartialAsync("_CopyButton", firstPlayer.ProfileUrl)
                }
                @if (secondPlayer != null)
                {
                    <br/>
                    <span class="second">
                        <a href="@secondPlayer.ProfileUrl" target="_blank">
                            @secondPlayer.ProfileUrl
                        </a>
                        @if (!string.IsNullOrWhiteSpace(secondPlayer.ProfileUrl))
                        {
                            @await Html.PartialAsync("_CopyButton", secondPlayer.ProfileUrl)
                        }
                    </span>
                }
            </td>
        </tr>
        @if (firstPlayer.PreviousNames != null && firstPlayer.PreviousNames.Any())
        {
            <tr class="previous-names">
                <th>@L["Previous names"]:</th>
                <td data-label="@L["Previous names"]:" colspan="5">
                    @foreach (var previousName in firstPlayer.PreviousNames.Take(AppConsts.PlayerPreviousNamesVisible))
                    {
                        <span class="label label-default" data-toggle="tooltip" data-placement="top" title="@previousName.Name">@previousName.Name</span>
                    }
                    @if (secondPlayer is { PreviousNames: not null } && secondPlayer.PreviousNames.Any())
                    {
                        <span class="separator"> | </span>
                        @foreach (var previousName in secondPlayer.PreviousNames.Take(AppConsts.PlayerPreviousNamesVisible))
                        {
                            <span class="label label-warning" data-toggle="tooltip" data-placement="top" title="@previousName.Name">@previousName.Name</span>
                        }
                    }
                </td>
            </tr>
        }
        <tr class="hide-mobile">
            <th class="vertical-align-middle">@L["Patent"]:</th>
            <td class="vertical-align-middle" data-label="@L["Patent"]:">
                <img src="@firstPlayerPatent.Image" alt="@firstPlayerPatent.FullName" data-toggle="tooltip" data-placement="top" title="@firstPlayer.MainName - @firstPlayerPatent.FullName" style="width: 32px"/>
                @if (secondPlayer != null && secondPlayerPatent != null)
                {
                    <span class="separator"> | </span>
                    <img src="@secondPlayerPatent.Image" alt="@secondPlayerPatent.FullName" data-toggle="tooltip" data-placement="top" title="@secondPlayer.MainName - @secondPlayerPatent.FullName" style="width: 32px"/>
                }
            </td>

            <th class="vertical-align-middle">XP:</th>
