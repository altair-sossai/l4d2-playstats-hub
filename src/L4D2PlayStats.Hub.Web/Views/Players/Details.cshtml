@model PlayerViewModel
@{
    ViewData["Title"] = Model.Name;
    var ranked = Model.Ranked;
}
<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <img class="avatar-lg" src="/avatar/@Model.CommunityId" alt="">
    <div class="flex-grow-1">
        <h1 class="h3 mb-1">@Model.Name</h1>
        <div class="text-body-secondary small">
            <a class="link-secondary" href="@SteamIds.ProfileUrl(Model.CommunityId)" rel="noopener" target="_blank">@L["Steam profile"]</a>
            · @SteamIds.SteamId(Model.CommunityId)
            · ★ @Model.Stars @L["stars"]
        </div>
        @if (ranked != null && ranked.PreviousNames.Count > 1)
        {
            <div class="small text-body-secondary">@L["Also known as"]: @ranked.MostUsedNames</div>
        }
    </div>
    <form method="get" action="/player/@Model.CommunityId">
        <select class="form-select form-select-sm w-auto" name="season" aria-label="@L["Season"]" onchange="this.form.submit()">
            @foreach (var season in Model.Seasons)
            {
                <option value="@season.Id" selected="@(season.Id == Model.Season.Id)">@Display.SeasonName(season)</option>
            }
        </select>
    </form>
</div>

@if (ranked == null)
{
    <div class="alert alert-secondary">@L["This player has no ranked matches in this season."]</div>
}
else
{
    var progress = Model.Progress!;

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <img class="patent-lg" src="@progress.Patent.Image" alt="">
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@progress.Patent.Name</div>
                        <div class="small text-body-secondary">#@ranked.Position · @Display.Number(ranked.Experience) @L["experience"]</div>
                        <div class="progress progress-thin mt-2" role="progressbar" aria-label="@L["Progress to the next patent"]" aria-valuenow="@((int)(progress.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @((int)(progress.Progress * 100))%"></div>
                        </div>
                        @if (progress.NextPatent != null)
                        {
                            <div class="small text-body-secondary mt-1">@L["Next"]: @progress.NextPatent.Name (@Display.Number(progress.NextPatent.Experience))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-4 col-lg-2"><div class="h4 mb-0 text-win">@ranked.Wins</div><div class="small text-body-secondary">@L["Wins"]</div></div>
                        <div class="col-4 col-lg-2"><div class="h4 mb-0 text-loss">@ranked.Loss</div><div class="small text-body-secondary">@L["Losses"]</div></div>
                        <div class="col-4 col-lg-2"><div class="h4 mb-0">@Display.Percent(ranked.WinRate)</div><div class="small text-body-secondary">@L["Win rate"]</div></div>
                        <div class="col-4 col-lg-2"><div class="h4 mb-0">@ranked.MaxWinStreak</div><div class="small text-body-secondary">@L["Best win streak"]</div></div>
                        <div class="col-4 col-lg-2"><div class="h4 mb-0">@ranked.RageQuit</div><div class="small text-body-secondary">@L["Rage quits"]</div></div>
                        <div class="col-4 col-lg-2"><div class="h4 mb-0">@ranked.Stars</div><div class="small text-body-secondary">@L["MVPs"]</div></div>
                    </div>
                    @if (ranked.Punishment > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0 py-2">@L["Punishment this season"]: -@ranked.Punishment</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <h2 class="h5">@L["Averages per match"]</h2>
            <table class="table table-sm">
                <tbody>
                <tr><td>@L["SI damage"]</td><td class="numeric">@Display.PerGame(ranked.SiDamage, ranked.Games)</td></tr>
                <tr><td>@L["SI killed"]</td><td class="numeric">@Display.PerGame(ranked.SiKilled, ranked.Games)</td></tr>
                <tr><td>@L["Common"]</td><td class="numeric">@Display.PerGame(ranked.Common, ranked.Games)</td></tr>
                <tr><td>@L["Tank damage"]</td><td class="numeric">@Display.PerGame(ranked.TankDamage, ranked.Games)</td></tr>
                <tr><td>@L["Skeets"]</td><td class="numeric">@Display.PerGame(ranked.Skeets, ranked.Games)</td></tr>
                <tr><td>@L["Infected damage"]</td><td class="numeric">@Display.PerGame(ranked.DmgTotal, ranked.Games)</td></tr>
                <tr><td>@L["FF"]</td><td class="numeric">@Display.PerGame(ranked.FfGiven, ranked.Games)</td></tr>
                <tr><td>@L["Incapacitations"]</td><td class="numeric">@Display.PerGame(ranked.Incaps, ranked.Games)</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-lg-6">
            <h2 class="h5">@L["Campaigns"]</h2>
            <table class="table table-sm">
                <thead><tr><th>@L["Campaign"]</th><th class="numeric">@L["Wins"]</th><th class="numeric">@L["Losses"]</th></tr></thead>
                <tbody>
                @foreach (var campaign in ranked.Campaigns.OrderByDescending(c => c.Value.Wins + c.Value.Loss).Take(AppConsts.PlayerRelations))
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(campaign.Key) ? L["Custom campaign"].Value : campaign.Key)</td>
                        <td class="numeric text-win">@campaign.Value.Wins</td>
                        <td class="numeric text-loss">@campaign.Value.Loss</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (ranked.Relations.Count > 0)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <h2 class="h5">@L["Plays most with"]</h2>
                <table class="table table-sm">
                    <thead><tr><th>@L["Player"]</th><th class="numeric">@L["Wins"]</th><th class="numeric">@L["Losses"]</th></tr></thead>
                    <tbody>
                    @foreach (var relation in ranked.Relations.Values.Where(r => r.TogetherGames > 0).OrderByDescending(r => r.TogetherGames).Take(AppConsts.PlayerRelations))
                    {
                        <tr>
                            <td><a href="/player/@relation.CommunityId?season=@Model.Season.Id">@Model.Names.GetValueOrDefault(relation.CommunityId, relation.CommunityId.ToString())</a></td>
                            <td class="numeric text-win">@relation.TogetherWins</td>
                            <td class="numeric text-loss">@relation.TogetherLosses</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-6">
                <h2 class="h5">@L["Plays most against"]</h2>
                <table class="table table-sm">
                    <thead><tr><th>@L["Player"]</th><th class="numeric">@L["Wins"]</th><th class="numeric">@L["Losses"]</th></tr></thead>
                    <tbody>
                    @foreach (var relation in ranked.Relations.Values.Where(r => r.AgainstGames > 0).OrderByDescending(r => r.AgainstGames).Take(AppConsts.PlayerRelations))
                    {
                        <tr>
                            <td><a href="/player/@relation.CommunityId?season=@Model.Season.Id">@Model.Names.GetValueOrDefault(relation.CommunityId, relation.CommunityId.ToString())</a></td>
                            <td class="numeric text-win">@relation.AgainstWins</td>
                            <td class="numeric text-loss">@relation.AgainstLosses</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (Model.Matches.Count > 0)
{
    <h2 class="h5">@L["Matches"]</h2>
    <div class="list-group mb-4">
        @foreach (var match in Model.Matches)
        {
            var row = match.Players.FirstOrDefault(p => p.CommunityId == Model.CommunityId);
            var outcome = row == null ? "" : row.RageQuits > 0 ? L["Rage quit"].Value : row.Win ? L["Win"].Value : row.Loss ? L["Loss"].Value : row.Draws > 0 ? L["Draw"].Value : "";
            var style = row is { Win: true } ? "text-win" : row != null && (row.Loss || row.RageQuits > 0) ? "text-loss" : "";

            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/matches/@match.Id">
                <span>
                    <span class="fw-semibold">@(match.Campaign ?? L["Custom campaign"].Value)</span>
                    <span class="small text-body-secondary ms-2">@match.LastFileDate.ToString("g")</span>
                </span>
                <span>
                    <span class="me-3">@match.TeamAScore × @match.TeamBScore</span>
                    <span class="@style">@outcome</span>
                </span>
            </a>
        }
    </div>
}

@if (Model.Administrator)
{
    <div class="card border-warning">
        <div class="card-header">@L["Administration"] · @L["Punishment"]</div>
        <div class="card-body">
            <form class="row g-2 align-items-end" method="post" asp-antiforgery="true" action="/admin/punishments">
                <input type="hidden" name="seasonId" value="@Model.Season.Id">
                <input type="hidden" name="communityId" value="@Model.CommunityId">
                <div class="col-sm-3">
                    <label class="form-label" for="points">@L["Experience to remove"]</label>
                    <input class="form-control" id="points" type="number" name="points" min="1" required>
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="reason">@L["Reason"]</label>
                    <input class="form-control" id="reason" type="text" name="reason" maxlength="300">
                </div>
                <div class="col-sm-3">
                    <button class="btn btn-warning w-100" type="submit">@L["Punish"]</button>
                </div>
            </form>
            @if (ranked is { Punishment: > 0 })
            {
                <form class="mt-2" method="post" asp-antiforgery="true" action="/admin/punishments/delete">
                    <input type="hidden" name="seasonId" value="@Model.Season.Id">
                    <input type="hidden" name="communityId" value="@Model.CommunityId">
                    <button class="btn btn-outline-secondary btn-sm" type="submit">@L["Remove the punishments of this season"]</button>
                </form>
            }
        </div>
    </div>
}
