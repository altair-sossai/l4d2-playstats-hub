@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Antiforgery
@model PlayerDetailsModel
@inject ICurrentUser CurrentUser
@inject ISettingsService Settings
@inject IAntiforgery Antiforgery

@{
    var firstPlayerRanking = Model.FirstPlayerRanking;
    var firstPlayer = firstPlayerRanking.Player;
    var firstPlayerPatentProgress = firstPlayerRanking.PatentProgress;
    var firstPlayerPatent = firstPlayerPatentProgress.Patent;

    var secondPlayerRanking = Model.SecondPlayerRanking;
    var secondPlayer = secondPlayerRanking?.Player;
    var secondPlayerPatentProgress = secondPlayerRanking?.PatentProgress;
    var secondPlayerPatent = secondPlayerPatentProgress?.Patent;

    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var copyIcon = light ? "copy-light.png" : "copy-dark.png";

    var site = await Settings.GetAsync<SiteSettings>();
    var seasonId = Model.Period.SeasonId;
    var antiforgeryToken = Model.Administrator ? Antiforgery.GetAndStoreTokens(Context).RequestToken : null;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = secondPlayer == null
            ? $"{firstPlayer.MainName} - {L["Player details"].Value}"
            : $"{firstPlayer.MainName} vs {secondPlayer.MainName}",
        Description = secondPlayer == null
            ? L["See {0}'s statistics: rank #{1}, {2} matches, and {3} wins.", firstPlayer.MainName, firstPlayer.Position, firstPlayer.Games, firstPlayer.Wins]
            : L["Compare {0} and {1}'s performance and statistics on {2}.", firstPlayer.MainName, secondPlayer.MainName, site.Name],
        Image = $"/avatar/{firstPlayer.CommunityId}",
        ImageAlt = firstPlayer.MainName,
        OpenGraphType = AppConsts.PlayerOpenGraphType
    };

    string FormatPunishment(int punishment)
    {
        return punishment == 0 ? "0" : $"-{punishment:N0} XP";
    }

    void RenderStreak(RankingPlayer player, bool second, bool showName)
    {
        <div class="streak-row">
            @if (showName)
            {
                <div class="streak-name @(second ? "second" : "text-muted")">@player.MainName</div>
            }
            <div class="streak-tiles">
                @if (player.Results == null || player.Results.Count == 0)
                {
                    <small class="text-muted">@Html.Raw("&mdash;")</small>
                }
                else
                {
                    foreach (var result in player.Results)
                    {
                        var cssClass = result switch
                        {
                            MatchOutcome.Win => "streak-win",
                            MatchOutcome.Draw => "streak-draw",
                            _ => "streak-loss"
                        };

                        var title = result switch
                        {
                            MatchOutcome.Win => L["Win"],
                            MatchOutcome.Draw => L["Draw"],
                            _ => L["Loss"]
                        };

                        <span class="streak-tile @cssClass" data-toggle="tooltip" data-placement="top" title="@title"></span>
                    }
                }
            </div>
        </div>
    }

    string Width(decimal rate)
    {
        return (rate * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    void RenderCampaign(PlayerCampaign? campaign, RankingPlayer player, bool second, bool showName)
    {
        <div class="campaign-line">
            @if (showName)
            {
                <div class="campaign-player @(second ? "second" : "text-muted")">
                    @player.MainName
                    @if (campaign is { Games: > 0 })
                    {
                        <small>· @campaign.Games.ToString("N0") @L["Games"]</small>
                    }
                </div>
            }
            @if (campaign is not { Games: > 0 })
            {
                <small class="text-muted">@L["Has not played it yet"]</small>
            }
            else
            {
                <div class="campaign-bar">
                    <span class="streak-win" style="width: @Width(campaign.WinRate)" data-toggle="tooltip" data-container="body" title="@L["Wins"]: @campaign.WinRate.ToString("P0")"></span>
                    <span class="streak-draw" style="width: @Width(campaign.DrawRate)" data-toggle="tooltip" data-container="body" title="@L["Draws"]: @campaign.DrawRate.ToString("P0")"></span>
                    <span class="streak-loss" style="width: @Width(campaign.LossRate)" data-toggle="tooltip" data-container="body" title="@L["Loss"]: @campaign.LossRate.ToString("P0")"></span>
                </div>
                <div class="campaign-numbers">
                    <div>
                        <strong class="campaign-win">@campaign.Wins.ToString("N0")</strong>
                        <small>@L["Wins"] · @campaign.WinRate.ToString("P0")</small>
                    </div>
                    <div>
                        <strong>@campaign.Draws.ToString("N0")</strong>
                        <small>@L["Draws"] · @campaign.DrawRate.ToString("P0")</small>
                    </div>
                    <div>
                        <strong class="campaign-loss">@campaign.Loss.ToString("N0")</strong>
                        <small>@L["Loss"] · @campaign.LossRate.ToString("P0")</small>
                    </div>
                </div>
                @if (campaign.RageQuit > 0)
                {
                    <small class="text-muted">@L["Rage quit"]: @campaign.RageQuit.ToString("N0")</small>
                }
            }
        </div>
    }

    void RenderWallet(PlayerSkinsModel? playerSkins)
    {
        var wallet = playerSkins?.Wallet;

        if (wallet == null)
            return;

        <span class="player-stars">
            <span class="player-stars-icon">★</span>
            <strong>@wallet.Balance.ToString("N0")</strong>
            @L[wallet.Balance == 1 ? "star available" : "stars available"]
            <small>· @string.Format(L["{0} earned, {1} spent"].Value, wallet.Stars.ToString("N0"), wallet.Spent.ToString("N0"))</small>
        </span>
    }

    void RenderPlayerSkins(PlayerSkinsModel? playerSkins, RankingPlayer player, bool second, bool showName)
    {
        var ownedSkins = playerSkins?.OwnedSkins ?? [];

        <div class="player-skins-row">
            @if (showName || playerSkins?.Wallet != null)
            {
                <div class="player-skins-header">
                    @if (showName)
                    {
                        <span class="streak-name @(second ? "second" : "text-muted")">
                            @player.MainName <small>(@ownedSkins.Count.ToString("N0"))</small>
                        </span>
                    }
                    @{ RenderWallet(playerSkins); }
                </div>
            }
            @if (ownedSkins.Count == 0)
            {
                <p class="text-muted" style="margin: 0">@L["This player does not own any skins yet."]</p>
            }
            else
            {
                <div class="player-skins">
                    @foreach (var skin in ownedSkins)
                    {
                        var title = skin.Title(CultureInfo.CurrentUICulture);
                        var image = playerSkins!.Image(skin);
                        var equipped = playerSkins!.IsEquipped(skin);

                        <a class="player-skin @(equipped ? "player-skin-equipped" : "")" href="@(AppConsts.SkinShopUrl + AppConsts.PlayerSkinAnchor + skin.Id)" title="@title">
                            @if (image != null)
                            {
                                <img src="@image" alt="@title" loading="lazy"/>
                            }
                            else
                            {
                                <div class="player-skin-no-image"></div>
                            }
                            <span class="@(second ? "second" : "")">@title</span>
                            @if (equipped)
                            {
                                <span class="label label-success">@L["Equipped"]</span>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    }
}

