@model PlayerNotFoundModel
@inject ISettingsService Settings

@{
    var playerName = Model.Name ?? Model.CommunityId.ToString();

    var site = await Settings.GetAsync<SiteSettings>();
    var seasonId = Model.Period?.Query;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = $"{playerName} - {L["Player details"].Value}",
        Description = L["See the available information about player {0} on {1}.", playerName, site.Name],
        Image = $"/avatar/{Model.CommunityId}",
        ImageAlt = playerName,
        OpenGraphType = AppConsts.PlayerOpenGraphType,
        NoIndex = true
    };
}

@section Styles {
    @if (Model.Community?.HasActivity == true)
    {
        @await Html.PartialAsync("_CommunityStyles", Model.Community)
    }
    <link rel="stylesheet" href="~/css/pages/players-player-not-found.css" asp-append-version="true"/>
}

<h4 class="text-center">@L["Player details"]</h4>

@if (Model.Period is { HasChoices: true })
{
    <div class="row" style="margin-bottom: 5px">
        <div class="col-md-12">
            @await Html.PartialAsync("_PeriodSelector", new PlayerPeriodSelectorModel(Model.Period, season => PlayerUrls.Details(Model.CommunityId, null, season)))
        </div>
    </div>
}

<div class="alert alert-warning text-center" role="alert">
    @if (Model.Ranking)
    {
        <h4>@L["Player not ranked"]</h4>
        <p>@L["This player is not currently present in the ranking."]</p>
        <p>@L["Therefore, complete statistics are unavailable. The known account information is shown below."]</p>
    }
    else
    {
        <h4>@L["No statistics yet"]</h4>
        <p>@L["This site has no statistics for this player yet. The known account information is shown below."]</p>
    }
</div>

<div class="row">
    <div class="col-sm-3 text-center player-summary-avatar-container">
        <img src="/avatar/@(Model.CommunityId).jpg" alt="@playerName" title="@playerName" class="img-responsive img-thumbnail center-block player-summary-avatar" onerror="imgOnError(this)" data-lity/>
        <a href="@Model.ProfileUrl" class="btn btn-primary btn-block player-steam-profile" target="_blank" rel="noopener noreferrer">
            <span class="glyphicon glyphicon-new-window"></span> @L["Open Steam profile"]
        </a>
        @if (Model.Community?.HasActivity == true)
        {
            @await Html.PartialAsync("_CommunityStanding", Model.Community.First)
        }
    </div>
    <div class="col-sm-9">
        <div class="panel panel-default">
            <div class="panel-heading">
                @L["Available information"]
            </div>

            <table class="table table-hover table-condensed table-responsive">
                <tbody>
                @if (!string.IsNullOrWhiteSpace(Model.Name))
                {
                    <tr>
                        <th>@L["Name"]:</th>
                        <td data-label="@L["Name"]:">@Model.Name</td>
                    </tr>
                }
                <tr>
                    <th>@L["Community ID"]:</th>
                    <td data-label="@L["Community ID"]:">
                        @Model.CommunityId
                        @await Html.PartialAsync("_CopyButton", Model.CommunityId.ToString())
                    </td>
                </tr>
                <tr>
                    <th>@L["Steam ID"]:</th>
                    <td data-label="@L["Steam ID"]:">
                        @Model.SteamId
                        @await Html.PartialAsync("_CopyButton", Model.SteamId)
                    </td>
                </tr>
                <tr>
                    <th>@L["Steam ID"] (STEAM_1):</th>
                    <td data-label="@L["Steam ID"] (STEAM_1):">
                        @Model.GameSteamId
                        @await Html.PartialAsync("_CopyButton", Model.GameSteamId)
                    </td>
                </tr>
                <tr>
                    <th>@L["Steam3 ID"]:</th>
                    <td data-label="@L["Steam3 ID"]:">
                        @Model.Steam3
                        @await Html.PartialAsync("_CopyButton", Model.Steam3)
                    </td>
                </tr>
                @await Html.PartialAsync("_SteamFacts", new PlayerSteamFactsModel(Model.Steam, null, false))
                @if (Model.LastConnectedAtUtc.HasValue)
                {
                    <tr>
                        <th>@L["Last login"]:</th>
                        <td data-label="@L["Last login"]:">@Model.LocalTime(Model.LastConnectedAtUtc.Value).ToString("g")</td>
                    </tr>
                }
                @if (Model.ConnectionCount.HasValue)
                {
                    <tr>
                        <th>@L["Connections"]:</th>
                        <td data-label="@L["Connections"]:">@Model.ConnectionCount.Value.ToString("N0")</td>
                    </tr>
                }
                <tr>
                    <th>@L["Profile URL"]:</th>
                    <td data-label="@L["Profile URL"]:">
                        <a href="@Model.ProfileUrl" target="_blank" rel="noopener noreferrer">
                            @Model.ProfileUrl
                        </a>
                        @await Html.PartialAsync("_CopyButton", Model.ProfileUrl)
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.RelatedPlayers.Any())
{
    <div class="panel panel-warning">
        <div class="panel-heading">
            @L["Related accounts"]
        </div>

        <table class="table table-hover table-condensed table-responsive">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Steam ID"]</th>
                <th>@L["Last login"]</th>
                <th>@L["Connections"]</th>
                <th>@L["Profile URL"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var relatedPlayer in Model.RelatedPlayers)
            {
                <tr>
                    <td data-label="@L["Name"]:">
                        <img src="/avatar/@relatedPlayer.CommunityId" alt="@relatedPlayer.Name" title="@relatedPlayer.Name" class="img-thumbnail" style="width: 32px; margin-right: 5px" onerror="imgOnError(this)"/>
                        <a href="@PlayerUrls.Details(long.Parse(relatedPlayer.CommunityId), null, seasonId)">@relatedPlayer.Name</a>
                    </td>
                    <td data-label="@L["Steam ID"]:">
                        @SteamIds.DisplaySteamId(long.Parse(relatedPlayer.CommunityId))
                        @if (!string.IsNullOrWhiteSpace(relatedPlayer.SteamId))
                        {
                            @await Html.PartialAsync("_CopyButton", SteamIds.DisplaySteamId(long.Parse(relatedPlayer.CommunityId)))
                        }
                    </td>
                    <td data-label="@L["Last login"]:">@Model.LocalTime(relatedPlayer.LastConnectedAtUtc).ToString("g")</td>
                    <td data-label="@L["Connections"]:">@relatedPlayer.ConnectionCount.ToString("N0")</td>
                    <td data-label="@L["Profile URL"]:">
                        @if (!string.IsNullOrWhiteSpace(relatedPlayer.ProfileUrl))
                        {
                            <a href="@relatedPlayer.ProfileUrl" target="_blank" rel="noopener noreferrer">
                                @relatedPlayer.ProfileUrl
                            </a>
                            @await Html.PartialAsync("_CopyButton", relatedPlayer.ProfileUrl)
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Community is { ShowsVotes: true, HasActivity: true })
{
    <ul class="nav nav-tabs player-not-found-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#votes-received" role="tab" data-toggle="tab">
                @L["Votes received"] <span class="badge">@Model.Community.ReceivedTotal.ToString("N0")</span>
            </a>
        </li>
        @if (Model.Community.ShowVoters)
        {
            <li role="presentation">
                <a href="#votes-cast" role="tab" data-toggle="tab">
                    @L["Votes cast"] <span class="badge">@Model.Community.CastTotal.ToString("N0")</span>
                </a>
            </li>
        }
    </ul>
    <div class="tab-content player-not-found-votes">
        @{
            ViewData[AppConsts.PlayerVotesActiveViewData] = true;
        }
        @await Html.PartialAsync("_CommunityVotes", Model.Community)
    </div>
}

<div class="text-center">
    <a href="/" class="btn btn-primary">@(Model.Ranking ? L["Return to ranking page"] : L["Back to the home page"])</a>
</div>
