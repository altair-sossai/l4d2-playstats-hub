@model SkinPricesAdminModel

@{
    ViewData["Title"] = L["Skin prices"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Skins, number => Url.Action("Prices", "SkinsAdmin", new { q = Model.Query, rarity = Model.Rarity, weapon = Model.Weapon, page = number })!);
    var filtered = !string.IsNullOrEmpty(Model.Query) || Model.Rarity != null || !string.IsNullOrEmpty(Model.Weapon);
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@Html.AntiForgeryToken()

@await Html.PartialAsync("_SkinsAdminNav")

<div class="admin-header">
    <h3>@L["Skin prices"]</h3>
</div>

<p class="text-muted">@L["The default price comes from the catalog. A changed price only applies to new purchases; players who already bought are not affected. Click a skin to change its price."]</p>

<div class="admin-stats">
    <div>
        <strong>@Model.CustomPrices.ToString("N0", culture)</strong>
        <small>@L["skins with a changed price"]</small>
    </div>
</div>

<form method="get" class="admin-filters">
    <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@L["Search skin by name or id..."]"/>
    <select name="rarity" class="form-control" onchange="this.form.submit()">
        <option value="">@L["All rarities"]</option>
        @foreach (var rarity in SkinDisplay.Rarities)
        {
            <option value="@rarity" selected="@(Model.Rarity == rarity)">@L[SkinDisplay.RarityKey(rarity)]</option>
        }
    </select>
    <select name="weapon" class="form-control" onchange="this.form.submit()">
        <option value="">@L["All weapons"]</option>
        @foreach (var weapon in Model.Weapons)
        {
            <option value="@weapon" selected="@(Model.Weapon == weapon)">@L[SkinWeapons.Name(weapon)]</option>
        }
    </select>
    <button type="submit" class="btn btn-default">
        <span class="glyphicon glyphicon-search"></span> @L["Search"]
    </button>
    @if (filtered)
    {
        <a class="btn btn-link" href="@Url.Action("Prices", "SkinsAdmin")">@L["Clear filters"]</a>
    }
</form>

<div class="admin-list">
    @if (Model.Skins.Items.Count == 0)
    {
        <div class="admin-empty">@L["No skins found."]</div>
    }
    @foreach (var skin in Model.Skins.Items)
    {
        var title = skin.Title(culture);
        var weapon = L[SkinWeapons.Name(skin.Weapon)].Value;
        var rarity = L[SkinDisplay.RarityKey(skin.Rarity)].Value;
        var image = SkinDisplay.Image(Model.AssetsUrl, skin);

        <div class="admin-item ska-skin"
             data-skin="@skin.Id" data-title="@title" data-image="@image" data-weapon="@weapon" data-rarity="@rarity"
             data-price="@skin.Price" data-default-price="@skin.DefaultPrice" data-custom="@(skin.HasCustomPrice ? 1 : 0)" data-available="@(skin.Available ? 1 : 0)">
            <img class="admin-thumb" src="@image" alt="@title" loading="lazy"/>
            <div class="admin-main">
                <div class="admin-title">@title</div>
                <small>@weapon · @rarity · @skin.Id</small>
            </div>
            <div class="admin-side">
                <strong>@skin.Price.ToString("N0", culture) ⭐</strong>
                @if (skin.HasCustomPrice)
                {
                    <small>
                        <span class="label label-warning">@L["Changed"]</span> @string.Format(L["default: {0} ⭐"].Value, skin.DefaultPrice.ToString("N0", culture))
                    </small>
                }
                @if (!skin.Available)
                {
                    <small>
                        <span class="label label-default">@L["No longer for sale"]</span>
                    </small>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)

<div id="ska-price-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title ska-title"></h4>
            </div>
            <div class="modal-body">
                <div class="admin-details">
                    <img class="ska-image" src="" alt=""/>
                    <dl>
                        <dt>@L["Weapon"]</dt>
                        <dd class="ska-weapon"></dd>
                        <dt>@L["Rarity"]</dt>
                        <dd class="ska-rarity"></dd>
                        <dt>@L["Default price"]</dt>
                        <dd class="ska-default-price"></dd>
                        <dt>@L["Current price"]</dt>
                        <dd>
                            <div class="input-group" style="max-width: 200px">
                                <input type="number" min="1" max="100000" class="form-control ska-price"/>
                                <span class="input-group-addon">⭐</span>
                            </div>
                        </dd>
                    </dl>
                </div>
                <p class="text-muted">
                    <small>@L["The new price applies to new purchases. Use \"Reset to default\" to go back to the catalog price."]</small>
                </p>
                <div class="ska-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-success ska-gift">
                    <span class="glyphicon glyphicon-gift"></span> @L["Give as a gift"]
                </button>
                <button type="button" class="btn btn-warning ska-reset">@L["Reset to default"]</button>
                <button type="button" class="btn btn-primary ska-save">@L["Save"]</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_GiftModal", Model.AllSkins)

@section Scripts {
    <script>
        $(function () {
            var texts = {
                saved: @Json.Serialize(L["Price saved. Reloading..."].Value),
                invalid: @Json.Serialize(L["Enter a price between 1 and 100,000."].Value),
                error: @Json.Serialize(L["Could not save. Reload the page and try again."].Value)
            };

            var token = $('input[name="__RequestVerificationToken"]').val();
            var selected = null;

            function message(success, text) {
                $('#ska-price-modal .ska-message').html('<div class="alert ' + (success ? 'alert-success' : 'alert-danger') + '">' + $('<div/>').text(text).html() + '</div>');
            }

            function save(price) {
                var $buttons = $('#ska-price-modal .ska-save, #ska-price-modal .ska-reset');

                $buttons.prop('disabled', true);

                $.ajax({
                    url: '/api/shop/skins/' + encodeURIComponent(selected) + '/price',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify({ price: price })
                }).done(function () {
                    message(true, texts.saved);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function () {
                    message(false, texts.error);
                    $buttons.prop('disabled', false);
                });
            }

            $('.ska-skin').on('click', function () {
                var $item = $(this);
                var $modal = $('#ska-price-modal');

                selected = $item.data('skin');

                $modal.find('.ska-title').text($item.data('title'));
                $modal.find('.ska-image').attr({ src: $item.data('image'), alt: $item.data('title') });
                $modal.find('.ska-weapon').text($item.data('weapon'));
                $modal.find('.ska-rarity').text($item.data('rarity'));
                $modal.find('.ska-default-price').text(Number($item.data('default-price')).toLocaleString() + ' ⭐');
                $modal.find('.ska-price').val($item.data('price'));
                $modal.find('.ska-reset').toggle($item.data('custom') === 1);
                $modal.find('.ska-gift').toggle($item.data('available') === 1);
                $modal.find('.ska-message').empty();
                $modal.find('.ska-save, .ska-reset').prop('disabled', false);
                $modal.modal('show');
            });

            $('.ska-save').on('click', function () {
                var price = parseInt($('#ska-price-modal .ska-price').val(), 10);

                if (isNaN(price) || price < 1 || price > 100000) {
                    message(false, texts.invalid);
                    return;
                }

                save(price);
            });

            $('.ska-gift').on('click', function () {
                var skin = selected;

                $('#ska-price-modal').one('hidden.bs.modal', function () {
                    GiftModal.open({ skin: skin });
                }).modal('hide');
            });

            $('.ska-reset').on('click', function () {
                save(null);
            });

            $('#ska-price-modal').on('shown.bs.modal', function () {
                $(this).find('.ska-price').focus().select();
            });
        });
    </script>
}