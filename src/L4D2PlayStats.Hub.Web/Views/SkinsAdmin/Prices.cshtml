@using L4D2PlayStats.Hub.Core.Modules.Skins.Helpers
@using L4D2PlayStats.Hub.Web.Helpers
@using L4D2PlayStats.Hub.Web.Models.Skins
@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts
@model SkinPricesViewModel
@{
    ViewData["Title"] = L["Skins"].Value;

    var culture = CultureInfo.CurrentUICulture;

    string Link(int page)
    {
        return AppConsts.SkinPricesUrl + SkinDisplay.Query(("q", Model.Query), ("weapon", Model.Weapon), ("rarity", Model.Rarity), ("page", page));
    }
}
<link rel="stylesheet" href="~/css/skins.css" asp-append-version="true">
<h1 class="h3">@L["Skins"]</h1>
<partial name="_AdminNav"/>
<partial name="_SkinsAdminNav"/>

<p class="text-body-secondary">
    @L["Each skin comes with a price from the catalog. A price set here replaces it, and stays when the catalog is imported again."]
    @L["{0} skins have their own price.", Model.CustomPrices]
</p>

<form class="d-flex flex-wrap gap-2 mb-3" method="get" action="@AppConsts.SkinPricesUrl">
    <input class="form-control form-control-sm w-auto" name="q" value="@Model.Query" placeholder="@L["Skin"]" aria-label="@L["Search"]">
    <select class="form-select form-select-sm w-auto" name="weapon" aria-label="@L["Weapon"]" onchange="this.form.submit()">
        <option value="">@L["All weapons"]</option>
        @foreach (var weapon in Model.Weapons)
        {
            <option value="@weapon" selected="@(weapon == Model.Weapon)">@L[SkinWeapons.Name(weapon)]</option>
        }
    </select>
    <select class="form-select form-select-sm w-auto" name="rarity" aria-label="@L["Rarity"]" onchange="this.form.submit()">
        <option value="">@L["All rarities"]</option>
        @foreach (var rarity in SkinDisplay.Rarities)
        {
            <option value="@rarity" selected="@(rarity == Model.Rarity)">@L[rarity.ToString()]</option>
        }
    </select>
    <button class="btn btn-sm btn-outline-light" type="submit">@L["Search"]</button>
</form>

@if (Model.Skins.Total == 0)
{
    <div class="alert alert-secondary">@L["No skins found."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
            <tr>
                <th>@L["Skin"]</th>
                <th>@L["Weapon"]</th>
                <th>@L["Rarity"]</th>
                <th class="numeric">@L["Catalog price"]</th>
                <th>@L["Price"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var skin in Model.Skins.Items)
            {
                <tr>
                    <td>
                        @skin.Title(culture)
                        @if (!skin.Available)
                        {
                            <span class="badge text-bg-warning">@L["No longer for sale"]</span>
                        }
                        <div class="small text-body-secondary"><code>@skin.Id</code></div>
                    </td>
                    <td>@L[SkinWeapons.Name(skin.Weapon)]</td>
                    <td><span class="badge skin-rarity-badge @SkinDisplay.RarityCss(skin.Rarity)">@L[skin.Rarity.ToString()]</span></td>
                    <td class="numeric">@skin.DefaultPrice</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <form class="d-flex gap-2" method="post" asp-antiforgery="true" action="@AppConsts.SkinPricesUrl">
                                <input type="hidden" name="skinId" value="@skin.Id">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                <input class="form-control form-control-sm" style="width: 7rem;" name="price" type="number" min="@CoreConsts.SkinMinPrice" max="@CoreConsts.SkinMaxPrice" value="@skin.Price" required aria-label="@L["Price"]">
                                <button class="btn btn-sm btn-primary" type="submit">@L["Save"]</button>
                            </form>
                            @if (skin.HasCustomPrice)
                            {
                                <form method="post" asp-antiforgery="true" action="@AppConsts.SkinPricesUrl">
                                    <input type="hidden" name="skinId" value="@skin.Id">
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Use the catalog price"]</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Skins.Pages > 1)
    {
        <nav aria-label="@L["Pages"]">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Skins.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Skins.Page - 1)">@L["Previous"]</a></li>
                <li class="page-item disabled"><span class="page-link">@Model.Skins.Page / @Model.Skins.Pages</span></li>
                <li class="page-item @(Model.Skins.Page >= Model.Skins.Pages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Skins.Page + 1)">@L["Next"]</a></li>
            </ul>
        </nav>
    }
}
