@model SkinCatalogViewModel

@{
    ViewData["Title"] = L["Skin catalog"].Value;
    var culture = CultureInfo.CurrentUICulture;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

<div class="admin-header">
    <h3>@L["Skin catalog"]</h3>
</div>

@if (TempData[AppConsts.SkinImportTempData] is string imported)
{
    <div class="alert alert-success">@L["Catalog imported: {0} skins in the file, {1} added, {2} updated and {3} no longer for sale.", SkinDisplay.Arguments(imported)]</div>
}

<p class="text-muted">@L["The catalog is a skins.json file. The hub comes with the catalog of the current server and imports it by itself the first time the shop is turned on. Importing a catalog again updates the skins that exist, adds the new ones, and takes off sale the skins that are no longer in the file. Players keep the skins they own and the prices you changed."]</p>

<div class="admin-stats">
    <div>
        <strong>@Model.Total.ToString("N0", culture)</strong>
        <small>@L["skins in the catalog"]</small>
    </div>
    <div>
        <strong>@Model.Available.ToString("N0", culture)</strong>
        <small>@L["skins for sale"]</small>
    </div>
    <div>
        <strong>@Model.Unavailable.ToString("N0", culture)</strong>
        <small>@L["skins no longer for sale"]</small>
    </div>
</div>

@if (Model.UpdatedAt != null)
{
    <p class="text-muted">
        <small>@L["Last change"]: @Model.UpdatedAt.Value.ToString(AppConsts.ShortDateTimeFormat, culture)</small>
    </p>
}

@if (TempData[AppConsts.SkinAuthorSyncTempData] is string synced)
{
    <div class="alert alert-success">@L["Author names checked on Steam: {0} authors, {1} skins renamed.", SkinDisplay.Arguments(synced)]</div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>@L["Author names"]</strong>
    </div>
    <div class="panel-body">
        <p>@L["The name of each author comes from their Steam profile. The site checks it every day and updates the skins when an author changes their name, even after the catalog is imported again."]</p>
        <p class="text-muted">
            <small>
                @L["Authors"]: @Model.Authors.Authors.ToString("N0", culture)
                · @L["checked"]: @Model.Authors.Synced.ToString("N0", culture)
                @if (Model.AuthorsSyncedAt != null)
                {
                    <text>· @L["last check"]: @Model.AuthorsSyncedAt.Value.ToString(AppConsts.ShortDateTimeFormat, culture)</text>
                }
                @if (Model.AuthorRenamedAt != null)
                {
                    <text>· @L["last name change"]: @Model.AuthorRenamedAt.Value.ToString(AppConsts.ShortDateTimeFormat, culture)</text>
                }
            </small>
        </p>
        <form method="post" asp-antiforgery="true" action="@AppConsts.SkinCatalogUrl/authors" style="margin: 0">
            <button class="btn btn-default" type="submit" @(Model.Authors.Authors == 0 ? "disabled" : null)>
                <span class="glyphicon glyphicon-refresh"></span> @L["Check the names now"]
            </button>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>@L["Import the bundled catalog"]</strong>
    </div>
    <div class="panel-body">
        <form method="post" asp-antiforgery="true" action="@AppConsts.SkinCatalogUrl/bundled">
            <p>@L["The catalog that comes with this version of the hub, with {0} skins and their thumbnails.", Model.Bundled.ToString("N0", culture)]</p>
            <button class="btn btn-primary" type="submit">
                <span class="glyphicon glyphicon-import"></span> @L["Import the bundled catalog"]
            </button>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>@L["Import from a file"]</strong>
    </div>
    <div class="panel-body">
        <form method="post" asp-antiforgery="true" action="@AppConsts.SkinCatalogUrl/upload" enctype="multipart/form-data">
            <div class="form-group">
                <label for="file">@L["Catalog file"]</label>
                <input id="file" name="file" type="file" accept=".json,application/json" required/>
            </div>
            <button class="btn btn-primary" type="submit">
                <span class="glyphicon glyphicon-upload"></span> @L["Import"]
            </button>
        </form>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <strong>@L["Import from the configured address"]</strong>
    </div>
    <div class="panel-body">
        @if (string.IsNullOrEmpty(Model.Settings.CatalogUrl))
        {
            <p class="text-muted" style="margin: 0">
                @L["Set the catalog address in the shop settings first."]
                <a href="@AppConsts.SkinSettingsUrl">
                    <u>@L["Shop settings"]</u>
                </a>
            </p>
        }
        else
        {
            <form method="post" asp-antiforgery="true" action="@AppConsts.SkinCatalogUrl/fetch">
                <p>
                    <code>@Model.Settings.CatalogUrl</code>
                </p>
                <button class="btn btn-primary" type="submit">
                    <span class="glyphicon glyphicon-download-alt"></span> @L["Download and import"]
                </button>
            </form>
        }
    </div>
</div>
