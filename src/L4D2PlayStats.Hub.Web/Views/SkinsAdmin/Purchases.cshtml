@model SkinPurchasesAdminModel
@inject SkinThumbnailStore SkinThumbnails

@{
    ViewData["Title"] = L["Skin purchases"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Purchases, number => Url.Action("Purchases", "SkinsAdmin", new { q = Model.Query, player = Model.Player, page = number })!);
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <link rel="stylesheet" href="~/css/pages/skin-purchases.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="admin-header">
    <h3>@L["Skin purchases"]</h3>
    @if (Model.TotalPurchases + Model.TotalGifts > 0)
    {
        <button type="button" class="btn btn-danger ska-refund-all-open">
            <span class="glyphicon glyphicon-repeat"></span> @L["Refund everything"]
        </button>
    }
</div>

<div class="admin-stats">
    <div>
        <strong>@Model.TotalPurchases.ToString("N0", culture)</strong>
        <small>@L["purchases"]</small>
    </div>
    <div>
        <strong>@Model.TotalStars.ToString("N0", culture) ⭐</strong>
        <small>@L["stars spent"]</small>
    </div>
    <div>
        <strong>@Model.TotalGifts.ToString("N0", culture)</strong>
        <small>@L["gifts given"]</small>
    </div>
</div>

@if (Model.Season.Refunds)
{
    <div class="alert alert-info">
        <span class="glyphicon glyphicon-calendar"></span>
        @string.Format(L["At the end of the ranking season ({0}), purchases are refunded automatically and the stars go back to the players; gifts stay with them forever."].Value, Model.Season.LastDay.ToString("d", culture))
    </div>
}

<div class="admin-toolbar">
    <form method="get" class="admin-filters">
        <input type="hidden" name="player" value="@Model.Player"/>
        <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@L["Search by player, Steam ID or skin..."]"/>
        <span style="align-self: center">@FieldHelp.Tip(L["Finds purchases by part of the player's name, the SteamID64, the skin id or the skin name. Filter by player shows the purchases of one player only."])</span>
        <button type="submit" class="btn btn-default">
            <span class="glyphicon glyphicon-search"></span> @L["Search"]
        </button>
        @if (Model.Player == null)
        {
            <button type="button" class="btn btn-default ska-pick-player">
                <span class="glyphicon glyphicon-user"></span> @L["Filter by player"]
            </button>
        }
        else
        {
            <div class="ska-filter-player" title="@Model.Player">
                <img src="/avatar/@Model.Player" alt="@Model.PlayerName" onerror="imgOnError(this)"/>
                <span>@Model.PlayerName</span>
                <a href="#" class="ska-pick-player" title="@L["Change player"]">
                    <span class="glyphicon glyphicon-pencil"></span>
                </a>
                <a href="@Url.Action("Purchases", "SkinsAdmin", new { q = Model.Query })" title="@L["Show every player"]">
                    <span class="glyphicon glyphicon-remove"></span>
                </a>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Query) || Model.Player != null)
        {
            <a class="btn btn-link" href="@Url.Action("Purchases", "SkinsAdmin")">@L["Clear filters"]</a>
        }
    </form>
    <div class="admin-toolbar-actions">
        <button type="button" class="btn btn-primary" onclick="GiftModal.open()">
            <span class="glyphicon glyphicon-gift"></span> @L["Give a skin"]
        </button>
    </div>
</div>

<div class="admin-list">
    @if (Model.Purchases.Items.Count == 0)
    {
        <div class="admin-empty">@L["No purchases found."]</div>
    }
    @foreach (var row in Model.Purchases.Items)
    {
        var purchase = row.Purchase;
        var title = row.SkinTitle(culture);
        var image = row.Skin == null ? AppConsts.SkinEmptyImage : SkinThumbnails.Image(Model.AssetsUrl, row.Skin);
        var weapon = row.Skin == null ? string.Empty : L[SkinWeapons.Name(row.Skin.Weapon)].Value;
        var date = row.Date.ToString(AppConsts.ShortDateTimeFormat, culture);
        var price = purchase.Gift ? L["Gift"].Value : $"{purchase.Price.ToString("N0", culture)} ⭐";
        var rarity = row.Skin == null ? null : SkinDisplay.RarityKey(row.Skin.Rarity);
        var shopUrl = row.Skin is { Available: true } ? $"{Url.Action("Index", "Skins")}#{SkinDisplay.Anchor(row.Skin)}" : string.Empty;

        <div class="admin-item ska-purchase"
             data-player="@row.CommunityId" data-player-name="@row.PlayerName" data-avatar="/avatar/@row.CommunityId"
             data-skin="@purchase.SkinId" data-title="@title" data-image="@image" data-weapon="@weapon"
             data-shop-url="@shopUrl"
             data-rarity="@(rarity == null ? "" : L[rarity].Value)" data-rarity-css="@(row.Skin == null ? "" : SkinDisplay.PurchaseCss(row.Skin.Rarity))"
             data-price="@price" data-date="@date" data-gift="@(purchase.Gift ? 1 : 0)" data-gifted-by="@row.GiftedByName"
             data-stars-before="@(purchase.Gift ? "" : purchase.StarsBefore.ToString("N0", culture))"
             data-stars-after="@(purchase.Gift ? "" : (purchase.StarsBefore - purchase.Price).ToString("N0", culture))">
            <img class="admin-thumb" src="@image" alt="@title" loading="lazy"/>
            <div class="admin-main">
                <div class="admin-title">@title</div>
                <small>@weapon · @purchase.SkinId</small>
            </div>
            <div class="admin-player">
                <img class="admin-avatar" src="/avatar/@row.CommunityId" alt="@row.PlayerName" onerror="imgOnError(this)"/>
                <div class="admin-main">
                    <div class="admin-title">@row.PlayerName</div>
                    <small>@row.CommunityId</small>
                </div>
            </div>
            <div class="admin-side">
                @if (purchase.Gift)
                {
                    <span class="label label-success">@L["Gift"]</span>
                    @if (!string.IsNullOrEmpty(row.GiftedByName))
                    {
                        <small>@string.Format(L["by {0}"].Value, row.GiftedByName)</small>
                    }
                }
                else
                {
                    <strong>@price</strong>
                }
                <small>@date</small>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)

<div id="ska-purchase-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Purchase details"]</h4>
            </div>
            <div class="modal-body">
                <div class="ska-hero">
                    <a class="ska-cover ska-shop-link" href="#" target="_blank" rel="noopener">
                        <img class="ska-image" src="" alt=""/>
                        <span class="ska-cover-hint">
                            <span class="glyphicon glyphicon-new-window"></span> @L["View in the shop"]
                        </span>
                    </a>
                    <div class="ska-hero-info">
                        <span class="ska-rarity"></span>
                        <span class="label label-success ska-gift-badge">
                            <span class="glyphicon glyphicon-gift"></span> @L["Gift"]
                        </span>
                        <h4>
                            <a class="ska-title ska-shop-link" href="#" target="_blank" rel="noopener"></a>
                        </h4>
                        <div class="ska-weapon"></div>
                        <a class="btn btn-default btn-sm ska-shop-link" href="#" target="_blank" rel="noopener">
                            <span class="glyphicon glyphicon-new-window"></span> @L["View in the shop"]
                        </a>
                    </div>
                </div>
                <div class="ska-section">
                    <div class="ska-player">
                        <img class="ska-avatar" src="" alt="" onerror="imgOnError(this)"/>
                        <div class="ska-player-info">
                            <strong class="ska-player-name"></strong>
                            <small class="ska-player-id"></small>
                        </div>
                        <a class="btn btn-default btn-sm ska-player-filter" href="#" title="@L["Show only this player's purchases"]">
                            <span class="glyphicon glyphicon-filter"></span>
                        </a>
                        <a class="btn btn-default btn-sm ska-player-link" href="#" target="_blank" rel="noopener" title="@L["Open the player's profile"]">
                            <span class="glyphicon glyphicon-user"></span>
                        </a>
                    </div>
                    <div class="ska-facts">
                        <div>
                            <small>@L["Price"]</small>
                            <strong class="ska-price"></strong>
                        </div>
                        <div class="ska-stars-before-box">
                            <small title="@L["Balance before → after the purchase"]">@L["Balance"]</small>
                            <strong>
                                <span class="ska-stars-before"></span> <span class="ska-balance-after"></span>
                            </strong>
                        </div>
                        <div class="ska-gifted-by-box">
                            <small>@L["Gift given by"]</small>
                            <strong class="ska-gifted-by"></strong>
                        </div>
                        <div>
                            <small>@L["Date"]</small>
                            <strong class="ska-date"></strong>
                        </div>
                    </div>
                </div>
                <div class="ska-feedback">
                    <div class="alert alert-warning admin-confirm ska-refund-confirm"></div>
                    <div class="ska-message"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
                <button type="button" class="btn btn-danger ska-refund">
                    <span class="glyphicon glyphicon-repeat"></span> @L["Refund purchase"]
                </button>
                <button type="button" class="btn btn-danger ska-refund-yes" style="display: none">@L["Confirm refund"]</button>
            </div>
        </div>
    </div>
</div>

<div id="ska-refund-all-modal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close ska-refund-all-close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Refund all purchases"]</h4>
            </div>
            <div class="modal-body">
                <p>@string.Format(L["This refunds, one by one, the {0} purchases and {1} gifts of every player. The {2} stars spent go back to the players, every skin leaves their accounts and weapons go back to the default skin."].Value, Model.TotalPurchases.ToString("N0", culture), Model.TotalGifts.ToString("N0", culture), Model.TotalStars.ToString("N0", culture))</p>
                <div class="alert alert-warning">@L["This cannot be undone. Use it, for example, after recalculating prices. Players' stars do not change: only what was spent is returned."]</div>
                <div class="checkbox">
                    <label>
                        <input type="checkbox" class="ska-refund-all-check"/> @L["I understand that every purchase and every gift of every player will be refunded."]
                    </label>
                </div>
                <div class="ska-refund-all-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default ska-refund-all-close" data-dismiss="modal">@L["Close"]</button>
                <button type="button" class="btn btn-danger ska-refund-all-yes" disabled>
                    <span class="glyphicon glyphicon-repeat"></span> <span class="ska-refund-all-label">@L["Refund everything"]</span>
                </button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_GiftModal", Model.Skins)

@section Scripts {
    <script>
        var HubPage = {
            texts: {
                confirmRefund: @Json.Serialize(L["Refund {0} from {1}? The stars paid go back to the player, the skin is removed from their account and, if it was equipped, the weapon goes back to the default skin."].Value),
                refundDone: @Json.Serialize(L["Purchase refunded. Reloading..."].Value),
                refundAllDone: @Json.Serialize(L["{0} purchases and {1} gifts refunded. {2} stars returned to {3} players."].Value),
                refundAllFailed: @Json.Serialize(L["{0} items could not be refunded; try again to refund what is left."].Value),
                refundAllRunning: @Json.Serialize(L["Refunding..."].Value),
                confirmRefundAll: @Json.Serialize(L["Refund everything"].Value),
                errors: {
                    NotOwned: @Json.Serialize(L["The player no longer owns this skin."].Value),
                    Busy: @Json.Serialize(L["Too many operations at the same time. Try again."].Value),
                    Generic: @Json.Serialize(L["Something went wrong. Reload the page and check before trying again."].Value)
                }
            },
            purchasesUrl: @Json.Serialize(Url.Action("Purchases", "SkinsAdmin")),
            query: @Json.Serialize(Model.Query ?? string.Empty),
            playerPageUrl: @Json.Serialize(AppConsts.PlayerUrlPrefix)
        };
    </script>
    <script src="~/js/pages/skin-purchases.js" asp-append-version="true"></script>
}
