@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts
@model SkinShopSettings

@{
    ViewData["Title"] = L["Shop settings"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_SkinsAdminNav")

<div class="admin-header">
    <h3>@L["Shop settings"]</h3>
</div>

<form method="post" asp-antiforgery="true" action="@AppConsts.SkinSettingsUrl">
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>@L["Seasons"]</strong>
        </div>
        <div class="panel-body">
            <div class="checkbox" style="margin-top: 0">
                <label for="RefundAtSeasonEnd">
                    <input type="checkbox" id="RefundAtSeasonEnd" name="RefundAtSeasonEnd" value="true" checked="@Model.RefundAtSeasonEnd"/>
                    <input type="hidden" name="RefundAtSeasonEnd" value="false"/>
                    @L["Refund the skins when a season ends"]
                </label>
            </div>
            <p class="help-block" style="margin-bottom: 0">@L["When a new ranking season starts, the skins bought before it are taken back and their stars return to the players. Gifts are kept."]</p>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>@L["Assets"]</strong>
        </div>
        <div class="panel-body">
            <div class="form-group">
                <label for="AssetsUrl">@L["Address of the assets"]</label>
                <input class="form-control" id="AssetsUrl" name="AssetsUrl" value="@Model.AssetsUrl" placeholder="https://assets.example.com"/>
                <p class="help-block">
                    @L["Where the pictures published from the assets repository are served."]
                    @L["Thumbnails"]: <code>@($"/{CoreConsts.SkinThumbnailsFolder}/<id>{CoreConsts.SkinThumbnailExtension}")</code>
                    · @L["Photos"]: <code>@($"/{CoreConsts.SkinShotsFolder}/<id>/1{CoreConsts.SkinShotExtension}")</code>
                </p>
            </div>
            <div class="form-group" style="margin-bottom: 0">
                <label for="CatalogUrl">@L["Address of the catalog"]</label>
                <input class="form-control" id="CatalogUrl" name="CatalogUrl" value="@Model.CatalogUrl" placeholder="https://assets.example.com/skins/skins.json"/>
                <p class="help-block" style="margin-bottom: 0">@L["The skins.json file of the assets repository. It is downloaded when you import the catalog from the configured address."]</p>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>@L["Skin authors"]</strong>
        </div>
        <div class="panel-body">
            <div class="form-group">
                <label for="AuthorContactUrl">@L["Steam profile for contact"]</label>
                <input class="form-control" id="AuthorContactUrl" name="AuthorContactUrl" value="@Model.AuthorContactUrl" placeholder="https://steamcommunity.com/profiles/7656119..."/>
                <p class="help-block">@L["Opened by the Message me on Steam button of the notice for skin authors in the shop. Leave it empty to hide the button."]</p>
            </div>
            <div class="form-group" style="margin-bottom: 0">
                <label for="AuthorRequestUrl">@L["Address for removal requests"]</label>
                <input class="form-control" id="AuthorRequestUrl" name="AuthorRequestUrl" value="@Model.AuthorRequestUrl" placeholder="@CoreConsts.SkinAuthorRequestUrl"/>
                <p class="help-block" style="margin-bottom: 0">@L["Opened by the Open a request on GitHub button of the same notice, with the skin already filled in. Leave it empty to hide the button."]</p>
            </div>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">
        <span class="glyphicon glyphicon-ok"></span> @L["Save"]
    </button>
</form>
