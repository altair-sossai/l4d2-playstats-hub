@model ChampionshipAdminModel
@{
    var view = Model.Page;
    var pagination = PaginationModel.Of(Model.History, number => AdminListUrls.TabPage(Model.Url, AppConsts.ChampionshipAdminHistoryTab, AppConsts.ChampionshipHistoryPageQuery, number));
}

<p class="admin-lead">@L["The changes of the championship, with who made them."]</p>

@if (Model.History.TotalItems == 0)
{
    <div class="admin-list">
        <div class="admin-empty">@L["Nothing yet."]</div>
    </div>
}
else
{
    <table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table championship-history" style="margin-bottom: 0">
        <thead>
        <tr>
            <th>@L["When"]</th>
            <th>@L["Who"]</th>
            <th>@L["What"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var log in Model.History.Items)
        {
            <tr>
                <td class="vertical-align-middle text-nowrap" data-label="@L["When"]">@Display.DateTime(log.CreatedAtUtc, view.TimeZone)</td>
                <td class="vertical-align-middle" data-label="@L["Who"]">@(log.CommunityId == null ? "—" : DisplayNames.Apply(log.CommunityId.Value, view.PlayerName(log.CommunityId.Value)))</td>
                <td class="vertical-align-middle" data-label="@L["What"]">@view.LogText(log, (text, values) => L[text, values].Value)</td>
            </tr>
        }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", pagination)
}
