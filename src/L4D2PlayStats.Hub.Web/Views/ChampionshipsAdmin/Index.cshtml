@model ChampionshipsAdminIndexModel
@{
    ViewData["Title"] = L["Championships"].Value;
    var pagination = PaginationModel.Of(Model.Championships, number => AdminListUrls.Page(AppConsts.AdminChampionshipsUrl, number));
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Championships"]</h3>
    <a class="btn btn-default" href="@AppConsts.ChampionshipsUrl" target="_blank">
        <span class="glyphicon glyphicon-eye-open"></span> @L["See the page"]
    </a>
</div>

<p class="admin-lead">@L["Each championship has its participants, teams and stages. Add one with the Add button, then open it with Edit to set it up. A championship in draft is seen only by the administrators."]</p>

<div class="admin-toolbar">
    <div class="admin-toolbar-actions">
        <button class="btn btn-primary" type="button" data-toggle="modal" data-target="#championship-add-modal">
            <span class="glyphicon glyphicon-plus"></span> @L["Add"]
        </button>
    </div>
</div>

@if (Model.Championships.TotalItems == 0)
{
    <div class="admin-list">
        <div class="admin-empty">@L["No championship yet."]</div>
    </div>
}
else
{
    <table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table" style="margin-bottom: 0">
        <thead>
        <tr>
            <th>@L["Championship"]</th>
            <th>@L["Status"]</th>
            <th class="text-center">@L["Teams"]</th>
            <th class="text-center">@L["Participants"]</th>
            <th>@L["Champion"]</th>
            <th class="text-center">@L["Created"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Championships.Items)
        {
            <tr>
                <td class="vertical-align-middle" data-label="@L["Championship"]">
                    <a href="@ChampionshipUrls.Admin(item.Id)"><span class="text-underline">@item.Name</span></a>
                    <br/><small class="text-muted admin-mono">@ChampionshipUrls.Page(item.Slug)</small>
                </td>
                <td class="vertical-align-middle" data-label="@L["Status"]"><span class="label @ChampionshipTexts.StatusLabel(item.Status)">@ChampionshipTexts.Status(L, item.Status)</span></td>
                <td class="text-center vertical-align-middle" data-label="@L["Teams"]">@Display.Number(item.Teams)</td>
                <td class="text-center vertical-align-middle" data-label="@L["Participants"]">@Display.Number(item.Participants)</td>
                <td class="vertical-align-middle" data-label="@L["Champion"]">@item.Champion</td>
                <td class="text-center vertical-align-middle" data-label="@L["Created"]">@Display.Date(item.CreatedAtUtc, Model.TimeZone)</td>
                <td class="text-center vertical-align-middle slim admin-actions admin-row-actions">
                    <a class="btn btn-xs btn-default" href="@ChampionshipUrls.Admin(item.Id)">
                        <span class="glyphicon glyphicon-pencil"></span> @L["Edit"]
                    </a>
                    <form method="post" asp-antiforgery="true" action="@(ChampionshipUrls.Admin(item.Id))/delete" data-confirm="@L["Delete the championship {0} and everything in it?", item.Name]">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                        <button class="btn btn-xs btn-danger" type="submit">
                            <span class="glyphicon glyphicon-trash"></span> @L["Delete"]
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", pagination)
}

<div class="modal fade" id="championship-add-modal" tabindex="-1" role="dialog" aria-labelledby="championship-add-title">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" asp-antiforgery="true" action="@AppConsts.AdminChampionshipsUrl" data-confirm="@L["Create this championship? It starts as a draft, seen only by the administrators."]">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="championship-add-title">@L["Add a championship"]</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="championship-name">@L["Name"] @FieldHelp.Tip(L["The name shown on the site. The address of the page is made from it and can be changed in the settings."])</label>
                    <input class="form-control" id="championship-name" name="name" required maxlength="@L4D2PlayStats.Hub.Core.AppConsts.ChampionshipNameMaxLength" autocomplete="off" placeholder="@L["Championship 2027"]">
                </div>
                <div class="form-group" style="margin-bottom: 0">
                    <label for="championship-template">@L["Format"] @FieldHelp.More(L["The stages the championship starts with. Everything can be changed later."], L["Format"], L["Round robin: one league where every team plays every other team.\nRound robin + knockout: a league, and the four best play a knockout in best of three.\nKnockout: only a knockout in best of three, with the bracket drawn.\nGroups + knockout: two groups, and the two best of each group play a knockout.\nThe stages, the number of games and the rules of the campaigns can be changed on the Stages page until each stage is built."])</label>
                    <select class="form-control" id="championship-template" name="template">
                        @foreach (var template in Enum.GetValues<ChampionshipTemplate>())
                        {
                            <option value="@template">@ChampionshipTexts.Template(L, template)</option>
                        }
                    </select>
                </div>
                <p class="help-block" style="margin: 10px 0 0">@L["After saving, the page of the championship opens so you can add the participants and the teams."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">
                    <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                </button>
            </div>
        </form>
    </div>
</div>
