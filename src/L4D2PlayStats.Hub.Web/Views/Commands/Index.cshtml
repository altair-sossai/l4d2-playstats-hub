@model CommandsViewModel
@inject ISettingsService Settings

@{
    var site = await Settings.GetAsync<SiteSettings>();
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Commands"],
        Description = L["Every command of the {0} game server, explained with examples.", site.Name]
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/commands-index.css" asp-append-version="true"/>
    <style>
        .cmd-page {
            --cmd-accent: @(light ? "#008cba" : "#5bc0de");
            --cmd-name: @(light ? "#0b5f80" : "#9fdcf0");
            --cmd-name-bg: @(light ? "rgba(0, 140, 186, .08)" : "rgba(91, 192, 222, .12)");
            --cmd-name-border: @(light ? "rgba(0, 140, 186, .35)" : "rgba(91, 192, 222, .4)");
            --cmd-who: @(light ? "#2b6f45" : "#8fd88f");
            --cmd-who-bg: @(light ? "rgba(67, 172, 106, .12)" : "rgba(98, 196, 98, .14)");
            --cmd-when: @(light ? "#8a5300" : "#f5c27a");
            --cmd-when-bg: @(light ? "rgba(233, 144, 2, .13)" : "rgba(240, 173, 78, .14)");
            --cmd-admin: @(light ? "#b3260f" : "#f28b88");
            --cmd-admin-bg: @(light ? "rgba(240, 65, 36, .1)" : "rgba(238, 95, 91, .15)");
            --cmd-card-bg: @(light ? "#ffffff" : "rgba(255, 255, 255, .03)");
            --cmd-border: @(light ? "#dddddd" : "rgba(0, 0, 0, .45)");
            --cmd-code-bg: @(light ? "#f3f5f7" : "rgba(0, 0, 0, .28)");
            --cmd-muted: @(light ? "#6f6f6f" : "#9aa0a8");
        }
    </style>
}

<div class="cmd-page" id="cmd-page">
    <div class="cmd-hero">
        <h1><span class="glyphicon glyphicon-console" aria-hidden="true"></span>@L["Commands"]</h1>
        <p class="lead">@L["Every command you can use on the game server, explained with examples."]</p>
        <div class="cmd-search">
            <span class="glyphicon glyphicon-search" aria-hidden="true"></span>
            <input type="search" id="cmd-search" class="form-control" autocomplete="off" spellcheck="false" placeholder="@L["Search a command: mix, pause, tank..."]" aria-label="@L["Search commands"]">
        </div>
        <div class="cmd-count" id="cmd-count" aria-live="polite" data-found="@L["{0} command(s) found"]"></div>
    </div>

    <nav class="cmd-chips" id="cmd-chips" aria-label="@L["Sections"]">
        @foreach (var group in Model.Sections)
        {
            <a href="#@group.Anchor" data-section="@group.Anchor" class="@(group.Admin ? "cmd-chip-admin" : null)">
                <span class="glyphicon @(AppConsts.CommandsGlyphiconPrefix + group.Icon)" aria-hidden="true"></span>@group.Title
            </a>
        }
    </nav>

    <div class="alert alert-info cmd-hidden" id="cmd-empty">@L["No command matches your search."]</div>

    @foreach (var group in Model.PlayerSections)
    {
        <section class="cmd-section" id="@group.Anchor">
            <h2 class="cmd-section-title"><span class="glyphicon @(AppConsts.CommandsGlyphiconPrefix + group.Icon)" aria-hidden="true"></span>@group.Title</h2>
            <p class="cmd-section-intro">@CommandText.Format(group.Intro)</p>
            <div class="cmd-grid">
                @foreach (var command in group.Commands)
                {
                    <partial name="_CommandCard" model="(command, group.Admin)"/>
                }
            </div>
        </section>
    }

    @foreach (var group in Model.AdminSections)
    {
        var body = $"{group.Anchor}-body";

        <section class="cmd-section cmd-admin" id="@group.Anchor">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <a href="#@body" class="collapsed" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="@body">
                        <h2 class="panel-title"><span class="glyphicon @(AppConsts.CommandsGlyphiconPrefix + group.Icon)" aria-hidden="true"></span>@group.Title</h2>
                        <span class="glyphicon glyphicon-chevron-down cmd-toggle" aria-hidden="true"></span>
                    </a>
                </div>
                <div id="@body" class="panel-collapse collapse">
                    <div class="panel-body">
                        <p class="cmd-section-intro">@CommandText.Format(group.Intro)</p>
                        <div class="cmd-grid">
                            @foreach (var command in group.Commands)
                            {
                                <partial name="_CommandCard" model="(command, group.Admin)"/>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('cmd-search');
            var count = document.getElementById('cmd-count');
            var empty = document.getElementById('cmd-empty');
            var cards = Array.prototype.slice.call(document.querySelectorAll('#cmd-page .cmd-card'));
            var sections = Array.prototype.slice.call(document.querySelectorAll('#cmd-page .cmd-section'));
            var chips = Array.prototype.slice.call(document.querySelectorAll('#cmd-chips a'));

            function normalize(text) {
                return (text || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
            }

            cards.forEach(function (card) {
                card.setAttribute('data-search', normalize(card.textContent));
            });

            function openAdmin(section) {
                var body = section.querySelector('.panel-collapse');

                if (body && !body.classList.contains('in'))
                    $(body).collapse('show');
            }

            function filter() {
                var terms = normalize(input.value).split(' ').filter(function (term) { return term.length > 0; });
                var total = 0;

                cards.forEach(function (card) {
                    var text = card.getAttribute('data-search');
                    var match = terms.every(function (term) { return text.indexOf(term) >= 0; });

                    card.classList.toggle('cmd-hidden', !match);

                    if (match)
                        total++;
                });

                sections.forEach(function (section) {
                    var visible = section.querySelector('.cmd-card:not(.cmd-hidden)') !== null;
                    var chip = document.querySelector('#cmd-chips a[data-section="' + section.id + '"]');

                    section.classList.toggle('cmd-hidden', !visible);

                    if (chip)
                        chip.classList.toggle('cmd-hidden', !visible);

                    if (visible && terms.length > 0 && section.classList.contains('cmd-admin'))
                        openAdmin(section);
                });

                empty.classList.toggle('cmd-hidden', terms.length === 0 || total > 0);
                count.textContent = terms.length === 0 ? '' : count.getAttribute('data-found').replace('{0}', total);
            }

            input.addEventListener('input', filter);

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    var section = document.getElementById(chip.getAttribute('data-section'));

                    if (section && section.classList.contains('cmd-admin'))
                        openAdmin(section);
                });
            });

            if (window.location.hash) {
                var target = document.getElementById(window.location.hash.substring(1));

                if (target && target.classList.contains('cmd-admin'))
                    openAdmin(target);
            }
        })();
    </script>
}
