@inject ISettingsService Settings
@{
    var site = await Settings.GetAsync<SiteSettings>();
    ViewData["Title"] = site.Name;
}
<div class="py-5 text-center">
    <h1 class="display-6">@site.Name</h1>
    <p class="lead text-body-secondary">@L["Use the menu to see what is available on this site."]</p>
</div>
