@model RankingViewModel
@{
    var title = Model.Scope switch
    {
        RankingScope.Season => Display.SeasonName(Model.Season!),
        RankingScope.Year => Model.Year!.Value.ToString(),
        _ => L["All time"].Value
    };

    ViewData["Title"] = $"{L["Ranking"].Value} {title}";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@L["Ranking"]</h1>
        <div class="text-body-secondary">
            @title
            @if (Model.Current)
            {
                <span class="badge text-bg-success ms-1">@L["Current season"]</span>
            }
        </div>
    </div>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Seasons"]</button>
        <ul class="dropdown-menu dropdown-menu-end" style="max-height: 60vh; overflow-y: auto;">
            <li><a class="dropdown-item" href="/ranking/all-time">@L["All time"]</a></li>
            @foreach (var year in Model.Years)
            {
                <li><a class="dropdown-item" href="/ranking/year/@year">@L["Year"] @year</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            @foreach (var season in Model.Seasons)
            {
                <li><a class="dropdown-item" href="/ranking/season/@season.Id">@Display.SeasonName(season)</a></li>
            }
        </ul>
    </div>
</div>

@if (Model.Players.Count == 0)
{
    <div class="alert alert-secondary">@L["No ranked matches in this period yet."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th class="position">#</th>
                <th>@L["Player"]</th>
                <th>@L["Patent"]</th>
                <th class="numeric">@L["Experience"]</th>
                <th class="numeric">@L["Wins"]</th>
                <th class="numeric">@L["Losses"]</th>
                <th class="numeric">@L["Win rate"]</th>
                <th class="numeric">@L["MVPs"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Players)
            {
                var player = row.Player;
                var difference = player.ExperienceDifference;

                <tr class="@(player.CommunityId == Model.Highlight ? "row-highlight" : "")">
                    <td class="position @(player.Position == 1 ? "position-1" : "")">@player.Position</td>
                    <td>
                        <a class="text-decoration-none d-flex align-items-center gap-2" href="/player/@player.CommunityId@(Model.Season != null ? $"?season={Model.Season.Id}" : "")">
                            <img class="avatar" src="/avatar/@player.CommunityId" alt="" loading="lazy">
                            <span>@player.MainName</span>
                        </a>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <img class="patent" src="@row.Progress.Patent.Image" alt="@row.Progress.Patent.Name" title="@row.Progress.Patent.Name">
                            <div class="progress progress-thin flex-grow-1" role="progressbar" aria-label="@L["Progress to the next patent"]" aria-valuenow="@((int)(row.Progress.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @((int)(row.Progress.Progress * 100))%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="numeric">
                        @Display.Number(player.Experience)
                        @if (difference is > 0)
                        {
                            <small class="text-win">+@Display.Number(difference.Value)</small>
                        }
                        else if (difference is < 0)
                        {
                            <small class="text-loss">@Display.Number(difference.Value)</small>
                        }
                    </td>
                    <td class="numeric">@player.Wins</td>
                    <td class="numeric">@player.Loss</td>
                    <td class="numeric">@Display.Percent(player.WinRate)</td>
                    <td class="numeric">@player.Stars</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
