@model CampaignsViewModel
@{
    ViewData["Title"] = L["Campaigns"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Campaigns"]</h3>
</div>

<p class="admin-lead">@L["Maps played one after the other in the order below form a single match. Add your custom campaigns here, one map per line, in play order."]</p>

<div class="admin-columns">
    @foreach (var campaign in Model.Campaigns)
    {
        <form class="panel panel-default admin-card" method="post" asp-antiforgery="true" action="/admin/campaigns">
            <div class="panel-body">
                <input type="hidden" name="Id" value="@campaign.Id">
                <div class="form-group">
                    <input class="form-control input-sm bold" name="Name" value="@campaign.Name" required aria-label="@L["Name"]">
                </div>
                <textarea class="form-control input-sm admin-mono" name="Maps" rows="@Math.Max(4, campaign.Maps.Count)" aria-label="@L["Maps"]">@string.Join("\n", campaign.Maps.OrderBy(m => m.Order).Select(m => m.MapName))</textarea>
            </div>
            <div class="panel-footer">
                <button class="btn btn-sm btn-primary" type="submit">@L["Save"]</button>
                <button class="btn btn-sm btn-danger pull-right" type="submit" formaction="/admin/campaigns/@campaign.Id/delete" onclick="return confirm('@L["Delete this campaign?"]')">
                    <span class="glyphicon glyphicon-trash"></span> @L["Delete"]
                </button>
            </div>
        </form>
    }
    <form class="panel panel-success admin-card" method="post" asp-antiforgery="true" action="/admin/campaigns">
        <div class="panel-body">
            <div class="form-group">
                <input class="form-control input-sm" name="Name" placeholder="@L["New campaign"]" required aria-label="@L["Name"]">
            </div>
            <textarea class="form-control input-sm admin-mono" name="Maps" rows="5" placeholder="map_1&#10;map_2" required aria-label="@L["Maps"]"></textarea>
        </div>
        <div class="panel-footer">
            <button class="btn btn-sm btn-success" type="submit">
                <span class="glyphicon glyphicon-plus"></span> @L["Add"]
            </button>
        </div>
    </form>
</div>
