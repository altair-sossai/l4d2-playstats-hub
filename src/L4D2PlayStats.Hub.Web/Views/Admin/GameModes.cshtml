@model GameModesViewModel
@{
    ViewData["Title"] = L["Game modes"].Value;
    const string newRuleForm = "rule-new";
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Game modes"]</h3>
</div>

<p class="admin-lead">
    @L["A match counts toward the ranking when the first rule that fits its configuration says so. Rules are checked in order of priority, lowest first. In the pattern, * stands for any text, which lets one rule cover every version of a configuration."]
</p>

<h4 class="admin-section">@L["Rules"]</h4>

<table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table">
    <thead>
    <tr>
        <th>@L["Name"] @FieldHelp.Tip(L["A label for you, such as 4v4 or 1v1 practice. It shows in the list of configurations seen on your servers."])</th>
        <th>@L["Configuration pattern"] @FieldHelp.More(L["The configuration names the rule covers. * stands for any text and ? for one character."], L["Configuration pattern"], L["Every statistics file carries the name of the configuration the server was running, such as ZoneMod v2.9.2b. The rule covers a configuration when its name fits this pattern.\n* stands for any text and ? for exactly one character. Upper and lower case do not matter. * alone covers every configuration.\nExamples: ZoneMod* covers every version of ZoneMod; *Practice* covers any name that contains Practice; ZoneMod v2.9.2b covers only that exact name.\nThe list Configurations seen on your servers, below, shows which rule applies to each configuration."])</th>
        <th class="text-center">@L["Team size"] @FieldHelp.Tip(L["Players per team the rule covers, from 1 to 8. Empty means any team size."])</th>
        <th class="text-center">@L["Minimum maps"] @FieldHelp.Tip(L["How many maps a match needs to be ranked under this rule. A shorter match is casual. At least 1."])</th>
        <th class="text-center">@L["Priority"] @FieldHelp.More(L["The order in which the rules are checked, lowest number first. The first rule that fits is the one used."], L["Priority"], L["For each match, the site checks the rules from the lowest priority number to the highest and uses only the first one that fits its configuration and team size. The other rules are ignored for that match.\nGive specific rules a low number and general ones a high number. For example: a rule Practice, pattern *Practice*, priority 10, that does not count, and then the rule 4v4, pattern *, priority 100, that counts. Practice matches stay casual and every other 4v4 match is ranked.\nThe default rule 4v4 has priority 100."])</th>
        <th class="text-center">@L["Counts for the ranking"] @FieldHelp.Tip(L["Yes: the matches the rule covers that have enough maps are ranked and give experience, wins, losses and stars. No: they are casual."])</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var rule in Model.Rules)
    {
        var form = $"rule-{rule.Id}";

        <tr>
            <td class="vertical-align-middle" data-label="@L["Name"]">
                <input class="form-control input-sm" form="@form" name="Name" value="@rule.Name" required aria-label="@L["Name"]">
            </td>
            <td class="vertical-align-middle" data-label="@L["Configuration pattern"]">
                <input class="form-control input-sm admin-mono" form="@form" name="ConfigurationPattern" value="@rule.ConfigurationPattern" required aria-label="@L["Configuration pattern"]">
            </td>
            <td class="vertical-align-middle slim" data-label="@L["Team size"]">
                <input class="form-control input-sm text-center" form="@form" name="TeamSize" type="number" min="1" max="8" value="@rule.TeamSize" placeholder="@L["Any"]" aria-label="@L["Team size"]">
            </td>
            <td class="vertical-align-middle slim" data-label="@L["Minimum maps"]">
                <input class="form-control input-sm text-center" form="@form" name="MinimumMaps" type="number" min="1" value="@rule.MinimumMaps" aria-label="@L["Minimum maps"]">
            </td>
            <td class="vertical-align-middle slim" data-label="@L["Priority"]">
                <input class="form-control input-sm text-center" form="@form" name="Priority" type="number" value="@rule.Priority" aria-label="@L["Priority"]">
            </td>
            <td class="vertical-align-middle slim" data-label="@L["Counts for the ranking"]">
                <select class="form-control input-sm" form="@form" name="CountsForRanking" aria-label="@L["Counts for the ranking"]">
                    <option value="true" selected="@rule.CountsForRanking">@L["Yes"]</option>
                    <option value="false" selected="@(!rule.CountsForRanking)">@L["No"]</option>
                </select>
            </td>
            <td class="text-center vertical-align-middle slim admin-actions">
                <form id="@form" method="post" asp-antiforgery="true" action="/admin/game-modes">
                    <input type="hidden" name="Id" value="@rule.Id">
                    <button class="btn btn-sm btn-primary" type="submit">@L["Save"]</button>
                    <button class="btn btn-sm btn-danger" type="submit" formaction="/admin/game-modes/@rule.Id/delete" onclick="return confirm('@L["Delete this rule?"]')">
                        <span class="glyphicon glyphicon-trash"></span> @L["Delete"]
                    </button>
                </form>
            </td>
        </tr>
    }
    <tr>
        <td class="vertical-align-middle" data-label="@L["Name"]">
            <input class="form-control input-sm" form="@newRuleForm" name="Name" placeholder="@L["New rule"]" required aria-label="@L["Name"]">
        </td>
        <td class="vertical-align-middle" data-label="@L["Configuration pattern"]">
            <input class="form-control input-sm admin-mono" form="@newRuleForm" name="ConfigurationPattern" value="*" required aria-label="@L["Configuration pattern"]">
        </td>
        <td class="vertical-align-middle slim" data-label="@L["Team size"]">
            <input class="form-control input-sm text-center" form="@newRuleForm" name="TeamSize" type="number" min="1" max="8" placeholder="@L["Any"]" aria-label="@L["Team size"]">
        </td>
        <td class="vertical-align-middle slim" data-label="@L["Minimum maps"]">
            <input class="form-control input-sm text-center" form="@newRuleForm" name="MinimumMaps" type="number" min="1" value="2" aria-label="@L["Minimum maps"]">
        </td>
        <td class="vertical-align-middle slim" data-label="@L["Priority"]">
            <input class="form-control input-sm text-center" form="@newRuleForm" name="Priority" type="number" value="50" aria-label="@L["Priority"]">
        </td>
        <td class="vertical-align-middle slim" data-label="@L["Counts for the ranking"]">
            <select class="form-control input-sm" form="@newRuleForm" name="CountsForRanking" aria-label="@L["Counts for the ranking"]">
                <option value="true">@L["Yes"]</option>
                <option value="false">@L["No"]</option>
            </select>
        </td>
        <td class="text-center vertical-align-middle slim admin-actions">
            <form id="@newRuleForm" method="post" asp-antiforgery="true" action="/admin/game-modes">
                <button class="btn btn-sm btn-success" type="submit">
                    <span class="glyphicon glyphicon-plus"></span> @L["Add"]
                </button>
            </form>
        </td>
    </tr>
    </tbody>
</table>

<h4 class="admin-section">@L["Configurations seen on your servers"]</h4>

@if (Model.Configurations.Count == 0)
{
    <div class="admin-list">
        <div class="admin-empty">@L["Nothing yet. Configurations appear here when the first statistics files arrive."]</div>
    </div>
}
else
{
    <table class="table table-striped table-hover table-bordered table-condensed table-responsive">
        <thead>
        <tr>
            <th>@L["Configuration"]</th>
            <th class="text-center">@L["Team size"]</th>
            <th class="text-center">@L["Last seen"]</th>
            <th>@L["Rule"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var seen in Model.Configurations)
        {
            <tr>
                <td class="vertical-align-middle" data-label="@L["Configuration"]">@seen.Configuration.Name</td>
                <td class="text-center vertical-align-middle" data-label="@L["Team size"]">@seen.Configuration.TeamSize</td>
                <td class="text-center vertical-align-middle" data-label="@L["Last seen"]">@seen.Configuration.LastSeenAtUtc.ToString("d")</td>
                <td class="vertical-align-middle" data-label="@L["Rule"]">
                    @if (seen.Rule == null)
                    {
                        <span class="label label-warning">@L["No rule: not ranked"]</span>
                    }
                    else if (seen.Rule.CountsForRanking)
                    {
                        <span class="label label-success">@seen.Rule.Name</span>
                    }
                    else
                    {
                        <span class="label label-default">@seen.Rule.Name: @L["Not ranked"]</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
