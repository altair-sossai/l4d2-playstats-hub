@model GameModesViewModel
@{
    ViewData["Title"] = L["Game modes"].Value;
}
<h1 class="h3">@L["Game modes"]</h1>
<partial name="_AdminNav"/>

<p class="text-body-secondary">
    @L["A match counts toward the ranking when the first rule that fits its configuration says so. Rules are checked in order of priority, lowest first. In the pattern, * stands for any text, which lets one rule cover every version of a configuration."]
</p>

<h2 class="h5">@L["Rules"]</h2>
<div class="table-responsive mb-4">
    <table class="table">
        <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Configuration pattern"]</th>
            <th>@L["Team size"]</th>
            <th>@L["Minimum maps"]</th>
            <th>@L["Priority"]</th>
            <th>@L["Counts for the ranking"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var rule in Model.Rules)
        {
            <tr>
                <td colspan="7" class="p-0">
                    <form class="row g-2 align-items-center m-0 p-2" method="post" asp-antiforgery="true" action="/admin/game-modes">
                        <input type="hidden" name="Id" value="@rule.Id">
                        <div class="col-md-2"><input class="form-control form-control-sm" name="Name" value="@rule.Name" required aria-label="@L["Name"]"></div>
                        <div class="col-md-3"><input class="form-control form-control-sm" name="ConfigurationPattern" value="@rule.ConfigurationPattern" required aria-label="@L["Configuration pattern"]"></div>
                        <div class="col-md-1"><input class="form-control form-control-sm" name="TeamSize" type="number" min="1" max="8" value="@rule.TeamSize" placeholder="@L["Any"]" aria-label="@L["Team size"]"></div>
                        <div class="col-md-1"><input class="form-control form-control-sm" name="MinimumMaps" type="number" min="1" value="@rule.MinimumMaps" aria-label="@L["Minimum maps"]"></div>
                        <div class="col-md-1"><input class="form-control form-control-sm" name="Priority" type="number" value="@rule.Priority" aria-label="@L["Priority"]"></div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" name="CountsForRanking" aria-label="@L["Counts for the ranking"]">
                                <option value="true" selected="@rule.CountsForRanking">@L["Yes"]</option>
                                <option value="false" selected="@(!rule.CountsForRanking)">@L["No"]</option>
                            </select>
                        </div>
                        <div class="col-md-2 text-end">
                            <button class="btn btn-sm btn-primary" type="submit">@L["Save"]</button>
                            <button class="btn btn-sm btn-outline-danger" type="submit" formaction="/admin/game-modes/@rule.Id/delete" onclick="return confirm('@L["Delete this rule?"]')">@L["Delete"]</button>
                        </div>
                    </form>
                </td>
            </tr>
        }
        <tr>
            <td colspan="7" class="p-0">
                <form class="row g-2 align-items-center m-0 p-2" method="post" asp-antiforgery="true" action="/admin/game-modes">
                    <div class="col-md-2"><input class="form-control form-control-sm" name="Name" placeholder="@L["New rule"]" required aria-label="@L["Name"]"></div>
                    <div class="col-md-3"><input class="form-control form-control-sm" name="ConfigurationPattern" value="*" required aria-label="@L["Configuration pattern"]"></div>
                    <div class="col-md-1"><input class="form-control form-control-sm" name="TeamSize" type="number" min="1" max="8" placeholder="@L["Any"]" aria-label="@L["Team size"]"></div>
                    <div class="col-md-1"><input class="form-control form-control-sm" name="MinimumMaps" type="number" min="1" value="2" aria-label="@L["Minimum maps"]"></div>
                    <div class="col-md-1"><input class="form-control form-control-sm" name="Priority" type="number" value="50" aria-label="@L["Priority"]"></div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="CountsForRanking" aria-label="@L["Counts for the ranking"]">
                            <option value="true">@L["Yes"]</option>
                            <option value="false">@L["No"]</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end"><button class="btn btn-sm btn-success" type="submit">@L["Add"]</button></div>
                </form>
            </td>
        </tr>
        </tbody>
    </table>
</div>

<h2 class="h5">@L["Configurations seen on your servers"]</h2>
@if (Model.Configurations.Count == 0)
{
    <div class="alert alert-secondary">@L["Nothing yet. Configurations appear here when the first statistics files arrive."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
            <tr>
                <th>@L["Configuration"]</th>
                <th>@L["Team size"]</th>
                <th>@L["Last seen"]</th>
                <th>@L["Rule"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var seen in Model.Configurations)
            {
                <tr>
                    <td>@seen.Configuration.Name</td>
                    <td>@seen.Configuration.TeamSize</td>
                    <td>@seen.Configuration.LastSeenAtUtc.ToString("d")</td>
                    <td>
                        @if (seen.Rule == null)
                        {
                            <span class="badge text-bg-warning">@L["No rule: not ranked"]</span>
                        }
                        else if (seen.Rule.CountsForRanking)
                        {
                            <span class="badge text-bg-success">@seen.Rule.Name</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@seen.Rule.Name: @L["Not ranked"]</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
