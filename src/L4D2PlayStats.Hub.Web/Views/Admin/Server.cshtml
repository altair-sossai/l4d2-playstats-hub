@model ServerViewModel
@{
    var server = Model.Status.Server;
    ViewData["Title"] = server.Name;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

@section Scripts {
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
}

<div class="admin-header">
    <h3>@server.Name</h3>
    <a class="btn btn-default" href="/admin/servers">
        <span class="glyphicon glyphicon-chevron-left"></span> @L["Game servers"]
    </a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["How to connect this server"]</h3>
            </div>
            <div class="panel-body">
                <partial name="_ServerInstructions" model="Model"/>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Status"]</h3>
            </div>
            <div class="panel-body">
                <partial name="_ServerStatus" model="Model.Status"/>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <form method="post" asp-antiforgery="true" action="/admin/servers/@server.Id">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["Details"]</h3>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label for="Name">@L["Server name"] @FieldHelp.Tip(L["The name shown on the site, as players know the server. The identifier is made from the name when the server is created and does not change when you rename it."])</label>
                        <input class="form-control" id="Name" name="Name" value="@server.Name" required maxlength="100">
                    </div>
                    <div class="form-group">
                        <label for="Address">@L["Address players connect to (optional)"] @FieldHelp.Tip(L["Where players connect, such as play.example.com:27015 or an IP and port. The live server page shows it with a copy button and uses it for the connect button."])</label>
                        <input class="form-control" id="Address" name="Address" value="@server.Address" maxlength="200">
                    </div>
                    <div class="form-group">
                        <label for="AlternativeAddress">@L["Alternative address, such as a DNS name (optional)"] @FieldHelp.Tip(L["A second way to connect, such as a DNS name when the main address is an IP. Shown next to the address on the live server page."])</label>
                        <input class="form-control" id="AlternativeAddress" name="AlternativeAddress" value="@server.AlternativeAddress" maxlength="200">
                    </div>
                    <div class="checkbox">
                        <label for="Enabled">
                            <input type="checkbox" id="Enabled" name="Enabled" value="true" checked="@server.Enabled">
                            <input type="hidden" name="Enabled" value="false">
                            @L["Enabled"] @FieldHelp.Tip(L["A disabled server is not shown on the live server page, and the site refuses what it sends. Its files and matches are kept."])
                        </label>
                    </div>
                    <p class="text-muted" style="margin-bottom: 0">
                        <small>@L["Identifier"]: <code>@server.PublicId</code></small>
                    </p>
                </div>
            </div>
            @await Html.PartialAsync("_FormSaveButton")
        </form>
        <div class="panel panel-warning">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Key"]</h3>
            </div>
            <div class="panel-body">
                <p>@L["Generating a new key disconnects the game server until its configuration has the new token."]</p>
                <form style="display: inline-block" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/key" data-confirm="@L["Generate a new key?"]">
                    <button class="btn btn-warning btn-sm" type="submit">
                        <span class="glyphicon glyphicon-refresh"></span> @L["Generate a new key"]
                    </button>
                </form>
                <form style="display: inline-block" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/delete" data-confirm="@L["Delete this server?"]">
                    <button class="btn btn-danger btn-sm" type="submit">
                        <span class="glyphicon glyphicon-trash"></span> @L["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
