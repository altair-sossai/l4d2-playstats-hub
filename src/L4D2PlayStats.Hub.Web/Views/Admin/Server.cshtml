@model ServerViewModel
@{
    var server = Model.Status.Server;
    ViewData["Title"] = server.Name;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

@section Scripts {
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
}

<div class="admin-header">
    <h3>@server.Name</h3>
    <a class="btn btn-default" href="/admin/servers">
        <span class="glyphicon glyphicon-chevron-left"></span> @L["Game servers"]
    </a>
</div>

<partial name="_AdminNav"/>

<div class="row">
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["How to connect this server"]</h3>
            </div>
            <div class="panel-body">
                <partial name="_ServerInstructions" model="Model"/>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Status"]</h3>
            </div>
            <div class="panel-body">
                <partial name="_ServerStatus" model="Model.Status"/>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Details"]</h3>
            </div>
            <div class="panel-body">
                <form method="post" asp-antiforgery="true" action="/admin/servers/@server.Id">
                    <div class="form-group">
                        <label for="Name">@L["Server name"]</label>
                        <input class="form-control" id="Name" name="Name" value="@server.Name" required maxlength="100">
                    </div>
                    <div class="form-group">
                        <label for="Address">@L["Address players connect to (optional)"]</label>
                        <input class="form-control" id="Address" name="Address" value="@server.Address" maxlength="200">
                    </div>
                    <div class="checkbox">
                        <label for="Enabled">
                            <input type="checkbox" id="Enabled" name="Enabled" value="true" checked="@server.Enabled">
                            <input type="hidden" name="Enabled" value="false">
                            @L["Enabled"]
                        </label>
                    </div>
                    <p class="text-muted">
                        <small>@L["Identifier"]: <code>@server.PublicId</code></small>
                    </p>
                    <button class="btn btn-primary" type="submit">@L["Save"]</button>
                </form>
            </div>
        </div>
        <div class="panel panel-warning">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Key"]</h3>
            </div>
            <div class="panel-body">
                <p>@L["Generating a new key disconnects the game server until its configuration has the new token."]</p>
                <form style="display: inline-block" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/key" onsubmit="return confirm('@L["Generate a new key?"]')">
                    <button class="btn btn-warning btn-sm" type="submit">
                        <span class="glyphicon glyphicon-refresh"></span> @L["Generate a new key"]
                    </button>
                </form>
                <form style="display: inline-block" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/delete" onsubmit="return confirm('@L["Delete this server?"]')">
                    <button class="btn btn-danger btn-sm" type="submit">
                        <span class="glyphicon glyphicon-trash"></span> @L["Delete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
