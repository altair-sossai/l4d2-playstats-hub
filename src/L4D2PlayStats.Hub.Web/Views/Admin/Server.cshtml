@model ServerViewModel
@{
    var server = Model.Status.Server;
    ViewData["Title"] = server.Name;
}
<h1 class="h3">@server.Name</h1>
<partial name="_AdminNav"/>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">@L["How to connect this server"]</div>
            <div class="card-body">
                <partial name="_ServerInstructions" model="Model"/>
            </div>
        </div>
        <div class="card">
            <div class="card-header">@L["Status"]</div>
            <div class="card-body">
                <partial name="_ServerStatus" model="Model.Status"/>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">@L["Details"]</div>
            <div class="card-body">
                <form method="post" asp-antiforgery="true" action="/admin/servers/@server.Id">
                    <div class="mb-3">
                        <label class="form-label" for="Name">@L["Server name"]</label>
                        <input class="form-control" id="Name" name="Name" value="@server.Name" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Address">@L["Address players connect to (optional)"]</label>
                        <input class="form-control" id="Address" name="Address" value="@server.Address" maxlength="200">
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="Enabled" name="Enabled" value="true" checked="@server.Enabled">
                        <input type="hidden" name="Enabled" value="false">
                        <label class="form-check-label" for="Enabled">@L["Enabled"]</label>
                    </div>
                    <div class="mb-3 small text-body-secondary">@L["Identifier"]: <code>@server.PublicId</code></div>
                    <button class="btn btn-primary" type="submit">@L["Save"]</button>
                </form>
            </div>
        </div>
        <div class="card border-warning">
            <div class="card-header">@L["Key"]</div>
            <div class="card-body">
                <p class="small">@L["Generating a new key disconnects the game server until its configuration has the new token."]</p>
                <form class="d-inline" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/key" onsubmit="return confirm('@L["Generate a new key?"]')">
                    <button class="btn btn-outline-warning btn-sm" type="submit">@L["Generate a new key"]</button>
                </form>
                <form class="d-inline" method="post" asp-antiforgery="true" action="/admin/servers/@server.Id/delete" onsubmit="return confirm('@L["Delete this server?"]')">
                    <button class="btn btn-outline-danger btn-sm" type="submit">@L["Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
