@model ModuleSettings
@{
    ViewData["Title"] = L["Modules"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Modules"]</h3>
</div>

<p class="admin-lead">@L["A module that is off disappears from the menu and its pages stop answering."]</p>

<div class="row">
    <div class="col-md-8">
        <form class="panel panel-default" method="post" asp-antiforgery="true" action="/admin/modules">
            <div class="panel-body">
                <partial name="_ModuleSwitches" model="Model"/>
            </div>
            <div class="panel-footer">
                <button class="btn btn-primary" type="submit">@L["Save"]</button>
            </div>
        </form>
    </div>
</div>