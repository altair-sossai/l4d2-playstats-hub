@model ModuleSettings
@{
    ViewData["Title"] = L["Modules"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Modules"]</h3>
</div>

<p class="admin-lead">@L["A module that is off disappears from the menu and its pages stop answering."]</p>

<div class="row">
    <div class="col-md-8">
        <form method="post" asp-antiforgery="true" action="/admin/modules" data-confirm="@L["Save the modules? A module turned off hides its pages and menu items, and its data is kept."]">
            <div class="panel panel-default">
                <div class="panel-body">
                    <partial name="_ModuleSwitches" model="Model"/>
                </div>
            </div>
            @await Html.PartialAsync("_FormSaveButton")
        </form>
    </div>
</div>
