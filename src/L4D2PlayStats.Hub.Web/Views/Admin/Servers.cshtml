@model List<ServerStatusViewModel>
@inject ISettingsService Settings
@using CoreConsts = L4D2PlayStats.Hub.Core.AppConsts
@{
    var live = await Settings.GetAsync<LiveServerSettings>();
    ViewData["Title"] = L["Game servers"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3>@L["Game servers"]</h3>
</div>

@if (Model.Count > 0)
{
    <table class="table table-striped table-hover table-bordered table-condensed table-responsive">
        <thead>
        <tr>
            <th>@L["Server"]</th>
            <th>@L["Identifier"]</th>
            <th>@L["Status"]</th>
            <th class="text-center">@L["Statistics files"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var server in Model)
        {
            <tr>
                <td class="vertical-align-middle" data-label="@L["Server"]">
                    <a href="/admin/servers/@server.Server.Id"><u>@server.Server.Name</u></a>
                    @if (!server.Server.Enabled)
                    {
                        <span class="label label-default">@L["Disabled"]</span>
                    }
                </td>
                <td class="vertical-align-middle" data-label="@L["Identifier"]">
                    <code>@server.Server.PublicId</code>
                </td>
                <td class="vertical-align-middle" data-label="@L["Status"]">
                    <span class="status-dot status-@server.Status.State"></span>@L[server.Status.State.ToString()]
                </td>
                <td class="text-center vertical-align-middle" data-label="@L["Statistics files"]">@Display.Number(server.Files)</td>
            </tr>
        }
        </tbody>
    </table>
}

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">@L["Add a game server"]</h3>
            </div>
            <div class="panel-body">
                <form method="post" asp-antiforgery="true" action="/admin/servers">
                    <div class="form-group">
                        <label for="Name">@L["Server name"] @FieldHelp.Tip(L["The name shown on the site, as players know the server. The identifier is made from the name when the server is created and does not change when you rename it."])</label>
                        <input class="form-control" id="Name" name="Name" required maxlength="100">
                    </div>
                    <div class="form-group">
                        <label for="Address">@L["Address players connect to (optional)"] @FieldHelp.Tip(L["Where players connect, such as play.example.com:27015 or an IP and port. The live server page shows it with a copy button and uses it for the connect button."])</label>
                        <input class="form-control" id="Address" name="Address" placeholder="@AppConsts.AdminServerAddressPlaceholder" maxlength="200">
                    </div>
                    <div class="form-group">
                        <label for="AlternativeAddress">@L["Alternative address, such as a DNS name (optional)"] @FieldHelp.Tip(L["A second way to connect, such as a DNS name when the main address is an IP. Shown next to the address on the live server page."])</label>
                        <input class="form-control" id="AlternativeAddress" name="AlternativeAddress" maxlength="200">
                    </div>
                    <button class="btn btn-primary" type="submit">
                        <span class="glyphicon glyphicon-plus"></span> @L["Create"]
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><span class="glyphicon glyphicon-time"></span> @L["Live server page"]</h3>
            </div>
            <div class="panel-body">
                @if (TempData["LiveSaved"] != null)
                {
                    <div class="alert alert-success">@L["Saved."]</div>
                }
                <form method="post" asp-antiforgery="true" action="/admin/servers/live">
                    <div class="form-group">
                        <label for="DelayInSeconds">@L["Delay of the live page, in seconds"] @FieldHelp.More(L["How far behind the game the live page shows the score, the players and the events."], L["Delay of the live page, in seconds"], L["The live page waits this many seconds before showing what the game server sends: the score, the players, their health, the game chat and the events of the feed. It stops someone who is watching the site from telling a team where the other team is.\nMessages sent from the site appear at once.\nThe change applies to what the game server sends from then on, without a restart. 0 shows everything right away."])</label>
                        <input class="form-control" id="DelayInSeconds" name="DelayInSeconds" type="number" min="0" max="@CoreConsts.LiveMaxDelayInSeconds" value="@live.DelayInSeconds">
                    </div>
                    <button class="btn btn-primary" type="submit">
                        <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
