@model DashboardViewModel
@{
    ViewData["Title"] = L["Administration"].Value;
}
<h1 class="h3">@L["Administration"]</h1>
<partial name="_AdminNav"/>

@if (TempData["Reprocessed"] != null)
{
    <div class="alert alert-success">@L["Reprocessing finished. Matches rebuilt:"] @TempData["Reprocessed"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="card"><div class="card-body"><div class="h3 mb-0">@Model.Servers.Count</div><div class="text-body-secondary">@L["Game servers"]</div></div></div></div>
    <div class="col-6 col-lg"><div class="card"><div class="card-body"><div class="h3 mb-0">@Display.Number(Model.Files)</div><div class="text-body-secondary">@L["Statistics files"]</div></div></div></div>
    <div class="col-6 col-lg"><div class="card"><div class="card-body"><div class="h3 mb-0">@Display.Number(Model.Matches)</div><div class="text-body-secondary">@L["Matches"]</div></div></div></div>
    <div class="col-6 col-lg"><div class="card"><div class="card-body"><div class="h3 mb-0">@Display.Number(Model.RankedMatches)</div><div class="text-body-secondary">@L["Ranked matches"]</div></div></div></div>
    <div class="col-6 col-lg"><div class="card"><div class="card-body"><div class="h3 mb-0">@Display.Number(Model.Players)</div><div class="text-body-secondary">@L["Players"]</div></div></div></div>
</div>

@if (Model.UnmatchedConfigurations > 0)
{
    <div class="alert alert-warning">
        @L["Some game configurations seen on your servers match no rule, so their matches do not count toward the ranking."]
        <a class="alert-link" href="/admin/game-modes">@L["Review the game modes"]</a>
    </div>
}

<h2 class="h5">@L["Game servers"]</h2>
@if (Model.Servers.Count == 0)
{
    <div class="alert alert-secondary">@L["No game server registered yet."] <a class="alert-link" href="/admin/servers">@L["Add one"]</a></div>
}
else
{
    <div class="list-group mb-4">
        @foreach (var server in Model.Servers)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/admin/servers/@server.Server.Id">
                <span><span class="status-dot status-@server.Status.State"></span>@server.Server.Name</span>
                <span class="text-body-secondary small">@Display.Number(server.Files) @L["files"]</span>
            </a>
        }
    </div>
}

<div class="card">
    <div class="card-header">@L["Maintenance"]</div>
    <div class="card-body">
        <p>@L["Reprocessing rebuilds every match from the stored statistics files, applying the current game mode rules and campaigns. Use it after changing those rules if old matches should follow them."]</p>
        <form method="post" asp-antiforgery="true" action="/admin/reprocess" onsubmit="return confirm('@L["Rebuild every match now?"]')">
            <button class="btn btn-outline-warning" type="submit">@L["Reprocess all matches"]</button>
        </form>
    </div>
</div>
