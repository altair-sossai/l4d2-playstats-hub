@model InGameViewModel
@{
    Layout = "_InGameLayout";
    ViewData["Tab"] = "ranking";
}
@if (Model.Players.Count == 0)
{
    <p class="muted">@L["No ranked matches in this period yet."]</p>
}
else
{
    <table>
        <tr>
            <th>#</th>
            <th>@L["Player"]</th>
            <th>@L["Patent"]</th>
            <th class="num">@L["Experience"]</th>
            <th class="num">@L["Wins"]</th>
            <th class="num">@L["Losses"]</th>
            <th class="num">@L["Win rate"]</th>
            <th class="num">@L["MVPs"]</th>
        </tr>
        @foreach (var row in Model.Players)
        {
            <tr class="@(row.Player.CommunityId == Model.SteamId ? "me" : "")">
                <td>@row.Player.Position</td>
                <td>@row.Player.MainName</td>
                <td>
                    <img class="patent" src="@row.Progress.Patent.Image" alt=""> @row.Progress.Patent.Name
                </td>
                <td class="num">@Display.Number(row.Player.Experience)</td>
                <td class="num win">@row.Player.Wins</td>
                <td class="num loss">@row.Player.Loss</td>
                <td class="num">@Display.Percent(row.Player.WinRate)</td>
                <td class="num">@row.Player.Stars</td>
            </tr>
        }
        @if (Model.Me != null && Model.Players.All(row => row.Player.CommunityId != Model.SteamId))
        {
            <tr class="me">
                <td>@Model.Me.Player.Position</td>
                <td>@Model.Me.Player.MainName</td>
                <td>
                    <img class="patent" src="@Model.Me.Progress.Patent.Image" alt=""> @Model.Me.Progress.Patent.Name
                </td>
                <td class="num">@Display.Number(Model.Me.Player.Experience)</td>
                <td class="num win">@Model.Me.Player.Wins</td>
                <td class="num loss">@Model.Me.Player.Loss</td>
                <td class="num">@Display.Percent(Model.Me.Player.WinRate)</td>
                <td class="num">@Model.Me.Player.Stars</td>
            </tr>
        }
    </table>
}
