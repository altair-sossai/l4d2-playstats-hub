@model InGameViewModel
@{
    Layout = "_InGameLayout";
    ViewData["Tab"] = "matches";
}
@if (Model.Matches.Count == 0)
{
    <p class="muted">@L["No matches found."]</p>
}
else
{
    <table>
        <tr>
            <th>@L["Date"]</th>
            <th>@L["Campaign"]</th>
            <th>@L["Team"] A</th>
            <th class="num">A</th>
            <th class="num">B</th>
            <th>@L["Team"] B</th>
        </tr>
        @foreach (var match in Model.Matches)
        {
            var teamA = string.Join(", ", match.Players.Where(p => p.TeamA).Select(p => p.Name));
            var teamB = string.Join(", ", match.Players.Where(p => p.TeamB).Select(p => p.Name));

            <tr>
                <td class="muted">@match.LastFileDate.ToString("d") @match.LastFileDate.ToString(AppConsts.ShortTimeFormat)</td>
                <td>@(match.Campaign ?? L["Custom campaign"].Value)</td>
                <td style="white-space: normal;">@teamA</td>
                <td class="num @(match.TeamAScore > match.TeamBScore ? "win" : "")">@match.TeamAScore</td>
                <td class="num @(match.TeamBScore > match.TeamAScore ? "win" : "")">@match.TeamBScore</td>
                <td style="white-space: normal;">@teamB</td>
            </tr>
        }
    </table>
}
