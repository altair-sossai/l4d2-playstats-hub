@model ChampionshipPageModel
@{
    var championship = Model.Championship;
    var url = Model.Url;
    var landing = Model.Tab == AppConsts.ChampionshipOverviewTab;
    var podium = championship.Status == ChampionshipStatus.Finished ? Model.Podium : ChampionshipPodium.None;
    var tabs = new List<(string Tab, string Title, string Url)> { (AppConsts.ChampionshipOverviewTab, L["Overview"].Value, url) };

    if (!string.IsNullOrWhiteSpace(Model.Rules(CultureInfo.CurrentUICulture.Name)))
        tabs.Add((AppConsts.ChampionshipRulesTab, L["Rules"].Value, $"{url}/{AppConsts.ChampionshipRulesTab}"));

    tabs.Add((AppConsts.ChampionshipTeamsTab, L["Teams"].Value, $"{url}/{AppConsts.ChampionshipTeamsTab}"));

    if (Model.HasDraft)
        tabs.Add((AppConsts.ChampionshipDraftTab, L["Draft"].Value, $"{url}/{AppConsts.ChampionshipDraftTab}"));

    if (Model.HasStandings)
        tabs.Add((AppConsts.ChampionshipStandingsTab, L["Standings"].Value, $"{url}/{AppConsts.ChampionshipStandingsTab}"));

    if (Model.HasBracket)
        tabs.Add((AppConsts.ChampionshipBracketTab, L["Bracket"].Value, $"{url}/{AppConsts.ChampionshipBracketTab}"));

    if (Model.HasGames)
    {
        tabs.Add((AppConsts.ChampionshipGamesTab, L["Games"].Value, $"{url}/{AppConsts.ChampionshipGamesTab}"));
        tabs.Add((AppConsts.ChampionshipStatisticsTab, L["Statistics"].Value, $"{url}/{AppConsts.ChampionshipStatisticsTab}"));
    }
}

<ol class="breadcrumb championship-breadcrumb">
    <li><a href="@AppConsts.ChampionshipsUrl">@L["Championships"]</a></li>
    <li class="active">@championship.Name</li>
</ol>

<header class="championship-hero @(landing ? "championship-hero-full" : "championship-hero-compact") @(Model.BannerUrl != null ? "has-banner" : null)" style="--championship-hue: @ChampionshipBadges.Hue(championship.Id)">
    @if (Model.BannerUrl != null)
    {
        <img class="championship-hero-banner" src="@Model.BannerUrl" alt="">
    }
    <div class="championship-hero-shade"></div>
    <div class="championship-hero-content">
        @if (Model.LogoUrl != null)
        {
            <img class="championship-hero-logo" src="@Model.LogoUrl" alt="@championship.Name">
        }
        else
        {
            <span class="championship-hero-logo championship-monogram" aria-hidden="true">@ChampionshipBadges.Initials(championship.Name)</span>
        }
        <div class="championship-hero-text">
            <div class="championship-hero-kicker">
                <span class="label @ChampionshipTexts.StatusLabel(championship.Status)">@ChampionshipTexts.Status(L, championship.Status)</span>
                @if (championship.StartsOn != null)
                {
                    <span class="championship-hero-dates"><span class="glyphicon glyphicon-calendar"></span> @championship.StartsOn.Value.ToString("d", CultureInfo.CurrentCulture)@(championship.EndsOn != null ? $" – {championship.EndsOn.Value.ToString("d", CultureInfo.CurrentCulture)}" : "")</span>
                }
            </div>
            <h1 class="championship-hero-title">@championship.Name</h1>
            <div class="championship-hero-meta">
                <span><span class="glyphicon glyphicon-flag"></span> @L["{0} teams", championship.Teams.Count]</span>
                <span><span class="glyphicon glyphicon-user"></span> @L["{0} players", championship.Participants.Count]</span>
                @if (!string.IsNullOrWhiteSpace(championship.GameConfiguration))
                {
                    <span><span class="glyphicon glyphicon-cog"></span> @championship.GameConfiguration</span>
                }
                @if (!landing && !string.IsNullOrWhiteSpace(championship.StreamUrl))
                {
                    <a href="@championship.StreamUrl" target="_blank" rel="noopener"><span class="glyphicon glyphicon-facetime-video"></span> @L["Live stream"]</a>
                }
                @if (!landing && !string.IsNullOrWhiteSpace(championship.VideosUrl))
                {
                    <a href="@championship.VideosUrl" target="_blank" rel="noopener"><span class="glyphicon glyphicon-film"></span> @L["Videos"]</a>
                }
                @if (Model.Administrator)
                {
                    <a href="@ChampionshipUrls.Admin(championship.Id)"><span class="glyphicon glyphicon-wrench"></span> @L["Manage"]</a>
                }
            </div>
            <div class="championship-hero-actions">
                @if (landing && Model.ShowsJoin && Model.JoinOpen && !Model.IsParticipant && Model.JoinRequest == null)
                {
                    <a class="btn btn-warning championship-hero-cta" href="#@AppConsts.ChampionshipJoinSection"><span class="glyphicon glyphicon-hand-up"></span> @L["Ask to join"]</a>
                }
            </div>
            @if (podium.Champion != null)
            {
                <div class="championship-hero-champion"><span aria-hidden="true">🏆</span> @L["Champion"]: <strong>@await Html.PartialAsync("_ChampionshipTeamName", (Model, podium.Champion))</strong></div>
            }
        </div>
    </div>
</header>

@if (Model.MyTeam() is { } myTeam)
{
    <div class="alert alert-info championship-captain-link">
        <span class="glyphicon glyphicon-tower"></span>
        @L["You are the {0} of {1}.", myTeam.CaptainCommunityId == Model.CurrentUser ? L["captain"].Value : L["vice-captain"].Value, myTeam.Name]
        <a class="btn btn-primary btn-sm" href="@ChampionshipUrls.Captain(championship.Slug)">@L["Open the captain area"]</a>
    </div>
}
@if (championship.Status == ChampionshipStatus.Draft)
{
    <div class="alert alert-warning">@L["This championship is a draft. Only administrators can see it."]</div>
}
@if (championship.Status == ChampionshipStatus.Cancelled)
{
    <div class="alert alert-danger">@L["This championship was cancelled."] @championship.CancelReason</div>
}

<nav class="championship-nav" aria-label="@championship.Name">
    <ul class="nav nav-tabs championship-tabs">
        @foreach (var tab in tabs)
        {
            <li role="presentation" class="@(tab.Tab == Model.Tab ? "active" : null)"><a href="@tab.Url">@tab.Title</a></li>
        }
    </ul>
</nav>
