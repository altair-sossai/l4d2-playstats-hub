@model ChampionshipPageModel
@{
    ViewData["PageMetadata"] = new PageMetadata { Title = $"{L["Statistics"].Value} - {Model.Championship.Name}", Description = L["Statistics of the players and teams of {0}.", Model.Championship.Name] };
    var stats = Model.Statistics;
    var teamRows = Model.Teams.Select(team =>
    {
        var series = Model.AllSeries.Where(item => item.HasTeams && !item.Bye && item.Has(team.Id)).ToList();
        var finished = series.Where(item => item.Finished).ToList();
        var games = series.SelectMany(item => item.Games.Where(game => game.IsPlayed).Select(game => (Series: item, Game: game))).ToList();

        return new
        {
            Team = team,
            Wins = finished.Count(item => item.WinnerTeamId == team.Id),
            Draws = finished.Count(item => item.WinnerTeamId == null),
            Losses = finished.Count(item => item.WinnerTeamId != null && item.WinnerTeamId != team.Id),
            GameWins = games.Count(pair => pair.Series.TeamAId == team.Id ? pair.Game.TeamATotal > pair.Game.TeamBTotal : pair.Game.TeamBTotal > pair.Game.TeamATotal),
            GameLosses = games.Count(pair => pair.Series.TeamAId == team.Id ? pair.Game.TeamATotal < pair.Game.TeamBTotal : pair.Game.TeamBTotal < pair.Game.TeamATotal),
            Scored = games.Sum(pair => pair.Series.TeamAId == team.Id ? pair.Game.TeamAScore : pair.Game.TeamBScore),
            Conceded = games.Sum(pair => pair.Series.TeamAId == team.Id ? pair.Game.TeamBScore : pair.Game.TeamAScore)
        };
    }).OrderByDescending(row => row.Wins).ThenByDescending(row => row.GameWins).ThenByDescending(row => row.Scored - row.Conceded).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/championships.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/pages/details-modal.css" asp-append-version="true"/>
}

@await Html.PartialAsync("_Header", Model)

<div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title">@L["Teams"]</h3></div>
    <div class="championship-table">
        <table class="table table-condensed table-hover">
            <thead>
            <tr>
                <th>@L["Team"]</th>
                <th class="text-center" title="@L["Series won, drawn and lost"]">@L["Series"]</th>
                <th class="text-center hide-mobile" title="@L["Games won and lost"]">@L["Games"]</th>
                <th class="text-center hide-mobile">@L["Points scored"]</th>
                <th class="text-center hide-mobile">@L["Points conceded"]</th>
                <th class="details-cell"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in teamRows)
            {
                <tr>
                    <td>@await Html.PartialAsync("_ChampionshipTeamName", (Model, (int?)row.Team.Id))</td>
                    <td class="text-center">@row.Wins - @row.Draws - @row.Losses</td>
                    <td class="text-center hide-mobile">@row.GameWins - @row.GameLosses</td>
                    <td class="text-center hide-mobile">@row.Scored.ToString("N0", CultureInfo.CurrentCulture)</td>
                    <td class="text-center hide-mobile">@row.Conceded.ToString("N0", CultureInfo.CurrentCulture)</td>
                    <td class="details-cell">
                        <button type="button" class="btn btn-default btn-sm" data-details="#team-statistics-@row.Team.Id" data-details-title="@row.Team.Name">
                                            <span class="glyphicon glyphicon-info-sign"></span> @L["Details"]
                                        </button>
                        <template id="team-statistics-@row.Team.Id">@await Html.PartialAsync("_DetailsList", new[]
                        {
                            new DetailsRow(L["Series won, drawn and lost"].Value, $"{row.Wins} - {row.Draws} - {row.Losses}"),
                            new DetailsRow(L["Games won and lost"].Value, $"{row.GameWins} - {row.GameLosses}"),
                            new DetailsRow(L["Points scored"].Value, row.Scored.ToString("N0", CultureInfo.CurrentCulture)),
                            new DetailsRow(L["Points conceded"].Value, row.Conceded.ToString("N0", CultureInfo.CurrentCulture))
                        })</template>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title">@L["Players"]</h3></div>
    @if (stats.Count == 0)
    {
        <div class="panel-body text-muted">@L["The statistics appear when the games are linked to the matches of the server."]</div>
    }
    else
    {
        <div class="championship-table">
            <table class="table table-condensed table-hover table-striped championship-statistics">
                <thead>
                <tr>
                    <th>@L["Player"]</th>
                    <th class="hide-mobile">@L["Team"]</th>
                    <th class="text-center">@L["Games"]</th>
                    <th class="text-center hide-mobile">@L["MVP SI"]</th>
                    <th class="text-center hide-mobile">@L["MVP CI"]</th>
                    <th class="text-center hide-mobile">@L["SI damage"]</th>
                    <th class="text-center hide-mobile">@L["Commons"]</th>
                    <th class="text-center hide-mobile">@L["Skeets"]</th>
                    <th class="text-center hide-mobile">@L["Levels"]</th>
                    <th class="text-center hide-mobile">@L["Crowns"]</th>
                    <th class="text-center hide-mobile">@L["Tank damage"]</th>
                    <th class="text-center hide-mobile">@L["Deaths"]</th>
                    <th class="details-cell"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in stats)
                {
                    <tr>
                        <td>
                            @await Html.PartialAsync("_PlayerChip", new PlayerChipModel(row.CommunityId, DisplayNames.Apply(row.CommunityId, Model.PlayerName(row.CommunityId))))
                        </td>
                        <td class="hide-mobile">@await Html.PartialAsync("_ChampionshipTeamName", (Model, (int?)row.TeamId))</td>
                        <td class="text-center">@row.Games</td>
                        <td class="text-center hide-mobile">@row.Totals.MvpSiDamage</td>
                        <td class="text-center hide-mobile">@row.Totals.MvpCommon</td>
                        <td class="text-center hide-mobile">@row.Totals.SiDamage.ToString("N0", CultureInfo.CurrentCulture)</td>
                        <td class="text-center hide-mobile">@row.Totals.Common.ToString("N0", CultureInfo.CurrentCulture)</td>
                        <td class="text-center hide-mobile">@row.Totals.Skeets</td>
                        <td class="text-center hide-mobile">@row.Totals.Levels</td>
                        <td class="text-center hide-mobile">@row.Totals.Crowns</td>
                        <td class="text-center hide-mobile">@row.Totals.TankDamage.ToString("N0", CultureInfo.CurrentCulture)</td>
                        <td class="text-center hide-mobile">@row.Totals.Died</td>
                        <td class="details-cell">
                            <button type="button" class="btn btn-default btn-sm" data-details="#player-statistics-@row.CommunityId" data-details-title="@DisplayNames.Apply(row.CommunityId, Model.PlayerName(row.CommunityId))">
                                            <span class="glyphicon glyphicon-info-sign"></span> @L["Details"]
                                        </button>
                            <template id="player-statistics-@row.CommunityId">@await Html.PartialAsync("_DetailsList", new[]
                            {
                                new DetailsRow(L["Team"].Value, Model.Teams.FirstOrDefault(team => team.Id == row.TeamId)?.Name ?? "-"),
                                new DetailsRow(L["Games"].Value, row.Games.ToString()),
                                new DetailsRow(L["MVP SI"].Value, row.Totals.MvpSiDamage.ToString()),
                                new DetailsRow(L["MVP CI"].Value, row.Totals.MvpCommon.ToString()),
                                new DetailsRow(L["SI damage"].Value, row.Totals.SiDamage.ToString("N0", CultureInfo.CurrentCulture)),
                                new DetailsRow(L["Commons"].Value, row.Totals.Common.ToString("N0", CultureInfo.CurrentCulture)),
                                new DetailsRow(L["Skeets"].Value, row.Totals.Skeets.ToString()),
                                new DetailsRow(L["Levels"].Value, row.Totals.Levels.ToString()),
                                new DetailsRow(L["Crowns"].Value, row.Totals.Crowns.ToString()),
                                new DetailsRow(L["Tank damage"].Value, row.Totals.TankDamage.ToString("N0", CultureInfo.CurrentCulture)),
                                new DetailsRow(L["Deaths"].Value, row.Totals.Died.ToString())
                            })</template>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@await Html.PartialAsync("_DetailsModal")
