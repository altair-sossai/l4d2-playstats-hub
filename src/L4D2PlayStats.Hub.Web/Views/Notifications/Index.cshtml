@model NotificationsIndexModel
@{
    ViewData["Title"] = L["Notifications"].Value;
    var pagination = PaginationModel.Of(Model.Notifications, number => QueryUrl.Build(AppConsts.NotificationsUrl, (AppConsts.NotificationsPageQuery, number)));
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

<div class="admin-header">
    <h3><span class="glyphicon glyphicon-bell"></span> @L["Notifications"]</h3>
</div>

<p class="text-muted">@L["What happened on the site for you: your championships, your team, the administration and the community. A click opens the page of the notification and marks it as read."]</p>

@if (Model.Unread > 0)
{
    <div class="admin-toolbar">
        <div class="admin-toolbar-actions">
            <form method="post" asp-antiforgery="true" action="@AppConsts.NotificationsUrl/read" data-confirm="@L["Mark every notification as read? The counter next to the bell goes back to zero."]">
                <button type="submit" class="btn btn-default"><span class="glyphicon glyphicon-ok"></span> @L["Mark all as read"]</button>
            </form>
        </div>
    </div>
}

<table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table notifications-table" style="margin-bottom: 0">
    <thead>
    <tr>
        <th>@L["Notification"]</th>
        <th class="text-center">@L["Date"]</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var notification in Model.Notifications.Items)
    {
        <tr class="@(notification.Read ? null : "notifications-unread")">
            <td class="vertical-align-middle" data-label="@L["Notification"]">
                @if (!notification.Read)
                {
                    <span class="label label-danger">@L["New"]</span>
                }
                @notification.Text
            </td>
            <td class="text-center vertical-align-middle text-nowrap" data-label="@L["Date"]">@Display.DateTime(notification.CreatedAtUtc, Model.TimeZone)</td>
            <td class="text-center vertical-align-middle slim admin-actions admin-row-actions">
                <a class="btn btn-xs btn-default" href="@AppConsts.NotificationsUrl/@notification.Id"><span class="glyphicon glyphicon-share-alt"></span> @L["Open"]</a>
            </td>
        </tr>
    }
    @if (Model.Notifications.Items.Count == 0)
    {
        <tr>
            <td colspan="3" class="text-center text-muted">@L["No notification yet."]</td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", pagination)
