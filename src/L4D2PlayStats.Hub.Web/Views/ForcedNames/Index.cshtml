@model L4D2PlayStats.Hub.Web.Models.Players.ForcedNamesViewModel
@{
    ViewData["Title"] = L["Forced names"].Value;
    var pagination = PaginationModel.Of(Model.Names, number => ForcedNameUrls.Page(Model.Search, number));
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .fn-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 12px;
        }

            .fn-toolbar .admin-filters {
                margin-bottom: 0;
            }

        .fn-actions form {
            display: inline-block;
            margin: 2px;
        }

        .fn-current {
            display: block;
            font-size: 12px;
            opacity: .7;
        }
    </style>
}

<div class="admin-header">
    <h3>@L["Forced names"]</h3>
</div>

<p class="text-muted">@L["A player on this list always plays with the name written here: the game servers rename them when they join or change the name, and the site shows this name on every page. The servers read the list at the start of each round."]</p>

@if (TempData["ForcedNameRemoved"] != null)
{
    <div class="alert alert-success">@L["The forced name was removed."]</div>
}
@if (TempData["ForcedNamesImported"] is int[] imported && imported.Length == 4)
{
    <div class="alert @(imported[3] > 0 ? "alert-warning" : "alert-success")">@L["Import finished: {0} added, {1} updated, {2} already up to date, {3} lines left out.", imported[0], imported[1], imported[2], imported[3]]</div>
}

<div class="fn-toolbar">
    <form method="get" class="admin-filters" action="@AppConsts.ForcedNamesUrl">
        <div class="input-group admin-search">
            <input class="form-control" name="q" type="search" value="@Model.Search" placeholder="@L["Name or Steam ID"]" aria-label="@L["Name or Steam ID"]">
            <span class="input-group-btn">
                <button class="btn btn-default" type="submit" title="@L["Search"]" aria-label="@L["Search"]">
                    <span class="glyphicon glyphicon-search"></span>
                </button>
            </span>
        </div>
    </form>
    <div>
        <button class="btn btn-default" type="button" data-toggle="modal" data-target="#fn-import-modal">
            <span class="glyphicon glyphicon-import"></span> @L["Import"]
        </button>
        <button class="btn btn-primary" type="button" data-fn-edit="">
            <span class="glyphicon glyphicon-plus"></span> @L["Add"]
        </button>
    </div>
</div>

@if (Model.Names.TotalItems == 0)
{
    <div class="admin-empty">@(string.IsNullOrEmpty(Model.Search) ? L["No forced names yet."] : L["No forced name matches the search."])</div>
}
else
{
    <table class="table table-striped table-hover table-bordered table-condensed table-responsive admin-table" style="margin-bottom: 0">
        <thead>
        <tr>
            <th colspan="2">@L["Player"]</th>
            <th>@L["Forced name"]</th>
            <th class="text-center">@L["Changed on"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Names.Items)
        {
            <tr>
                <td class="text-center vertical-align-middle slim hide-mobile" style="margin: 0; padding: 0">
                    <img src="/avatar/@entry.CommunityId" alt="@entry.Name" style="width: 40px; border-radius: 5px" onerror="imgOnError(this)"/>
                </td>
                <td class="vertical-align-middle" data-label="@L["Player"]">
                    <a href="@PlayerUrls.Details(entry.CommunityId)" target="_blank">@(entry.CurrentName ?? entry.CommunityId.ToString())</a>
                    <span class="fn-current">@SteamIds.DisplaySteamId(entry.CommunityId)</span>
                </td>
                <td class="vertical-align-middle" data-label="@L["Forced name"]"><strong>@entry.Name</strong></td>
                <td class="text-center vertical-align-middle" data-label="@L["Changed on"]">@entry.UpdatedAtUtc.ToString("d")</td>
                <td class="text-center vertical-align-middle slim admin-actions fn-actions">
                    <button class="btn btn-xs btn-default" type="button" data-fn-edit="@entry.CommunityId" data-fn-name="@entry.Name">
                        <span class="glyphicon glyphicon-pencil"></span> @L["Edit"]
                    </button>
                    <form method="post" asp-antiforgery="true" action="@AppConsts.ForcedNamesUrl/delete" onsubmit="return confirm('@L["Remove the forced name of this player? They will be able to change the name again."]')">
                        <input type="hidden" name="communityId" value="@entry.CommunityId">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
                        <button class="btn btn-xs btn-danger" type="submit">
                            <span class="glyphicon glyphicon-trash"></span> @L["Remove"]
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pagination", pagination)
}

<div class="modal fade" id="fn-edit-modal" tabindex="-1" role="dialog" aria-labelledby="fn-edit-title">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" asp-antiforgery="true" action="@AppConsts.ForcedNamesUrl/save">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="fn-edit-title" data-add="@L["Add a forced name"]" data-edit="@L["Edit the forced name"]"></h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="fn-player">@L["Player"]</label>
                    <div class="input-group">
                        <input class="form-control" id="fn-player" name="communityId" type="text" required autocomplete="off" placeholder="@AppConsts.AdminSteamIdPlaceholder" aria-label="@L["Steam ID or profile URL"]">
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-default fn-picker" data-player-picker="#fn-player" data-player-picker-name="#fn-name" title="@L["Search for a player"]" aria-label="@L["Search for a player"]">
                                <span class="glyphicon glyphicon-search"></span>
                            </button>
                        </span>
                    </div>
                </div>
                <div class="form-group" style="margin-bottom: 0">
                    <label for="fn-name">@L["Forced name"]</label>
                    <input class="form-control" id="fn-name" name="name" type="text" required maxlength="@L4D2PlayStats.Hub.Core.AppConsts.ForcedNameMaxLength" autocomplete="off">
                    <span class="help-block">@L["The name the player always uses on the game servers and on the site."]</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">
                    <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="fn-import-modal" tabindex="-1" role="dialog" aria-labelledby="fn-import-title">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" asp-antiforgery="true" action="@AppConsts.ForcedNamesUrl/import">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="fn-import-title">@L["Import from forced_names.cfg"]</h4>
            </div>
            <div class="modal-body">
                <p>@L["Paste the contents of the forced_names.cfg file of the l4d2_forced_names plugin. Each line with a Steam ID and a name between quotes is added, or updates the name already on the list."]</p>
                <textarea class="form-control admin-mono" name="text" rows="10" required placeholder="&quot;STEAM_0:0:12345678&quot; &quot;Player&quot;"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">
                    <span class="glyphicon glyphicon-import"></span> @L["Import"]
                </button>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_PlayerPickerModal")

@section Scripts {
    <script>
        $(document).on('click', '[data-fn-edit]', function () {
            var id = $(this).attr('data-fn-edit');
            var $title = $('#fn-edit-title');
            var editing = id !== '';

            $title.text(editing ? $title.attr('data-edit') : $title.attr('data-add'));
            $('#fn-player').val(id).prop('readonly', editing);
            $('#fn-edit-modal .fn-picker').prop('disabled', editing);
            $('#fn-name').val(editing ? $(this).attr('data-fn-name') : '');
            $('#fn-edit-modal').modal('show');
        });

        $('#fn-edit-modal').on('shown.bs.modal', function () {
            $($('#fn-player').prop('readonly') ? '#fn-name' : '#fn-player').trigger('focus');
        });
    </script>
}
