@model SetupViewModel
@inject BrandingStore Branding
@{
    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Setup"],
        Description = L["A few steps and the site is ready."],
        NoIndex = true
    };

    var steps = new (string Key, string Title)[]
    {
        ("token", L["Administrator"].Value),
        ("site", L["Site"].Value),
        ("modules", L["Modules"].Value),
        ("server", L["Game server"].Value),
        ("finish", L["Finish"].Value)
    };

    var current = Model.Step == "signin" ? "token" : Model.Step;
    var index = Array.FindIndex(steps, step => step.Key == current);
    var cultures = new Dictionary<string, string> { ["en-US"] = "English", ["pt-BR"] = "Português", ["es-ES"] = "Español" };
    var logoTypes = string.Join(",", AppConsts.LogoContentTypes.Keys);
    var logoMegabytes = AppConsts.LogoMaxBytes / AppConsts.BytesPerMegabyte;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    @await Html.PartialAsync("_AdministrationStyles")
}

@section Scripts {
    @if (Model.Server != null)
    {
        <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    }
}

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="admin-header">
            <h3>@L["Welcome"]</h3>
        </div>
        <p class="admin-lead">@L["A few steps and the site is ready."]</p>

        <ul class="nav nav-pills nav-justified wizard-steps">
            @for (var i = 0; i < steps.Length; i++)
            {
                <li role="presentation" class="@(i == index ? "active" : i < index ? "done hide-mobile" : "hide-mobile")">
                    <a>
                        @if (i < index)
                        {
                            <span class="glyphicon glyphicon-ok text-success"></span>
                        }
                        @(i + 1). @steps[i].Title
                    </a>
                </li>
            }
        </ul>

        @if (TempData[AppConsts.SettingsProblemsTempData] is string[] problems)
        {
            foreach (var problem in problems)
            {
                <div class="alert alert-danger">@L[problem]</div>
            }
        }

        @if (Model.Step == "token")
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["Who is the administrator?"]</h3>
                </div>
                <div class="panel-body">
                    <p>@L["Type the setup code that the installer printed. It is also in the application log. Then sign in with Steam: that account becomes the first administrator."]</p>
                    @if (Model.Error != null)
                    {
                        <div class="alert alert-danger">@L[Model.Error]</div>
                    }
                    <form method="post" asp-antiforgery="true" action="/setup/start">
                        <div class="form-group">
                            <label for="token">@L["Setup code"] @FieldHelp.More(L["The code the installer printed. Then you sign in with Steam, and that account becomes the first administrator."], L["Setup code"], L["The installer prints the setup code at the end. It is also in the application log and in the file setup-code.txt in the data folder, and on Linux the command playstats-hub setup-code shows it again.\nAfter the code, you sign in with Steam: that Steam account becomes the first administrator, and the code stops working. Only that account can continue the setup."])</label>
                            <input class="form-control" id="token" name="token" value="@Model.Token" autocomplete="off" required>
                        </div>
                        @if (Model.DevelopmentSignIn)
                        {
                            <div class="form-group">
                                <label for="developmentCommunityId">@L["Development only: sign in as this SteamID64, without Steam"] @FieldHelp.Tip(L["Shown only while the site runs in development. Signs in as this SteamID64 without going through Steam."])</label>
                                <input class="form-control" id="developmentCommunityId" name="developmentCommunityId" type="number">
                            </div>
                        }
                        <button class="btn btn-primary" type="submit">
                            <img src="~/imgs/steam.png" alt="" class="img-header-icon">@L["Continue with Steam"]
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Step == "signin")
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["Setup is in progress"]</h3>
                </div>
                <div class="panel-body">
                    <p>@L["An administrator already exists. Sign in with that Steam account to continue the setup."]</p>
                    <a class="btn btn-primary" href="/login?returnUrl=/setup">
                        <img src="~/imgs/steam.png" alt="" class="img-header-icon">@L["Sign in with Steam"]
                    </a>
                </div>
            </div>
        }
        else if (Model.Step == "site")
        {
            <form class="panel panel-default" method="post" asp-antiforgery="true" action="/setup/site" enctype="multipart/form-data">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["About the site"]</h3>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label for="Site_Name">@L["Site name"] @FieldHelp.Tip(L["Shown in the menu when there is no logo, in the title of every page and in the pages inside the game."])</label>
                        <input class="form-control" id="Site_Name" name="Site.Name" value="@Model.Settings.Site.Name" required>
                    </div>
                    <div class="form-group">
                        <label for="Logo">@L["Site logo (optional)"] @FieldHelp.Tip(L["An image shown in the menu in place of the site name. Choose a file only to change it: saving without a file keeps the current logo."])</label>
                        @if (Branding.HasLogo)
                        {
                            <div>
                                <div class="navbar navbar-default settings-logo">
                                    <img src="@AppConsts.LogoUrl?v=@Branding.LogoVersion" alt="@Model.Settings.Site.Name">
                                </div>
                            </div>
                        }
                        <input type="file" id="Logo" name="Logo" accept="@logoTypes">
                        <span class="help-block">@L["PNG, JPG, WEBP or GIF, up to {0} MB. It appears in the menu, in place of the site name.", logoMegabytes]</span>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="Site_DefaultCulture">@L["Default language"] @FieldHelp.Tip(L["The language of visitors who have not chosen one. Each visitor can change it in the settings menu, and the choice is remembered in that browser."])</label>
                                <select class="form-control" id="Site_DefaultCulture" name="Site.DefaultCulture">
                                    @foreach (var culture in cultures)
                                    {
                                        <option value="@culture.Key" selected="@(culture.Key == Model.Settings.Site.DefaultCulture)">@culture.Value</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label for="Site_TimeZone">@L["Time zone"] @FieldHelp.More(L["The clock of the site: the dates on the pages and the start and end of each season."], L["Time zone"], L["Every date and time on the site is shown in this time zone. It also decides the day used by the vote limits of the community ranking and the moment each season starts and ends: a season that ends on 31 December ends at midnight in this time zone.\nChoose the time zone of your community from the list, such as America/Sao_Paulo or Europe/Lisbon. A name the server does not recognize is not saved, and the previous time zone stays."])</label>
                                <input class="form-control" id="Site_TimeZone" name="Site.TimeZone" value="@Model.Settings.Site.TimeZone" list="timezones">
                                <datalist id="timezones">
                                    @foreach (var zone in Model.Settings.TimeZones)
                                    {
                                        <option value="@zone"></option>
                                    }
                                </datalist>
                                <span class="help-block">@L["Decides when a season starts and ends."]</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Season_LengthInMonths">@L["Season length, in months"] @FieldHelp.More(L["How long each season lasts, from 1 to 24 months. The ranking starts again from zero at each season."], L["Season length, in months"], L["The ranking is played in seasons. At the start of each season everybody starts again from zero experience; past seasons stay available in the period selectors and in the history.\nSeasons are blocks counted from the start of the year. With 2 months, the default, seasons start in January, March, May, July, September and November. With 3 months, in January, April, July and October.\nA change applies from the next season: the seasons that already exist keep their dates. The start and the end of a season follow the time zone of the site.\nWith the skin shop on, bought skins are refunded when a season ends, unless that is turned off in the shop settings."])</label>
                        <input class="form-control" id="Season_LengthInMonths" name="Season.LengthInMonths" type="number" min="1" max="24" value="@Model.Settings.Season.LengthInMonths">
                        <span class="help-block">@L["The ranking starts again at each new season. Past seasons stay available."]</span>
                    </div>
                    <div class="form-group">
                        <label for="Site_SteamApiKey">@L["Steam Web API key (optional)"] @FieldHelp.More(L["A key from Steam that makes the avatars and names of the players load faster. The site works without it."], L["Steam Web API key"], L["The site downloads the avatars and the names of the players from Steam. Without a key it reads the public profile of each player, one at a time, which works but is slower. With a key it asks the Steam Web API for many players at once.\nThe key is also used to show the name and the photo of a player when you type a Steam ID in the administration forms, and to check the names of the skin authors.\nGet a key at steamcommunity.com/dev/apikey, signed in with any Steam account, and paste it here. Keep it private: it is linked to that Steam account. Leave the field empty to stop using it."])</label>
                        <input class="form-control" id="Site_SteamApiKey" name="Site.SteamApiKey" type="password" value="" autocomplete="new-password" placeholder="@(string.IsNullOrWhiteSpace(Model.Settings.Site.SteamApiKey) ? "" : L["A key is saved. Leave empty to keep it."].Value)">
                        <span class="help-block">
                            @L["Optional. Player avatars load without it; with a key they load faster."]
                            <a href="https://steamcommunity.com/dev/apikey" rel="noopener" target="_blank">
                                <span class="text-underline">steamcommunity.com/dev/apikey</span>
                            </a>
                        </span>
                    </div>
                    <button class="btn btn-primary" type="submit">
                        @L["Continue"] <span class="glyphicon glyphicon-chevron-right"></span>
                    </button>
                </div>
            </form>
        }
        else if (Model.Step == "modules")
        {
            <form class="panel panel-default" method="post" asp-antiforgery="true" action="/setup/modules">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["What should this site have?"]</h3>
                </div>
                <div class="panel-body">
                    <p class="text-muted">@L["You can change this later in the administration area."]</p>
                    <partial name="_ModuleSwitches" model="Model.Modules"/>
                    <button class="btn btn-primary" type="submit">
                        @L["Continue"] <span class="glyphicon glyphicon-chevron-right"></span>
                    </button>
                </div>
            </form>
        }
        else if (Model.Step == "server")
        {
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["Connect a game server"]</h3>
                </div>
                <div class="panel-body">
                    @if (Model.Server == null)
                    {
                        <p>@L["Give the game server a name. You get an identifier and a key for it."]</p>
                        <form method="post" asp-antiforgery="true" action="/setup/server">
                            <div class="form-group">
                                <label for="Name">@L["Server name"] @FieldHelp.Tip(L["The name shown on the site, as players know the server. The identifier is made from the name when the server is created and does not change when you rename it."])</label>
                                <input class="form-control" id="Name" name="Name" required maxlength="100">
                            </div>
                            <div class="form-group">
                                <label for="Address">@L["Address players connect to (optional)"] @FieldHelp.Tip(L["Where players connect, such as play.example.com:27015 or an IP and port. The live server page shows it with a copy button and uses it for the connect button."])</label>
                                <input class="form-control" id="Address" name="Address" placeholder="@AppConsts.AdminServerAddressPlaceholder" maxlength="200">
                            </div>
                            <button class="btn btn-primary" type="submit">
                                <span class="glyphicon glyphicon-plus"></span> @L["Create"]
                            </button>
                            <a class="btn btn-link" href="/setup?step=finish">@L["Skip for now"]</a>
                        </form>
                    }
                    else
                    {
                        <p class="bold">@Model.Server.Status.Server.Name</p>
                        <partial name="_ServerInstructions" model="Model.Server"/>
                        <div class="well">
                            <partial name="_ServerStatus" model="Model.Server.Status"/>
                        </div>
                        <a class="btn btn-primary" href="/setup?step=finish">
                            @L["Continue"] <span class="glyphicon glyphicon-chevron-right"></span>
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <form class="panel panel-default" method="post" asp-antiforgery="true" action="/setup/finish">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["All set"]</h3>
                </div>
                <div class="panel-body">
                    <p>@L["The site is ready. Everything you chose can be changed in the administration area, where you can also add more game servers."]</p>
                    <button class="btn btn-success" type="submit">
                        <span class="glyphicon glyphicon-ok"></span> @L["Finish"]
                    </button>
                </div>
            </form>
        }
    </div>
</div>