@model InGameViewModel
@{
    var query = Model.SteamId == null ? "" : $"?steamid={Model.SteamId}";
    var active = ViewData["Tab"] as string;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@Model.SiteName</title>
    <style>
        html, body { margin: 0; padding: 0; background: #14171c; color: #d8dce3; font-family: Arial, Helvetica, sans-serif; font-size: 13px; }
        a { color: #8fb8ff; text-decoration: none; }
        .top { background: #1d2129; border-bottom: 1px solid #323844; padding: 6px 10px; overflow: hidden; }
        .site { float: left; font-size: 15px; font-weight: bold; color: #ffffff; padding: 4px 12px 4px 0; }
        .tab { float: left; padding: 4px 10px; margin-right: 4px; border: 1px solid #323844; -webkit-border-radius: 4px; border-radius: 4px; color: #d8dce3; }
        .tab.on { background: #2f6fed; border-color: #2f6fed; color: #ffffff; }
        .season { float: right; padding: 5px 0; color: #8a909c; }
        .body { padding: 8px 10px; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; color: #8a909c; font-weight: normal; padding: 3px 6px; border-bottom: 1px solid #323844; }
        td { padding: 3px 6px; border-bottom: 1px solid #23272f; white-space: nowrap; }
        .num { text-align: right; }
        .me td { background: #3a3320; }
        .win { color: #5fc48a; }
        .loss { color: #e07a7a; }
        .muted { color: #8a909c; }
        .patent { width: 22px; height: 22px; vertical-align: middle; }
        .box { background: #1d2129; border: 1px solid #323844; -webkit-border-radius: 6px; border-radius: 6px; padding: 10px; margin-bottom: 8px; overflow: hidden; }
        .big { font-size: 22px; font-weight: bold; }
        .cell { float: left; width: 16%; text-align: center; }
        .bar { background: #323844; height: 6px; -webkit-border-radius: 3px; border-radius: 3px; overflow: hidden; }
        .bar div { background: #2f6fed; height: 6px; }
    </style>
</head>
<body>
<div class="top">
    <div class="site">@Model.SiteName</div>
    <a class="tab @(active == "ranking" ? "on" : "")" href="/ingame@(query)">@L["Ranking"]</a>
    <a class="tab @(active == "player" ? "on" : "")" href="/ingame/player@(query)">@L["My summary"]</a>
    <a class="tab @(active == "matches" ? "on" : "")" href="/ingame/matches@(query)">@L["Matches"]</a>
    <div class="season">@RankingPeriod.ForSeason(Model.Season).Label(L)</div>
</div>
<div class="body">
    @RenderBody()
</div>
</body>
</html>