@model IReadOnlyCollection<Skin>

@await Html.PartialAsync("_PlayerPickerModal")
@await Html.PartialAsync("_SkinPickerModal", Model)

<link rel="stylesheet" href="~/css/pages/gift-modal.css" asp-append-version="true"/>

<div id="gm-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Give a skin as a gift"]</h4>
            </div>
            <div class="modal-body">
                <p class="text-muted">@L["The skin is equipped for the player and no stars are charged. It shows up on the server from the next map change."]</p>

                <label>@L["Player"]</label>
                <div class="gm-choice gm-player">
                    <span class="gm-empty">@L["No player chosen"]</span>
                </div>
                <div class="input-group" style="margin-bottom: 14px">
                    <input type="text" class="form-control gm-player-id" placeholder="@L["Steam ID (any format) or profile link"]"/>
                    <span class="input-group-btn">
                        <button type="button" class="btn btn-default gm-pick-player">
                            <span class="glyphicon glyphicon-user"></span> @L["Choose from the list"]
                        </button>
                    </span>
                </div>

                <label>@L["Skin"]</label>
                <div class="gm-choice gm-skin">
                    <span class="gm-empty">@L["No skin chosen"]</span>
                </div>
                <button type="button" class="btn btn-default btn-block gm-pick-skin">
                    <span class="glyphicon glyphicon-th"></span> @L["Choose a skin"]
                </button>

                <div class="gm-message" style="margin-top: 12px"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-success gm-confirm">
                    <span class="glyphicon glyphicon-gift"></span> @L["Give as a gift"]
                </button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="gift-modal-config">{ "texts": { "No player chosen": @Json.Serialize(L["No player chosen"].Value), "No skin chosen": @Json.Serialize(L["No skin chosen"].Value), "Choose the player or enter the Steam ID.": @Json.Serialize(L["Choose the player or enter the Steam ID."].Value), "Choose the skin.": @Json.Serialize(L["Choose the skin."].Value), "Gift given! Reloading...": @Json.Serialize(L["Gift given! Reloading..."].Value), "Steam ID typed manually": @Json.Serialize(L["Steam ID typed manually"].Value), "The player already owns this skin.": @Json.Serialize(L["The player already owns this skin."].Value), "Skin not found.": @Json.Serialize(L["Skin not found."].Value), "Too many operations at the same time. Try again.": @Json.Serialize(L["Too many operations at the same time. Try again."].Value), "Invalid Steam ID. Use STEAM_0:1:123, [U:1:123], 7656119... or the profile link.": @Json.Serialize(L["Invalid Steam ID. Use STEAM_0:1:123, [U:1:123], 7656119... or the profile link."].Value), "Something went wrong. Reload the page and check before trying again.": @Json.Serialize(L["Something went wrong. Reload the page and check before trying again."].Value) } }</script>
<script src="~/js/pages/gift-modal.js" asp-append-version="true"></script>
