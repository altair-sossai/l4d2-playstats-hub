@inject ISettingsService Settings
@inject ICurrentUser CurrentUser
@inject BrandingStore Branding
@inject ILiveViewService LiveView
@{
    var site = await Settings.GetAsync<SiteSettings>();
    var modules = await Settings.GetAsync<ModuleSettings>();
    var administrator = await CurrentUser.IsAdministratorAsync();
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var culture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Uri.EscapeDataString(ErrorPages.OriginalPathAndQuery(Context));
    var ranking = modules.IsEnabled(HubModule.Ranking);
    var liveServer = modules.IsEnabled(HubModule.LiveServer);
    var mainServer = liveServer ? await LiveView.MainServerAsync(Context.RequestAborted) : null;
    var playersOnline = mainServer is { Players: > 0 };
    var connectAddress = mainServer?.Server.Address;
    var skinShop = modules.IsEnabled(HubModule.SkinShop);
    var communityRanking = modules.IsEnabled(HubModule.CommunityRanking);
    var antiCheat = modules.IsEnabled(HubModule.AntiCheat);
    var championships = modules.IsEnabled(HubModule.Championships);
    var metadata = ViewData["PageMetadata"] as PageMetadata;
    var pageTitle = metadata?.Title ?? ViewData["Title"] as string;
    var title = string.IsNullOrEmpty(pageTitle) || pageTitle == site.Name ? site.Name : $"{pageTitle} | {site.Name}";
    var description = metadata?.Description ?? L["Statistics, rankings, players, and matches from the {0} Left 4 Dead 2 server.", site.Name].Value;
    var siteUrl = string.IsNullOrWhiteSpace(site.PublicUrl) ? $"{Context.Request.Scheme}://{Context.Request.Host}" : site.PublicUrl.TrimEnd('/');
    var canonical = $"{siteUrl}{ErrorPages.OriginalPath(Context)}";
    var pageImage = !string.IsNullOrWhiteSpace(metadata?.Image) ? metadata.Image : Branding.HasLogo ? AppConsts.LogoUrl : null;
    var image = pageImage == null ? null : Uri.TryCreate(pageImage, UriKind.Absolute, out var imageUri) && (imageUri.Scheme == Uri.UriSchemeHttp || imageUri.Scheme == Uri.UriSchemeHttps) ? pageImage : $"{siteUrl}/{pageImage.TrimStart('/')}";
    var imageAlt = metadata?.ImageAlt ?? pageTitle ?? site.Name;
    var footerLinks = FooterLinks.Parse(site.FooterLinks);
    var languages = new[] { ("en-US", "us", "English", "lang-en"), ("pt-BR", "br", "Português", "lang-pt"), ("es-ES", "es", "Español", "lang-es") };
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="@description">
    @if (!string.IsNullOrWhiteSpace(site.MetaKeywords))
    {
        <meta name="keywords" content="@site.MetaKeywords">
    }
    <meta name="author" content="@site.Name">
    <meta name="robots" content="@(metadata?.NoIndex == true ? "noindex, follow" : "index, follow")">

    <link rel="canonical" href="@canonical">
    <meta property="og:title" content="@title">
    <meta property="og:description" content="@description">
    <meta property="og:url" content="@canonical">
    <meta property="og:type" content="@(metadata?.OpenGraphType ?? AppConsts.DefaultOpenGraphType)">
    @if (image != null)
    {
        <meta property="og:image" content="@image">
        <meta property="og:image:secure_url" content="@image">
        <meta property="og:image:alt" content="@imageAlt">
    }
    <meta property="og:site_name" content="@site.Name">
    <meta property="og:locale" content="@culture.Replace('-', '_')">

    <meta name="twitter:card" content="@(image == null ? "summary" : "summary_large_image")">
    <meta name="twitter:title" content="@title">
    <meta name="twitter:description" content="@description">
    @if (image != null)
    {
        <meta name="twitter:image" content="@image">
        <meta name="twitter:image:alt" content="@imageAlt">
    }

    <title>@title</title>

    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="~/css/lity.min.css" asp-append-version="true"/>

    @if (light)
    {
        <link rel="stylesheet" href="~/css/bootstrap.light.min.css" asp-append-version="true"/>
    }
    else
    {
        <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true"/>
    }

    <link rel="stylesheet" href="~/css/pages/layout.css" asp-append-version="true"/>
    <style>
        .table > thead > tr > td.it-is-me,
        .table > tbody > tr > td.it-is-me,
        .table > tfoot > tr > td.it-is-me,
        .table > thead > tr > th.it-is-me,
        .table > tbody > tr > th.it-is-me,
        .table > tfoot > tr > th.it-is-me,
        .table > thead > tr.it-is-me > td,
        .table > tbody > tr.it-is-me > td,
        .table > tfoot > tr.it-is-me > td,
        .table > thead > tr.it-is-me > th,
        .table > tbody > tr.it-is-me > th,
        .table > tfoot > tr.it-is-me > th {
            background-color: @Html.Raw(light ? "#bcf3a6" : "#2e6b2e");
        }
    </style>

    @await RenderSectionAsync("Styles", false)

    <script type="application/json" id="layout-1-config">{ "values": { "copyFailed": @Json.Serialize(L["It was not possible to copy the text automatically. Please copy it manually."].Value), "emptyAvatarUrl": @Json.Serialize(AppConsts.EmptyAvatarUrl) } }</script>
    <script src="~/js/pages/layout-1.js" asp-append-version="true"></script>
</head>
<body>

<nav class="navbar navbar-default">
    <div class="container-fluid main-container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-navbar-collapse" aria-expanded="false">
                <span class="sr-only">@L["Toggle navigation"]</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @if (Branding.HasLogo)
            {
                <a class="navbar-brand" href="/">
                    <img src="@AppConsts.LogoUrl?v=@Branding.LogoVersion" alt="@site.Name" class="logo img-responsive">
                </a>
            }
            else
            {
                <a class="navbar-brand site-name" href="/">@site.Name</a>
            }
            @if (liveServer)
            {
                <a id="server-info" class="navbar-brand server-info pulsate" href="/servers" title="@L["Server"]" style="@(playersOnline ? null : "display:none;")">
                    <span id="server-status" class="label label-success">@if (playersOnline)
                        {
                            <text>● @mainServer!.Players/@mainServer.MaxPlayers</text>
                        }</span>
                </a>
            }
        </div>

        <div class="collapse navbar-collapse" id="bs-navbar-collapse">
            <ul class="nav navbar-nav" id="nav-main">
                @if (ranking)
                {
                    <li class="nav-fit @ViewBag.Home">
                        <a href="/">@L["Ranking"]</a>
                    </li>
                }
                @if (communityRanking)
                {
                    <li class="nav-fit @ViewBag.Community">
                        <a href="/community">@L["Community"]</a>
                    </li>
                }
                @if (ranking)
                {
                    <li class="nav-fit @ViewBag.LastMatches">
                        <a href="/matches">@L["Last matches"]</a>
                    </li>
                }
                @if (championships)
                {
                    <li class="nav-fit @ViewBag.Championships">
                        <a href="@AppConsts.ChampionshipsUrl">@L["Championships"]</a>
                    </li>
                }
                @if (liveServer)
                {
                    <li class="nav-fit @ViewBag.Server">
                        <a href="/servers">@L["Server"]</a>
                    </li>
                }
                @if (skinShop)
                {
                    <li class="nav-fit @ViewBag.Skins">
                        <a href="/skins">@L["Skins"]</a>
                    </li>
                }
                @if (antiCheat)
                {
                    <li class="nav-fit @ViewBag.AntiCheat">
                        <a href="@AppConsts.AntiCheatUrl">@L["Anti-Cheat"]</a>
                    </li>
                }
                <li class="dropdown @(ViewBag.Players ?? ViewBag.Patent ?? ViewBag.Commands)" id="nav-more" data-own="true">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        @L["More"] <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu" id="nav-more-menu">
                        <li role="separator" class="divider" id="nav-fit-divider" style="display: none"></li>
                        @if (ranking)
                        {
                            <li class="@ViewBag.Players">
                                <a href="/players">
                                    <img src="~/imgs/menu/players.svg" alt="" class="img-responsive img-header-icon">
                                    @L["Players"]
                                </a>
                            </li>
                            <li class="@ViewBag.Patent">
                                <a href="/patents">
                                    <img src="~/imgs/menu/patents.svg" alt="" class="img-responsive img-header-icon">
                                    @L["Patents"]
                                </a>
                            </li>
                        }
                        <li class="@ViewBag.Commands">
                            <a href="@AppConsts.CommandsUrl">
                                <img src="~/imgs/menu/commands.svg" alt="" class="img-responsive img-header-icon">
                                @L["Commands"]
                            </a>
                        </li>
                    </ul>
                </li>
                @if (administrator)
                {
                    <li class="@ViewBag.Admin">
                        <a href="/admin">
                            <span class="glyphicon glyphicon-cog"></span> @L["Admin"]
                        </a>
                    </li>
                }
            </ul>
            <ul class="nav navbar-nav navbar-right">
                @if (CurrentUser.IsAuthenticated)
                {
                    if (skinShop)
                    {
                        <li class="nav-stars" style="display: none">
                            <a href="/skins" title="@L["Your stars to buy skins"]" data-toggle="tooltip" data-placement="bottom">
                                <span class="nav-stars-pill">
                                    <span class="nav-stars-icon">★</span>
                                    <b class="nav-stars-value"></b>
                                    <span class="nav-stars-label"></span>
                                </span>
                            </a>
                        </li>
                    }

                    if (championships)
                    {
                        @await Html.PartialAsync("_CaptainAlert")
                    }

                    <li>
                        <a href="@(CurrentUser.CommunityId == null ? "#" : PlayerUrls.Details(CurrentUser.CommunityId.Value))">
                            <img src="/avatar/@CurrentUser.CommunityId" alt="@CurrentUser.Name" title="@CurrentUser.Name" class="img-responsive img-header-icon" data-toggle="tooltip" data-placement="bottom" onerror="imgOnError(this)">
                            <span class="show-mobile" style="margin-left: 5px">
                                @CurrentUser.Name
                            </span>
                        </a>
                    </li>
                }
                <li class="dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        <img src="~/imgs/settings.png" alt="@L["Settings"]" title="@L["Settings"]" class="img-responsive img-header-icon">
                        <span class="show-mobile">
                            @L["Settings"]
                        </span>
                        <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu">
                        @if (light)
                        {
                            <li>
                                <a href="/theme/default?returnUrl=@returnUrl" rel="nofollow">
                                    <img src="~/imgs/dark-theme.png" alt="@L["Switch to dark theme"]" title="@L["Switch to dark theme"]" class="img-responsive img-header-icon">
                                    @L["Switch to dark theme"]
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="/theme/@AppConsts.LightTheme?returnUrl=@returnUrl" rel="nofollow">
                                    <img src="~/imgs/light-theme.png" alt="@L["Switch to light theme"]" title="@L["Switch to light theme"]" class="img-responsive img-header-icon">
                                    @L["Switch to light theme"]
                                </a>
                            </li>
                        }
                        <li role="separator" class="divider"></li>
                        @foreach (var (name, flag, label, id) in languages)
                        {
                            if (culture.Equals(name, StringComparison.InvariantCultureIgnoreCase))
                            {
                                continue;
                            }

                            <li id="@id">
                                <a href="/language?culture=@name&returnUrl=@returnUrl" rel="nofollow">
                                    <img src="~/imgs/@(flag).png" alt="@label" title="@label" class="img-responsive img-header-icon">
                                    @label
                                </a>
                            </li>
                        }
                        <li role="separator" class="divider"></li>
                        @if (CurrentUser.IsAuthenticated)
                        {
                            <li>
                                <form id="logout-form" method="post" action="/logout?returnUrl=@returnUrl" style="display: none">
                                    @Html.AntiForgeryToken()
                                </form>
                                <a href="#" onclick="document.getElementById('logout-form').submit(); return false;">
                                    <img src="~/imgs/logout.png" alt="@L["Click here to logout"]" title="@L["Click here to logout"]" class="img-responsive img-header-icon">
                                    @L["Click here to logout"]
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="/login?returnUrl=@returnUrl">
                                    <img src="~/imgs/steam.png" alt="@L["Login with Steam"]" title="@L["Login with Steam"]" class="img-responsive img-header-icon">
                                    @L["Login with Steam"]
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script type="application/json" id="layout-2-config">{ "values": { "navbarDesktopWidth": @Json.Serialize(AppConsts.NavbarDesktopWidth) } }</script>
<script src="~/js/pages/layout-2.js" asp-append-version="true"></script>

<div class="container-fluid main-container">
    @if (TempData[AppConsts.ErrorTempData] is string error)
    {
        <div class="alert alert-danger" style="margin-top: 15px">@L[error]</div>
    }
    @if (TempData[AppConsts.SavedTempData] != null)
    {
        <div class="alert alert-success" style="margin-top: 15px">@L["Saved."]</div>
    }

    @RenderBody()

    <hr/>

    <div class="row text-center" style="margin-bottom: 25px">
        <div class="col-md-12">
            @for (var index = 0; index < footerLinks.Count; index++)
            {
                if (index > 0)
                {
                    <small> ● </small>
                }

                <a href="@footerLinks[index].Url" target="_blank" rel="noopener">
                    <small>@footerLinks[index].Text</small>
                </a>
            }
        </div>
    </div>
</div>

@if (liveServer)
{
    <a id="connect-icon" href="/connect" class="float-icon hide-mobile" style="@(string.IsNullOrEmpty(connectAddress) ? "display: none" : null)">
        <img src="~/imgs/icons/l4d2.png" alt="connect @connectAddress" data-toggle="tooltip" data-placement="top" title="connect @connectAddress"/>
    </a>
}

<script src="~/js/jquery.min.js" asp-append-version="true"></script>
<script src="~/js/bootstrap.min.js" asp-append-version="true"></script>
<script src="~/js/diffDOM.min.js" asp-append-version="true"></script>
<script src="~/js/chart.min.js" asp-append-version="true"></script>
<script src="~/js/lity.min.js" asp-append-version="true"></script>
<script src="~/js/hub.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)

<script type="application/json" id="layout-3-config">{ "texts": { "star available": @Json.Serialize(L["star available"].Value), "stars available": @Json.Serialize(L["stars available"].Value) }, "values": { "communityId": @Json.Serialize($"{CurrentUser.CommunityId}"), "liveServer": @Json.Serialize(liveServer), "robotUserAgentPattern": @Json.Serialize(AppConsts.RobotUserAgentPattern), "skinShop": @Json.Serialize(skinShop) } }</script>
<script src="~/js/pages/layout-3.js" asp-append-version="true"></script>

@if (!string.IsNullOrWhiteSpace(site.GoogleAnalyticsId) && ViewData[AppConsts.AdministrationAreaViewData] == null)
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@site.GoogleAnalyticsId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', @Json.Serialize(site.GoogleAnalyticsId));
    </script>
}

<div class="modal fade" id="field-help-modal" tabindex="-1" role="dialog" data-more="@L["Click the icon for more details."]">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>
