                                @CurrentUser.Name
                            </span>
                        </a>
                    </li>
                }
                <li class="dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        <img src="~/imgs/settings.png" alt="@L["Settings"]" title="@L["Settings"]" class="img-responsive img-header-icon">
                        <span class="show-mobile">
                            @L["Settings"]
                        </span>
                        <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu">
                        @if (light)
                        {
                            <li>
                                <a href="/theme/default?returnUrl=@returnUrl">
                                    <img src="~/imgs/dark-theme.png" alt="@L["Switch to dark theme"]" title="@L["Switch to dark theme"]" class="img-responsive img-header-icon">
                                    @L["Switch to dark theme"]
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="/theme/@AppConsts.LightTheme?returnUrl=@returnUrl">
                                    <img src="~/imgs/light-theme.png" alt="@L["Switch to light theme"]" title="@L["Switch to light theme"]" class="img-responsive img-header-icon">
                                    @L["Switch to light theme"]
                                </a>
                            </li>
                        }
                        <li role="separator" class="divider"></li>
                        @foreach (var (name, flag, label, id) in languages)
                        {
                            if (culture.Equals(name, StringComparison.InvariantCultureIgnoreCase))
                            {
                                continue;
                            }

                            <li id="@id">
                                <a href="/language?culture=@name&returnUrl=@returnUrl">
                                    <img src="~/imgs/@(flag).png" alt="@label" title="@label" class="img-responsive img-header-icon">
