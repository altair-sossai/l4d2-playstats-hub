@inject ISettingsService Settings
@inject ICurrentUser CurrentUser
@{
    var site = await Settings.GetAsync<SiteSettings>();
    var modules = await Settings.GetAsync<ModuleSettings>();
    var administrator = await CurrentUser.IsAdministratorAsync();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var culture = CultureInfo.CurrentUICulture.Name;
    var flags = new Dictionary<string, string> { ["en-US"] = "us", ["pt-BR"] = "br", ["es-ES"] = "es" };
    var languages = new Dictionary<string, string> { ["en-US"] = "English", ["pt-BR"] = "Português", ["es-ES"] = "Español" };
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="@culture" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(title) ? site.Name : $"{title} · {site.Name}")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">@site.Name</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="@L["Menu"]">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                @if (modules.IsEnabled(HubModule.Ranking))
                {
                    <li class="nav-item"><a class="nav-link" href="/">@L["Ranking"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="/matches">@L["Matches"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="/players">@L["Players"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="/patents">@L["Patents"]</a></li>
                }
                @if (modules.IsEnabled(HubModule.LiveServer))
                {
                    <li class="nav-item"><a class="nav-link" href="/servers">@L["Servers"]</a></li>
                }
                @if (modules.IsEnabled(HubModule.CommunityRanking))
                {
                    <li class="nav-item"><a class="nav-link" href="/community">@L["Community ranking"]</a></li>
                }
                @if (modules.IsEnabled(HubModule.SkinShop))
                {
                    <li class="nav-item"><a class="nav-link" href="/skins">@L["Skins"]</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="~/imgs/@(flags.GetValueOrDefault(culture, "us")).png" alt="" width="20" class="me-1">@languages.GetValueOrDefault(culture, "English")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var language in languages)
                        {
                            <li>
                                <a class="dropdown-item" href="/language?culture=@language.Key&returnUrl=@Uri.EscapeDataString(returnUrl)">
                                    <img src="~/imgs/@(flags[language.Key]).png" alt="" width="20" class="me-2">@language.Value
                                </a>
                            </li>
                        }
                    </ul>
                </li>
                @if (CurrentUser.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="/avatar/@CurrentUser.CommunityId" alt="" width="24" height="24" class="rounded me-1">@(CurrentUser.Name ?? CurrentUser.CommunityId.ToString())
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (modules.IsEnabled(HubModule.Ranking))
                            {
                                <li><a class="dropdown-item" href="/player/@CurrentUser.CommunityId">@L["My profile"]</a></li>
                            }
                            @if (administrator)
                            {
                                <li><a class="dropdown-item" href="/admin">@L["Administration"]</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/logout?returnUrl=@Uri.EscapeDataString(returnUrl)">@L["Sign out"]</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" href="/login?returnUrl=@Uri.EscapeDataString(returnUrl)">
                            <img src="~/imgs/steam.png" alt="" width="18" class="me-1">@L["Sign in with Steam"]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@L[error]</div>
    }
    @if (TempData["Saved"] != null)
    {
        <div class="alert alert-success">@L["Saved."]</div>
    }
    @RenderBody()
</main>
<footer class="container py-4 text-body-secondary small border-top">
    @site.Name · <a class="link-secondary" href="https://github.com/altair-sossai/l4d2-playstats-hub">L4D2 PlayStats Hub</a>
</footer>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
