@inject ISettingsService Settings
@inject ICurrentUser CurrentUser
@inject BrandingStore Branding
@{
    var site = await Settings.GetAsync<SiteSettings>();
    var modules = await Settings.GetAsync<ModuleSettings>();
    var administrator = await CurrentUser.IsAdministratorAsync();
    var light = Context.Request.Cookies[AppConsts.ThemeCookie] == AppConsts.LightTheme;
    var culture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Uri.EscapeDataString(ErrorPages.OriginalPathAndQuery(Context));
    var ranking = modules.IsEnabled(HubModule.Ranking);
    var liveServer = modules.IsEnabled(HubModule.LiveServer);
    var skinShop = modules.IsEnabled(HubModule.SkinShop);
    var communityRanking = modules.IsEnabled(HubModule.CommunityRanking);
    var antiCheat = modules.IsEnabled(HubModule.AntiCheat);
    var siteChat = modules.IsEnabled(HubModule.SiteChat);
    var metadata = ViewData["PageMetadata"] as PageMetadata;
    var pageTitle = metadata?.Title ?? ViewData["Title"] as string;
    var title = string.IsNullOrEmpty(pageTitle) || pageTitle == site.Name ? site.Name : $"{pageTitle} | {site.Name}";
    var description = metadata?.Description ?? L["Statistics, rankings, players, and matches from the {0} Left 4 Dead 2 server.", site.Name].Value;
    var siteUrl = string.IsNullOrWhiteSpace(site.PublicUrl) ? $"{Context.Request.Scheme}://{Context.Request.Host}" : site.PublicUrl.TrimEnd('/');
    var canonical = $"{siteUrl}{ErrorPages.OriginalPath(Context)}";
    var pageImage = !string.IsNullOrWhiteSpace(metadata?.Image) ? metadata.Image : Branding.HasLogo ? AppConsts.LogoUrl : null;
    var image = pageImage == null ? null : Uri.TryCreate(pageImage, UriKind.Absolute, out var imageUri) && (imageUri.Scheme == Uri.UriSchemeHttp || imageUri.Scheme == Uri.UriSchemeHttps) ? pageImage : $"{siteUrl}/{pageImage.TrimStart('/')}";
    var imageAlt = metadata?.ImageAlt ?? pageTitle ?? site.Name;
    var footerLinks = FooterLinks.Parse(site.FooterLinks);
    var languages = new[] { ("en-US", "us", "English", "lang-en"), ("pt-BR", "br", "Português", "lang-pt"), ("es-ES", "es", "Español", "lang-es") };
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="@description">
    @if (!string.IsNullOrWhiteSpace(site.MetaKeywords))
    {
        <meta name="keywords" content="@site.MetaKeywords">
    }
    <meta name="author" content="@site.Name">
    <meta name="robots" content="@(metadata?.NoIndex == true ? "noindex, follow" : "index, follow")">

    <link rel="canonical" href="@canonical">
    <meta property="og:title" content="@title">
    <meta property="og:description" content="@description">
    <meta property="og:url" content="@canonical">
    <meta property="og:type" content="@(metadata?.OpenGraphType ?? AppConsts.DefaultOpenGraphType)">
    @if (image != null)
    {
        <meta property="og:image" content="@image">
        <meta property="og:image:secure_url" content="@image">
        <meta property="og:image:alt" content="@imageAlt">
    }
    <meta property="og:site_name" content="@site.Name">
    <meta property="og:locale" content="@culture.Replace('-', '_')">

    <meta name="twitter:card" content="@(image == null ? "summary" : "summary_large_image")">
    <meta name="twitter:title" content="@title">
    <meta name="twitter:description" content="@description">
    @if (image != null)
    {
        <meta name="twitter:image" content="@image">
        <meta name="twitter:image:alt" content="@imageAlt">
    }

    <title>@title</title>

    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="~/css/lity.min.css" asp-append-version="true"/>

    @if (light)
    {
        <link rel="stylesheet" href="~/css/bootstrap.light.min.css" asp-append-version="true"/>
    }
    else
    {
        <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true"/>
    }

    <style>
        .main-container {
            max-width: 1200px;
        }

        .text-underline {
            text-decoration: underline;
        }

        a, a:visited, a:hover, a:active {
            color: inherit;
        }

        .navbar {
            margin-bottom: 0;
        }

        .navbar-nav .nav-item img {
            width: 20px;
            height: auto;
            margin-top: -2px;
        }

        .logo {
            height: 100%;
            max-height: 50px;
        }

        .navbar-brand.site-name {
            font-weight: bold;
            letter-spacing: .5px;
        }

        .img-header-icon {
            height: 100%;
            max-height: 20px !important;
            max-width: 20px !important;
            display: inline !important;
            margin-right: 5px;
        }

        .vertical-align-middle {
            vertical-align: middle !important;
        }

        .bold {
            font-weight: bold;
        }

        .line-break-anywhere {
            line-break: anywhere
        }

        .tooltip-inner {
            min-width: 150px;
        }

        .icon-copy {
            cursor: pointer;
            width: 14px;
            height: 14px;
            margin: 0 5px;
            margin-bottom: 4px;
        }

        .match .panel h4,
        .match .panel p {
            margin: 0;
        }

        .match .icon {
            width: 16px;
        }

        .match .teams .col-xs-6 {
            padding-right: 5px;
            padding-left: 5px;
        }

        .match table {
            margin-bottom: 0 !important;
        }

        .match .img-campaign {
            max-height: 155px;
        }

        .show-mobile {
            display: none;
        }

        .server-info {
            font-size: 14px;
            padding-left: 7px;
            padding-right: 7px;
        }

        .float-icon {
            position: fixed;
            bottom: 20px;
            right: 20px;
        }

            .float-icon img {
                width: 70px;
            }

        .table > thead > tr > td.it-is-me,
        .table > tbody > tr > td.it-is-me,
        .table > tfoot > tr > td.it-is-me,
        .table > thead > tr > th.it-is-me,
        .table > tbody > tr > th.it-is-me,
        .table > tfoot > tr > th.it-is-me,
        .table > thead > tr.it-is-me > td,
        .table > tbody > tr.it-is-me > td,
        .table > tfoot > tr.it-is-me > td,
        .table > thead > tr.it-is-me > th,
        .table > tbody > tr.it-is-me > th,
        .table > tfoot > tr.it-is-me > th {
            background-color: @Html.Raw(light ? "#bcf3a6" : "#2e6b2e");
        }

        @@media screen and (min-width: 700px) {
            .slim {
                width: 1px;
                white-space: nowrap;
            }
        }

        @@media screen and (max-width: 700px) {
            .hide-mobile {
                display: none !important;
            }

            .show-mobile {
                display: inline;
            }

            .match .left-side {
                width: 100% !important;
                margin-bottom: 10px;
            }

            .match .right-side {
                width: 100% !important;
            }

            .table-responsive thead,
            .table-responsive tfoot,
            .table-responsive th {
                display: none;
            }

            .table-responsive tr {
                border-top: 1px solid #ddd;
                display: block;
                margin: 0;
                padding: 0;
            }

            .table-responsive td {
                border-bottom: 1px solid #ddd;
                display: block;
                text-align: right !important;
                padding: 5px !important;
                margin: 0px !important;
                overflow-wrap: anywhere;
            }

                .table-responsive td::before {
                    content: attr(data-label);
                    float: left;
                    vertical-align: middle;
                    font-weight: bold;
                    padding-right: 15px;
                }

                .table-responsive td::after {
                    content: "";
                    display: table;
                    clear: both;
                }
        }

        @@media (min-width: 768px) and (max-width: 930px) {
            .navbar-nav > li > a {
                padding-left: 10px;
                padding-right: 10px;
            }
        }

        .nav-stars-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: -4px 0;
            padding: 3px 10px 3px 7px;
            border: 1px solid rgba(240, 173, 78, .6);
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(240, 173, 78, .28), rgba(240, 173, 78, .08));
            line-height: 20px;
            white-space: nowrap;
            transition: background-color .2s, border-color .2s;
        }

        .nav-stars a:hover .nav-stars-pill,
        .nav-stars a:focus .nav-stars-pill {
            border-color: #f0ad4e;
            background-color: rgba(240, 173, 78, .18);
        }

        .nav-stars-icon {
            color: #f0ad4e;
            font-size: 16px;
            text-shadow: 0 0 6px rgba(240, 173, 78, .7);
        }

        .nav-stars-label {
            font-size: 12px;
            opacity: .85;
        }

        @@media (min-width: 768px) and (max-width: 1199px) {
            .nav-stars-label {
                display: none;
            }
        }

        .nav-compact .nav-stars-label {
            display: none;
        }

        .field-help {
            margin-left: 4px;
            color: #8a8f98;
            cursor: help;
            font-size: 13px;
            font-weight: normal;
            vertical-align: 1px;
        }

        .field-help:hover,
        .field-help:focus {
            color: #5bc0de;
            text-decoration: none;
            outline: none;
        }

        .field-help-more {
            color: #5bc0de;
            cursor: pointer;
        }

        .field-help-more:hover,
        .field-help-more:focus {
            color: #8fd9ef;
        }

        #field-help-modal .modal-title .glyphicon,
        #field-help-modal .modal-body strong {
            color: #5bc0de;
        }

        .field-help-summary {
            margin-bottom: 14px;
            padding: 10px 12px;
            border-left: 4px solid #5bc0de;
            border-radius: 4px;
            background: rgba(91, 192, 222, .1);
            font-weight: bold;
        }

        #field-help-modal .modal-body p:last-child {
            margin-bottom: 0;
        }
    </style>

    @await RenderSectionAsync("Styles", false)

    <script>

        function imgOnError(img) {
            img.onerror = null;
            img.src = '@AppConsts.EmptyAvatarUrl';
        }

        function copyTextToClipboard(text, sender) {
            var $this = $(sender);

            navigator.clipboard.writeText(text)
                .then(function(){
                    $this.popover("show");

                    setTimeout(function () {
                        $this.popover("hide");
                    }, 1500);
                })
                .catch(function () {
                    alert('@L["It was not possible to copy the text automatically. Please copy it manually."]');
                });
        }

    </script>
</head>
<body>

<nav class="navbar navbar-default">
    <div class="container-fluid main-container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-navbar-collapse" aria-expanded="false">
                <span class="sr-only">@L["Toggle navigation"]</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @if (Branding.HasLogo)
            {
                <a class="navbar-brand" href="/">
                    <img src="@AppConsts.LogoUrl?v=@Branding.LogoVersion" alt="@site.Name" class="logo img-responsive">
                </a>
            }
            else
            {
                <a class="navbar-brand site-name" href="/">@site.Name</a>
            }
            @if (liveServer)
            {
                <a id="server-info" class="navbar-brand server-info pulsate" href="/servers" title="@L["Server"]" style="display:none;">
                    <span id="server-status" class="label label-success"></span>
                </a>
            }
        </div>

        <div class="collapse navbar-collapse" id="bs-navbar-collapse">
            <ul class="nav navbar-nav" id="nav-main">
                @if (ranking)
                {
                    <li class="nav-fit @ViewBag.Home">
                        <a href="/">@L["Ranking"]</a>
                    </li>
                }
                @if (communityRanking)
                {
                    <li class="nav-fit @ViewBag.Community">
                        <a href="/community">@L["Community"]</a>
                    </li>
                }
                @if (ranking)
                {
                    <li class="nav-fit @ViewBag.LastMatches">
                        <a href="/matches">@L["Last matches"]</a>
                    </li>
                }
                @if (liveServer)
                {
                    <li class="nav-fit @ViewBag.Server">
                        <a href="/servers">@L["Server"]</a>
                    </li>
                }
                @if (skinShop)
                {
                    <li class="nav-fit @ViewBag.Skins">
                        <a href="/skins">@L["Skins"]</a>
                    </li>
                }
                @if (antiCheat)
                {
                    <li class="nav-fit @ViewBag.AntiCheat">
                        <a href="@AppConsts.AntiCheatUrl">@L["Anti-Cheat"]</a>
                    </li>
                }
                <li class="dropdown @(ViewBag.Players ?? ViewBag.History ?? ViewBag.Patent)" id="nav-more" data-own="@(ranking ? "true" : "false")" style="@(ranking ? null : "display: none")">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        @L["More"] <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu" id="nav-more-menu">
                        <li role="separator" class="divider" id="nav-fit-divider" style="display: none"></li>
                        @if (ranking)
                        {
                            <li class="@ViewBag.Players">
                                <a href="/players">
                                    <img src="~/imgs/menu/players.svg" alt="" class="img-responsive img-header-icon">
                                    @L["Players"]
                                </a>
                            </li>
                            <li class="@ViewBag.Patent">
                                <a href="/patents">
                                    <img src="~/imgs/menu/patents.svg" alt="" class="img-responsive img-header-icon">
                                    @L["Patents"]
                                </a>
                            </li>
                            <li role="separator" class="divider"></li>
                            <li class="@ViewBag.History">
                                <a href="/history">
                                    <img src="~/imgs/menu/history.svg" alt="" class="img-responsive img-header-icon">
                                    @L["History"]
                                </a>
                            </li>
                        }
                    </ul>
                </li>
                @if (administrator)
                {
                    <li class="dropdown @ViewBag.Admin">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            <span class="glyphicon glyphicon-cog"></span> @L["Admin"] <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="@ViewBag.Administration">
                                <a href="/admin">
                                    <span class="glyphicon glyphicon-wrench" style="margin-right: 5px"></span>
                                    @L["Administration"]
                                </a>
                            </li>
                            @if (siteChat)
                            {
                                <li role="separator" class="divider"></li>
                                <li class="@ViewBag.ChatBans">
                                    <a href="/admin/chat-bans">
                                        <img src="~/imgs/menu/chat-bans.svg" alt="" class="img-responsive img-header-icon">
                                        @L["Chat Bans"]
                                    </a>
                                </li>
                            }
                            @if (antiCheat)
                            {
                                <li role="separator" class="divider"></li>
                                <li class="@ViewBag.AntiCheatAdmin">
                                    <a href="@AppConsts.AntiCheatAdminUrl">
                                        <span class="glyphicon glyphicon-lock" style="margin-right: 5px"></span>
                                        @L["Anti-Cheat"]
                                    </a>
                                </li>
                            }
                            @if (skinShop)
                            {
                                <li role="separator" class="divider"></li>
                                <li class="@ViewBag.SkinPurchases">
                                    <a href="@AppConsts.SkinAdminUrl">
                                        <img src="~/imgs/menu/skin-purchases.svg" alt="" class="img-responsive img-header-icon">
                                        @L["Skin purchases"]
                                    </a>
                                </li>
                                <li class="@ViewBag.SkinPrices">
                                    <a href="@AppConsts.SkinPricesUrl">
                                        <img src="~/imgs/menu/skin-prices.svg" alt="" class="img-responsive img-header-icon">
                                        @L["Skin prices"]
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
            <ul class="nav navbar-nav navbar-right">
                @if (CurrentUser.IsAuthenticated)
                {
                    if (skinShop)
                    {
                        <li class="nav-stars" style="display: none">
                            <a href="/skins" title="@L["Your stars to buy skins"]" data-toggle="tooltip" data-placement="bottom">
                                <span class="nav-stars-pill">
                                    <span class="nav-stars-icon">★</span>
                                    <b class="nav-stars-value"></b>
                                    <span class="nav-stars-label"></span>
                                </span>
                            </a>
