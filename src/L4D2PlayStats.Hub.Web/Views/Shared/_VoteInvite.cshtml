@using L4D2PlayStats.Hub.Web.Infrastructure.InGame
@model VoteInviteModel
@{
    if (InGameBrowser.IsInGame(Context))
        return;
}

<style>
    .vote-invite {
        position: relative;
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 12px 0 14px;
        padding: 14px 18px;
        border: 1px solid rgba(92, 184, 92, .55);
        border-radius: 6px;
        background: linear-gradient(110deg, rgba(92, 184, 92, .20), rgba(240, 173, 78, .14));
        box-shadow: 0 0 18px rgba(92, 184, 92, .15);
    }

    .vote-invite-icon {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #5cb85c;
        color: #fff;
        font-size: 20px;
    }

    .vote-invite-text {
        flex: 1;
        min-width: 0;
    }

        .vote-invite-text strong {
            display: block;
            font-size: 17px;
        }

        .vote-invite-text > span {
            display: block;
            opacity: .85;
        }

    .vote-invite-more {
        display: inline-block;
        margin-top: 4px;
        font-weight: bold;
        color: #8fd98f !important;
    }

        .vote-invite-more:hover,
        .vote-invite-more:focus {
            color: #fff !important;
            text-decoration: none;
        }

        .vote-invite-more .glyphicon-chevron-right {
            font-size: 10px;
        }

    .vote-invite-button {
        flex: none;
        font-weight: bold;
        animation: vote-invite-glow 2.2s ease-in-out infinite;
    }

    .vote-invite-close {
        position: absolute;
        top: 4px;
        right: 8px;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font-size: 18px;
        line-height: 1;
        opacity: .6;
    }

        .vote-invite-close:hover {
            opacity: 1;
        }

    .vote-invite-compact {
        padding: 10px 34px 10px 14px;
    }

        .vote-invite-compact .vote-invite-icon {
            width: 36px;
            height: 36px;
            font-size: 16px;
        }

        .vote-invite-compact .vote-invite-text strong {
            font-size: 15px;
        }

    @@keyframes vote-invite-glow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(92, 184, 92, .55);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(92, 184, 92, 0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .vote-invite-more {
        display: inline-block;
        margin-top: 4px;
        font-weight: bold;
        color: #8fd98f !important;
    }

        .vote-invite-more:hover,
        .vote-invite-more:focus {
            color: #fff !important;
            text-decoration: none;
        }

        .vote-invite-more .glyphicon-chevron-right {
            font-size: 10px;
        }

    .vote-invite-button {
            animation: none;
        }
    }

    @@media (max-width: 600px) {
        .vote-invite {
            flex-wrap: wrap;
        }

        .vote-invite-more {
        display: inline-block;
        margin-top: 4px;
        font-weight: bold;
        color: #8fd98f !important;
    }

        .vote-invite-more:hover,
        .vote-invite-more:focus {
            color: #fff !important;
            text-decoration: none;
        }

        .vote-invite-more .glyphicon-chevron-right {
            font-size: 10px;
        }

    .vote-invite-button {
            width: 100%;
        }
    }
</style>

<div class="vote-invite@(Model.Compact ? " vote-invite-compact hidden" : "")" id="@(Model.Compact ? "vote-invite" : null)">
    <div class="vote-invite-icon">
        <span class="glyphicon glyphicon-thumbs-up"></span>
    </div>
    <div class="vote-invite-text">
        <strong>@L["Who plays better?"]</strong>
        <span>@L["Pick the better of two players you know and help build the community ranking. It takes a few seconds."]</span>
        @if (Model.HowItWorks)
        {
            <a class="vote-invite-more" href="#how-it-works-modal" data-toggle="modal">
                <span class="glyphicon glyphicon-info-sign"></span> @L["How does it work?"] <span class="glyphicon glyphicon-chevron-right"></span>
            </a>
        }
    </div>
    <a class="btn btn-success @(Model.Compact ? "" : "btn-lg ")vote-invite-button" href="@AppConsts.CommunityVotePage">
        <span class="glyphicon glyphicon-hand-right"></span> @L["Vote now"]
    </a>
    @if (Model.Compact)
    {
        <button type="button" class="vote-invite-close" aria-label="@L["Close"]" title="@L["Close"]">&times;</button>
    }
</div>

@if (Model.Compact)
{
    <script>
        (function () {
            var key = 'vote-invite-hidden-until';
            var invite = document.getElementById('vote-invite');
            var hiddenUntil = 0;

            try {
                hiddenUntil = parseInt(localStorage.getItem(key) || '0', 10);
            } catch (e) {
            }

            if (Date.now() >= hiddenUntil)
                invite.classList.remove('hidden');

            invite.querySelector('.vote-invite-close').addEventListener('click', function () {
                invite.classList.add('hidden');

                try {
                    localStorage.setItem(key, String(Date.now() + @((long)TimeSpan.FromDays(AppConsts.VoteInviteHiddenDays).TotalMilliseconds)));
                } catch (e) {
                }
            });
        })();
    </script>
}
