@using L4D2PlayStats.Hub.Web.Infrastructure.InGame
@model VoteInviteModel
@inject ICurrentUser CurrentUser
@inject L4D2PlayStats.Hub.Core.Modules.Community.Services.Contracts.ICommunityVoteService CommunityVotes
@{
    if (InGameBrowser.IsInGame(Context))
        return;

    if (CurrentUser.CommunityId is { } voterId && !await CommunityVotes.CanVoteAsync(voterId))
        return;
}

<link rel="stylesheet" href="~/css/pages/vote-invite.css" asp-append-version="true"/>

<div class="vote-invite@(Model.Compact ? " vote-invite-compact hidden" : "")" id="@(Model.Compact ? "vote-invite" : null)">
    <div class="vote-invite-icon">
        <span class="glyphicon glyphicon-thumbs-up"></span>
    </div>
    <div class="vote-invite-text">
        <strong>@L["Who plays better?"]</strong>
        <span>@L["Pick the better of two players you know and help build the community ranking. It takes a few seconds."]</span>
        @if (Model.HowItWorks)
        {
            <a class="vote-invite-more" href="#how-it-works-modal" data-toggle="modal">
                <span class="glyphicon glyphicon-info-sign"></span> @L["How does it work?"] <span class="glyphicon glyphicon-chevron-right"></span>
            </a>
        }
    </div>
    <a class="btn btn-success @(Model.Compact ? "" : "btn-lg ")vote-invite-button" href="@AppConsts.CommunityVotePage">
        <span class="glyphicon glyphicon-hand-right"></span> @L["Vote now"]
    </a>
    @if (Model.Compact)
    {
        <button type="button" class="vote-invite-close" aria-label="@L["Close"]" title="@L["Close"]">&times;</button>
    }
</div>

@if (Model.Compact)
{
    <script>
        (function () {
            var key = 'vote-invite-hidden-until';
            var invite = document.getElementById('vote-invite');
            var hiddenUntil = 0;

            try {
                hiddenUntil = parseInt(localStorage.getItem(key) || '0', 10);
            } catch (e) {
            }

            if (Date.now() >= hiddenUntil)
                invite.classList.remove('hidden');

            invite.querySelector('.vote-invite-close').addEventListener('click', function () {
                invite.classList.add('hidden');

                try {
                    localStorage.setItem(key, String(Date.now() + @((long)TimeSpan.FromDays(AppConsts.VoteInviteHiddenDays).TotalMilliseconds)));
                } catch (e) {
                }
            });
        })();
    </script>
}
