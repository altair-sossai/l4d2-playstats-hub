@{
    var path = (Context.Request.Path.Value ?? string.Empty).TrimEnd('/');

    var items = new (string Url, string Title)[]
    {
        (AppConsts.SkinAdminUrl, L["Skin purchases"].Value),
        (AppConsts.SkinPricesUrl, L["Skin prices"].Value),
        (AppConsts.SkinCatalogUrl, L["Skin catalog"].Value),
        (AppConsts.SkinSettingsUrl, L["Shop settings"].Value)
    };
}

<ul class="nav nav-tabs" style="margin-top: 15px">
    @foreach (var item in items)
    {
        var active = path.Equals(item.Url, StringComparison.OrdinalIgnoreCase);

        <li role="presentation" class="@(active ? "active" : "")">
            <a href="@item.Url">@item.Title</a>
        </li>
    }
</ul>
