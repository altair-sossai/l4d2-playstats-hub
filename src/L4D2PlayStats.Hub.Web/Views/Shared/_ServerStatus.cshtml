@model ServerStatusViewModel
@{
    var status = Model.Status;
    var signal = status.Signal;
    var connected = status.State == GameServerConnectionState.Online;

    var title = status.State switch
    {
        GameServerConnectionState.Online => L["Connected"].Value,
        GameServerConnectionState.Offline => L["Offline"].Value,
        GameServerConnectionState.InvalidKey => L["Invalid key"].Value,
        _ => L["Waiting for the first connection"].Value
    };

    string Icon(bool? ok)
    {
        return ok == true ? "glyphicon-ok" : ok == false ? "glyphicon-remove" : "glyphicon-option-horizontal";
    }

    string Style(bool? ok)
    {
        return ok == true ? "text-success" : ok == false ? "text-danger" : "text-muted";
    }

    bool? Plugin(string name)
    {
        return signal == null ? null : signal.Plugins.ContainsKey(name);
    }

    var files = L["First statistics file received"].Value;

    var checks = new List<(bool? Ok, string Text)>
    {
        (connected ? true : status.LastSeenAtUtc == null ? null : false, L["Connection with this site"].Value),
        (Plugin("l4d2_playstats_sync"), L["Statistics upload plugin loaded"].Value),
        (signal?.StatisticsWriting, L["Statistics writing enabled (sm_stats_writestats 1)"].Value),
        (Model.Files > 0 ? true : null, Model.Files > 0 ? $"{files} ({Display.Number(Model.Files)})" : files)
    };

    if (Model.Modules.IsEnabled(HubModule.LiveServer))
    {
        checks.Add((status.LastLiveDataAtUtc != null ? true : null, L["Live match data arriving"].Value));
    }

    if (Model.Modules.IsEnabled(HubModule.SkinShop))
    {
        checks.Add((Plugin("l4d2_weapon_skins"), L["Weapon skins plugin loaded"].Value));
    }
}
<div id="server-status-@Model.Server.Id" hx-get="/admin/servers/@Model.Server.Id/status" hx-trigger="every @(AppConsts.ServerStatusRefreshInSeconds)s" hx-swap="outerHTML">
    <p>
        <span class="status-dot status-@status.State"></span>
        <strong>@title</strong>
        @if (status.LastSeenAtUtc != null)
        {
            <small class="text-muted" style="margin-left: 8px">@L["Last contact"]: @status.LastSeenAtUtc.Value.ToString("u")</small>
        }
    </p>
    @if (status.State == GameServerConnectionState.InvalidKey)
    {
        <div class="alert alert-danger">@L["The server identifier arrived with the wrong key. Check the token in the server configuration, or generate a new key."]</div>
    }
    <ul class="list-unstyled server-checks">
        @foreach (var check in checks)
        {
            <li class="@Style(check.Ok)">
                <span class="glyphicon @Icon(check.Ok)"></span> @check.Text
            </li>
        }
    </ul>
    @if (signal != null)
    {
        <small class="text-muted" style="display: block; margin-top: 8px">
            @signal.Hostname
            @if (!string.IsNullOrEmpty(signal.Map))
            {
                <span>· @signal.Map</span>
            }
            @if (!string.IsNullOrEmpty(signal.Configuration))
            {
                <span>· @signal.Configuration</span>
            }
            @if (!string.IsNullOrEmpty(signal.SourceModVersion))
            {
                <span>· SourceMod @signal.SourceModVersion</span>
            }
        </small>
    }
</div>
