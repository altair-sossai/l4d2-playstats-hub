@inject ISettingsService Settings
@{
    var path = Context.Request.Path.Value ?? string.Empty;
    var modules = await Settings.GetAsync<ModuleSettings>();

    var items = new List<(string Url, string Title)>
    {
        ("/admin", L["Overview"].Value),
        ("/admin/servers", L["Game servers"].Value),
        ("/admin/modules", L["Modules"].Value),
        ("/admin/settings", L["Settings"].Value),
        ("/admin/game-modes", L["Game modes"].Value),
        ("/admin/campaigns", L["Campaigns"].Value),
        ("/admin/administrators", L["Administrators"].Value)
    };

    if (modules.IsEnabled(HubModule.SkinShop))
        items.Add((AppConsts.SkinAdminUrl, L["Skins"].Value));

    if (modules.IsEnabled(HubModule.CommunityRanking))
        items.Add(("/admin/community", L["Community ranking"].Value));

    if (modules.IsEnabled(HubModule.SiteChat))
        items.Add(("/admin/chat-bans", L["Chat bans"].Value));

    if (modules.IsEnabled(HubModule.RemoteCommands))
        items.Add(("/admin/remote-commands", L["Remote commands"].Value));

    if (modules.IsEnabled(HubModule.LiveServer))
        items.Add(("/admin/player-connections", L["Player connections"].Value));
}
<ul class="nav nav-pills flex-wrap mb-4">
    @foreach (var item in items)
    {
        var active = item.Url == "/admin" ? path == "/admin" : path.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase);

        <li class="nav-item"><a class="nav-link @(active ? "active" : "")" href="@item.Url">@item.Title</a></li>
    }
</ul>
