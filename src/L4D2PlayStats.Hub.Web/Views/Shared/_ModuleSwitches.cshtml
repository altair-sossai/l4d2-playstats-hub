@model ModuleSettings
@{
    var modules = new (string Name, bool Value, string Title, string Description)[]
    {
        (nameof(ModuleSettings.Ranking), Model.Ranking, L["Ranking and statistics"].Value, L["Ranking, matches, players, patents and season history."].Value),
        (nameof(ModuleSettings.LiveServer), Model.LiveServer, L["Live server"].Value, L["Scoreboard, players and events of the match in progress, for each game server."].Value),
        (nameof(ModuleSettings.SiteChat), Model.SiteChat, L["Site chat"].Value, L["Chat between the site and the game. Needs the live server."].Value),
        (nameof(ModuleSettings.RemoteCommands), Model.RemoteCommands, L["Remote commands"].Value, L["Administrators send commands from the site to a game server. Needs the live server."].Value),
        (nameof(ModuleSettings.SkinShop), Model.SkinShop, L["Weapon skin shop"].Value, L["Players earn stars from MVPs and spend them on skins. Needs the ranking."].Value),
        (nameof(ModuleSettings.CommunityRanking), Model.CommunityRanking, L["Community ranking"].Value, L["Players vote on who is better, and the votes build a second ranking."].Value),
        (nameof(ModuleSettings.AntiCheat), Model.AntiCheat, L["Anti-Cheat"].Value, L["Shows the Anti-Cheat page with the download and instructions. The Anti-Cheat itself is a separate program."].Value)
    };
}
@foreach (var module in modules)
{
    <div class="checkbox module-switch">
        <label for="module-@module.Name">
            <input type="checkbox" id="module-@module.Name" name="@module.Name" value="true" checked="@module.Value">
            <input type="hidden" name="@module.Name" value="false">
            <strong>@module.Title</strong>
            <span class="help-block">@module.Description</span>
        </label>
    </div>
}
