@model ModuleSettings
@{
    var modules = new (string Name, bool Value, string Title, string Description, string HelpSummary, string HelpDetails)[]
    {
        (nameof(ModuleSettings.Ranking), Model.Ranking, L["Ranking and statistics"].Value, L["Ranking, matches, players, patents and season history."].Value, L["When it is off, the first page shows a short welcome text and the matches are still built, out of sight."].Value, L["Contains the ranking, the matches, the players, the patents, the history, the punishments and the pages inside the game.\nWhen it is off, those pages leave the menu and answer as not found, and the first page shows a short welcome text. The statistics files keep arriving and the matches are still built from them, out of sight.\nThe weapon skin shop needs this module: while it is off, the shop behaves as off too.\nTurning a module off deletes nothing: its data comes back when it is turned on again."].Value),
        (nameof(ModuleSettings.LiveServer), Model.LiveServer, L["Live server"].Value, L["Scoreboard, players and events of the match in progress, for each game server."].Value, L["When it is off, there is no Server menu item and the site refuses the live data of the plugins."].Value, L["Shows the match in progress on each game server: the scoreboard, the players and the events.\nWhen it is off, the Server menu item disappears and the site refuses the live data sent by the plugins. The related accounts and the player connections are not shown either, whatever the privacy setting says.\nThe site chat and the remote commands need this module: while it is off, they behave as off too. The sync command the site sends to the anti-cheat plugin after a change in the Anti-Cheat settings also travels through it; without it, the plugin still reads the lists by itself every minute.\nTurning a module off deletes nothing: its data comes back when it is turned on again."].Value),
        (nameof(ModuleSettings.SiteChat), Model.SiteChat, L["Site chat"].Value, L["Chat between the site and the game. Needs the live server."].Value, L["Signed-in players write in the game chat from the live page. Needs the live server."].Value, L["Signed-in players can write in the chat of a game server from the live server page.\nIt adds the Chat bans page, to stop a player from writing from the site. A chat ban does not mute the player inside the game.\nIt needs the live server module: while that one is off, this one behaves as off, even when it is ticked.\nWhen it is off, the live page has no chat box and there is no Chat bans page."].Value),
        (nameof(ModuleSettings.RemoteCommands), Model.RemoteCommands, L["Remote commands"].Value, L["Administrators send commands from the site to a game server. Needs the live server."].Value, L["Administrators send SourceMod commands from the site to a game server, without RCON. Needs the live server."].Value, L["An administrator chooses a game server and sends a SourceMod command, such as sm_forcestart. The game server picks it up on its next check and runs it. Every command is recorded in an audit log.\nIt adds the Remote commands page and the terminal on the live page.\nIt needs the live server module: while that one is off, this one behaves as off, even when it is ticked.\nThe sync command the site sends to the anti-cheat plugin after a change in the Anti-Cheat settings does not need this module."].Value),
        (nameof(ModuleSettings.SkinShop), Model.SkinShop, L["Weapon skin shop"].Value, L["Players earn stars from MVPs and spend them on skins. Needs the ranking."].Value, L["Players earn stars from MVP awards and spend them on weapon skins. Needs the ranking."].Value, L["Each SI MVP and CI MVP award of a ranked match gives one star. Players spend the stars on weapon skins, and the game server equips them in the game. Administrators can also give skins as gifts.\nIt adds the Skins menu item, the stars in the menu bar, the Skins tab on the player page, and the Purchases, Prices, Catalog and Shop settings pages. The bundled catalog is imported by itself when the module is turned on and no catalog was imported yet.\nIt needs the ranking module: while that one is off, this one behaves as off, even when it is ticked.\nWhen it is off, the game server gets no skins. The purchases are kept and come back when it is turned on again."].Value),
        (nameof(ModuleSettings.CommunityRanking), Model.CommunityRanking, L["Community ranking"].Value, L["Players vote on who is better, and the votes build a second ranking."].Value, L["Players vote on which of two players is better, and the votes build a second ranking."].Value, L["Signed-in players compare two players at a time, and the votes build a ranking made by the community, apart from the experience ranking.\nIt adds the Community menu item and the Community ranking page of the administration area, with the rules of the voting.\nWhen it is off, the Community menu item disappears.\nTurning a module off deletes nothing: its data comes back when it is turned on again."].Value),
        (nameof(ModuleSettings.AntiCheat), Model.AntiCheat, L["Anti-Cheat"].Value, L["Shows the Anti-Cheat page with the download and instructions. The Anti-Cheat itself is a separate program."].Value, L["The Anti-Cheat page for players and the settings of who must use the Anti-Cheat on the game servers."].Value, L["Adds the Anti-Cheat page, with the download and the instructions for the players, and the Anti-Cheat settings page, where you choose who must run the Anti-Cheat to play and keep the lists of players.\nThe Anti-Cheat itself is a separate program with its own service. This site only shows its page and gives the mode and the lists to the anti-cheat plugin of the game servers.\nWhen it is off, the menu items disappear, the pages answer as not found, and the anti-cheat plugin gets no mode or lists from the site."].Value)
    };
}
@foreach (var module in modules)
{
    <div class="checkbox module-switch">
        <label for="module-@module.Name">
            <input type="checkbox" id="module-@module.Name" name="@module.Name" value="true" checked="@module.Value">
            <input type="hidden" name="@module.Name" value="false">
            <strong>@module.Title</strong> @FieldHelp.More(module.HelpSummary, module.Title, module.HelpDetails)
            <span class="help-block">@module.Description</span>
        </label>
    </div>
}
