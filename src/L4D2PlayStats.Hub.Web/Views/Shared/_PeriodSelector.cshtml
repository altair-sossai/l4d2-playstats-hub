@using L4D2PlayStats.Hub.Web.Models.Players
@model L4D2PlayStats.Hub.Web.Models.Players.PlayerPeriodSelectorModel

@functions {

    private string SeasonLabel(Season season)
    {
        var label = RankingPeriod.ForSeason(season).Label(L);

        return season.Id == Model.Period.CurrentSeason.Id ? $"{label} ({L["Current season"].Value})" : label;
    }

    private string OptionLabel(PlayerPeriodOption option)
    {
        if (option.AllTime)
            return L["All time"];

        return option.Season != null ? SeasonLabel(option.Season) : RankingPeriod.ForYear(option.Year!.Value).Label(L);
    }

    private string SelectedLabel()
    {
        if (Model.Period.AllTime)
            return L["All time"];

        return Model.Period.Season != null ? SeasonLabel(Model.Period.Season) : RankingPeriod.ForYear(Model.Period.Year!.Value).Label(L);
    }

}

@if (Model.Period.HasChoices)
{
    <div class="dropdown period-selector" style="display: inline-block; vertical-align: top; max-width: 100%; margin-bottom: 5px">
        <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown" style="max-width: 100%; white-space: normal">
            @L["Displayed period"]:
            <b>@SelectedLabel()</b>
            <span class="caret"></span>
        </button>
        <ul class="dropdown-menu" style="max-height: 60vh; overflow-y: auto">
            @{ var yearsStarted = false; }
            @foreach (var option in Model.Period.Options)
            {
                if ((option.Year != null || option.AllTime) && !yearsStarted)
                {
                    yearsStarted = true;

                    <li role="separator" class="divider"></li>
                }

                <li>
                    <a href="@Model.Url(option.Query)">@OptionLabel(option)</a>
                </li>
            }
        </ul>
    </div>
}
