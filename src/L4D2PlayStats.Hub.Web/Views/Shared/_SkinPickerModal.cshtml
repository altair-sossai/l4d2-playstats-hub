@model IReadOnlyCollection<Skin>
@inject ISettingsService ShopSettingsService
@inject SkinThumbnailStore SkinThumbnails

@{
    var culture = CultureInfo.CurrentUICulture;
    var shop = await ShopSettingsService.GetAsync<SkinShopSettings>();
    var weapons = SkinWeapons.Sort(SkinWeapons.All.Concat(Model.Select(skin => skin.Weapon)));
    var skins = Model
        .OrderByDescending(skin => skin.Rarity)
        .ThenByDescending(skin => skin.Price)
        .ThenBy(skin => SkinWeapons.Order(skin.Weapon))
        .ToList();
}

<link rel="stylesheet" href="~/css/pages/skin-picker-modal.css" asp-append-version="true"/>

<div id="sp-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@L["Choose a skin"]</h4>
            </div>
            <div class="modal-body">
                <div class="sp-filters">
                    <input type="text" class="form-control sp-search" placeholder="@L["Search skin by name or id..."]"/>
                    <select class="form-control sp-weapon">
                        <option value="">@L["All weapons"]</option>
                        @foreach (var weapon in weapons)
                        {
                            <option value="@weapon">@L[SkinWeapons.Name(weapon)]</option>
                        }
                    </select>
                    <select class="form-control sp-rarity-filter">
                        <option value="">@L["All rarities"]</option>
                        @foreach (var rarity in SkinDisplay.Rarities)
                        {
                            <option value="@rarity">@L[SkinDisplay.RarityKey(rarity)]</option>
                        }
                    </select>
                </div>
                <div class="sp-grid">
                    @foreach (var skin in skins)
                    {
                        var title = skin.Title(culture);
                        var weapon = L[SkinWeapons.Name(skin.Weapon)].Value;
                        var rarity = L[SkinDisplay.RarityKey(skin.Rarity)].Value;
                        var image = SkinThumbnails.Image(shop.AssetsUrl, skin);

                        <div class="sp-tile @SkinDisplay.PickerCss(skin.Rarity)"
                             data-id="@skin.Id" data-title="@title" data-image="@image" data-weapon="@skin.Weapon" data-weapon-name="@weapon"
                             data-rarity="@skin.Rarity" data-rarity-name="@rarity" data-price="@skin.Price"
                             data-search="@($"{title} {skin.Id} {weapon}".ToLowerInvariant())">
                            <img src="@image" alt="@title" loading="lazy"/>
                            <div class="sp-tile-body">
                                <strong title="@title">@title</strong>
                                <small>@weapon</small>
                                <small><span class="sp-rarity">@rarity</span> · @skin.Price.ToString("N0", culture) ⭐</small>
                            </div>
                        </div>
                    }
                </div>
                <p class="text-muted text-center sp-empty" style="display: none">@L["No skins match these filters."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/pages/skin-picker-modal.js" asp-append-version="true"></script>
