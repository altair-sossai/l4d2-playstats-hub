@using L4D2PlayStats.Hub.Core.Modules.AntiCheat.Enums
@using L4D2PlayStats.Hub.Core.Modules.AntiCheat.Extensions
@model L4D2PlayStats.Hub.Web.Models.AntiCheat.AntiCheatAdminModel
@{
    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Anti-Cheat settings"],
        Description = L["Anti-Cheat settings"],
        NoIndex = true
    };

    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Players, number => QueryUrl.Build(AppConsts.AntiCheatAdminUrl, (AppConsts.AntiCheatListQuery, Model.ShownListName), (AppConsts.SearchQuery, Model.Query), (AppConsts.AdminPageQuery, number)));
    var whitelistShown = Model.ShownList == AntiCheatAccessList.Whitelist;
    var listTitle = whitelistShown ? L["Except these players"].Value : L["Only these players"].Value;
    var listHelp = whitelistShown ? L["Whitelist: these players can play without the Anti-Cheat while everyone must use it."].Value : L["Required list: these players must run the Anti-Cheat while no one else has to."].Value;
    var otherListName = Model.OtherList == AntiCheatAccessList.Whitelist ? L["whitelist"].Value : L["required list"].Value;
    var updatedAt = Model.Access.UpdatedAtUtc == null ? null : Display.DateTime(Model.Access.UpdatedAtUtc.Value, Model.TimeZone);
    var updatedFrom = Model.Access.UpdatedFrom == AntiCheatAccessSource.Game ? L["in the game"].Value : L["on the site"].Value;
    var tabs = new AdminTabsModel(
    [
        new AdminTab(AppConsts.AntiCheatPlayersTab, L["Players"].Value, "user"),
        new AdminTab(AppConsts.AntiCheatPageTab, L["Anti-Cheat page"].Value, "file")
    ], AdminTabs.Active(Context.Request.Query[AppConsts.AdminTabQuery], AppConsts.AntiCheatPlayersTab, AppConsts.AntiCheatPageTab));
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <link rel="stylesheet" href="~/css/pages/anti-cheat-admin-index.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="admin-header">
    <h3>@L["Anti-Cheat settings"]</h3>
</div>

@await Html.PartialAsync("_AdminTabs", tabs)

<div class="tab-content">
    <div role="tabpanel" class="@AdminTabs.Pane(tabs, AppConsts.AntiCheatPlayersTab)" id="@AdminTabs.PaneId(AppConsts.AntiCheatPlayersTab)">
        <p class="text-muted">@L["Choose who must run the Anti-Cheat on the game server and keep one list of players for each mode. The server picks up every change within a minute."]</p>

        <h4>@L["Usage mode"] @FieldHelp.More(L["Who must run the Anti-Cheat to play on the game servers. Each mode has its own list of players."], L["Usage mode"], L["Everyone must use it: every player needs the Anti-Cheat running to play, except the players on the whitelist. On the game server this is anti_cheat_mode 0.\nNo one, except these players: only the players on the required list need the Anti-Cheat; everyone else plays without it. This is anti_cheat_mode 1.\nEach mode keeps its own list, so changing the mode loses neither of them. The mode and the lists are the same for every game server of the site.\nThe mode saved here wins over the anti_cheat_mode of the game server; until a mode is saved, each server uses its own value. After a change, the game servers pick it up within a minute.\nThese settings only decide who must use the program. Whether a game server enforces it at all is the anti_cheat_enabled setting of the plugin."])</h4>
        <div class="aca-modes">
            <label class="aca-mode @(Model.Mode == AntiCheatAccessMode.Everyone ? "aca-selected" : "")">
                <input type="radio" name="aca-mode" value="@AntiCheatAccessMode.Everyone.ToName()" @(Model.Mode == AntiCheatAccessMode.Everyone ? "checked" : "")/>
                <span>
                    <strong>@L["Everyone must use it"]</strong>
                    <small>@L["Every player needs the Anti-Cheat running to play. The players on the list below are exempt."]</small>
                </span>
            </label>
            <label class="aca-mode @(Model.Mode == AntiCheatAccessMode.Listed ? "aca-selected" : "")">
                <input type="radio" name="aca-mode" value="@AntiCheatAccessMode.Listed.ToName()" @(Model.Mode == AntiCheatAccessMode.Listed ? "checked" : "")/>
                <span>
                    <strong>@L["No one, except these players"]</strong>
                    <small>@L["Only the players on the list below need the Anti-Cheat running to play."]</small>
                </span>
            </label>
        </div>
        <div class="aca-mode-footer">
            <small class="aca-mode-status">
                @if (!Model.Access.ModeSaved)
                {
                    @L["Not saved on the site yet: the server is using the anti_cheat_mode value from its config file."]
                }
                else if (!string.IsNullOrWhiteSpace(Model.Access.UpdatedByName) && updatedAt != null)
                {
                    @string.Format(L["Last changed by {0} {1} on {2}."].Value, Model.Access.UpdatedByName, updatedFrom, updatedAt)
                }
            </small>
            <button type="button" class="btn btn-success aca-save-mode" @(Model.Access.ModeSaved ? "disabled" : "")>
                <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save mode"]
            </button>
        </div>
        <div class="aca-mode-message"></div>

        <div class="aca-list-header">
            <h4>@listTitle</h4>
            <a href="@($"{AppConsts.AntiCheatAdminUrl}?list={Model.OtherListName}")">@string.Format(L["See the {0} ({1})"].Value, otherListName, Model.OtherCount.ToString("N0", culture))</a>
        </div>
        <p class="text-muted">@listHelp</p>

        @if (!Model.ShowingActiveList)
        {
            <div class="alert alert-info">
                @L["This list is not used in the current mode. It stays saved for when the mode changes."]
                <a class="alert-link" href="@AppConsts.AntiCheatAdminUrl">@L["See the list in use"]</a>
            </div>
        }

        <div class="admin-stats">
            <div>
                <strong>@Model.ShownCount.ToString("N0", culture)</strong>
                <small>@L["players on this list"]</small>
            </div>
        </div>

        <div class="admin-toolbar">
            <form method="get" class="admin-filters" action="@AppConsts.AntiCheatAdminUrl">
                <input type="hidden" name="list" value="@Model.ShownListName"/>
                <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@L["Search by name or Steam ID"]"/>
                <button type="submit" class="btn btn-default">
                    <span class="glyphicon glyphicon-search"></span> @L["Search"]
                </button>
                @if (!string.IsNullOrEmpty(Model.Query))
                {
                    <a class="btn btn-link" href="@($"{AppConsts.AntiCheatAdminUrl}?list={Model.ShownListName}")">@L["Clear filters"]</a>
                }
            </form>
            <div class="admin-toolbar-actions">
                <button type="button" class="btn btn-primary aca-add">
                    <span class="glyphicon glyphicon-plus"></span> @L["Add"]
                </button>
            </div>
        </div>

        <div class="admin-list">
            @if (Model.Players.Items.Count == 0)
            {
                <div class="admin-empty">@L["No players on this list."]</div>
            }
            @foreach (var player in Model.Players.Items)
            {
                var addedAt = Display.DateTime(player.CreatedAtUtc, Model.TimeZone);
                var addedFrom = player.AddedFrom == nameof(AntiCheatAccessSource.Game) ? L["in the game"].Value : L["on the site"].Value;
                var addedBy = string.IsNullOrWhiteSpace(player.AddedByName) ? addedFrom : string.Format(L["by {0} {1}"].Value, player.AddedByName, addedFrom);

                <div class="admin-item aca-player"
                     data-community-id="@player.CommunityId" data-name="@player.Name" data-avatar="@player.AvatarUrl" data-steam-id="@player.SteamId"
                     data-profile-url="@player.ProfileUrl" data-added-at="@addedAt" data-added-by="@addedBy">
                    <img class="admin-avatar" src="@player.AvatarUrl" alt="@player.Name" onerror="imgOnError(this)"/>
                    <div class="admin-main">
                        <div class="admin-title">@player.Name</div>
                        <small title="SteamID64: @player.CommunityId">@player.SteamId</small>
                    </div>
                    <div class="admin-side">
                        <strong>@addedAt</strong>
                        <small>@addedBy</small>
                    </div>
                </div>
            }
        </div>

        @await Html.PartialAsync("_Pagination", pagination)
    </div>

    <div role="tabpanel" class="@AdminTabs.Pane(tabs, AppConsts.AntiCheatPageTab)" id="@AdminTabs.PaneId(AppConsts.AntiCheatPageTab)">
        <div class="row">
            <div class="col-lg-8">
                <form method="post" asp-antiforgery="true" action="@AppConsts.AntiCheatAdminUrl">
                    <div class="panel panel-default aca-page-panel">
                        <div class="panel-heading">
                            <h3 class="panel-title">@L["Anti-Cheat page"]</h3>
                        </div>
                        <div class="panel-body">
                            <p>
                                @L["The Anti-Cheat page explains how to play through the Anti-Cheat and offers its download. The Anti-Cheat itself is a separate program with its own service; this site only shows its page."]
                                <a href="@AppConsts.AntiCheatUrl">@L["Open the Anti-Cheat page"]</a>
                            </p>
                            <div class="form-group">
                                <label for="serviceUrl">@L["Anti-Cheat service address"] @FieldHelp.More(L["Optional. The service the Anti-Cheat page asks for the latest version of the program."], L["Anti-Cheat service address"], L["The Anti-Cheat is a separate program with its own service. When this address is set, the Anti-Cheat page asks that service for the latest version, its size, its date and its checksum, and shows them to the players with the download.\nIt must start with https://. Leave it empty to use only the download address.\nWhen the service does not answer, the page uses the download address instead."])</label>
                                <input class="form-control" id="serviceUrl" name="serviceUrl" type="url" value="@Model.Settings.ServiceUrl" placeholder="https://">
                                <p class="help-block">@L["Optional. The page asks this service for the latest version, its size, date and checksum. Must start with https://."]</p>
                            </div>
                            <div class="form-group" style="margin-bottom: 0">
                                <label for="downloadUrl">@L["Download address"] @FieldHelp.Tip(L["The direct link to the Anti-Cheat download, used when the service is not set or does not answer. Must start with https://."])</label>
                                <input class="form-control" id="downloadUrl" name="downloadUrl" type="url" value="@Model.Settings.DownloadUrl" placeholder="https://">
                                <p class="help-block" style="margin-bottom: 0">@L["Used when the service does not answer or is not set. Must start with https://."]</p>
                            </div>
                        </div>
                    </div>
                    @await Html.PartialAsync("_FormSaveButton")
                </form>
            </div>
        </div>
    </div>
</div>

<div id="aca-details-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@listTitle</h4>
            </div>
            <div class="modal-body">
                <div class="admin-details">
                    <img class="aca-avatar aca-details-avatar" src="" alt="" onerror="imgOnError(this)"/>
                    <dl>
                        <dt>@L["Player"]</dt>
                        <dd>
                            <a class="aca-player-link" href="#"></a><br/>
                            <small class="aca-ids text-muted"></small><br/>
                            <a class="aca-steam-link" href="#" target="_blank" rel="noopener noreferrer">@L["Steam profile"]</a>
                        </dd>
                        <dt>@L["Added on"]</dt>
                        <dd class="aca-added-at"></dd>
                        <dt>@L["Added by"]</dt>
                        <dd class="aca-added-by"></dd>
                    </dl>
                </div>
                <div class="alert alert-warning admin-confirm aca-remove-confirm">@L["Remove this player from the list? The server applies it within a minute."]</div>
                <div class="aca-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
                <button type="button" class="btn btn-danger aca-remove">
                    <span class="glyphicon glyphicon-trash"></span> @L["Remove from the list"]
                </button>
                <button type="button" class="btn btn-danger aca-remove-yes" style="display: none">@L["Yes, remove"]</button>
            </div>
        </div>
    </div>
</div>

<div id="aca-add-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@string.Format(L["Add to: {0}"].Value, listTitle)</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="aca-add-player">@L["Steam ID or profile URL"] @FieldHelp.Tip(L["A SteamID64, a Steam ID such as STEAM_1:0:123 or [U:1:123], or a profile link such as https://steamcommunity.com/profiles/76561198000000000."])</label>
                    <div class="input-group">
                        <input type="text" id="aca-add-player" class="form-control" placeholder="76561198000000000" autocomplete="off"/>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-default aca-pick-player">
                                <span class="glyphicon glyphicon-user"></span> @L["Pick a player"]
                            </button>
                        </span>
                    </div>
                    <div class="aca-preview"></div>
                </div>
                <div class="aca-add-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-primary aca-add-save" disabled>
                    <span class="glyphicon glyphicon-floppy-disk"></span> @L["Save"]
                </button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PlayerPickerModal")
@await Html.PartialAsync("_RelatedAccountsModal")

@section Scripts {
    <script type="application/json" id="anti-cheat-admin-index-config">{
            "shownList": @Json.Serialize(Model.ShownListName),
            "savedMode": @Json.Serialize(Model.Access.ModeSaved ? Model.Mode.ToName() : null),
            "pageUrl": @Json.Serialize(AppConsts.AntiCheatAdminUrl),
            "apiUrl": @Json.Serialize(AppConsts.AntiCheatAccessApiUrl),
            "lookupUrl": @Json.Serialize(AppConsts.PlayerLookupUrl),
            "playerUrl": @Json.Serialize(AppConsts.PlayerUrlPrefix),
            "relatedList": @Json.Serialize(AppConsts.RelatedAntiCheatListPrefix + Model.ShownListName),
            "texts": {
                "saved": @Json.Serialize(L["Player added."].Value),
                "removed": @Json.Serialize(L["Player removed."].Value),
                "modeSaved": @Json.Serialize(L["Mode saved."].Value),
                "searching": @Json.Serialize(L["Looking up..."].Value),
                "notFound": @Json.Serialize(L["This is not a valid Steam ID or profile URL."].Value),
                "known": @Json.Serialize(L["Player on the site"].Value),
                "steam": @Json.Serialize(L["Steam profile (never played here)"].Value),
                "noName": @Json.Serialize(L["Name not found"].Value),
                "already": @Json.Serialize(L["This player is already on this list."].Value),
                "error": @Json.Serialize(L["Something went wrong. Reload the page and try again."].Value)
            },
            "listedIds": @Json.Serialize(Model.ListedIds.Select(communityId => communityId.ToString()))
    }</script>
    <script src="~/js/pages/anti-cheat-admin-index.js" asp-append-version="true"></script>
}
