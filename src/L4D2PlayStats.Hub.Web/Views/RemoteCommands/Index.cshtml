@model RemoteCommandsViewModel

@{
    ViewData["Title"] = L["Remote commands"].Value;

    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Logs, number => $"{AppConsts.RemoteCommandsUrl}?page={number}");
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .rc-command {
            font-family: Menlo, Monaco, Consolas, "Courier New", monospace;
        }

        .rc-log {
            cursor: default;
        }
    </style>
}

@section Scripts {
    @if (Model.Servers.Count > 0)
    {
        @await Html.PartialAsync("_CommandBuilder")

        <script>
            terminal.apply = function (command) {
                $('#command').val(command);

                $('#terminal').one('hidden.bs.modal', function () {
                    $('#command').trigger('focus');
                });

                return true;
            };
        </script>
    }
}

<div class="admin-header">
    <h3>@L["Remote commands"]</h3>
    <a class="btn btn-default" href="/admin">
        <span class="glyphicon glyphicon-chevron-left"></span> @L["Administration"]
    </a>
</div>

@if (TempData["Queued"] is string queued)
{
    <div class="alert alert-success">
        @L["Command queued. The game server runs it on its next check."] <code>@queued</code>
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">@L["Send a command to a game server"]</h3>
    </div>
    <div class="panel-body">
        @if (Model.Servers.Count == 0)
        {
            <p class="text-muted" style="margin: 0">@L["No game server available yet."]</p>
        }
        else
        {
            <form method="post" asp-antiforgery="true" action="/admin/remote-commands">
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="serverId">@L["Server"] @FieldHelp.Tip(L["The game server that runs the command. Only enabled game servers are listed."])</label>
                            <select class="form-control" id="serverId" name="serverId" required>
                                @foreach (var server in Model.Servers)
                                {
                                    <option value="@server.Id">@server.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <div class="form-group">
                            <label for="command">@L["Command"] @FieldHelp.More(L["A SourceMod command with its arguments, such as sm_forcestart. !command and /command also work."], L["Command"], L["Type the command as you would in the game: sm_command, !command or /command, with its arguments. !forcestart and /forcestart are sent as sm_forcestart.\nA command cannot contain ; and has at most 256 characters.\nThe command is queued: the game server asks the site for queued commands on its next check and runs it. If no game server picks it up within 5 minutes, it is dropped.\nEvery command is recorded in the audit log below, with who sent it and whether it was delivered."])</label>
                            <div class="input-group">
                                <input class="form-control rc-command" id="command" name="command" required maxlength="@L4D2PlayStats.Hub.Core.AppConsts.ServerCommandMaxLength" placeholder="sm_forcestart"/>
                                <span class="input-group-btn">
                                    <button class="btn btn-info" type="button" onclick="terminal.show()" data-toggle="tooltip" data-placement="top" data-container="body" title="@L["Build the command step by step"]">
                                        <img src="~/imgs/icons/terminal.png" alt="@L["Terminal"]" class="icon"/>
                                    </button>
                                    <button class="btn btn-primary" type="submit">@L["Send"]</button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="help-block" style="margin-bottom: 0">@L["SourceMod commands only: sm_command, !command or /command. Every command is recorded below."] @L["The terminal button builds the command step by step, and you can still edit it before sending."]</p>
            </form>
        }
    </div>
</div>

<div class="admin-header">
    <h3>@L["Audit log"]</h3>
</div>

<div class="admin-stats">
    <div>
        <strong>@Model.Logs.TotalItems.ToString("N0", culture)</strong>
        <small>@L["commands sent"]</small>
    </div>
    <div>
        <strong>@Model.Delivered.ToString("N0", culture)</strong>
        <small>@L["commands delivered to the game server"]</small>
    </div>
</div>

<div class="admin-list">
    @if (Model.Logs.TotalItems == 0)
    {
        <div class="admin-empty">@L["No command was sent yet."]</div>
    }
    @foreach (var log in Model.Logs.Items)
    {
        var administrator = log.AdministratorName ?? log.AdministratorCommunityId.ToString();

        <div class="admin-item rc-log">
            <img class="admin-avatar" src="@($"{AppConsts.AvatarUrl}{log.AdministratorCommunityId}")" alt="@administrator" onerror="imgOnError(this)"/>
            <div class="admin-main">
                <div class="admin-title">
                    <code>@log.Command</code>
                </div>
                <small>
                    @L["Administrator"]:
                    <a href="@PlayerUrls.Details(log.AdministratorCommunityId)" target="_blank">@administrator</a>
                    · @L["Server"]: @log.GameServerName
                </small>
            </div>
            <div class="admin-side">
                <strong>@LiveDisplay.ShortDateTime(log.CreatedAtUtc, Model.TimeZone)</strong>
                @if (log.DeliveredAtUtc != null)
                {
                    <small>
                        <span class="label label-success">@L["Delivered"]</span> @LiveDisplay.ShortDateTime(log.DeliveredAtUtc.Value, Model.TimeZone)
                    </small>
                }
                else
                {
                    <small>
                        <span class="label label-default">@L["Not delivered"]</span>
                    </small>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)
