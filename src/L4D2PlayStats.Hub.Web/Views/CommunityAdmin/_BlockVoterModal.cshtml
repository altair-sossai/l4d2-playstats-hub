@{
    if (Context.Items.ContainsKey(AppConsts.CommunityBlockModalItem))
    {
        return;
    }

    Context.Items[AppConsts.CommunityBlockModalItem] = true;
    var returnUrl = ViewData[AppConsts.CommunityBlockModalItem] as string ?? $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="modal fade" id="ca-block-modal" tabindex="-1" role="dialog" aria-labelledby="ca-block-title">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" asp-antiforgery="true" action="@AppConsts.CommunityBlockVoterUrl">
            <input type="hidden" id="ca-block-id" name="communityId" value="">
            <input type="hidden" id="ca-block-return" name="returnUrl" value="@returnUrl" data-default="@returnUrl" data-return-hash>
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="ca-block-title">
                    <span class="glyphicon glyphicon-ban-circle text-warning"></span> @L["Block this voter"]
                </h4>
            </div>
            <div class="modal-body">
                <p>
                    <img id="ca-block-avatar" src="" alt="" style="width: 32px; height: 32px; margin-right: 8px; border-radius: 50%; vertical-align: middle" onerror="imgOnError(this)">
                    <strong id="ca-block-name"></strong>
                </p>
                <p>@L["The player will no longer be able to vote: the voting page tells them the administrators blocked their votes."]</p>
                <p>@L["Their votes can stay in the ranking, or be deleted now, with the ratings calculated again without them."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Cancel"]</button>
                <button type="submit" class="btn btn-warning" name="removeVotes" value="false">
                    <span class="glyphicon glyphicon-ban-circle"></span> @L["Only block"]
                </button>
                <button type="submit" class="btn btn-danger" name="removeVotes" value="true">
                    <span class="glyphicon glyphicon-trash"></span> @L["Block and delete the votes"]
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        $(document).on('click', '[data-block-voter], [data-block-source]', function () {
            var $button = $(this);
            var source = $button.attr('data-block-source');
            var id = $.trim(source ? $(source).val() : $button.attr('data-block-voter') || '');

            if (!id) {
                if (source)
                    $(source).focus();

                return;
            }

            var numeric = /^\d+$/.test(id);

            $('#ca-block-id').val(id);
            $('#ca-block-return').val($button.attr('data-block-return') || $('#ca-block-return').attr('data-default'));
            $('#ca-block-name').text($button.attr('data-block-name') || id);
            $('#ca-block-avatar').attr('src', numeric ? '/avatar/' + id : '').toggle(numeric);
            $('#ca-block-modal').modal('show');
        });
    });
</script>
