@model CommunityVoteViewModel

@{
    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Who is better?"],
        Description = L["Your answers move players up and down the community ranking."]
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/community-vote.css" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/community-vote.js" asp-append-version="true"></script>
}

<div class="community-lead">
    <small>
        @L["Your answers move players up and down the community ranking."]
        <a class="how-it-works-link" href="#how-it-works-modal" data-toggle="modal">
            <span class="glyphicon glyphicon-info-sign"></span> @L["How does it work?"]
        </a>
    </small>
    <a class="btn btn-sm btn-default" href="/community">
        <span class="glyphicon glyphicon-list"></span> @L["Community ranking"]
    </a>
</div>

@await Html.PartialAsync("_HowItWorks", Model.Settings)

<h3 class="text-center ballot-title">
    <span class="glyphicon glyphicon-fire"></span> @L["Who is better?"]
</h3>

<partial name="_Ballot" model="Model"/>
