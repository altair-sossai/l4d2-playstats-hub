@model CommunityVoteViewModel
@{
    var ballot = Model.Ballot;
}
<div id="@AppConsts.CommunityBallotElement">
    @if (Model.Refusal != null)
    {
        <div class="alert alert-warning">@L[Model.Refusal]</div>
    }

    @if (ballot == null)
    {
        <div class="jumbotron text-center">
            <p>@L["Sign in with Steam to vote."]</p>
            <p>
                <a class="btn btn-default" href="/login?returnUrl=@Uri.EscapeDataString(AppConsts.CommunityVotePage)">
                    <img src="~/imgs/steam.png" alt="" class="img-header-icon">@L["Sign in with Steam"]
                </a>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.TooFewMatches)
    {
        <div class="jumbotron text-center">
            <p>@L["You need to play more matches before you can vote."]</p>
            <p>
                <small>@L["Matches played:"] <strong>@ballot.Matches</strong> / @ballot.MinimumMatches</small>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.LimitReached)
    {
        <div class="jumbotron text-center">
            <p>@L["You have used all your votes for today. Come back tomorrow."]</p>
            <p>
                <small>@L["Votes per day:"] @ballot.VotesPerDay</small>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.NobodyLeft)
    {
        <div class="jumbotron text-center">
            <p>@L["There is nobody left for you to compare right now."]</p>
        </div>
    }
    else
    {
        var left = ballot.Left!;
        var right = ballot.Right!;
        var remaining = ballot.VotesPerDay <= 0 ? 0 : Math.Clamp(ballot.VotesLeft * 100 / ballot.VotesPerDay, 0, 100);

        <form class="ballot" method="post" asp-antiforgery="true" action="@AppConsts.CommunityVotePage" hx-post="@AppConsts.CommunityVotePage" hx-target="#@(AppConsts.CommunityBallotElement)" hx-swap="outerHTML swap:600ms">
            <input type="hidden" name="Left" value="@left.CommunityId">
            <input type="hidden" name="Right" value="@right.CommunityId">
            <div class="ballot-arena">
                <div class="panel panel-default ballot-card ballot-left">
                    <div class="ballot-photo">
                        <img class="ballot-avatar" src="/avatar/@left.CommunityId" alt="@left.Name" onerror="imgOnError(this)">
                        <span class="ballot-mark ballot-mark-win"><span class="glyphicon glyphicon-ok"></span></span>
                        <span class="ballot-mark ballot-mark-unknown"><span class="glyphicon glyphicon-question-sign"></span></span>
                    </div>
                    <h4 class="ballot-name">@left.Name</h4>
                    <button class="btn btn-success btn-block ballot-pick" type="submit" name="Outcome" value="@CommunityVoteOutcome.Left">
                        <span class="glyphicon glyphicon-thumbs-up"></span> @L["This one is better"] <kbd class="ballot-key hidden-xs">&larr;</kbd>
                    </button>
                    <button class="btn btn-link btn-sm btn-block ballot-skip" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownLeft">
                        <span class="glyphicon glyphicon-eye-close"></span> @L["I don't know this player"]
                    </button>
                </div>
                <div class="ballot-versus">
                    <span class="ballot-versus-text">VS</span>
                    <span class="ballot-versus-equal">=</span>
                </div>
                <div class="panel panel-default ballot-card ballot-right">
                    <div class="ballot-photo">
                        <img class="ballot-avatar" src="/avatar/@right.CommunityId" alt="@right.Name" onerror="imgOnError(this)">
                        <span class="ballot-mark ballot-mark-win"><span class="glyphicon glyphicon-ok"></span></span>
                        <span class="ballot-mark ballot-mark-unknown"><span class="glyphicon glyphicon-question-sign"></span></span>
                    </div>
                    <h4 class="ballot-name">@right.Name</h4>
                    <button class="btn btn-success btn-block ballot-pick" type="submit" name="Outcome" value="@CommunityVoteOutcome.Right">
                        <span class="glyphicon glyphicon-thumbs-up"></span> @L["This one is better"] <kbd class="ballot-key hidden-xs">&rarr;</kbd>
                    </button>
                    <button class="btn btn-link btn-sm btn-block ballot-skip" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownRight">
                        <span class="glyphicon glyphicon-eye-close"></span> @L["I don't know this player"]
                    </button>
                </div>
            </div>
            <div class="ballot-both">
                <button class="btn btn-warning ballot-same" type="submit" name="Outcome" value="@CommunityVoteOutcome.SameLevel">
                    <span class="glyphicon glyphicon-transfer"></span> @L["They are at the same level"] <kbd class="ballot-key hidden-xs">&uarr;</kbd>
                </button>
                <button class="btn btn-default ballot-neither" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownBoth">
                    <span class="glyphicon glyphicon-eye-close"></span> @L["I don't know either of them"] <kbd class="ballot-key hidden-xs">&darr;</kbd>
                </button>
            </div>
        </form>

        <div class="ballot-votes">
            <div class="ballot-votes-label">
                <span class="glyphicon glyphicon-flash"></span> @L["Votes left today:"] <strong>@ballot.VotesLeft</strong> / @ballot.VotesPerDay
            </div>
            <div class="progress">
                <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="@ballot.VotesLeft" aria-valuemin="0" aria-valuemax="@ballot.VotesPerDay" style="width: @(remaining)%"></div>
            </div>
            <small class="text-muted hidden-xs">@L["You can also vote with the ← and → keys."]</small>
        </div>
    }
</div>
