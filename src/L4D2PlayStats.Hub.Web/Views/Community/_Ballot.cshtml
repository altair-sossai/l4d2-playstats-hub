@model CommunityVoteViewModel
@{
    var ballot = Model.Ballot;
}
<div id="@AppConsts.CommunityBallotElement">
    @if (Model.Refusal != null)
    {
        <div class="alert alert-warning">@L[Model.Refusal]</div>
    }

    @if (ballot == null)
    {
        <div class="jumbotron text-center">
            <p>@L["Sign in with Steam to vote."]</p>
            <p>
                <a class="btn btn-default" href="/login?returnUrl=@Uri.EscapeDataString(AppConsts.CommunityVotePage)">
                    <img src="~/imgs/steam.png" alt="" class="img-header-icon">@L["Sign in with Steam"]
                </a>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.TooFewMatches)
    {
        <div class="jumbotron text-center">
            <p>@L["You need to play more matches before you can vote."]</p>
            <p>
                <small>@L["Matches played:"] <strong>@ballot.Matches</strong> / @ballot.MinimumMatches</small>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.LimitReached)
    {
        <div class="jumbotron text-center">
            <p>@L["You have used all your votes for today. Come back tomorrow."]</p>
            <p>
                <small>@L["Votes per day:"] @ballot.VotesPerDay</small>
            </p>
        </div>
    }
    else if (ballot.Status == CommunityBallotStatus.NobodyLeft)
    {
        <div class="jumbotron text-center">
            <p>@L["There is nobody left for you to compare right now."]</p>
        </div>
    }
    else
    {
        var left = ballot.Left!;
        var right = ballot.Right!;

        <form class="ballot" method="post" asp-antiforgery="true" action="@AppConsts.CommunityVotePage" hx-post="@AppConsts.CommunityVotePage" hx-target="#@(AppConsts.CommunityBallotElement)" hx-swap="outerHTML">
            <input type="hidden" name="Left" value="@left.CommunityId">
            <input type="hidden" name="Right" value="@right.CommunityId">
            <div class="row" style="margin: 0 -5px">
                <div class="col-xs-6">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img class="ballot-avatar" src="/avatar/@left.CommunityId" alt="@left.Name" onerror="imgOnError(this)">
                            <h4 class="ballot-name">@left.Name</h4>
                            <button class="btn btn-primary btn-block" type="submit" name="Outcome" value="@CommunityVoteOutcome.Left">
                                <span class="glyphicon glyphicon-thumbs-up"></span> @L["This one is better"]
                            </button>
                            <button class="btn btn-link btn-sm btn-block" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownLeft">@L["I don't know this player"]</button>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img class="ballot-avatar" src="/avatar/@right.CommunityId" alt="@right.Name" onerror="imgOnError(this)">
                            <h4 class="ballot-name">@right.Name</h4>
                            <button class="btn btn-primary btn-block" type="submit" name="Outcome" value="@CommunityVoteOutcome.Right">
                                <span class="glyphicon glyphicon-thumbs-up"></span> @L["This one is better"]
                            </button>
                            <button class="btn btn-link btn-sm btn-block" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownRight">@L["I don't know this player"]</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center ballot-both">
                <button class="btn btn-default" type="submit" name="Outcome" value="@CommunityVoteOutcome.SameLevel">@L["They are at the same level"]</button>
                <button class="btn btn-default" type="submit" name="Outcome" value="@CommunityVoteOutcome.UnknownBoth">@L["I don't know either of them"]</button>
            </div>
        </form>

        <p class="text-center text-muted" style="margin-top: 15px">
            <small>@L["Votes left today:"] <strong>@ballot.VotesLeft</strong> / @ballot.VotesPerDay</small>
        </p>
    }
</div>
