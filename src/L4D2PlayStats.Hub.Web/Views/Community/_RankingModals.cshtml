@model CommunityRankingViewModel

<link rel="stylesheet" href="~/css/pages/community-ranking-modals.css" asp-append-version="true"/>

<div class="modal fade" id="community-columns-modal" tabindex="-1" role="dialog" aria-labelledby="community-columns-title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="community-columns-title">
                    <span class="glyphicon glyphicon-question-sign"></span> @L["What the columns mean"]
                </h4>
            </div>
            <div class="modal-body">
                <ul class="crm-columns">
                    <li>
                        <span class="crm-icon">
                            <span class="glyphicon glyphicon-stats"></span>
                        </span>
                        <div>
                            <strong>@L["Rating"]</strong>@L["The points built from all the votes together, with the margin of uncertainty (±) next to them. Being chosen over a strong player is worth more than over a weak one. The more comparisons, the smaller the margin; the position uses the rating minus twice the margin."]
                        </div>
                    </li>
                    <li>
                        <span class="crm-icon">
                            <span class="glyphicon glyphicon-transfer"></span>
                        </span>
                        <div>
                            <strong>@L["Comparisons"]</strong>@L["How many times the player was judged against another player. The more comparisons, the more reliable the rating."]
                        </div>
                    </li>
                    <li>
                        <span class="crm-icon crm-win">
                            <span class="glyphicon glyphicon-thumbs-up"></span>
                        </span>
                        <div>
                            <strong>@L["Wins"]</strong>@L["Comparisons in which voters said this player is better."]
                        </div>
                    </li>
                    <li>
                        <span class="crm-icon crm-draw">=</span>
                        <div>
                            <strong>@L["Draws"]</strong>@L["Comparisons in which voters said the two are at the same level."]
                        </div>
                    </li>
                    <li>
                        <span class="crm-icon crm-loss">
                            <span class="glyphicon glyphicon-thumbs-down"></span>
                        </span>
                        <div>
                            <strong>@L["Losses"]</strong>@L["Comparisons in which voters said the other player is better."]
                        </div>
                    </li>
                </ul>
                <p class="crm-note">
                    <span class="glyphicon glyphicon-info-sign"></span> @L["Answers of the kind \"I don't know\" do not count as comparisons. Click a player's row to see their details."]
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="community-player-modal" tabindex="-1" role="dialog" aria-labelledby="community-player-name">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">
                    <span class="glyphicon glyphicon-user"></span> @L["Community ranking"]
                </h4>
            </div>
            <div class="modal-body">
                <div class="crm-player">
                    <img class="crm-avatar" src="@AppConsts.EmptyAvatarUrl" alt="" onerror="imgOnError(this)">
                    <div>
                        <h4 id="community-player-name"></h4>
                        <span class="crm-position"></span><span class="crm-patent"></span>
                    </div>
                </div>
                <div class="crm-tiles">
                    <div>
                        <strong class="crm-rating"></strong><small>@L["Rating"]</small>
                    </div>
                    <div>
                        <strong class="crm-comparisons"></strong><small>@L["Comparisons"]</small>
                    </div>
                </div>
                <div class="crm-bar">
                    <span class="crm-bar-win" style="background: #5cb85c"></span>
                    <span class="crm-bar-draw" style="background: #f0ad4e"></span>
                    <span class="crm-bar-loss" style="background: #d9534f"></span>
                </div>
                <div class="crm-legend">
                    <span><i style="background: #5cb85c"></i> @L["Wins"]: <b class="crm-wins"></b></span>
                    <span><i style="background: #f0ad4e"></i> @L["Draws"]: <b class="crm-draws"></b></span>
                    <span><i style="background: #d9534f"></i> @L["Losses"]: <b class="crm-losses"></b></span>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default crm-profile" href="#">
                    <span class="glyphicon glyphicon-user"></span> @L["Player profile"]
                </a>
                <a class="btn btn-info crm-votes" href="@AppConsts.CommunityVotesPage">
                    <span class="glyphicon glyphicon-transfer"></span> @L["See the comparisons of this player"]
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var positionText = @Json.Serialize(L["#{0} in the community ranking"].Value);

        function percent(value, total) {
            return total > 0 ? (value * 100 / total).toFixed(2) + '%' : '0%';
        }

        function share(value, total) {
            return (total > 0 ? Math.round(value * 100 / total) : 0) + '%';
        }

        document.addEventListener('click', function (event) {
            var row = event.target.closest('#table-community-ranking tbody tr[data-player]');

            if (!row || event.target.closest('a'))
                return;

            var data = row.dataset;
            var modal = $('#community-player-modal');
            var wins = parseInt(data.wins, 10);
            var draws = parseInt(data.draws, 10);
            var losses = parseInt(data.losses, 10);
            var total = wins + draws + losses;

            modal.find('.crm-avatar').attr('src', '/avatar/' + data.player).attr('alt', data.name);
            modal.find('#community-player-name').text(data.name);
            modal.find('.crm-position').text(positionText.replace('{0}', data.position));
            modal.find('.crm-patent').text(data.patent || '');
            modal.find('.crm-rating').text(data.rating);
            modal.find('.crm-comparisons').text(data.comparisons);
            modal.find('.crm-wins').text(wins + ' (' + share(wins, total) + ')');
            modal.find('.crm-draws').text(draws + ' (' + share(draws, total) + ')');
            modal.find('.crm-losses').text(losses + ' (' + share(losses, total) + ')');
            modal.find('.crm-bar-win').css('width', percent(wins, total));
            modal.find('.crm-bar-draw').css('width', percent(draws, total));
            modal.find('.crm-bar-loss').css('width', percent(losses, total));
            modal.find('.crm-votes').attr('href', @Json.Serialize(AppConsts.CommunityVotesPage) + '?player=' + data.player);
            modal.find('.crm-profile').toggle(!!data.profile).attr('href', data.profile || '#');
            modal.modal('show');
        });
    })();
</script>
