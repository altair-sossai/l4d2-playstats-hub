@model CommunityRankingSettings

<style>
    .how-it-works-link {
        font-weight: bold;
        white-space: nowrap;
    }

    #how-it-works-modal .modal-body > p {
        margin-bottom: 14px;
        font-size: 14px;
    }

    .how-it-works-steps {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .how-it-works-step {
        padding: 14px;
        border: 1px solid rgba(255, 255, 255, .08);
        border-left: 4px solid #5cb85c;
        border-radius: 6px;
        background: rgba(255, 255, 255, .03);
    }

        .how-it-works-step h5 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 10px;
            font-size: 15px;
            font-weight: bold;
        }

        .how-it-works-step p {
            margin: 0 0 6px;
            font-size: 13px;
            opacity: .9;
        }

            .how-it-works-step p:last-child {
                margin-bottom: 0;
            }

        .how-it-works-step strong {
            color: #5cb85c;
        }

    .how-it-works-icon {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #5cb85c;
        color: #fff;
        font-size: 14px;
    }

    @@media (max-width: 600px) {
        .how-it-works-steps {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<div class="modal fade" id="how-it-works-modal" tabindex="-1" role="dialog" aria-labelledby="how-it-works-title">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@L["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="how-it-works-title">
                    <span class="glyphicon glyphicon-info-sign"></span> @L["How does the community ranking work?"]
                </h4>
            </div>
            <div class="modal-body">
                <p>@L["The statistics ranking measures what the game records: kills, damage, wins. The community ranking measures what the players think: it is built only from the votes of the players themselves, who know best who plays well. It does not reset with the season."]</p>
                <div class="how-it-works-steps">
                    <div class="how-it-works-step">
                        <h5>
                            <span class="how-it-works-icon">
                                <span class="glyphicon glyphicon-transfer"></span>
                            </span> @L["You compare two players"]
                        </h5>
                        <p>@L["The site shows two players, preferably people you have played with or against. Say which one is better, that they are at the same level, or that you do not know them."]</p>
                        <p>@L["You are never asked about yourself, nor about the same pair twice."]</p>
                        <p>@L["The two players have close ratings, and the site prefers the ones whose rating is least certain, so the best players are compared with each other."]</p>
                    </div>
                    <div class="how-it-works-step">
                        <h5>
                            <span class="how-it-works-icon">
                                <span class="glyphicon glyphicon-stats"></span>
                            </span> @L["The votes become a rating"]
                        </h5>
                        <p>@L["Everybody starts with {0} points. After each answer the ratings are calculated again from all the votes together, so being chosen over a strong player is worth more than over a weak one, and the order of the votes does not matter.", Model.InitialRating]</p>
                        <p>@L["Each rating has a margin (±) that shrinks as the player is compared more. The position uses the rating minus twice the margin, so a player with few votes does not jump to the top."]</p>
                        <p>@L["After thousands of votes, the order reflects what the whole community thinks, not the opinion of one person."]</p>
                    </div>
                    <div class="how-it-works-step">
                        <h5>
                            <span class="how-it-works-icon">
                                <span class="glyphicon glyphicon-eye-open"></span>
                            </span> @L["Who appears"]
                        </h5>
                        <p>
                            @if (Model.CandidatePlayedWithinDays > 0)
                            {
                                @L["The voting offers players with at least {0} matches who played in the last {1} days.", Model.MinimumMatchesToBeCandidate, Model.CandidatePlayedWithinDays]
                            }
                            else
                            {
                                @L["The voting offers players with at least {0} matches.", Model.MinimumMatchesToBeCandidate]
                            }
                        </p>
                        <p>
                            @if (Model.MaximumPlayersListed > 0)
                            {
                                @L["The list shows the top {0} players who were judged at least {1} times.", Model.MaximumPlayersListed, Model.MinimumComparisonsToBeListed]
                            }
                            else
                            {
                                @L["The list shows every player who was judged at least {0} times.", Model.MinimumComparisonsToBeListed]
                            }
                        </p>
                    </div>
                    <div class="how-it-works-step">
                        <h5>
                            <span class="how-it-works-icon">
                                <span class="glyphicon glyphicon-thumbs-up"></span>
                            </span> @L["Who can vote"]
                        </h5>
                        <p>@L["Anyone signed in with Steam who has played at least {0} matches on the server.", Model.MinimumMatchesToVote]</p>
                        <p>@L["Each player has {0} votes per day. \"I don't know\" answers are free, so only vote on who you really know.", Model.VotesPerDay]</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" href="@AppConsts.CommunityVotesPage">
                    <span class="glyphicon glyphicon-transfer"></span> @L["See the latest votes"]
                </a>
                <a class="btn btn-success" href="@AppConsts.CommunityVotePage">
                    <span class="glyphicon glyphicon-thumbs-up"></span> @L["Vote now"]
                </a>
            </div>
        </div>
    </div>
</div>
