@model CommunityVoteRowsModel
@{
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="vf-list">
    @foreach (var vote in Model.Votes)
    {
        var same = vote.Outcome == CommunityVoteOutcome.SameLevel;
        var leftClass = same ? "vf-same" : vote.Outcome == CommunityVoteOutcome.Left ? "vf-win" : "vf-lose";
        var rightClass = same ? "vf-same" : vote.Outcome == CommunityVoteOutcome.Right ? "vf-win" : "vf-lose";

        <div class="vf-row">
            <time class="vf-when" datetime="@vote.CreatedAtUtc.ToString("o")">@Display.DateTime(vote.CreatedAtUtc, Model.TimeZone)</time>
            @if (Model.ShowVoters)
            {
                <a class="vf-voter" href="@CommunityVoteUrls.Votes(vote.VoterId, Model.PlayerId)" title="@L["See the votes made by this player"]">
                    <img src="/avatar/@vote.VoterId" alt="" onerror="imgOnError(this)">
                    <span>@vote.VoterName</span>
                </a>
            }
            else
            {
                <span class="vf-voter">
                    <span class="glyphicon glyphicon-user"></span> <span>@L["A player voted"]</span>
                </span>
            }
            <div class="vf-pair">
                <div class="vf-pair-cells">
                    <div class="vf-side">
                        <a class="vf-player @leftClass" href="@CommunityVoteUrls.Votes(Model.VoterId, vote.LeftPlayerId)" title="@L["See the comparisons of this player"]">
                            <img src="/avatar/@vote.LeftPlayerId" alt="" onerror="imgOnError(this)">
                            <span class="vf-name">@vote.LeftName</span>
                            <span class="glyphicon glyphicon-ok"></span>
                        </a>
                    </div>
                    <div class="vf-center">
                        <span class="vf-mid@(same ? " vf-mid-same" : "")" title="@(same ? L["Same level"] : L["Better"])">@(same ? "=" : "VS")</span>
                    </div>
                    <div class="vf-side">
                        <a class="vf-player vf-right @rightClass" href="@CommunityVoteUrls.Votes(Model.VoterId, vote.RightPlayerId)" title="@L["See the comparisons of this player"]">
                            <img src="/avatar/@vote.RightPlayerId" alt="" onerror="imgOnError(this)">
                            <span class="glyphicon glyphicon-ok"></span>
                            <span class="vf-name">@vote.RightName</span>
                        </a>
                    </div>
                </div>
            </div>
            @if (Model.Moderate)
            {
                <div class="vf-mod">
                    <form method="post" asp-antiforgery="true" action="@AppConsts.CommunityRemoveVoteUrl" data-confirm="@L["Delete this vote? The ratings are calculated again without it."]">
                        <input type="hidden" name="voteId" value="@vote.Id">
                        <input type="hidden" name="returnUrl" value="@returnUrl" data-return-hash>
                        <button class="btn btn-xs btn-danger" type="submit" title="@L["Delete this vote"]" aria-label="@L["Delete this vote"]">
                            <span class="glyphicon glyphicon-trash"></span>
                        </button>
                    </form>
                    <button class="btn btn-xs btn-warning" type="button" data-block-voter="@vote.VoterId" data-block-name="@vote.VoterName" title="@L["Block this voter"]" aria-label="@L["Block this voter"]">
                        <span class="glyphicon glyphicon-ban-circle"></span>
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (Model.Moderate)
{
    @await Html.PartialAsync("~/Views/CommunityAdmin/_BlockVoterModal.cshtml")
    @await Html.PartialAsync("~/Views/CommunityAdmin/_ReturnHashScript.cshtml")
}
