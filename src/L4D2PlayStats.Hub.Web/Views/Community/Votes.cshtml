@model CommunityVotesViewModel

@{
    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Latest votes"],
        Description = L["See who voted for whom in the community ranking."]
    };

    var rating = Model.PlayerRating;
}

@section Styles {
    @await Html.PartialAsync("_VoteStyles")
    @await Html.PartialAsync("_PaginationStyles")
}

<h4 class="text-center">
    <span class="glyphicon glyphicon-transfer"></span> @L["Latest votes"]
</h4>

<div class="vf-lead">
    <p>@L["See who voted for whom. Click a player to see only their comparisons."]</p>
    <div class="vf-lead-actions">
        <a class="btn btn-sm btn-default" href="/community">
            <span class="glyphicon glyphicon-list"></span> @L["Community ranking"]
        </a>
        <a class="btn btn-sm btn-success" href="@AppConsts.CommunityVotePage">
            <span class="glyphicon glyphicon-thumbs-up"></span> @L["Vote now"]
        </a>
    </div>
</div>

<form class="vf-filters" method="get" action="@AppConsts.CommunityVotesPage" id="vf-filters">
    <div class="row">
        @if (Model.ShowVoters)
        {
            <div class="form-group col-sm-5">
                <label for="vf-voter-name">@L["Votes made by"]</label>
                <div class="input-group input-group-sm">
                    <input class="form-control" id="vf-voter-name" list="vf-voters" autocomplete="off" placeholder="@L["Type a player name"]" value="@Model.VoterName">
                    <span class="input-group-btn">
                        <button type="button" class="btn btn-default" data-player-picker="#vf-voter" data-player-picker-source="@AppConsts.CommunityPlayersSearchUrl" data-player-picker-role="@AppConsts.CommunityVoterRole" data-player-picker-hint="@L["The players who voted, the most recent vote first."]" data-player-picker-submit title="@L["Search for a player"]" aria-label="@L["Search for a player"]">
                            <span class="glyphicon glyphicon-search"></span>
                        </button>
                    </span>
                </div>
                <input type="hidden" name="voter" id="vf-voter" value="@Model.VoterId">
                <datalist id="vf-voters">
                    @foreach (var participant in Model.Participants.Where(participant => participant.Voted))
                    {
                        <option value="@participant.Name" data-id="@participant.CommunityId"></option>
                    }
                </datalist>
            </div>
        }
        <div class="form-group @(Model.ShowVoters ? "col-sm-5" : "col-sm-10")">
            <label for="vf-player-name">@L["Votes about"]</label>
            <div class="input-group input-group-sm">
                <input class="form-control" id="vf-player-name" list="vf-players" autocomplete="off" placeholder="@L["Type a player name"]" value="@Model.PlayerName">
                <span class="input-group-btn">
                    <button type="button" class="btn btn-default" data-player-picker="#vf-player" data-player-picker-source="@AppConsts.CommunityPlayersSearchUrl" data-player-picker-hint="@L["The players who were compared in the voting, the most recent comparison first."]" data-player-picker-submit title="@L["Search for a player"]" aria-label="@L["Search for a player"]">
                        <span class="glyphicon glyphicon-search"></span>
                    </button>
                </span>
            </div>
            <input type="hidden" name="player" id="vf-player" value="@Model.PlayerId">
            <datalist id="vf-players">
                @foreach (var participant in Model.Participants.Where(participant => participant.Compared))
                {
                    <option value="@participant.Name" data-id="@participant.CommunityId"></option>
                }
            </datalist>
        </div>
        <div class="vf-actions col-sm-2">
            <button class="btn btn-sm btn-primary" type="submit">
                <span class="glyphicon glyphicon-filter"></span> @L["Filter"]
            </button>
            @if (Model.VoterId != null || Model.PlayerId != null)
            {
                <a class="btn btn-sm btn-default" href="@AppConsts.CommunityVotesPage">
                    <span class="glyphicon glyphicon-remove"></span> @L["Clear"]
                </a>
            }
        </div>
    </div>
</form>

@if (Model.VoterId != null || Model.PlayerId != null)
{
    <div class="vf-chips">
        @if (Model.VoterId != null)
        {
            <span class="vf-chip">
                <img src="/avatar/@Model.VoterId" alt="@Model.VoterName" onerror="imgOnError(this)">
                <span>@L["Votes made by {0}", Model.VoterName ?? ""]</span>
                <a href="@CommunityVoteUrls.Votes(null, Model.PlayerId)" title="@L["Remove this filter"]" aria-label="@L["Remove this filter"]">
                    <span class="glyphicon glyphicon-remove-circle"></span>
                </a>
            </span>
        }
        @if (Model.PlayerId != null)
        {
            <span class="vf-chip">
                <img src="/avatar/@Model.PlayerId" alt="@Model.PlayerName" onerror="imgOnError(this)">
                <span>@L["Comparisons of {0}", Model.PlayerName ?? ""]</span>
                <a href="@CommunityVoteUrls.Votes(Model.VoterId, null)" title="@L["Remove this filter"]" aria-label="@L["Remove this filter"]">
                    <span class="glyphicon glyphicon-remove-circle"></span>
                </a>
            </span>
            @if (rating != null)
            {
                <span class="vf-summary">
                    <span>@L["Rating"]: <b>@CommunityDisplay.RatingWithMargin(rating.Rating, rating.Deviation)</b></span>
                    <span style="color: #5cb85c">@L["Wins"]: <b>@rating.Wins</b></span>
                    <span style="color: #f0ad4e">@L["Draws"]: <b>@rating.Draws</b></span>
                    <span style="color: #d9534f">@L["Losses"]: <b>@rating.Losses</b></span>
                </span>
            }
        }
    </div>
}

@if (Model.Votes.Total == 0)
{
    <div class="jumbotron text-center">
        <p>@L["There are no votes to show yet."]</p>
        <a class="btn btn-success btn-lg" href="@AppConsts.CommunityVotePage">
            <span class="glyphicon glyphicon-thumbs-up"></span> @L["Vote now"]
        </a>
    </div>
}
else
{
    @await Html.PartialAsync("_VoteRows", new CommunityVoteRowsModel(Model.Votes.Items, Model.ShowVoters, Model.TimeZone, Model.VoterId, Model.PlayerId, Model.Moderate))

    @await Html.PartialAsync("_Pagination", PaginationModel.Of(Model.Votes, number => CommunityVoteUrls.Votes(Model.VoterId, Model.PlayerId, number)))
}

<script src="~/js/pages/community-votes.js" asp-append-version="true"></script>

@await Html.PartialAsync("_PlayerPickerModal")
