@model CommunityVotesViewModel

@{
    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Latest votes"],
        Description = L["See who voted for whom in the community ranking."]
    };

    string Url(long? voter, long? player, int page = 1)
    {
        var query = new List<string>();

        if (voter != null)
            query.Add($"voter={voter}");

        if (player != null)
            query.Add($"player={player}");

        if (page > 1)
            query.Add($"page={page}");

        return query.Count == 0 ? AppConsts.CommunityVotesPage : $"{AppConsts.CommunityVotesPage}?{string.Join("&", query)}";
    }

    var rating = Model.PlayerRating;
}

@section Styles {
    <style>
        .vf-lead {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }

            .vf-lead p {
                margin: 0;
                font-style: italic;
                opacity: .85;
            }

        .vf-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: 10px;
            margin-bottom: 12px;
            padding: 10px 12px;
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 8px;
            background: rgba(255, 255, 255, .03);
        }

            .vf-filters .form-group {
                flex: 1 1 220px;
                margin: 0;
            }

            .vf-filters label {
                font-size: 12px;
                opacity: .8;
            }

        .vf-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 12px;
        }

        .vf-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 4px 10px 4px 4px;
            border: 1px solid rgba(91, 192, 222, .5);
            border-radius: 20px;
            background: rgba(91, 192, 222, .12);
        }

            .vf-chip img {
                width: 24px;
                height: 24px;
                border-radius: 50%;
            }

            .vf-chip a {
                color: inherit;
                opacity: .7;
            }

        .vf-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: center;
            font-size: 13px;
        }

            .vf-summary b {
                font-size: 15px;
            }

        .vf-list {
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 8px;
            overflow: hidden;
        }

        .vf-row {
            display: grid;
            grid-template-columns: 96px minmax(0, 190px) minmax(0, 1fr);
            align-items: center;
            gap: 12px;
            padding: 6px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, .06);
        }

            .vf-row:nth-child(even) {
                background: rgba(255, 255, 255, .025);
            }

            .vf-row:last-child {
                border-bottom: 0;
            }

            .vf-row:hover {
                background: rgba(255, 255, 255, .05);
            }

        .vf-when {
            font-size: 12px;
            white-space: nowrap;
            opacity: .65;
        }

        .vf-voter {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
            color: inherit;
            font-size: 13px;
        }

            .vf-voter span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .vf-voter img {
                width: 24px;
                height: 24px;
                border-radius: 50%;
            }

        a.vf-voter:hover {
            color: #5bc0de;
            text-decoration: none;
        }

        .vf-pair {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 34px minmax(0, 1fr);
            align-items: center;
            gap: 8px;
        }

        .vf-player {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
            padding: 3px 8px 3px 3px;
            border: 1px solid transparent;
            border-radius: 6px;
            color: inherit;
        }

            .vf-player:hover,
            .vf-player:focus {
                color: inherit;
                text-decoration: none;
                background: rgba(255, 255, 255, .06);
            }

            .vf-player img {
                flex: none;
                width: 30px;
                height: 30px;
                border-radius: 6px;
            }

            .vf-player .vf-name {
                overflow: hidden;
                font-weight: bold;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .vf-player .glyphicon {
                flex: none;
                margin-left: auto;
                font-size: 12px;
            }

        .vf-right {
            flex-direction: row-reverse;
            padding: 3px 3px 3px 8px;
            text-align: right;
        }

            .vf-right .glyphicon {
                margin-left: 0;
                margin-right: auto;
            }

        .vf-win {
            border-color: rgba(92, 184, 92, .7);
            background: rgba(92, 184, 92, .14);
        }

            .vf-win .glyphicon {
                color: #5cb85c;
            }

        .vf-lose {
            opacity: .5;
        }

            .vf-lose .glyphicon {
                display: none;
            }

        .vf-same {
            border-color: rgba(240, 173, 78, .7);
            background: rgba(240, 173, 78, .1);
        }

            .vf-same .glyphicon {
                display: none;
            }

        .vf-mid {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
            font-size: 11px;
            font-weight: bold;
        }

        .vf-mid-same {
            background: #f0ad4e;
            color: #fff;
            font-size: 16px;
        }

        .vf-pages {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 14px;
        }

        @@media (max-width: 767px) {
            .vf-row {
                grid-template-columns: minmax(0, 1fr) auto;
                gap: 6px 10px;
                padding: 8px 10px;
            }

            .vf-when {
                order: 2;
                text-align: right;
            }

            .vf-voter {
                order: 1;
            }

            .vf-pair {
                order: 3;
                grid-column: 1 / -1;
            }
        }
    </style>
}

<h4 class="text-center"><span class="glyphicon glyphicon-transfer"></span> @L["Latest votes"]</h4>

<div class="vf-lead">
    <p>@L["See who voted for whom. Click a player to see only their comparisons."]</p>
    <div>
        <a class="btn btn-sm btn-default" href="/community">
            <span class="glyphicon glyphicon-list"></span> @L["Community ranking"]
        </a>
        <a class="btn btn-sm btn-success" href="@AppConsts.CommunityVotePage">
            <span class="glyphicon glyphicon-thumbs-up"></span> @L["Vote now"]
        </a>
    </div>
</div>

<form class="vf-filters" method="get" action="@AppConsts.CommunityVotesPage" id="vf-filters">
    @if (Model.ShowVoters)
    {
        <div class="form-group">
            <label for="vf-voter-name">@L["Votes made by"]</label>
            <div class="input-group input-group-sm">
                <input class="form-control" id="vf-voter-name" list="vf-voters" autocomplete="off" placeholder="@L["Type a player name"]" value="@Model.VoterName">
                <span class="input-group-btn">
                    <button type="button" class="btn btn-default" data-player-picker="#vf-voter" data-player-picker-source="@AppConsts.CommunityPlayersSearchUrl" data-player-picker-role="@AppConsts.CommunityVoterRole" data-player-picker-hint="@L["The players who voted, the most recent vote first."]" data-player-picker-submit title="@L["Search for a player"]" aria-label="@L["Search for a player"]"><span class="glyphicon glyphicon-search"></span></button>
                </span>
            </div>
            <input type="hidden" name="voter" id="vf-voter" value="@Model.VoterId">
            <datalist id="vf-voters">
                @foreach (var participant in Model.Participants.Where(participant => participant.Voted))
                {
                    <option value="@participant.Name" data-id="@participant.CommunityId"></option>
                }
            </datalist>
        </div>
    }
    <div class="form-group">
        <label for="vf-player-name">@L["Votes about"]</label>
        <div class="input-group input-group-sm">
            <input class="form-control" id="vf-player-name" list="vf-players" autocomplete="off" placeholder="@L["Type a player name"]" value="@Model.PlayerName">
            <span class="input-group-btn">
                <button type="button" class="btn btn-default" data-player-picker="#vf-player" data-player-picker-source="@AppConsts.CommunityPlayersSearchUrl" data-player-picker-hint="@L["The players who were compared in the voting, the most recent comparison first."]" data-player-picker-submit title="@L["Search for a player"]" aria-label="@L["Search for a player"]"><span class="glyphicon glyphicon-search"></span></button>
            </span>
        </div>
        <input type="hidden" name="player" id="vf-player" value="@Model.PlayerId">
        <datalist id="vf-players">
            @foreach (var participant in Model.Participants.Where(participant => participant.Compared))
            {
                <option value="@participant.Name" data-id="@participant.CommunityId"></option>
            }
        </datalist>
    </div>
    <div>
        <button class="btn btn-sm btn-primary" type="submit"><span class="glyphicon glyphicon-filter"></span> @L["Filter"]</button>
        @if (Model.VoterId != null || Model.PlayerId != null)
        {
            <a class="btn btn-sm btn-default" href="@AppConsts.CommunityVotesPage"><span class="glyphicon glyphicon-remove"></span> @L["Clear"]</a>
        }
    </div>
</form>

@if (Model.VoterId != null || Model.PlayerId != null)
{
    <div class="vf-chips">
        @if (Model.VoterId != null)
        {
            <span class="vf-chip">
                <img src="/avatar/@Model.VoterId" alt="@Model.VoterName" onerror="imgOnError(this)">
                <span>@L["Votes made by {0}", Model.VoterName ?? ""]</span>
                <a href="@Url(null, Model.PlayerId)" title="@L["Remove this filter"]" aria-label="@L["Remove this filter"]"><span class="glyphicon glyphicon-remove-circle"></span></a>
            </span>
        }
        @if (Model.PlayerId != null)
        {
            <span class="vf-chip">
                <img src="/avatar/@Model.PlayerId" alt="@Model.PlayerName" onerror="imgOnError(this)">
                <span>@L["Comparisons of {0}", Model.PlayerName ?? ""]</span>
                <a href="@Url(Model.VoterId, null)" title="@L["Remove this filter"]" aria-label="@L["Remove this filter"]"><span class="glyphicon glyphicon-remove-circle"></span></a>
            </span>
            @if (rating != null)
            {
                <span class="vf-summary">
                    <span>@L["Rating"]: <b>@Display.Number((decimal)Math.Round(rating.Rating))</b></span>
                    <span style="color: #5cb85c">@L["Wins"]: <b>@rating.Wins</b></span>
                    <span style="color: #f0ad4e">@L["Draws"]: <b>@rating.Draws</b></span>
                    <span style="color: #d9534f">@L["Losses"]: <b>@rating.Losses</b></span>
                </span>
            }
        }
    </div>
}

@if (Model.Votes.Count == 0)
{
    <div class="jumbotron text-center">
        <p>@L["There are no votes to show yet."]</p>
        <a class="btn btn-success btn-lg" href="@AppConsts.CommunityVotePage">
            <span class="glyphicon glyphicon-thumbs-up"></span> @L["Vote now"]
        </a>
    </div>
}
else
{
    <div class="vf-list">
        @foreach (var vote in Model.Votes)
        {
            var same = vote.Outcome == CommunityVoteOutcome.SameLevel;
            var leftClass = same ? "vf-same" : vote.Outcome == CommunityVoteOutcome.Left ? "vf-win" : "vf-lose";
            var rightClass = same ? "vf-same" : vote.Outcome == CommunityVoteOutcome.Right ? "vf-win" : "vf-lose";

            <div class="vf-row">
                <time class="vf-when" datetime="@vote.CreatedAtUtc.ToString("o")">@LiveDisplay.ShortDateTime(vote.CreatedAtUtc, Model.TimeZone)</time>
                @if (Model.ShowVoters)
                {
                    <a class="vf-voter" href="@Url(vote.VoterId, Model.PlayerId)" title="@L["See the votes made by this player"]">
                        <img src="/avatar/@vote.VoterId" alt="" onerror="imgOnError(this)">
                        <span>@vote.VoterName</span>
                    </a>
                }
                else
                {
                    <span class="vf-voter"><span class="glyphicon glyphicon-user"></span> <span>@L["A player voted"]</span></span>
                }
                <div class="vf-pair">
                    <a class="vf-player @leftClass" href="@Url(Model.VoterId, vote.LeftPlayerId)" title="@L["See the comparisons of this player"]">
                        <img src="/avatar/@vote.LeftPlayerId" alt="" onerror="imgOnError(this)">
                        <span class="vf-name">@vote.LeftName</span>
                        <span class="glyphicon glyphicon-ok"></span>
                    </a>
                    <span class="vf-mid@(same ? " vf-mid-same" : "")" title="@(same ? L["Same level"] : L["Better"])">@(same ? "=" : "VS")</span>
                    <a class="vf-player vf-right @rightClass" href="@Url(Model.VoterId, vote.RightPlayerId)" title="@L["See the comparisons of this player"]">
                        <img src="/avatar/@vote.RightPlayerId" alt="" onerror="imgOnError(this)">
                        <span class="vf-name">@vote.RightName</span>
                        <span class="glyphicon glyphicon-ok"></span>
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="vf-pages">
        @if (Model.Page > 1)
        {
            <a class="btn btn-default" href="@Url(Model.VoterId, Model.PlayerId, Model.Page - 1)">
                <span class="glyphicon glyphicon-chevron-left"></span> @L["Newer"]
            </a>
        }
        @if (Model.HasMore)
        {
            <a class="btn btn-default" href="@Url(Model.VoterId, Model.PlayerId, Model.Page + 1)">
                @L["Older"] <span class="glyphicon glyphicon-chevron-right"></span>
            </a>
        }
    </div>
}

<script>
    (function () {
        var form = document.getElementById('vf-filters');

        function resolve(nameId, listId, hiddenId) {
            var input = document.getElementById(nameId);
            var hidden = document.getElementById(hiddenId);

            if (!input || !hidden)
                return;

            if (hidden.dataset.picked) {
                hidden.disabled = !hidden.value;
                return;
            }

            var text = input.value.trim().toLowerCase();
            var match = Array.prototype.find.call(document.getElementById(listId).options, function (option) {
                return option.value.toLowerCase() === text;
            });

            hidden.value = match ? match.getAttribute('data-id') : '';
            hidden.disabled = !hidden.value;
        }

        form.addEventListener('submit', function () {
            resolve('vf-voter-name', 'vf-voters', 'vf-voter');
            resolve('vf-player-name', 'vf-players', 'vf-player');
        });

        document.addEventListener('DOMContentLoaded', function () {
            $('#vf-voter, #vf-player').on('change', function () {
                this.dataset.picked = '1';
            });
        });

        ['vf-voter-name', 'vf-player-name'].forEach(function (id) {
            var input = document.getElementById(id);

            if (input)
                input.addEventListener('change', function () {
                    form.requestSubmit ? form.requestSubmit() : form.submit();
                });
        });
    })();
</script>

@await Html.PartialAsync("_PlayerPickerModal")
