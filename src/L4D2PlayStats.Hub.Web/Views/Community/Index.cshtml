@model CommunityRankingViewModel
@inject ICurrentUser CurrentUser

@{
    var topPlayer = Model.Players.FirstOrDefault()?.Entry;

    ViewData["PageMetadata"] = new PageMetadata
    {
        Title = L["Community ranking"],
        Description = L["Built from the votes of the players. It does not reset with the season."],
        Image = topPlayer == null ? null : $"/avatar/{topPlayer.CommunityId}",
        ImageAlt = topPlayer?.Name
    };
}

@section Styles {
    <style>
        .place {
            width: 30px;
        }

        table {
            margin-bottom: 0 !important;
        }

        p {
            margin-bottom: 0 !important;
        }

        th {
            vertical-align: middle !important;
        }

        .community-lead {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

            .community-lead small {
                margin-right: 10px;
                font-style: italic;
            }

        .community-toolbar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 8px;
        }

        .community-votes-link {
            margin-left: 6px;
            font-size: 12px;
            opacity: .55;
        }

            .community-votes-link:hover,
            .community-votes-link:focus {
                opacity: 1;
                text-decoration: none;
            }
    </style>
}

<h4 class="text-center">@L["Community ranking"]</h4>

<div class="community-lead">
    <small>@L["Built from the votes of the players. It does not reset with the season."]</small>
</div>

@await Html.PartialAsync("_VoteInvite", false)

@await Html.PartialAsync("_HowItWorks", new CommunityHowItWorksModel(Model.Settings, false))

@if (Model.Players.Count == 0)
{
    <div class="jumbotron text-center" style="margin-top: 20px">
        <p>@L["Nobody has enough comparisons to be listed yet."]</p>
        <a class="btn btn-info" href="@AppConsts.CommunityVotesPage">
            <span class="glyphicon glyphicon-transfer"></span> @L["See the latest votes"]
        </a>
    </div>
}
else
{
    <div class="community-toolbar">
        <a class="btn btn-sm btn-info" href="@AppConsts.CommunityVotesPage">
            <span class="glyphicon glyphicon-transfer"></span> @L["See the latest votes"]
        </a>
    </div>

    <table class="table table-striped table-hover table-bordered table-condensed" id="table-community-ranking">
        <thead>
        <tr>
            <th class="text-center">#</th>
            @if (Model.PlayerPages)
            {
                <th class="text-center hide-mobile">@L["Patent"]</th>
            }
            <th colspan="2">@L["Player"]</th>
            <th class="text-center">@L["Rating"] @FieldHelp.More(L["What the rating and the other columns mean."], L["Community ranking"], L["Rating: the points built from the votes. Everybody starts with the same rating; it goes up when voters say the player is better and down when they say the other one is. Beating someone with a higher rating is worth more.\nComparisons: how many times the player was judged against another player. The more comparisons, the more reliable the rating.\nWins: comparisons in which voters said this player is better.\nDraws: comparisons in which voters said the two are at the same level.\nLosses: comparisons in which voters said the other player is better.\nAnswers of the kind \"I don't know\" do not count as comparisons."])</th>
            <th class="text-center hide-mobile">@L["Comparisons"]</th>
            <th class="text-center hide-mobile">@L["Wins"]</th>
            <th class="text-center hide-mobile">@L["Draws"]</th>
            <th class="text-center hide-mobile">@L["Losses"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Players)
        {
            var player = row.Entry;

            <tr class="hover @(CurrentUser.ItIsMe(player.CommunityId) ? "it-is-me" : string.Empty)">
                <td class="text-center vertical-align-middle">
                    @switch (player.Position)
                    {
                        case 1:
                            <img src="~/imgs/first-place.png" alt="@L["First place"]" title="@L["First place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        case 2:
                            <img src="~/imgs/second-place.png" alt="@L["Second place"]" title="@L["Second place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        case 3:
                            <img src="~/imgs/third-place.png" alt="@L["Third place"]" title="@L["Third place"]" class="place" data-toggle="tooltip" data-placement="top"/>
                            break;
                        default:
                            @($"#{player.Position:N0}")
                            break;
                    }
                </td>
                @if (row.Patent != null)
                {
                    <td class="text-center vertical-align-middle slim hide-mobile">
                        <img src="@row.Patent.Image" alt="@row.Patent.FullName" data-toggle="tooltip" data-placement="top" title="@row.Patent.FullName" style="width: 32px"/>
                    </td>
                }
                <td class="text-center vertical-align-middle slim" style="margin: 0; padding: 0">
                    @if (Model.PlayerPages)
                    {
                        <a href="/player/@player.CommunityId" title="@player.Name">
                            <img src="/avatar/@player.CommunityId" alt="@player.Name" title="@player.Name" style="width: 40px; border-radius: 5px" onerror="imgOnError(this)"/>
                        </a>
                    }
                    else
                    {
                        <img src="/avatar/@player.CommunityId" alt="@player.Name" title="@player.Name" style="width: 40px; border-radius: 5px" onerror="imgOnError(this)"/>
                    }
                </td>
                <td class="vertical-align-middle">
                    @if (Model.PlayerPages)
                    {
                        <a href="/player/@player.CommunityId">@player.Name.TruncatePlayerName()</a>
                    }
                    else
                    {
                        @player.Name.TruncatePlayerName()
                    }
                    <a class="community-votes-link" href="@AppConsts.CommunityVotesPage?player=@player.CommunityId" title="@L["See the comparisons of this player"]" aria-label="@L["See the comparisons of this player"]"><span class="glyphicon glyphicon-transfer"></span></a>
                </td>
                <td class="text-center vertical-align-middle">
                    <p class="bold" data-toggle="tooltip" data-placement="top" title="@L["Rating"]">
                        @Display.Number((decimal)Math.Round(player.Rating))
                    </p>
                </td>
                <td class="text-center vertical-align-middle hide-mobile">
                    <p data-toggle="tooltip" data-placement="top" title="@L["Comparisons"]">
                        @player.Comparisons.ToString("N0")
                    </p>
                </td>
                <td class="text-center vertical-align-middle hide-mobile">
                    <p data-toggle="tooltip" data-placement="top" title="@L["Wins"]">
                        @player.Wins.ToString("N0")
                    </p>
                </td>
                <td class="text-center vertical-align-middle hide-mobile">
                    <p data-toggle="tooltip" data-placement="top" title="@L["Draws"]">
                        @player.Draws.ToString("N0")
                    </p>
                </td>
                <td class="text-center vertical-align-middle hide-mobile">
                    <p data-toggle="tooltip" data-placement="top" title="@L["Losses"]">
                        @player.Losses.ToString("N0")
                    </p>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="text-center" style="margin-top: 12px">
        <a class="btn btn-info" href="@AppConsts.CommunityVotesPage">
            <span class="glyphicon glyphicon-transfer"></span> @L["See who voted for whom"]
        </a>
    </div>
}

@if (Model.MinimumComparisons > 0)
{
    <small class="text-muted" style="display: block; margin-top: 6px; font-style: italic">@L["Minimum comparisons to be listed:"] @Model.MinimumComparisons</small>
}

@if (Model.MinimumMatches > 1)
{
    <small class="text-muted" style="display: block; margin-top: 6px; font-style: italic">@L["Minimum matches to be listed:"] @Model.MinimumMatches</small>
}
