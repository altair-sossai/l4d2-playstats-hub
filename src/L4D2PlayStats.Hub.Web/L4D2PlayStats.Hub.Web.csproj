<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OpenId.Steam" Version="11.0.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../L4D2PlayStats.Hub.Core/L4D2PlayStats.Hub.Core.csproj" />
    <ProjectReference Include="../L4D2PlayStats.Hub.Migrations.MySql/L4D2PlayStats.Hub.Migrations.MySql.csproj" />
    <ProjectReference Include="../L4D2PlayStats.Hub.Migrations.PostgreSql/L4D2PlayStats.Hub.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="../L4D2PlayStats.Hub.Migrations.Sqlite/L4D2PlayStats.Hub.Migrations.Sqlite.csproj" />
    <ProjectReference Include="../L4D2PlayStats.Hub.Migrations.SqlServer/L4D2PlayStats.Hub.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Resources\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Resources\Commands\*.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="L4D2PlayStats.Hub.Tests" />
  </ItemGroup>

</Project>
