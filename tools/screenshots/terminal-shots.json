  {
    "name": "install-docker-up",
    "directory": "~/playstats",
    "blocks": [
      { "command": "cat docker-compose.yml", "output": "docker-cat.log" },
      { "command": "docker compose up -d", "output": "docker-up.log" }
    ]
  },
  {
    "name": "install-docker-setup-code",
    "directory": "~/playstats",
    "blocks": [
      { "command": "docker compose logs hub | grep \"setup code\"", "output": "docker-code.log" },
      { "command": "docker compose ps", "output": "docker-ps.log" }
    ]
  },
  {
    "name": "install-docker-update",
    "directory": "~/playstats",
    "blocks": [
      { "command": "docker compose pull", "output": "docker-pull.log" },
      { "command": "docker compose up -d", "output": "docker-up2.log" }
    ]
  },
  {
    "name": "install-docker-backup",
    "directory": "~/playstats",
    "blocks": [
      { "command": "docker compose stop hub", "output": "docker-stop.log" },
      { "command": "docker volume ls", "output": "docker-vol.log" },
      { "command": "docker run --rm -v playstats_hub-data:/data -v \"$PWD\":/backup alpine tar -czf /backup/hub-backup.tar.gz -C /data .", "output": "docker-backup.log" },
      { "command": "docker compose start hub", "output": "docker-start.log" },
      { "command": "ls -lh hub-backup.tar.gz", "output": "docker-ls.log" }
    ]
  },
  {
    "name": "switch-installer",
    "blocks": [
      { "command": "curl -fsSL https://raw.githubusercontent.com/altair-sossai/l4d2-playstats-hub/main/deploy/install.sh | HUB_PORT=5090 HUB_VERSION=v0.8.0 bash", "output": "switch-install.log" }
    ]
  },
  {
    "name": "switch-ports",
    "blocks": [
      { "command": "ss -tlnp | grep -E ':(80|443|5000|5080|5090) '", "output": "switch-ports.log" }
